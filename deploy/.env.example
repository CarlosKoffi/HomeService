ASPNETCORE_ENVIRONMENT=Production

POSTGRES_DB=homeservice
POSTGRES_USER=homeservice
POSTGRES_PASSWORD=replace-with-a-strong-password

API_PORT=8080
COMPANY_PORT=8081
ADMIN_PORT=8082
POSTGRES_PORT=5432

API_BASE_URL=http://api:8080

# File storage. Keep Local for development. Use R2 in production after adding
# the credentials as protected environment variables in the hosting platform.
STORAGE_PROVIDER=Local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=wele-public-media-prod
R2_PRIVATE_BUCKET=wele-private-media-prod
R2_PUBLIC_BASE_URL=
R2_PUBLIC_DIRECT_DELIVERY_ENABLED=false

# API database options:
# Preferred explicit Npgsql format:
# ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=homeservice;Username=homeservice;Password=replace-with-a-strong-password
# Coolify PostgreSQL URL format is also accepted:
# DATABASE_URL=postgres://homeservice:replace-with-a-strong-password@postgres:5432/homeservice
