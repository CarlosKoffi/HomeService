<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="HomeService.Provider.Mobile.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <Color x:Key="Ink">#0F172A</Color>
        <Color x:Key="MutedInk">#667085</Color>
        <Color x:Key="WeleBlue">#155EEF</Color>
        <Color x:Key="WeleBlueDark">#0F172A</Color>
        <Color x:Key="Success">#16B364</Color>
        <Color x:Key="Warning">#F59E0B</Color>
        <Color x:Key="Danger">#DC2626</Color>
        <Color x:Key="BlueWash">#EEF4FF</Color>
        <Color x:Key="Line">#DCE8FF</Color>
        <Color x:Key="PageWash">#FFFFFF</Color>

        <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="White" /></Style>
        <Style TargetType="Shell">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="ForegroundColor" Value="{StaticResource Ink}" />
            <Setter Property="TabBarBackgroundColor" Value="White" />
            <Setter Property="TabBarForegroundColor" Value="{StaticResource WeleBlue}" />
            <Setter Property="TabBarUnselectedColor" Value="{StaticResource MutedInk}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="PlusJakartaSans" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="EyebrowLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" /><Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1" /><Setter Property="TextColor" Value="{StaticResource WeleBlue}" />
        </Style>
        <Style x:Key="ScreenTitleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="23" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="LineHeight" Value="1.05" />
        </Style>
        <Style x:Key="CardTitleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="17" /><Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="BodyLabel" TargetType="Label">
            <Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="1.25" />
        </Style>
        <Style x:Key="MutedLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" /><Setter Property="LineHeight" Value="1.25" /><Setter Property="TextColor" Value="{StaticResource MutedInk}" />
        </Style>
        <Style x:Key="PremiumCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" /><Setter Property="Stroke" Value="{StaticResource Line}" />
            <Setter Property="StrokeThickness" Value="1" /><Setter Property="StrokeShape" Value="RoundRectangle 18" /><Setter Property="Padding" Value="15" />
            <Setter Property="Shadow"><Setter.Value><Shadow Brush="#16155EEF" Offset="0,3" Radius="10" Opacity="0.12" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" /><Setter Property="Stroke" Value="{StaticResource Line}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" /><Setter Property="Padding" Value="14,0" /><Setter Property="HeightRequest" Value="54" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="FontFamily" Value="PlusJakartaSans" /><Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="PlaceholderColor" Value="{StaticResource MutedInk}" />
            <Setter Property="MinimumHeightRequest" Value="52" /><Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="Editor">
            <Setter Property="FontFamily" Value="PlusJakartaSans" /><Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="PlaceholderColor" Value="{StaticResource MutedInk}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="PlusJakartaSans" /><Setter Property="CornerRadius" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="50" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="FontSize" Value="14" />
            <Setter Property="BackgroundColor" Value="{StaticResource WeleBlue}" /><Setter Property="TextColor" Value="White" />
        </Style>
        <Style TargetType="ImageButton">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HeightRequest" Value="42" />
            <Setter Property="WidthRequest" Value="42" />
        </Style>
        <Style x:Key="FilterChip" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource Line}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="14,9" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="White" /><Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="BorderColor" Value="{StaticResource Line}" /><Setter Property="BorderWidth" Value="1" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource WeleBlue}" /><Setter Property="TextColor" Value="White" />
            <Setter Property="BorderColor" Value="{StaticResource WeleBlue}" /><Setter Property="BorderWidth" Value="1" />
        </Style>
    </Application.Resources>
</Application>
