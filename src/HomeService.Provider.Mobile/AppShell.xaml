<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="HomeService.Provider.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:HomeService.Provider.Mobile.Pages"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="Wélé Pro">
    <TabBar>
        <ShellContent Route="home" Title="Accueil" Icon="tab_home.svg" ContentTemplate="{DataTemplate pages:HomePage}" />
        <ShellContent x:Name="MissionsTab" Route="missions" Title="Missions" Icon="tab_missions.svg" ContentTemplate="{DataTemplate pages:MissionsPage}" />
        <ShellContent Route="calendar" Title="Calendrier" Icon="tab_calendar.svg" ContentTemplate="{DataTemplate pages:CalendarPage}" />
        <ShellContent x:Name="MessagesTab" Route="messages" Title="Messages" Icon="tab_messages.svg" ContentTemplate="{DataTemplate pages:ChatPage}" />
        <ShellContent Route="profile" Title="Profil" Icon="tab_profile.svg" ContentTemplate="{DataTemplate pages:ProfilePage}" />
    </TabBar>
</Shell>
