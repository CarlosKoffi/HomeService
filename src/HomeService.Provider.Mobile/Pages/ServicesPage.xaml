<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Provider.Mobile.Pages.ServicesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">
    <RefreshView x:Name="RefreshHost" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="18,18,18,30" Spacing="15">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Button Text="‹" FontSize="28" WidthRequest="42" BackgroundColor="White" TextColor="{StaticResource Ink}" Clicked="OnBackClicked" /><Label Grid.Column="1" Text="Services &amp; prestations" Style="{StaticResource ScreenTitleLabel}" VerticalTextAlignment="Center" /></Grid>
                <Label Text="Compétences validées pour les missions que vous pouvez recevoir." Style="{StaticResource MutedLabel}" />
                <Border BackgroundColor="{StaticResource BlueWash}" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 16" Padding="13"><Label Text="Pour un salarié, les tarifs ne sont jamais affichés. Les compétences restent gérées avec l’entreprise." Style="{StaticResource MutedLabel}" /></Border>
                <VerticalStackLayout x:Name="ContentHost" Spacing="11" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
