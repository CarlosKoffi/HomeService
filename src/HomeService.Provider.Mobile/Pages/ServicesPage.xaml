<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Provider.Mobile.Pages.ServicesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">
    <RefreshView x:Name="RefreshHost" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="18,16,18,32" Spacing="15">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <ImageButton Source="icon_back.svg" Clicked="OnBackClicked" />
                    <Label Grid.Column="1" Text="Compétences" Style="{StaticResource ScreenTitleLabel}" VerticalTextAlignment="Center" />
                </Grid>

                <Label Text="Les compétences validées par votre entreprise déterminent les missions que vous recevez." Style="{StaticResource MutedLabel}" />

                <Border x:Name="MessageBanner" IsVisible="False" BackgroundColor="#FFF7ED" Stroke="#FED7AA" StrokeShape="RoundRectangle 14" Padding="13">
                    <Label x:Name="MessageLabel" Style="{StaticResource BodyLabel}" />
                </Border>

                <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False" Color="{StaticResource WeleBlue}" />
                <VerticalStackLayout x:Name="ContentHost" Spacing="11" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
