<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Provider.Mobile.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="18,16,18,30" Spacing="12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7"><ImageButton Source="icon_back.svg" Clicked="OnBackClicked" /><Label Grid.Column="1" Text="Paramètres" Style="{StaticResource ScreenTitleLabel}" VerticalTextAlignment="Center" /></Grid>
            <Label Text="Préférences de votre application professionnelle." Style="{StaticResource MutedLabel}" Margin="0,0,0,4" />

            <Border Style="{StaticResource PremiumCard}" Padding="13"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Image Source="app_bell.svg" WidthRequest="23" HeightRequest="23" /><VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="Notifications" FontAttributes="Bold" /><Label Text="Autorisation Android et alertes de mission" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Image Grid.Column="2" Source="chevron_right.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" /></Grid><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNotificationSettingsTapped" /></Border.GestureRecognizers></Border>
            <Border Style="{StaticResource PremiumCard}" Padding="13"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Image Source="icon_lock.svg" WidthRequest="23" HeightRequest="23" /><VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="Sécurité et mot de passe" FontAttributes="Bold" /><Label Text="Votre mot de passe est chiffré et protégé" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Image Grid.Column="2" Source="chevron_right.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" /></Grid></Border>
            <Border Style="{StaticResource PremiumCard}" Padding="13"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Image Source="icon_theme.svg" WidthRequest="23" HeightRequest="23" /><VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="Apparence" FontAttributes="Bold" /><Label Text="Thème clair activé" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Border Grid.Column="2" BackgroundColor="#ECFDF3" Stroke="#ABEFC6" StrokeShape="RoundRectangle 11" Padding="8,5" VerticalOptions="Center"><Label Text="Actif" FontSize="10" FontAttributes="Bold" TextColor="#067647" /></Border></Grid></Border>
            <Border Style="{StaticResource PremiumCard}" Padding="13"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Image Source="icon_language.svg" WidthRequest="23" HeightRequest="23" /><VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="Langue" FontAttributes="Bold" /><Label Text="Français" Style="{StaticResource MutedLabel}" /></VerticalStackLayout></Grid></Border>
            <Border Style="{StaticResource PremiumCard}" Padding="13"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Image Source="icon_help.svg" WidthRequest="23" HeightRequest="23" /><VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="Aide &amp; support" FontAttributes="Bold" /><Label Text="Centre d’aide et contact" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Image Grid.Column="2" Source="chevron_right.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" /></Grid></Border>
            <Border Style="{StaticResource PremiumCard}" Padding="13"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Image Source="icon_legal.svg" WidthRequest="23" HeightRequest="23" /><VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="Conditions d’utilisation" FontAttributes="Bold" /><Label Text="Informations légales Wélé" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Image Grid.Column="2" Source="chevron_right.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" /></Grid></Border>

            <Button Text="Se déconnecter" Style="{StaticResource SecondaryButton}" TextColor="{StaticResource Danger}" BorderColor="#FECACA" Clicked="OnLogoutClicked" Margin="0,10,0,0" />
            <Label Text="Wélé Pro 0.4.3" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
