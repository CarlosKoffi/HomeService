<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Provider.Mobile.Pages.PortfolioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">
    <RefreshView x:Name="RefreshHost" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="18,18,18,30" Spacing="15">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Button Text="‹" FontSize="28" WidthRequest="42" BackgroundColor="White" TextColor="{StaticResource Ink}" Clicked="OnBackClicked" /><Label Grid.Column="1" Text="Portfolio" Style="{StaticResource ScreenTitleLabel}" VerticalTextAlignment="Center" /></Grid>
                <Label Text="Présentez vos réalisations pour les services qui exigent des preuves de savoir-faire." Style="{StaticResource MutedLabel}" />
                <Border Style="{StaticResource FieldBorder}"><Picker x:Name="ServicePicker" Title="Choisir un service" /></Border>
                <Button Text="Ajouter une réalisation" Clicked="OnAddPhotoClicked" />
                <Border x:Name="MessageBanner" IsVisible="False" BackgroundColor="{StaticResource BlueWash}" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 14" Padding="13"><Label x:Name="MessageLabel" Style="{StaticResource BodyLabel}" /></Border>
                <Grid x:Name="PortfolioGrid" ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
