<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Provider.Mobile.Pages.MissionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageWash}"
    Title="Missions">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="16">
            <Border x:Name="MessageBanner" IsVisible="False" BackgroundColor="#EEF4FF" Stroke="#CFE0FF" StrokeShape="RoundRectangle 18" Padding="14">
                <Label x:Name="MessageLabel" Text="Chargement..." Style="{StaticResource BodyLabel}" />
            </Border>

            <Border x:Name="CurrentMissionCard" BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 22" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="MissionStateLabel" Text="MISSION" Style="{StaticResource EyebrowLabel}" TextColor="{StaticResource WeleOrange}" />
                    <Label x:Name="MissionTitleLabel" Text="Aucune mission" Style="{StaticResource ScreenTitleLabel}" />
                    <Label x:Name="MissionCompanyLabel" Text="Entreprise : -" Style="{StaticResource BodyLabel}" />
                    <Label x:Name="MissionLocationLabel" Text="Zone : -" Style="{StaticResource BodyLabel}" />
                    <Label x:Name="MissionCountdownLabel" Text="" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource WeleOrange}" />
                    <Label x:Name="MissionCustomerLabel" Text="" Style="{StaticResource BodyLabel}" />
                    <Label x:Name="MissionDescriptionLabel" Text="" Style="{StaticResource BodyLabel}" />

                    <Grid x:Name="OfferActionsGrid" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button x:Name="RefuseButton" Text="Refuser" Grid.Column="0" BackgroundColor="White" BorderColor="{StaticResource Line}" BorderWidth="1" TextColor="Black" Clicked="OnRefuseClicked" />
                        <Button x:Name="AcceptButton" Text="Accepter" Grid.Column="1" BackgroundColor="{StaticResource WeleGreen}" TextColor="White" Clicked="OnAcceptClicked" />
                    </Grid>

                    <VerticalStackLayout x:Name="FieldActionsStack" IsVisible="False" Spacing="10" Margin="0,8,0,0">
                        <Button x:Name="VerifyArrivalButton" Text="Verifier mon arrivee" BackgroundColor="#EEF4FF" TextColor="Black" Clicked="OnVerifyArrivalClicked" />
                        <Button x:Name="StartButton" Text="Demarrer la prestation" BackgroundColor="{StaticResource WeleGreen}" TextColor="White" Clicked="OnStartClicked" />
                        <Button x:Name="CompleteButton" Text="Terminer la prestation" BackgroundColor="#111111" TextColor="White" Clicked="OnCompleteClicked" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Informations terrain" Style="{StaticResource CardTitleLabel}" />

            <Border BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 18" Padding="14">
                <VerticalStackLayout Spacing="5">
                    <Label x:Name="ArrivalStatusLabel" Text="Arrivee : non verifiee" Style="{StaticResource CardTitleLabel}" />
                    <Label x:Name="ArrivalDetailLabel" Text="L'application verifiera votre position avec tolerance avant le demarrage." Style="{StaticResource BodyLabel}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Une mission live acceptee bloque les nouvelles affectations jusqu'a la fin de prestation." FontSize="13" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
