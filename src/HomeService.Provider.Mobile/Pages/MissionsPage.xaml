<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Provider.Mobile.Pages.MissionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Missions">
    <RefreshView x:Name="RefreshHost" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="18,20,18,30" Spacing="15">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <ImageButton Source="icon_back.svg" Clicked="OnBackClicked" />
                    <Label Grid.Column="1" Text="Mes missions" Style="{StaticResource ScreenTitleLabel}" VerticalTextAlignment="Center" />
                </Grid>
                <Label Text="Chaque mission est rangée selon son véritable état." Style="{StaticResource MutedLabel}" />

                <Border x:Name="MessageBanner" IsVisible="False" BackgroundColor="#FFF7ED" Stroke="#FED7AA" StrokeShape="RoundRectangle 14" Padding="13">
                    <Label x:Name="MessageLabel" Style="{StaticResource BodyLabel}" />
                </Border>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Border x:Name="AvailableChip" Style="{StaticResource FilterChip}">
                            <Label x:Name="AvailableChipLabel" Text="Disponibles" FontAttributes="Bold" FontSize="13" />
                            <Border.GestureRecognizers><TapGestureRecognizer CommandParameter="Available" Tapped="OnFilterTapped" /></Border.GestureRecognizers>
                        </Border>
                        <Border x:Name="InProgressChip" Style="{StaticResource FilterChip}">
                            <Label x:Name="InProgressChipLabel" Text="En cours" FontAttributes="Bold" FontSize="13" />
                            <Border.GestureRecognizers><TapGestureRecognizer CommandParameter="InProgress" Tapped="OnFilterTapped" /></Border.GestureRecognizers>
                        </Border>
                        <Border x:Name="UpcomingChip" Style="{StaticResource FilterChip}">
                            <Label x:Name="UpcomingChipLabel" Text="À venir" FontAttributes="Bold" FontSize="13" />
                            <Border.GestureRecognizers><TapGestureRecognizer CommandParameter="Upcoming" Tapped="OnFilterTapped" /></Border.GestureRecognizers>
                        </Border>
                        <Border x:Name="CompletedChip" Style="{StaticResource FilterChip}">
                            <Label x:Name="CompletedChipLabel" Text="Terminées" FontAttributes="Bold" FontSize="13" />
                            <Border.GestureRecognizers><TapGestureRecognizer CommandParameter="Completed" Tapped="OnFilterTapped" /></Border.GestureRecognizers>
                        </Border>
                        <Border x:Name="CancelledChip" Style="{StaticResource FilterChip}">
                            <Label x:Name="CancelledChipLabel" Text="Annulées" FontAttributes="Bold" FontSize="13" />
                            <Border.GestureRecognizers><TapGestureRecognizer CommandParameter="Cancelled" Tapped="OnFilterTapped" /></Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>

                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="SectionTitleLabel" Text="En cours" Style="{StaticResource CardTitleLabel}" />
                    <Label x:Name="SectionCountLabel" Grid.Column="1" Style="{StaticResource MutedLabel}" VerticalTextAlignment="Center" />
                </Grid>

                <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False" Color="{StaticResource WeleBlue}" />
                <VerticalStackLayout x:Name="MissionListStack" Spacing="10" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
