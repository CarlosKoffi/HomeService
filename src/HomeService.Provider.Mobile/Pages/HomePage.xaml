<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Provider.Mobile.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Accueil">
    <RefreshView x:Name="RefreshHost" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="18,16,18,30" Spacing="15">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Image Source="https://media.wele.africa/website/provider/wele-logo-horizontal.png"
                           HeightRequest="48"
                           WidthRequest="128"
                           Aspect="AspectFit"
                           HorizontalOptions="Start" />
                    <Grid Grid.Column="1" WidthRequest="48" HeightRequest="48">
                        <ImageButton Source="app_bell.svg" WidthRequest="46" HeightRequest="46" Clicked="OnNotificationsClicked" />
                        <Border x:Name="NotificationBadge" IsVisible="False" BackgroundColor="{StaticResource WeleBlue}" Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 10" Padding="4,1" HorizontalOptions="End" VerticalOptions="Start" MinimumWidthRequest="20" HeightRequest="20">
                            <Label x:Name="NotificationBadgeLabel" Text="0" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <Border x:Name="MessageBanner" IsVisible="False" BackgroundColor="#FFF7ED" Stroke="#FED7AA" StrokeShape="RoundRectangle 14" Padding="13">
                    <Label x:Name="MessageLabel" Style="{StaticResource BodyLabel}" />
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label x:Name="GreetingLabel" Text="Bonjour" Style="{StaticResource ScreenTitleLabel}" />
                        <Label x:Name="ProviderStatusLabel" Text="Prêt pour vos missions aujourd’hui." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                        <Switch x:Name="AvailabilitySwitch" Toggled="OnAvailabilityToggled" HorizontalOptions="End" OnColor="{StaticResource Success}" />
                        <Label x:Name="AvailabilityLabel" Text="Disponible" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Success}" HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Grid>

                <Border x:Name="AvailabilityInfoCard" Style="{StaticResource PremiumCard}" IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="icon_info.svg" WidthRequest="23" HeightRequest="23" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Indisponible pendant la mission" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
                            <Label x:Name="AvailabilityMessageLabel" Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border BackgroundColor="{StaticResource WeleBlue}" Stroke="{StaticResource WeleBlue}" StrokeShape="RoundRectangle 20" Padding="16">
                    <VerticalStackLayout Spacing="13">
                        <Label Text="Missions aujourd’hui" TextColor="White" FontSize="13" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2"><Label x:Name="TodayCountLabel" Text="0" TextColor="White" FontSize="25" FontAttributes="Bold" HorizontalTextAlignment="Center" /><Label Text="Aujourd’hui" TextColor="#DDE8FF" FontSize="10" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2"><Label x:Name="ActiveCountLabel" Text="0" TextColor="White" FontSize="25" FontAttributes="Bold" HorizontalTextAlignment="Center" /><Label Text="En cours" TextColor="#DDE8FF" FontSize="10" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2"><Label x:Name="UpcomingCountLabel" Text="0" TextColor="White" FontSize="25" FontAttributes="Bold" HorizontalTextAlignment="Center" /><Label Text="À venir" TextColor="#DDE8FF" FontSize="10" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="ProfileCompletionBanner" BackgroundColor="#FFF9E8" Stroke="#FDE7A5" StrokeShape="RoundRectangle 18" Padding="14" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4"><Label Text="PROFIL À FINALISER" Style="{StaticResource EyebrowLabel}" /><Label x:Name="ProfileMessageLabel" Style="{StaticResource BodyLabel}" /></VerticalStackLayout>
                        <Label x:Name="ProfilePercentLabel" Grid.Column="1" FontAttributes="Bold" TextColor="{StaticResource Warning}" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

                <Border x:Name="LiveOfferCard" IsVisible="False" Style="{StaticResource PremiumCard}" Stroke="{StaticResource WeleBlue}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto"><Label Text="NOUVELLE MISSION" Style="{StaticResource EyebrowLabel}" /><Border Grid.Column="1" BackgroundColor="#FFF9E8" Stroke="#FDE7A5" StrokeShape="RoundRectangle 12" Padding="9,5"><Label x:Name="LiveOfferCountdownLabel" Text="--:--" TextColor="#B54708" FontAttributes="Bold" /></Border></Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                            <Border WidthRequest="50" HeightRequest="50" BackgroundColor="{StaticResource BlueWash}" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 15"><Image x:Name="LiveOfferIcon" Source="service_default.svg" WidthRequest="28" HeightRequest="28" /></Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3"><Label x:Name="LiveOfferTitleLabel" Text="Une mission vous attend" Style="{StaticResource CardTitleLabel}" /><Label x:Name="LiveOfferDetailLabel" Style="{StaticResource MutedLabel}" /></VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button x:Name="RefuseButton" Text="Refuser" Style="{StaticResource SecondaryButton}" Clicked="OnRefuseClicked" /><Button x:Name="AcceptButton" Grid.Column="1" Text="Accepter" Clicked="OnAcceptClicked" /></Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto"><Label Text="Prochaine mission" Style="{StaticResource CardTitleLabel}" /><Button Grid.Column="1" Text="Voir toutes" Style="{StaticResource SecondaryButton}" MinimumHeightRequest="36" HeightRequest="36" Padding="12,0" FontSize="11" Clicked="OnMissionsClicked" /></Grid>
                <Border x:Name="UpcomingMissionCard" Style="{StaticResource PremiumCard}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border BackgroundColor="{StaticResource BlueWash}" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 15" WidthRequest="50" HeightRequest="50"><Image x:Name="UpcomingMissionIcon" Source="icon_calendar.svg" WidthRequest="27" HeightRequest="27" /></Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3"><Label x:Name="UpcomingMissionTitleLabel" Text="Aucune mission planifiée" Style="{StaticResource CardTitleLabel}" /><Label x:Name="UpcomingMissionDetailLabel" Text="Les prochains rendez-vous apparaîtront ici." Style="{StaticResource MutedLabel}" /></VerticalStackLayout>
                        <Image Grid.Column="2" Source="chevron_right.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnUpcomingMissionClicked" /></Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
