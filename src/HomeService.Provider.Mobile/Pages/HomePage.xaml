<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Provider.Mobile.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageWash}"
    Title="Accueil">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">
            <Border x:Name="MessageBanner" IsVisible="False" BackgroundColor="#EEF4FF" Stroke="#CFE0FF" StrokeShape="RoundRectangle 18" Padding="14">
                <Label x:Name="MessageLabel" Text="Chargement..." Style="{StaticResource BodyLabel}" />
            </Border>

            <Border BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 22" Padding="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="STATUT" Style="{StaticResource EyebrowLabel}" />
                        <Label x:Name="AvailabilityLabel" Text="Disponible" Style="{StaticResource CardTitleLabel}" TextColor="{StaticResource WeleGreen}" />
                        <Label x:Name="ProviderStatusLabel" Text="Votre entreprise peut vous affecter une mission." Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource WeleGreen}" StrokeShape="RoundRectangle 18" Padding="14,8">
                        <Label x:Name="AvailabilityBadgeLabel" Text="ON" TextColor="White" FontAttributes="Bold" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="ProfileCompletionBanner" BackgroundColor="#FFF8EF" Stroke="#FFD6AD" StrokeShape="RoundRectangle 20" Padding="14">
                <VerticalStackLayout Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="PROFIL A FINALISER" Style="{StaticResource EyebrowLabel}" />
                        <Label x:Name="ProfilePercentLabel" Grid.Column="1" Text="92%" FontAttributes="Bold" TextColor="{StaticResource WeleOrange}" />
                    </Grid>
                    <Label x:Name="ProfileMessageLabel" Text="Completez votre profil pour recevoir toutes les missions." Style="{StaticResource BodyLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="UpcomingMissionCard" BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 22" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="MISSION A VENIR" Style="{StaticResource EyebrowLabel}" />
                    <Label x:Name="UpcomingMissionTitleLabel" Text="Aucune mission planifiee" Style="{StaticResource CardTitleLabel}" />
                    <Label x:Name="UpcomingMissionDetailLabel" Text="Les prochains rendez-vous apparaitront ici." Style="{StaticResource BodyLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="LiveOfferCard" BackgroundColor="White" Stroke="{StaticResource WeleGreen}" StrokeShape="RoundRectangle 22" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="LiveOfferCompanyLabel" Text="MISSION PROPOSEE" Style="{StaticResource EyebrowLabel}" />
                            <Label x:Name="LiveOfferTitleLabel" Text="Une mission vous attend" Style="{StaticResource ScreenTitleLabel}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource WeleOrange}" StrokeShape="RoundRectangle 16" Padding="10">
                            <Label x:Name="LiveOfferCountdownLabel" Text="--:--" TextColor="White" FontAttributes="Bold" />
                        </Border>
                    </Grid>
                    <Label x:Name="LiveOfferDetailLabel" Text="Service - zone" Style="{StaticResource BodyLabel}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button x:Name="RefuseButton" Text="Refuser" Grid.Column="0" BackgroundColor="#FFF0DF" TextColor="Black" Clicked="OnRefuseClicked" />
                        <Button x:Name="AcceptButton" Text="Accepter" Grid.Column="1" BackgroundColor="{StaticResource WeleGreen}" TextColor="White" Clicked="OnAcceptClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
