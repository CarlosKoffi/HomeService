<span class="figma-dashboard-icon @ToneClass @NameClass" aria-hidden="true">
    @switch (Name)
    {
        case "employees":
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="4" />
                <circle cx="9" cy="9" r="2.4" />
                <path d="M5.8 16.5c.55-2.05 1.6-3.1 3.2-3.1s2.65 1.05 3.2 3.1" />
                <path d="M15 8h3M15 12h3M15 16h2" />
            </svg>
            break;
        case "live-missions":
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="18" r="2.5" />
                <path d="M8.5 18h2.2c2 0 2.1-2.2 3.1-3.7.8-1.2 1.8-1.8 3.2-1.8h1" />
                <path d="M16 4h4l-1.6 2.5L20 9h-4z" />
                <path d="M16 4v8.5" />
                <path d="M4 6.5a4 4 0 0 1 6.4-1.1M3.5 10a7 7 0 0 1 8.7-7" opacity=".8" />
            </svg>
            break;
        case "completed":
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 5H6.8A2.8 2.8 0 0 0 4 7.8v10.4A2.8 2.8 0 0 0 6.8 21h10.4a2.8 2.8 0 0 0 2.8-2.8V10" />
                <rect x="8" y="3" width="8" height="4" rx="2" />
                <path d="m9 14 2 2 5-5" />
            </svg>
            break;
        case "payments":
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H18a2 2 0 0 1 2 2v2" />
                <rect x="3" y="7" width="18" height="13" rx="3" />
                <path d="M15 11h6v5h-6a2.5 2.5 0 0 1 0-5Z" />
                <circle cx="16" cy="13.5" r=".8" fill="currentColor" stroke="none" />
            </svg>
            break;
        case "calendar":
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            break;
        case "customer":
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
            </svg>
            break;
        case "document":
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <path d="M14 2v6h6" />
                <path d="M8 13h8" />
                <path d="M8 17h5" />
            </svg>
            break;
    }
</span>

@code {
    [Parameter]
    public string Name { get; set; } = "employees";

    [Parameter]
    public string Tone { get; set; } = "blue";

    private string ToneClass => Tone switch
    {
        "light" => "figma-dashboard-icon-light",
        _ => "figma-dashboard-icon-blue"
    };

    private string NameClass => $"figma-dashboard-icon-{Name}";
}
