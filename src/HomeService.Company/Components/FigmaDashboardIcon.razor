<span class="figma-dashboard-icon @ToneClass @NameClass" aria-hidden="true">
    @switch (Name)
    {
        case "employees":
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="9" cy="8" r="3" fill="currentColor" />
                <circle cx="17.2" cy="9.2" r="2.25" fill="currentColor" opacity=".48" />
                <path d="M3.8 18.2c0-3.35 2.1-5.25 5.2-5.25s5.2 1.9 5.2 5.25c0 .72-.58 1.3-1.3 1.3H5.1c-.72 0-1.3-.58-1.3-1.3Z" fill="currentColor" />
                <path d="M14.4 14.15c.82-.54 1.8-.8 2.8-.8 2.35 0 3.9 1.42 3.9 3.92 0 .62-.5 1.13-1.13 1.13h-4.45c.02-.2.03-.4.03-.61 0-1.42-.4-2.65-1.15-3.64Z" fill="currentColor" opacity=".48" />
            </svg>
            break;
        case "live-missions":
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M17.2 3.1a4.3 4.3 0 0 0-4.3 4.3c0 3.25 4.3 7.2 4.3 7.2s4.3-3.95 4.3-7.2a4.3 4.3 0 0 0-4.3-4.3Z" fill="currentColor" />
                <circle cx="17.2" cy="7.4" r="1.55" fill="white" />
                <circle cx="5.2" cy="18.5" r="2.7" fill="currentColor" opacity=".5" />
                <path d="M7.9 18.5h2.05c2.35 0 2.55-2.4 3.75-3.65.62-.65 1.35-.95 2.3-.95" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-dasharray="1.2 3" />
            </svg>
            break;
        case "completed":
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="9" fill="currentColor" opacity=".16" />
                <circle cx="12" cy="12" r="6.6" fill="currentColor" />
                <path d="m8.8 12.1 2.05 2.05 4.45-4.45" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            break;
        case "payments":
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 7.25A3.25 3.25 0 0 1 7.25 4h9.5A3.25 3.25 0 0 1 20 7.25v1.1H7.1A3.1 3.1 0 0 1 4 5.25v2Z" fill="currentColor" opacity=".42" />
                <rect x="3" y="7" width="18" height="13" rx="3.4" fill="currentColor" />
                <path d="M15.2 11h5.8v5.2h-5.8a2.6 2.6 0 1 1 0-5.2Z" fill="white" opacity=".94" />
                <circle cx="15.7" cy="13.6" r="1" fill="currentColor" />
            </svg>
            break;
        case "calendar":
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            break;
        case "customer":
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
            </svg>
            break;
        case "document":
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <path d="M14 2v6h6" />
                <path d="M8 13h8" />
                <path d="M8 17h5" />
            </svg>
            break;
    }
</span>

@code {
    [Parameter]
    public string Name { get; set; } = "employees";

    [Parameter]
    public string Tone { get; set; } = "blue";

    private string ToneClass => Tone switch
    {
        "light" => "figma-dashboard-icon-light",
        _ => "figma-dashboard-icon-blue"
    };

    private string NameClass => $"figma-dashboard-icon-{Name}";
}
