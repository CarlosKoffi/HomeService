@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment
@inject IJSRuntime Js
@inject PlatformApiClient ApiClient

<div class="@ShellClass">
    <input id="portal-sidebar-toggle" class="portal-sidebar-toggle" type="checkbox" />
    <label for="portal-sidebar-toggle" class="portal-mobile-backdrop" aria-hidden="true"></label>

    <aside class="portal-sidebar" aria-label="Navigation portail entreprise"
           data-coachmark-key="portal-orientation"
           data-coachmark-order="10"
           data-coachmark-title="Votre espace entreprise"
           data-coachmark-body="Retrouvez ici vos employés, vos missions, vos encaissements et vos reversements.">
        <a class="portal-sidebar-logo" href="@PortalLink("dashboard")" aria-label="Accueil du portail wélé Entreprise">
            <img src="https://media.wele.africa/website/company/wele-logo-horizontal.png" alt="Wélé entreprise" />
        </a>

        <nav id="company-portal-navigation" class="portal-sidebar-nav">
            <a class="@GetClass("dashboard")" href="@PortalLink("dashboard")">
                <PlatformIcon Name="dashboard" Tone="blue" />
                Tableau de bord
            </a>
            <a class="@GetClass("company-profile")" href="@PortalLink("company-profile")">
                <PlatformIcon Name="company" Tone="blue" />
                Informations
            </a>
            <a class="@GetClass("employees")" href="@PortalLink("employees")">
                <PlatformIcon Name="providers" Tone="blue" />
                Employes
            </a>
            <a class="@GetClass("interim-candidates")" href="@PortalLink("interim-candidates")">
                <PlatformIcon Name="locked" Tone="blue" />
                Interim
            </a>
            <a class="@GetClass("missions")" href="@PortalLink("missions")">
                <PlatformIcon Name="complete" Tone="blue" />
                Missions
            </a>
            <a class="@GetClass("accounts")" href="@PortalLink("accounts")">
                <PlatformIcon Name="payments" Tone="blue" />
                Encaissements
            </a>
            <a class="@GetClass("wallet")" href="@PortalLink("wallet")">
                <PlatformIcon Name="card" Tone="blue" />
                Reversements
            </a>
        </nav>

        <div class="portal-sidebar-progress">
            <div class="portal-progress-head">
                <span>Profil complet</span>
                <strong>@EffectiveProfileCompletionPercent%</strong>
            </div>
            <div class="portal-progress-track">
                <span style="width: @EffectiveProfileCompletionPercent%"></span>
            </div>
            <div class="portal-progress-steps">
                @foreach (var step in EffectiveProgressSteps)
                {
                    <div>
                        <span class="@(step.IsDone ? "done" : "todo")">@(step.IsDone ? "OK" : "+")</span>
                        <small>@step.Label</small>
                    </div>
                }
            </div>
        </div>

        <div class="portal-sidebar-user">
            <span>@Initials</span>
            <div>
                <strong>@CompanyName</strong>
                <small>@Email</small>
            </div>
            <button type="button" title="Sortir" @onclick="LogoutAsync">x</button>
        </div>
    </aside>

    <section class="portal-main">
        <header class="portal-topbar">
            <label for="portal-sidebar-toggle" class="portal-menu-button" title="Menu" aria-label="Ouvrir ou fermer le menu" aria-controls="company-portal-navigation">
                <span></span>
                <span></span>
                <span></span>
            </label>
            <div>
                <h1>@Title</h1>
                <p>@Subtitle</p>
            </div>
            <div class="portal-topbar-actions">
                @if (TopbarActions is null)
                {
                    <a class="portal-bell" href="@PortalLink("notifications")" title="Notifications" aria-label="Ouvrir les notifications">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M18 8a6 6 0 0 0-12 0c0 6.5-3 7-3 9h18c0-2-3-2.5-3-9"></path>
                            <path d="M10 21h4"></path>
                        </svg>
                        <span></span>
                        @if (EffectiveUnreadNotificationCount > 0)
                        {
                            <em>@EffectiveUnreadNotificationCount</em>
                        }
                    </a>
                    <button type="button" class="portal-logout" @onclick="LogoutAsync">Sortir</button>
                }
                else
                {
                    @TopbarActions
                }
            </div>
        </header>

        <main class="portal-content">
            @ChildContent
        </main>
    </section>
</div>

@code {
    [Parameter] public string Active { get; set; } = "dashboard";
    [Parameter] public string Title { get; set; } = "Tableau de bord";
    [Parameter] public string Subtitle { get; set; } = "Portail connecte";
    [Parameter] public Guid? CompanyId { get; set; }
    [Parameter] public string CompanyName { get; set; } = "CI Home Service";
    [Parameter] public string Email { get; set; } = "mode.demo@wele.ci";
    [Parameter] public int ProfileCompletionPercent { get; set; } = 25;
    [Parameter] public int? UnreadNotificationCount { get; set; }
    [Parameter] public IReadOnlyList<CompanyPortalProgressStepResponse> ProgressSteps { get; set; } =
    [
        new("Profil entreprise", true, null, null),
        new("Documents de conformite", false, "Completer", "company-profile"),
        new("Premier employe ajoute", false, "Ajouter", "employees"),
        new("Premiere mission creee", false, "Voir", "missions")
    ];
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? TopbarActions { get; set; }

    private Guid? LoadedCompanyId { get; set; }
    private CompanyPortalDashboardResponse? PortalSummary { get; set; }

    private int EffectiveProfileCompletionPercent => PortalSummary?.ProfileCompletionPercent ?? ProfileCompletionPercent;
    private IReadOnlyList<CompanyPortalProgressStepResponse> EffectiveProgressSteps => PortalSummary?.ProgressSteps ?? ProgressSteps;
    private int EffectiveUnreadNotificationCount => UnreadNotificationCount ?? PortalSummary?.UnreadNotificationCount ?? 0;

    private string Initials
    {
        get
        {
            var parts = CompanyName.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            return string.Concat(parts.Take(2).Select(part => part[0])).ToUpperInvariant();
        }
    }

    private string ShellClass => $"company-portal-shell portal-shell-{Active}";

    protected override async Task OnParametersSetAsync()
    {
        if (CompanyId is null
            || CompanyId == Guid.Empty
            || LoadedCompanyId == CompanyId
            || Environment.IsDevelopment() && Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("preview=1", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        LoadedCompanyId = CompanyId;

        try
        {
            PortalSummary = await ApiClient.GetCompanyDashboardAsync(CompanyId.Value);
        }
        catch
        {
            PortalSummary = null;
        }
    }

    private string GetClass(string key)
    {
        return string.Equals(Active, key, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    }

    private string PortalLink(string path)
    {
        return Environment.IsDevelopment() && Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("preview=1", StringComparison.OrdinalIgnoreCase)
            ? $"{path}?preview=1"
            : path;
    }

    private async Task LogoutAsync()
    {
        await Js.InvokeVoidAsync("localStorage.removeItem", "homeservice.company.session");
        Navigation.NavigateTo("");
    }
}

