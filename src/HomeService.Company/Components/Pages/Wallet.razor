@page "/wallet"
@layout HomeService.Company.Components.Layout.EmptyLayout
@using System.Text.Json
@inject IJSRuntime Js
@inject PlatformApiClient ApiClient
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment

<PageTitle>Reversements</PageTitle>

@if (IsLoading)
{
    <section class="wallet-state"><strong>Chargement du portefeuille...</strong></section>
}
else if (Session is null)
{
    <section class="wallet-state"><strong>Connexion requise</strong><a href="/">Se connecter</a></section>
}
else
{
    <CompanyPortalShell Active="wallet"
                        Title="Reversements"
                        Subtitle="Votre argent, avec un calendrier clair"
                        CompanyId="@Session.CompanyId"
                        CompanyName="@Session.CompanyName"
                        Email="@Session.Email">
        <ChildContent>
            <section class="wallet-page">
                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="wallet-message @(IsError ? "error" : "success")">@Message</div>
                }

                @if (Snapshot is not null)
                {
                    <section class="wallet-hero">
                        <div>
                            <span>Disponible au retrait</span>
                            <strong>@Money(Snapshot.AvailableBalance)</strong>
                            <small>Prochaine mise à disposition : @Date(Snapshot.NextEligibilityDate)</small>
                        </div>
                        <div class="wallet-hero-mark">W</div>
                    </section>

                    <section class="wallet-balances">
                        <article><span>En attente</span><strong>@Money(Snapshot.PendingBalance)</strong><small>Missions validées, pas encore à échéance</small></article>
                        <article><span>Réservé</span><strong>@Money(Snapshot.ReservedBalance)</strong><small>Reversements en cours de traitement</small></article>
                        <article><span>Déjà reversé</span><strong>@Money(Snapshot.WithdrawnBalance)</strong><small>Total versé à votre entreprise</small></article>
                    </section>

                    <section class="wallet-panel frequency-panel">
                        <div>
                            <span class="wallet-eyebrow">CALENDRIER</span>
                            <h2>Quand souhaitez-vous être payé ?</h2>
                            <p>Le choix s’applique aux prochaines missions. Aucun retrait anticipé n’est possible.</p>
                        </div>
                        <div class="frequency-options">
                            <button class="@(Snapshot.SettlementFrequency == "Fortnightly" ? "active" : null)"
                                    @onclick='() => ChangeFrequencyAsync("Fortnightly")'>
                                <strong>Toutes les 2 semaines</strong>
                                <small>Le 15 puis au début du mois suivant</small>
                            </button>
                            <button class="@(Snapshot.SettlementFrequency == "Monthly" ? "active" : null)"
                                    @onclick='() => ChangeFrequencyAsync("Monthly")'>
                                <strong>Une fois par mois</strong>
                                <small>Un reversement groupé au début du mois</small>
                            </button>
                        </div>
                    </section>

                    <section class="wallet-grid">
                        <article class="wallet-panel">
                            <header>
                                <div><span class="wallet-eyebrow">MODE DE REVERSEMENT</span><h2>Où recevoir l’argent ?</h2></div>
                                <button class="wallet-text-button" @onclick="ToggleDestinationForm">
                                    @(ShowDestinationForm ? "Fermer" : CurrentDestination is null ? "Configurer" : "Modifier")
                                </button>
                            </header>

                            @if (ShowDestinationForm)
                            {
                                <div class="destination-form">
                                    <label class="full">
                                        Mode de reversement
                                        <select value="@DestinationMethod" @onchange="ChangeDestinationMethod">
                                            <option value="MobileMoney">Mobile Money</option>
                                            <option value="BankTransfer">Virement bancaire</option>
                                            <option value="Cash">Retrait en agence</option>
                                        </select>
                                    </label>

                                    @if (IsCashDestination)
                                    {
                                        <label class="full">
                                            Personne autorisée à récupérer l’argent
                                            <input @bind="BeneficiaryName" autocomplete="name" placeholder="Nom et prénom(s)" />
                                        </label>
                                        <div class="destination-guidance cash-guidance full">
                                            <span class="guidance-icon">ID</span>
                                            <span>
                                                <strong>Pièce d’identité obligatoire</strong>
                                                <small>Cette personne devra venir à l’agence avec une pièce d’identité originale et valide.</small>
                                            </span>
                                        </div>
                                    }
                                    else if (IsBankDestination)
                                    {
                                        <label>
                                            Titulaire du compte
                                            <input @bind="BeneficiaryName" autocomplete="name" placeholder="Nom complet du titulaire" />
                                        </label>
                                        <label>
                                            Banque
                                            <input @bind="ProviderCode" autocomplete="organization" placeholder="Ex. NSIA Banque, SGCI..." />
                                        </label>
                                        <label class="full">
                                            Numéro de compte ou IBAN
                                            <input @bind="DestinationIdentifier" autocomplete="off" placeholder="Saisissez les coordonnées bancaires" />
                                            <small>Ces informations seront chiffrées et devront être vérifiées avant le premier versement.</small>
                                        </label>
                                    }
                                    else
                                    {
                                        <label>
                                            Titulaire du compte
                                            <input @bind="BeneficiaryName" autocomplete="name" placeholder="Nom complet du titulaire" />
                                        </label>
                                        <label>
                                            Réseau Mobile Money
                                            <select @bind="ProviderCode">
                                                <option value="wave">Wave</option>
                                                <option value="orange_money">Orange Money</option>
                                                <option value="mtn_momo">MTN MoMo</option>
                                                <option value="moov_money">Moov Money</option>
                                                <option value="djamo">Djamo</option>
                                            </select>
                                        </label>
                                        <label class="full">
                                            Numéro Mobile Money
                                            <input @bind="DestinationIdentifier" inputmode="tel" autocomplete="tel" placeholder="Ex. 07 00 00 00 00" />
                                            <small>Le numéro doit être actif sur le réseau choisi et appartenir au titulaire indiqué.</small>
                                        </label>
                                    }

                                    <button class="wallet-primary full" @onclick="SaveDestinationAsync" disabled="@(IsSaving || !CanSaveDestination)">
                                        @DestinationSubmitLabel
                                    </button>
                                </div>
                            }

                            @if (CurrentDestination is null)
                            {
                                <div class="wallet-empty">Configurez le mode que votre entreprise utilisera pour ses reversements.</div>
                            }
                            else if (!ShowDestinationForm)
                            {
                                <div class="destination-list">
                                    <div class="destination-card single">
                                        <span class="destination-icon">@DestinationInitial(CurrentDestination)</span>
                                        <span><strong>@CurrentDestination.Label</strong><small>@DestinationSubtitle(CurrentDestination)</small></span>
                                        <em class="@(CurrentDestination.IsVerified ? "verified" : "pending")">@DestinationStatus(CurrentDestination)</em>
                                    </div>
                                </div>
                            }
                        </article>

                        <article class="wallet-panel payout-panel">
                            <span class="wallet-eyebrow">PROCHAIN REVERSEMENT</span>
                            <h2>Demander le versement</h2>
                            <p>Seul le solde arrivé à échéance peut être demandé.</p>
                            <div class="payout-total"><span>Montant disponible</span><strong>@Money(Snapshot.AvailableBalance)</strong></div>
                            <div class="payout-fees">
                                <span>Mobile Money <b>1,5 %</b></span>
                                <span>Virement bancaire <b>1 000 F</b></span>
                                <span>Retrait agence <b>Gratuit</b></span>
                            </div>
                            <button class="wallet-primary"
                                    disabled="@(IsSaving || Snapshot.AvailableBalance < 5000 || !HasVerifiedSelectedDestination)"
                                    @onclick="RequestPayoutAsync">
                                Demander le reversement
                            </button>
                            @if (Snapshot.AvailableBalance < 5000)
                            {
                                <small class="payout-help">Minimum : 5 000 FCFA. Le solde reste conservé sans frais.</small>
                            }
                        </article>
                    </section>

                    <section class="wallet-panel history-panel">
                        <header><div><span class="wallet-eyebrow">HISTORIQUE</span><h2>Reversements</h2></div></header>
                        @if (Snapshot.Payouts.Count == 0)
                        {
                            <div class="wallet-empty">Aucun reversement pour le moment.</div>
                        }
                        else
                        {
                            @foreach (var payout in Snapshot.Payouts)
                            {
                                <div class="payout-row">
                                    <span><strong>@payout.Reference</strong><small>@Date(payout.CreatedAt) · @MethodLabel(payout.Method)</small></span>
                                    <span><strong>@Money(payout.NetAmount)</strong><small>Frais @Money(payout.FeeAmount)</small></span>
                                    <em class="status-@payout.Status.ToLowerInvariant()">@StatusLabel(payout.Status)</em>
                                </div>
                            }
                        }
                    </section>
                }
            </section>
        </ChildContent>
    </CompanyPortalShell>
}

<style>
