.wallet-text-button{border:0;background:transparent;color:#1264f5;font-weight:800}.destination-form{margin-top:18px;padding-top:18px;border-top:1px solid #edf0f5;display:grid;grid-template-columns:1fr 1fr;gap:14px}.destination-form label{display:grid;gap:7px;font-size:13px;font-weight:700}.destination-form label>small{color:#667085;font-size:12px;font-weight:500;line-height:1.45}.destination-form .full{grid-column:1/-1}.destination-form input,.destination-form select{height:46px;border:1px solid #d7dfec;border-radius:12px;padding:0 13px;background:#fff;color:#101828;outline:none}.destination-form input:focus,.destination-form select:focus{border-color:#1264f5;box-shadow:0 0 0 3px rgba(18,100,245,.1)}.destination-guidance{display:flex;align-items:flex-start;gap:12px;padding:14px 16px;border-radius:14px;border:1px solid #b9d2ff;background:#f5f8ff;color:#193b73}.destination-guidance .guidance-icon{flex:0 0 38px;height:38px;border-radius:12px;display:grid;place-content:center;background:#1264f5;color:#fff;font-size:12px;font-weight:900}.destination-guidance strong,.destination-guidance small{display:block}.destination-guidance small{margin-top:3px;line-height:1.45;color:#48658f}.destination-list{display:grid;gap:10px;margin-top:18px}.destination-card{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;padding:14px;border:1px solid #e3eaf5;border-radius:15px}.destination-icon{width:42px;height:42px;border-radius:13px;background:#eef4ff;color:#1264f5;display:grid;place-content:center;font-weight:900}.destination-card strong,.destination-card small{display:block}.destination-card small{color:#667085;margin-top:3px}.destination-card em{font-style:normal;font-size:12px;font-weight:800;padding:6px 9px;border-radius:999px}.destination-card em.verified{background:#ecfdf3;color:#067647}.destination-card em.pending{background:#fff7ed;color:#c2410c}.wallet-primary{border:0;border-radius:13px;background:#1264f5;color:white;min-height:46px;padding:0 18px;font-weight:800}.wallet-primary:disabled{background:#d0d5dd}.payout-total{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #edf0f5;border-bottom:1px solid #edf0f5;padding:18px 0;margin:18px 0}.payout-total strong{font-size:24px}.payout-fees{display:grid;gap:9px;margin-bottom:20px}.payout-fees span{display:flex;justify-content:space-between;color:#667085}.payout-panel .wallet-primary{width:100%}.payout-help{display:block;text-align:center;color:#667085;margin-top:10px}.wallet-empty{padding:24px 0;color:#667085}.payout-row{display:grid;grid-template-columns:1.5fr 1fr auto;align-items:center;gap:18px;padding:16px 0;border-top:1px solid #edf0f5}.payout-row strong,.payout-row small{display:block}.payout-row small{color:#667085;margin-top:4px}.payout-row em{font-style:normal;font-weight:800;font-size:12px;padding:7px 10px;border-radius:999px;background:#eef4ff;color:#1264f5}.payout-row em.status-paid{background:#ecfdf3;color:#067647}.payout-row em.status-failed,.payout-row em.status-rejected{background:#fef3f2;color:#b42318}
    @@media(max-width:900px){.wallet-balances,.wallet-grid{grid-template-columns:1fr}.frequency-panel{display:grid}.frequency-options{min-width:0}.wallet-hero{padding:24px}.wallet-hero strong{font-size:34px}}
    @@media(max-width:560px){.wallet-page{gap:14px}.wallet-balances{grid-template-columns:1fr 1fr}.wallet-balances article:last-child{grid-column:1/-1}.frequency-options,.destination-form{grid-template-columns:1fr}.destination-form .full{grid-column:auto}.wallet-hero-mark{display:none}.payout-row{grid-template-columns:1fr auto}.payout-row em{grid-column:1/-1;justify-self:start}}
</style>

@code {
    private CompanyPortalSessionResponse? Session { get; set; }
    private CompanyWalletResponse? Snapshot { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsSaving { get; set; }
    private bool ShowDestinationForm { get; set; }
    private string? Message { get; set; }
    private bool IsError { get; set; }
    private Guid? SelectedDestinationId { get; set; }
    private string DestinationMethod { get; set; } = "MobileMoney";
    private string BeneficiaryName { get; set; } = string.Empty;
    private string ProviderCode { get; set; } = "wave";
    private string DestinationIdentifier { get; set; } = string.Empty;

    private bool IsCashDestination => DestinationMethod == "Cash";
    private bool IsBankDestination => DestinationMethod == "BankTransfer";
    private CompanyPayoutDestinationResponse? CurrentDestination => Snapshot?.Destinations.FirstOrDefault(item => item.IsActive);
    private bool CanSaveDestination => BeneficiaryName.Trim().Length >= 3
        && (IsCashDestination
            || (!string.IsNullOrWhiteSpace(ProviderCode) && DestinationIdentifier.Trim().Length >= 5));
    private string DestinationSubmitLabel => CurrentDestination is not null
        ? "Enregistrer les modifications"
        : IsCashDestination
            ? "Enregistrer la personne autorisée"
            : IsBankDestination
                ? "Enregistrer le compte bancaire"
                : "Enregistrer le compte Mobile Money";
    private bool HasVerifiedSelectedDestination => Snapshot?.Destinations.Any(item => item.Id == SelectedDestinationId && item.IsVerified && item.IsActive) == true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var sessionJson = await Js.InvokeAsync<string?>("localStorage.getItem", "homeservice.company.session");
        if (!string.IsNullOrWhiteSpace(sessionJson))
        {
            Session = JsonSerializer.Deserialize<CompanyPortalSessionResponse>(sessionJson);
            if (Session is not null) await LoadAsync();
        }
        IsLoading = false;
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        if (Session is null) return;
        try
        {
            Snapshot = await ApiClient.GetCompanyWalletAsync(Session.CompanyId, Session.Token);
            SelectedDestinationId = CurrentDestination?.Id;
            if (CurrentDestination is null)
            {
                ShowDestinationForm = true;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            IsError = true;
            Message = "Le portefeuille est momentanément indisponible ou votre session a expiré.";
        }
    }

    private async Task ChangeFrequencyAsync(string frequency)
    {
        if (Session is null || IsSaving) return;
        IsSaving = true;
        try
        {
            var result = await ApiClient.UpdateSettlementFrequencyAsync(Session.CompanyId, Session.Token, frequency);
            Apply(result, "Calendrier de reversement mis à jour.");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            SetUnavailableMessage();
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task SaveDestinationAsync()
    {
        if (Session is null || IsSaving || !CanSaveDestination) return;
        IsSaving = true;
        try
        {
            var label = DestinationMethod switch
            {
                "Cash" => "Retrait en agence",
                "BankTransfer" => $"Compte bancaire · {ProviderCode.Trim()}",
                _ => $"Mobile Money · {ProviderLabel(ProviderCode)}"
            };
            var provider = IsCashDestination ? "agency" : ProviderCode.Trim();
            var identifier = IsCashDestination
                ? string.Empty
                : DestinationIdentifier.Trim();
            var result = await ApiClient.SavePayoutDestinationAsync(Session.CompanyId, Session.Token, new(
                DestinationMethod, label, BeneficiaryName.Trim(), provider, identifier));
            var successMessage = IsCashDestination
                ? "Personne autorisée enregistrée. Une pièce d’identité originale et valide sera exigée au retrait."
                : "Coordonnées enregistrées. Une vérification est nécessaire avant le premier versement.";
            Apply(result, successMessage);
            if (result.IsSuccess)
            {
                ShowDestinationForm = false;
                BeneficiaryName = string.Empty;
                DestinationIdentifier = string.Empty;
                ProviderCode = DestinationMethod == "MobileMoney" ? "wave" : string.Empty;
                SelectedDestinationId = result.Wallet?.Destinations.FirstOrDefault(item => item.IsActive)?.Id;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            SetUnavailableMessage();
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task RequestPayoutAsync()
    {
        if (Session is null || SelectedDestinationId is null || IsSaving) return;
        IsSaving = true;
        try
        {
            var result = await ApiClient.RequestPayoutAsync(Session.CompanyId, Session.Token, new(SelectedDestinationId.Value));
            Apply(result, "Votre reversement a été enregistré et le montant est maintenant réservé.");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            SetUnavailableMessage();
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void Apply(CompanyWalletSaveResult result, string successMessage)
    {
        Snapshot = result.Wallet ?? Snapshot;
        IsError = !result.IsSuccess;
        Message = result.IsSuccess ? successMessage : result.Message;
    }

    private void SetUnavailableMessage()
    {
        IsError = true;
        Message = "L'opération est momentanément indisponible. Vérifiez votre connexion puis réessayez.";
    }

    private void ChangeDestinationMethod(ChangeEventArgs args)
    {
        DestinationMethod = args.Value?.ToString() switch
        {
            "BankTransfer" => "BankTransfer",
            "Cash" => "Cash",
            _ => "MobileMoney"
        };
        ProviderCode = DestinationMethod switch
        {
            "MobileMoney" => "wave",
            "Cash" => "agency",
            _ => string.Empty
        };
        DestinationIdentifier = string.Empty;
        Message = null;
    }

    private void ToggleDestinationForm()
    {
        ShowDestinationForm = !ShowDestinationForm;
        if (!ShowDestinationForm || CurrentDestination is null)
        {
            return;
        }

        DestinationMethod = CurrentDestination.Method;
        BeneficiaryName = CurrentDestination.BeneficiaryName;
        ProviderCode = CurrentDestination.ProviderCode;
        // Les coordonnées complètes ne sont jamais renvoyées au navigateur.
        // L'entreprise les ressaisit pour confirmer toute modification.
        DestinationIdentifier = string.Empty;
        Message = null;
    }
    private static string Money(int amount) => $"{amount:N0} FCFA".Replace(',', ' ');
    private static string Date(DateTimeOffset date) => date.ToLocalTime().ToString("dd MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"));
    private static string DestinationInitial(CompanyPayoutDestinationResponse destination) => destination.Method switch
    {
        "Cash" => "ID",
        "BankTransfer" => "B",
        _ => string.IsNullOrWhiteSpace(destination.ProviderCode) ? "M" : destination.ProviderCode[..1].ToUpperInvariant()
    };
    private static string DestinationSubtitle(CompanyPayoutDestinationResponse destination) => destination.Method switch
    {
        "Cash" => $"{destination.BeneficiaryName} · Pièce d’identité obligatoire",
        "BankTransfer" => $"{destination.BeneficiaryName} · {destination.ProviderCode} · {destination.MaskedIdentifier}",
        _ => $"{destination.BeneficiaryName} · {ProviderLabel(destination.ProviderCode)} · {destination.MaskedIdentifier}"
    };
    private static string DestinationStatus(CompanyPayoutDestinationResponse destination) => destination.Method == "Cash"
        ? destination.IsVerified ? "Identité vérifiée" : "Identité à vérifier"
        : destination.IsVerified ? "Vérifié" : "À vérifier";
    private static string ProviderLabel(string providerCode) => providerCode.Trim().ToLowerInvariant() switch
    {
        "wave" => "Wave",
        "orange_money" => "Orange Money",
        "mtn_momo" => "MTN MoMo",
        "moov_money" => "Moov Money",
        "djamo" => "Djamo",
        _ => providerCode.Trim()
    };
    private static string MethodLabel(string method) => method switch { "MobileMoney" => "Mobile Money", "BankTransfer" => "Virement bancaire", "Cash" => "Retrait agence", _ => method };
    private static string StatusLabel(string status) => status switch { "Submitted" => "À valider", "Approved" => "Approuvé", "Processing" => "En cours", "Paid" => "Payé", "Failed" => "Échec", "Rejected" => "Rejeté", _ => status };
}
