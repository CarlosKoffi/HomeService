@page "/"
@using HomeService.Contracts.Contact
@inject NavigationManager Navigation
@inject PlatformApiClient ApiClient

<PageTitle>wélé Entreprises</PageTitle>

@if (IsSubmittedConfirmationVisible)
{
    <section class="submission-confirmation">
        <strong>Demande envoyée</strong>
        <p>Votre dossier a bien été transmis. Notre équipe va vérifier les informations et revenir vers vous.</p>
    </section>
}

<div class="company-landing premium-b2b">
    <section id="home" class="premium-hero">
        <img class="premium-hero-image" src="@ResolveContentUrl(HomeContent.Hero.ImageUrl, "website/company/wele-premium-hero.png")" alt="@HomeContent.Hero.ImageAlt" />
        <div class="premium-hero-overlay"></div>
        <div class="premium-hero-content">
            <h1>
                @HeroHeadline.Main
                @if (!string.IsNullOrWhiteSpace(HeroHeadline.Highlight))
                {
                    <span>@HeroHeadline.Highlight</span>
                }
            </h1>
            <p>@HomeContent.Hero.Subtitle</p>
            <div class="premium-actions">
                <a class="premium-primary" href="@HomeContent.Hero.PrimaryCta.Url">@HomeContent.Hero.PrimaryCta.Label</a>
                <a class="premium-secondary" href="@HomeContent.Hero.SecondaryCta.Url">@HomeContent.Hero.SecondaryCta.Label</a>
            </div>
            <div class="premium-proof" aria-label="Indicateurs wélé">
                @foreach (var proof in HomeContent.Hero.ProofItems)
                {
                    <span>@proof</span>
                }
            </div>
        </div>
    </section>

    <section id="how" class="premium-section">
        <div class="premium-section-head">
            <p class="premium-label">@HomeContent.Steps.Label</p>
            <h2>@HomeContent.Steps.Headline</h2>
            <p>@HomeContent.Steps.Subtitle</p>
        </div>

        <div class="premium-how-grid">
            @foreach (var step in HomeContent.Steps.Items)
            {
                <article>
                    <figure><img src="@ResolveStepImageUrl(step.Number, step.Image)" alt="@step.Title" loading="lazy" /></figure>
                    <div class="premium-step-meta"><span>@step.Number</span><strong>@step.Label</strong></div>
                    <h3>@step.Title</h3>
                    <p>@step.Text</p>
                </article>
            }
        </div>
    </section>

    <section id="benefits" class="premium-section premium-benefits-section" aria-label="Avantages partenaires">
        <div class="premium-section-head centered">
            <p class="premium-label">Avantages</p>
            <h2>@HomeContent.Trusted.Headline</h2>
            <p>@HomeContent.Trusted.Subtitle</p>
        </div>
        <div class="premium-benefits-grid">
            @foreach (var item in HomeContent.Trusted.Items)
            {
                <article>
                    <span></span>
                    <strong>@item</strong>
                </article>
            }
        </div>
    </section>

    <section id="dashboard" class="premium-section premium-dashboard-section">
        <div class="premium-section-head">
            <p class="premium-label">@HomeContent.Dashboard.Label</p>
            <h2>@HomeContent.Dashboard.Headline</h2>
            <p>@HomeContent.Dashboard.Subtitle</p>
        </div>

        <div class="company-operations-showcase">
            <div class="company-operations-copy">
                <span class="company-operations-kicker">Portail web + application terrain</span>
                <strong>Le portail centralise.<br />L'application fait agir.</strong>
                <p>Au bureau, vos équipes pilotent les missions, les collaborateurs, les notifications et les encaissements. Sur le terrain, l'application permet d'accepter, d'affecter et de suivre chaque intervention immédiatement. Les deux restent synchronisés.</p>

                <div class="company-operations-flow" aria-label="Parcours opérationnel wélé Entreprise">
                    <div>
                        <b>01</b>
                        <span><strong>Demande reçue</strong><small>Une priorité claire dès son arrivée</small></span>
                    </div>
                    <div>
                        <b>02</b>
                        <span><strong>Équipe affectée</strong><small>Le bon profil, au bon endroit</small></span>
                    </div>
                    <div>
                        <b>03</b>
                        <span><strong>Terrain suivi</strong><small>Avancement et alertes en direct</small></span>
                    </div>
                    <div>
                        <b>04</b>
                        <span><strong>Qualité contrôlée</strong><small>Étapes, preuves et historique</small></span>
                    </div>
                </div>

                <div class="company-operations-proof">
                    <span><strong>Une seule vue</strong><small>Missions, équipes et qualité</small></span>
                    <span><strong>Partout avec vous</strong><small>Au bureau comme sur le terrain</small></span>
                </div>
            </div>

            <div class="company-product-stage" aria-label="Le portail web et l'application mobile wélé Entreprise fonctionnent ensemble">
                <figure class="company-web-frame company-web-frame--real">
                    <figcaption class="company-screen-label">
                        <span>Portail web</span>
                        <strong>Pilotage complet au bureau</strong>
                    </figcaption>
                    <div class="company-web-browser">
                        <div class="company-browser-chrome" aria-hidden="true">
                            <span><i></i><i></i><i></i></span>
                            <small>entreprise.wele.africa</small>
                        </div>
                        <img
                            src="/images/wele-company-portal-showcase.png"
                            alt="Vrai portail web wélé Entreprise avec les missions, notifications, équipes et encaissements"
                            loading="lazy" />
                    </div>
                </figure>

                <figure class="company-mobile-product">
                    <figcaption class="company-screen-label company-screen-label--mobile">
                        <span>Application mobile</span>
                        <strong>Décisions et suivi terrain</strong>
                    </figcaption>
                    <div class="company-phone-frame company-phone-frame--paired">
                        <span class="company-phone-speaker" aria-hidden="true"></span>
                        <img
                            src="/images/wele-enterprise-app-showcase.png"
                            alt="Vraie application mobile wélé Entreprise pour accepter, affecter et suivre les missions sur le terrain"
                            loading="lazy" />
                    </div>
                </figure>

                <span class="company-sync-badge"><i aria-hidden="true"></i> Portail et terrain synchronisés</span>
            </div>
        </div>
    </section>

    <section id="faq" class="premium-section premium-faq-section">
        <div class="premium-section-head centered">
            <p class="premium-label">@HomeContent.Faq.Label</p>
            <h2>@HomeContent.Faq.Headline</h2>
        </div>

        <div class="premium-faq">
            @foreach (var item in HomeContent.Faq.Questions.Select((question, index) => new { question, index }))
            {
                <details open="@(item.index == 0)">
                    <summary>@item.question.Question</summary>
                    <p>@item.question.Answer</p>
                </details>
            }
        </div>
    </section>

    <section id="contact" class="premium-section premium-contact-section">
        <div class="premium-contact-copy">
            <p class="premium-label">@HomeContent.Contact.Label</p>
            <h2>@HomeContent.Contact.Headline</h2>
            <p>@HomeContent.Contact.Subtitle</p>
            <div class="premium-contact-tags">
                @foreach (var tag in HomeContent.Contact.Tags)
                {
                    <span>@tag</span>
                }
            </div>
        </div>

        <form class="premium-contact-form" @onsubmit="SubmitContactAsync" @onsubmit:preventDefault>
            <div class="premium-form-grid">
                <label>Nom complet<input placeholder="Ex: Jean Kouadio" @bind="ContactName" /></label>
                <label>Entreprise<input placeholder="Ex: CI Home Service" @bind="ContactCompany" /></label>
                <label>Telephone<input type="tel" placeholder="+225 07 00 00 00 00" @bind="ContactPhone" /></label>
                <label>Email<input type="email" placeholder="direction@entreprise.ci" @bind="ContactEmail" /></label>
            </div>
            <label>
                Sujet
                <select @bind="ContactSubject">
                    <option>Devenir partenaire</option>
                    <option>Comprendre le fonctionnement</option>
                    <option>Suivi d'une demande</option>
                    <option>Autre demande</option>
                </select>
            </label>
            <label>
                Message
                <textarea rows="5" placeholder="Expliquez rapidement votre besoin..." @bind="ContactBody"></textarea>
            </label>

            @if (!string.IsNullOrWhiteSpace(ContactMessage))
            {
                <p class="field-message">@ContactMessage</p>
            }

            <button type="submit" class="premium-primary">Envoyer le message</button>
        </form>
    </section>

    <footer class="premium-footer">
        <div class="premium-footer-brand">
            <a class="premium-footer-logo" href="#home" aria-label="Retour accueil wélé">
                <img src="https://media.wele.africa/website/company/wele-logo-horizontal.png" alt="Wélé entreprise" />
            </a>
            <p>@HomeContent.Footer.BrandText</p>
        </div>
        <nav aria-label="Solution">
            <h2>Solution</h2>
            <a href="#how">Fonctionnement</a>
            <a href="#benefits">Avantages</a>
            <a href="#dashboard">Portail et application</a>
        </nav>
        <nav aria-label="Entreprise">
            <h2>Entreprise</h2>
            <a href="register">Devenir partenaire</a>
            <a href="dashboard">Accéder au portail</a>
            <a href="#faq">Questions fréquentes</a>
        </nav>
        <nav aria-label="Informations légales">
            <h2>Informations légales</h2>
            <button type="button" class="premium-footer-link" @onclick="OpenTerms">Conditions générales</button>
            <a href="#contact">Confidentialité et données</a>
            <a href="#contact">Nous contacter</a>
        </nav>
        <div class="premium-footer-bottom">
            <span>@HomeContent.Footer.Copyright</span>
            <span>@HomeContent.Footer.Baseline</span>
        </div>
    </footer>

    @if (ShowTerms)
    {
        <div class="legal-modal-backdrop" @onclick="CloseTerms">
            <section class="legal-modal" role="dialog" aria-modal="true" aria-labelledby="company-terms-title" @onclick:stopPropagation>
                <header>
                    <div>
                        <span>Version provisoire · 17 août 2026</span>
                        <h2 id="company-terms-title">Conditions générales d’utilisation</h2>
                    </div>
                    <button type="button" class="legal-modal-close" aria-label="Fermer les conditions générales" @onclick="CloseTerms">×</button>
                </header>
                <div class="legal-modal-content">
                    <p class="legal-notice"><strong>Document provisoire.</strong> Cette base doit être relue et validée par un conseil juridique ivoirien avant l’ouverture commerciale.</p>
                    <h3>1. Objet et acceptation</h3>
                    <p>Les présentes conditions encadrent l’accès aux services numériques Wélé et leur utilisation. La création d’un compte ou l’utilisation de la plateforme implique leur acceptation.</p>
                    <h3>2. Rôle de Wélé</h3>
                    <p>Wélé fournit une technologie de mise en relation, de gestion des missions, de suivi et de paiement. Sauf mention contraire affichée avant la commande, chaque entreprise partenaire organise et exécute les prestations sous sa responsabilité, avec ses propres salariés ou intervenants autorisés. Lorsqu’une prestation est expressément réalisée par une équipe Wélé, Wélé assume les obligations attachées à cette qualité.</p>
                    <h3>3. Obligations de l’entreprise partenaire</h3>
                    <p>L’entreprise garantit l’exactitude de son dossier, sa capacité légale à exercer, la validité de ses documents, assurances et autorisations, ainsi que la compétence et la déclaration régulière de ses intervenants. Elle demeure responsable de leur encadrement, de leur sécurité, de leurs actes et de la qualité des prestations.</p>
                    <h3>4. Missions, prix, commissions et reversements</h3>
                    <p>Les missions doivent être acceptées, affectées et suivies dans la plateforme. Les prix, commissions, frais, échéances et moyens de reversement applicables sont présentés avant validation. Les prestations complémentaires doivent suivre le parcours prévu et être approuvées avant exécution.</p>
                    <h3>5. Relation avec le client</h3>
                    <p>Les coordonnées obtenues dans le cadre d’une mission ne peuvent être utilisées que pour son exécution. Le démarchage direct, le contournement de la plateforme, la conservation injustifiée des coordonnées ou la réutilisation des données du client sont interdits.</p>
                    <h3>6. Annulation, incident et réclamation</h3>
                    <p>L’entreprise informe immédiatement Wélé de tout retard, impossibilité, incident, dommage ou comportement inapproprié et coopère à l’analyse des réclamations. Wélé peut suspendre une mission, un reversement ou un compte le temps des vérifications nécessaires.</p>
                    <h3>7. Responsabilité</h3>
                    <p>Chaque partie répond de ses propres actes et omissions. Dans les limites autorisées par la loi, Wélé ne répond pas des fautes commises par une entreprise partenaire indépendante, ses dirigeants, salariés ou sous-traitants. Cette limitation ne couvre ni une faute propre à Wélé, ni la fraude, ni les obligations qui ne peuvent légalement être exclues ou limitées.</p>
                    <h3>8. Données et confidentialité</h3>
                    <p>Les données sont traitées pour gérer les comptes, dossiers, missions, paiements, communications, contrôles et obligations légales, conformément à la réglementation ivoirienne. L’entreprise protège les données auxquelles elle accède et les supprime lorsqu’elles ne sont plus nécessaires.</p>
                    <h3>9. Suspension et résiliation</h3>
                    <p>Wélé peut refuser, limiter ou suspendre l’accès en cas de fraude, documents invalides, risque pour la sécurité, mauvaise qualité répétée, non-respect des obligations sociales ou fiscales, contournement ou violation des présentes conditions, sans préjudice du traitement des sommes et missions déjà engagées.</p>
                    <h3>10. Droit applicable et litiges</h3>
                    <p>Les présentes conditions sont soumises au droit ivoirien. Les parties recherchent d’abord une solution amiable. À défaut, les juridictions ivoiriennes compétentes peuvent être saisies, sous réserve des règles impératives applicables.</p>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private CompanyHomeCmsResponse HomeContent { get; set; } = CreateDefaultHomeContent();
    private HeroHeadlineParts HeroHeadline => SplitHeroHeadline(HomeContent.Hero.Headline);
    private bool IsSubmittedConfirmationVisible { get; set; }
    private string ContactName { get; set; } = string.Empty;
    private string ContactCompany { get; set; } = string.Empty;
    private string ContactPhone { get; set; } = string.Empty;
    private string ContactEmail { get; set; } = string.Empty;
    private string ContactSubject { get; set; } = "Devenir partenaire";
    private string ContactBody { get; set; } = string.Empty;
    private string? ContactMessage { get; set; }
    private bool ShowTerms { get; set; }

    private void OpenTerms() => ShowTerms = true;
    private void CloseTerms() => ShowTerms = false;

    protected override async Task OnInitializedAsync()
    {
        IsSubmittedConfirmationVisible = new Uri(Navigation.Uri)
            .Query
            .Contains("submitted=1", StringComparison.OrdinalIgnoreCase);

        HomeContent = await ApiClient.GetCompanyHomeContentAsync() ?? CreateDefaultHomeContent();
    }

    private async Task SubmitContactAsync()
    {
        if (string.IsNullOrWhiteSpace(ContactName)
            || string.IsNullOrWhiteSpace(ContactCompany)
            || string.IsNullOrWhiteSpace(ContactPhone)
            || string.IsNullOrWhiteSpace(ContactBody))
        {
            ContactMessage = "Renseignez au moins le nom, l'entreprise, le téléphone et le message.";
            return;
        }

        var result = await ApiClient.SubmitContactRequestAsync(new SubmitContactRequest(
            "CompanyLanding",
            ContactName,
            ContactCompany,
            ContactPhone,
            ContactEmail,
            ContactSubject,
            ContactBody));

        if (!result.IsSuccess)
        {
            ContactMessage = result.ErrorMessage ?? "Impossible d'envoyer le message pour le moment.";
            return;
        }

        ContactName = string.Empty;
        ContactCompany = string.Empty;
        ContactPhone = string.Empty;
        ContactEmail = string.Empty;
        ContactSubject = "Devenir partenaire";
        ContactBody = string.Empty;
        ContactMessage = "Message envoyé. Notre équipe vous recontacte rapidement.";
    }

    private string ResolveContentUrl(string? url)
    {
        return ResolveContentUrl(url, string.Empty);
    }

    private string ResolveStepImageUrl(string? number, string? configuredUrl)
    {
        var normalizedNumber = number?.Trim().TrimStart('0');
        return normalizedNumber switch
        {
            "1" => "https://media.wele.africa/website/company/wele-how-step-1.png",
            "2" => "https://media.wele.africa/website/company/wele-how-step-2.png",
            "3" => "https://media.wele.africa/website/company/wele-how-step-3.png",
            _ => ResolveContentUrl(configuredUrl)
        };
    }

    private string ResolveContentUrl(string? url, string fallbackUrl)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return fallbackUrl;
        }

        if (Uri.TryCreate(url, UriKind.Absolute, out var absoluteUri))
        {
            return absoluteUri.ToString();
        }

        if (url.StartsWith("website/", StringComparison.OrdinalIgnoreCase))
        {
            return $"https://media.wele.africa/{url.TrimStart('/')}";
        }

        return url.StartsWith("/api/", StringComparison.OrdinalIgnoreCase)
            ? ApiClient.ToApiUrl(url)
            : NormalizeLegacyMediaUrl(url.TrimStart('/'));
    }

    private static string NormalizeLegacyMediaUrl(string url)
    {
        var normalized = url.Replace("images/kaza-", "images/wele-", StringComparison.OrdinalIgnoreCase);
        return normalized.StartsWith("images/wele-", StringComparison.OrdinalIgnoreCase)
            ? $"https://media.wele.africa/website/company/{Path.GetFileName(normalized)}"
            : normalized;
    }

    private static HeroHeadlineParts SplitHeroHeadline(string headline)
    {
        const string marker = ". ";
        var index = headline.IndexOf(marker, StringComparison.Ordinal);
        return index < 0
            ? new HeroHeadlineParts(headline, string.Empty)
            : new HeroHeadlineParts(headline[..(index + 1)], headline[(index + marker.Length)..]);
    }

    private static CompanyHomeCmsResponse CreateDefaultHomeContent()
    {
        return new CompanyHomeCmsResponse(
            new CompanyHomeHeroCmsResponse(
                string.Empty,
                "La plateforme qui fait grandir votre entreprise de services",
                "wélé connecte votre entreprise à des clients et vous donne les outils pour gérer vos techniciens, vos missions et vos revenus. Le tout depuis une interface unique.",
                new CmsLinkResponse("Devenir partenaire", "register"),
                new CmsLinkResponse("Voir le fonctionnement", "#how"),
                "website/company/wele-premium-hero.png",
                "Equipe wélé en intervention chez un client",
                ["Inscription gratuite", "Validation sous 48h", "Support partenaire 24/7"]),
            new CompanyHomeStepsCmsResponse(
                "Comment ca marche",
                "De l'inscription à votre première mission",
                "Un parcours clair en trois étapes.",
                [
                    new CmsStepResponse("01", "Compte", "Créez votre compte entreprise", "Renseignez les informations et les pièces légales et administratives de votre entreprise.", "website/company/wele-how-step-1.png"),
                    new CmsStepResponse("02", "Validation", "Validation par nos équipes", "Nous vérifions et approuvons votre dossier sous 48h.", "website/company/wele-how-step-2.png"),
                    new CmsStepResponse("03", "Demandes", "Recevez des demandes", "Ajoutez et gérez vos techniciens, recevez des demandes et suivez vos interventions.", "website/company/wele-how-step-3.png")
                ]),
            new CompanyHomeTrustedCmsResponse(
                "Tout ce qu'il faut pour développer votre activité",
                "Une infrastructure professionnelle conçue pour vous apporter des clients et simplifier votre gestion.",
                ["Demandes qualifiées", "Gestion des techniciens", "Suivi des missions", "Paiements sécurisés", "Visibilité locale", "Support partenaire 24/7"]),
            new CompanyHomeDashboardCmsResponse(
                "Le tableau de bord",
                "Une interface unique pour piloter votre entreprise",
                "Demandes, équipes, missions et paiements : tout est réuni au même endroit.",
                [
                    new CmsDashboardStatResponse("Demandes", "12", "+4 cette semaine"),
                    new CmsDashboardStatResponse("Assignées", "8", "Equipe mobilisée"),
                    new CmsDashboardStatResponse("Paiements", "185k", "XOF suivis")
                ],
                ["Ménage à Cocody Riviera", "Jardinage à Marcory", "Nounou aux Deux Plateaux"],
                ["Awa K. - Ménage", "Jean M. - Jardinage", "Fatou C. - Nounou"]),
            new CompanyHomeFaqCmsResponse(
                "FAQ",
                "Foire aux questions",
                [
                    new CmsFaqItemResponse("Quel type de sociétés peuvent s'inscrire sur wélé ?", "Les entreprises de jardinage, électricité, ménage à domicile, blanchisserie, dépannage auto, nounou, plomberie, climatisation, peinture, serrurerie, déménagement, maintenance maison et autres services de proximité peuvent rejoindre la plateforme selon le catalogue ouvert dans l'admin."),
                    new CmsFaqItemResponse("Comment sont vérifiées les entreprises sur wélé ?", "Nous vérifions les informations de l'entreprise, les documents essentiels et le contact responsable avant l'activation complète."),
                    new CmsFaqItemResponse("L'inscription est-elle gratuite ?", "Oui, la création de votre compte entreprise est entièrement gratuite. wélé ne prélève qu'une commission sur les missions réalisées avec succès."),
                    new CmsFaqItemResponse("Puis-je refuser une demande ?", "Absolument. Vous restez libre d'accepter ou de refuser chaque demande selon votre disponibilité et votre zone d'intervention."),
                    new CmsFaqItemResponse("Qui choisit le technicien ?", "C'est vous. Vous affectez le technicien de votre équipe que vous jugez le plus adapté à chaque intervention, ou vous laissez wélé s'en occuper."),
                    new CmsFaqItemResponse("Comment sont suivis les paiements ?", "Les paiements sont sécurisés et versés rapidement sur votre compte après la clôture de chaque mission."),
                    new CmsFaqItemResponse("Qui gère les réclamations clients ?", "wélé gère le support client de premier niveau, en coordination avec votre entreprise lorsque cela est nécessaire."),
                    new CmsFaqItemResponse("Puis-je mettre mon compte en pause ?", "Oui, vous pouvez suspendre temporairement votre activité à tout moment depuis vos paramètres."),
                    new CmsFaqItemResponse("Combien de temps prend la validation ?", "La validation de votre dossier est généralement réalisée sous 48h après réception de vos documents.")
                ]),
            new CompanyHomeContactCmsResponse(
                "Contact",
                "Vous voulez en parler avant de vous inscrire ?",
                "Laissez vos coordonnées. Nous vous rappelons pour voir comment wélé peut aider votre entreprise.",
                ["Abidjan", "Services à domicile", "Partenariat entreprise"]),
            new CompanyHomeFooterCmsResponse(
                "La plateforme B2B pour connecter clients, entreprises et professionnels de confiance.",
                "(c) 2026 wélé Technologies. Tous droits réservés.",
                "Conçu pour l'Afrique de l'Ouest",
                [
                    new CmsFooterColumnResponse("Produit", ["Plateforme", "Fonctionnement", "Tarifs", "Sécurité", "Intégrations", "Changelog"]),
                    new CmsFooterColumnResponse("Entreprise", ["A propos", "Blog", "Carrières", "Presse", "Partenaires"]),
                    new CmsFooterColumnResponse("Ressources", ["Documentation", "Centre d'aide", "Communauté", "Dashboard", "Etudes de cas"]),
                    new CmsFooterColumnResponse("Légal", ["CGU", "Confidentialité", "Cookies", "Mentions légales", "Conditions partenaires"])
                ]));
    }

    private sealed record HeroHeadlineParts(string Main, string Highlight);
}
