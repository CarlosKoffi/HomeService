    private string GetDocumentCounter()
    {
        var (approved, total) = GetRequiredDocumentCounts();
        return $"{approved}/{total}";
    }

    private bool AreRequiredDocumentsApproved()
    {
        var (approved, total) = GetRequiredDocumentCounts();
        return total > 0 && approved == total;
    }

    private (int Approved, int Total) GetRequiredDocumentCounts()
    {
        var required = DocumentSlots.Where(slot => !slot.Optional).ToList();
        var approved = required.Count(slot => FindDocument(slot.Key)?.ReviewStatus == "Approved");
        return (approved, required.Count);
    }

    private int GetZoneCount() => GetInterventionZones().Count;

    private IReadOnlyList<string> GetInterventionZones()
    {
        var zones = new List<string>();
        if (!string.IsNullOrWhiteSpace(Profile?.City))
        {
            zones.Add(Profile.City);
        }

        if (!string.IsNullOrWhiteSpace(Profile?.Address))
        {
            zones.AddRange(Profile.Address
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(zone => !string.IsNullOrWhiteSpace(zone)));
        }

        if (!string.IsNullOrWhiteSpace(Profile?.InterventionZones))
        {
            zones.AddRange(Profile.InterventionZones
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(zone => !string.IsNullOrWhiteSpace(zone)));
        }

        return zones.Count == 0 ? ["A completer"] : zones.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    }

    private string PortalLink(string path)
    {
        return Environment.IsDevelopment() && Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("preview=1", StringComparison.OrdinalIgnoreCase)
            ? $"{path}?preview=1"
            : path;
    }

    private string PortalSectionLink(string path, string section)
    {
        return $"/{PortalLink(path)}#{section}";
    }

    private bool HasMobileMoneyAccount() => GetMobileMoneyNumberOrNull() is not null;

    private string GetMobileMoneyNumber() => GetMobileMoneyNumberOrNull() ?? "A completer";

    private string? GetMobileMoneyNumberOrNull()
    {
        return new[]
        {
            Profile?.WavePaymentNumber,
            Profile?.OrangeMoneyPaymentNumber,
            Profile?.MtnMoneyPaymentNumber,
            Profile?.MoovMoneyPaymentNumber
        }.FirstOrDefault(number => !string.IsNullOrWhiteSpace(number));
    }

    private static string PaymentLogoUrl(string code) =>
        $"https://media.wele.africa/media/payment-providers/{code}.svg";

    private IReadOnlyList<string> GetPlannedServices()
    {
        var services = (Profile?.PlannedServices ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(service => !string.IsNullOrWhiteSpace(service))
            .ToList();

        return services.Count == 0 ? ["A completer"] : services;
    }

    private CompanyPortalProfileDocumentResponse? FindDocument(string documentType)
    {
        return Profile?.Documents
            .Where(document => string.Equals(document.DocumentType, documentType, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(document => document.CreatedAt)
            .FirstOrDefault();
    }

    private string GetDocumentProgress()
    {
        var required = DocumentSlots.Where(slot => !slot.Optional).ToList();
        var approved = required.Count(slot => FindDocument(slot.Key)?.ReviewStatus == "Approved");
        return $"{approved}/{required.Count} obligatoires valides";
    }

    private bool HasAnySubmittedDocument()
    {
        return Profile?.Documents.Count > 0;
    }

    private bool HasDocumentNeedingAction()
    {
        return Profile?.Documents.Any(document => document.ReviewStatus is "Rejected" or "NeedsReplacement") == true;
    }

    private bool HasPendingDocuments()
    {
        return Profile?.Documents.Any(document => document.ReviewStatus == "Pending") == true;
    }

    private string GetDocumentFooterClass()
    {
        if (AreRequiredDocumentsApproved())
        {
            return "complete";
        }

        if (HasDocumentNeedingAction())
        {
            return "rejected";
        }

        return HasAnySubmittedDocument() ? "pending" : "missing";
    }

    private string GetDocumentFooterMessage()
    {
        if (AreRequiredDocumentsApproved())
        {
            return "Vos pieces obligatoires sont validees. Vous pouvez les remplacer si une information change.";
        }

        if (HasDocumentNeedingAction())
        {
            return "Une ou plusieurs pieces doivent etre corrigees. Consultez la note affichee sur le document concerne.";
        }

        if (HasPendingDocuments() || HasAnySubmittedDocument())
        {
            return "Nous verifions vos documents. Vous pouvez remplacer une piece si besoin.";
        }

        return "Depot possible en ligne ou dans nos bureaux si vous preferez nous remettre les pieces en main propre.";
    }

