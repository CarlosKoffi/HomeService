@page "/activation"
@inject ProviderApiClient Api

<PageTitle>Activer mon compte - wélé Prestataire</PageTitle>

<main class="provider-activation-page">
    <section class="provider-activation-shell">
        <div class="provider-activation-intro">
            <p class="eyebrow">Invitation de votre entreprise</p>
            <h1>Activez votre accès Wélé Pro.</h1>
            <p>Créez votre mot de passe ici. Vos missions restent ensuite accessibles uniquement dans l’application Wélé Pro.</p>
        </div>

        <div class="provider-activation-card">
            @if (IsLoading)
            {
                <div class="provider-activation-state">
                    <span class="provider-activation-spinner" aria-hidden="true"></span>
                    <strong>Vérification de votre invitation…</strong>
                </div>
            }
            else if (IsActivated)
            {
                <div class="provider-activation-success">
                    <span class="provider-activation-success-icon" aria-hidden="true">✓</span>
                    <p class="eyebrow">Compte activé</p>
                    <h2>Votre mot de passe est créé.</h2>
                    <p>Téléchargez ou ouvrez Wélé Pro, puis connectez-vous avec le numéro <strong>@ActivatedPhone</strong> et le mot de passe que vous venez de choisir.</p>
                    <a class="primary-action" href="@LoginAppUrl">Ouvrir Wélé Pro</a>
                    <p class="provider-activation-footnote">L’espace prestataire et les missions sont disponibles dans l’application mobile, pas sur ce site.</p>
                </div>
            }
            else if (Preview is null)
            {
                <div class="provider-activation-state provider-activation-error">
                    <span>Invitation indisponible</span>
                    <strong>@(Message ?? "Ce lien est invalide ou a expiré. Demandez une nouvelle invitation à votre entreprise.")</strong>
                </div>
            }
            else
            {
                <div class="provider-invitation-summary">
                    <span class="provider-invitation-avatar">@Initials</span>
                    <span>
                        <small>Compte invité par @Preview.CompanyName</small>
                        <strong>@Preview.ProviderName</strong>
                        <em>@Preview.PhoneNumber</em>
                    </span>
                </div>

                <div class="provider-open-app">
                    <span>Première étape</span>
                    <strong>Créez votre mot de passe ici avant d’ouvrir l’application.</strong>
                </div>

                <form class="provider-activation-form" method="post" action="/activation/submit">
                    <label>
                        Code d’invitation
                        <input name="code" value="@Preview.Code" readonly aria-readonly="true" />
                    </label>
                    <label>
                        Créez votre mot de passe
                        <input name="password" type="password" autocomplete="new-password" placeholder="8 caractères minimum" minlength="8" required />
                    </label>
                    <label>
                        Confirmez le mot de passe
                        <input name="confirmPassword" type="password" autocomplete="new-password" placeholder="Retapez le mot de passe" minlength="8" required />
                    </label>

                    @if (!string.IsNullOrWhiteSpace(Message))
                    {
                        <p class="provider-activation-message">@Message</p>
                    }

                    <button type="submit" class="primary-action">
                        Créer mon mot de passe
                    </button>
                </form>
            }
        </div>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    [SupplyParameterFromQuery(Name = "activated")]
    public bool Activated { get; set; }

    [SupplyParameterFromQuery(Name = "phone")]
    public string? ActivatedPhone { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? ActivationError { get; set; }

    private ProviderInvitationPreviewResponse? Preview { get; set; }
    private string? Message { get; set; }
    private string? LoadedCode { get; set; }
    private bool IsLoading { get; set; }
    private bool IsActivated { get; set; }

    private string Initials => string.Join(string.Empty, (Preview?.ProviderName ?? "W")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    private string LoginAppUrl => $"wele-provider://login?phone={Uri.EscapeDataString(ActivatedPhone ?? string.Empty)}";

    protected override async Task OnParametersSetAsync()
    {
        var normalizedCode = Code?.Trim();
        if (string.Equals(LoadedCode, normalizedCode, StringComparison.Ordinal))
        {
            return;
        }

        LoadedCode = normalizedCode;
        Preview = null;
        IsActivated = Activated;
        Message = ActivationError;
        if (IsActivated)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(normalizedCode))
        {
            Message ??= "Le code d’invitation manque dans ce lien.";
            return;
        }

        IsLoading = true;
        var result = await Api.GetInvitationAsync(normalizedCode);
        IsLoading = false;
        if (!result.IsSuccess || result.Value is null)
        {
            Message = result.ErrorMessage ?? "Cette invitation n’est plus disponible.";
            return;
        }

        Preview = result.Value;
    }
}
