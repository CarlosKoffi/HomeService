@page "/onboarding"
@inject ProviderApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>wélé Prestataire - Interim</PageTitle>

@if (IsRegistrationComplete)
{
    <main class="provider-application-success-page" aria-labelledby="provider-success-title">
        <section class="provider-application-success-card" role="status">
            <div class="provider-success-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="m5 12.5 4.2 4.2L19 7" /></svg>
            </div>

            <p class="provider-success-eyebrow">Candidature envoyée</p>
            <h1 id="provider-success-title">Merci @RegisterFirstName, votre candidature est bien partie.</h1>
            <p class="provider-success-lead">
                L’entreprise <strong>@SubmittedCompanyName</strong> a reçu votre candidature et vous recontactera très bientôt.
            </p>
            <p class="provider-success-thanks">Merci pour votre candidature et à très bientôt sur Wélé.</p>

            <div class="provider-success-app-card">
                <div class="provider-success-app-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="2.5" /><path d="M10 6h4M11 18h2" /></svg>
                </div>
                <div>
                    <span>Votre prochaine étape</span>
                    <strong>Connectez-vous à l’application Wélé Pro</strong>
                    <p>Utilisez le numéro <b>@RegisterPhoneNumber</b> et le mot de passe choisis lors de votre inscription.</p>
                </div>
            </div>

            <div class="provider-success-actions">
                <a class="provider-success-primary" href="@ProviderAppUrl">
                    Ouvrir Wélé Pro
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
                <a class="provider-success-secondary" href="/">Retour à l’accueil</a>
            </div>

            <small class="provider-success-note">L’application Wélé Pro doit être installée sur ce téléphone pour s’ouvrir directement.</small>
        </section>
    </main>
}
else
{
<main class="provider-onboarding-page">
    <section class="registration-header onboarding-hero-copy">
        <p class="eyebrow">wélé prestataire</p>
        <h1>@PageHeadline</h1>
        <p>@PageSubtitle</p>
    </section>

    <section class="registration-form onboarding-form-shell">
        <div class="onboarding-choice-card">
            <div class="onboarding-card-head">
                <div class="onboarding-icon orange">
                    <svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" /><path d="M4 21a8 8 0 0 1 16 0" /><path d="M19 8v6" /><path d="M16 11h6" /></svg>
                </div>
                <div>
                    <span>Candidature prestataire</span>
                    <h2>Creer mon compte</h2>
                    <p>Renseignez vos informations et vos services. Une entreprise devra valider votre profil avant les missions.</p>
                </div>
            </div>

            <div class="register-fieldset">
                <span>Competences</span>
                <div class="provider-service-autocomplete">
                    <label for="provider-service-search">Services ou prestations proposes</label>
                    <input id="provider-service-search"
                           type="search"
                           autocomplete="off"
                           placeholder="Commencez a taper un service"
                           value="@ServiceEntry"
                           @oninput="OnServiceEntryChanged"
                           @onfocus="OpenServiceSuggestions"
                           @onkeyup="HandleServiceEntryKeyUp" />

                    @if (IsServiceSuggestionOpen && !string.IsNullOrWhiteSpace(ServiceEntry))
                    {
                        var visibleOptions = GetVisibleOnboardingOptions();
                        <div class="provider-service-suggestion-list" role="listbox" aria-label="Services et prestations proposes">
                            @foreach (var option in visibleOptions)
                            {
                                <button type="button" role="option" @onclick="@(() => SelectOnboardingOptionAsync(option))">
                                    <span class="provider-option-copy">
                                        <strong>@option.Label</strong>
                                        <small>@GetOptionKindLabel(option)</small>
                                    </span>
                                    <span aria-hidden="true">+</span>
                                </button>
                            }
                            @if (CanProposeTypedService())
                            {
                                <button type="button" class="proposed-option" @onclick="AddTypedServiceAsync">
                                    <span class="provider-option-copy">
                                        <strong>Proposer « @ServiceEntry.Trim() »</strong>
                                        <small>Nouveau service soumis a validation</small>
                                    </span>
                                    <span aria-hidden="true">+</span>
                                </button>
                            }
                            @if (visibleOptions.Count == 0 && !CanProposeTypedService())
                            {
                                <p class="provider-service-no-result">Tapez au moins 3 caracteres.</p>
                            }
                        </div>
                    }
                    <small>Tapez quelques lettres, puis touchez un resultat. Vous pouvez ajouter plusieurs services ou prestations.</small>
                </div>

                @if (!string.IsNullOrWhiteSpace(ServiceMessage))
                {
                    <p class="provider-service-message">@ServiceMessage</p>
                }

                @if (SelectedCompetencies.Count > 0)
                {
                    <div class="selected-competency-list">
                        @foreach (var competency in SelectedCompetencies)
                        {
                            <article class="selected-competency-card">
                                <div class="selected-competency-heading">
                                    <div>
                                        <span>@(competency.IsProposed ? "Nouveau service" : GetOptionKindLabel(competency.Option!))</span>
                                        <strong>@competency.Label</strong>
                                    </div>
                                    <button type="button"
                                            class="remove-competency-button"
                                            title="Retirer cette competence"
                                            aria-label="Retirer @competency.Label"
                                            @onclick="@(() => RemoveCompetencyAsync(competency.Key))">×</button>
                                </div>
                                <label>
                                    Annees d'experience
                                    <input type="number"
                                           min="0"
                                           max="60"
                                           value="@competency.YearsOfExperience"
                                           @onchange="@(args => UpdateCompetencyYears(competency.Key, args))" />
                                </label>
                            </article>
                        }
                    </div>
                }
            </div>

            <div class="register-fieldset">
                <span>Identite</span>
                <div class="two-field-grid">
                    <label>Prenom<input placeholder="Awa" @bind="RegisterFirstName" /></label>
                    <label>Nom<input placeholder="Kone" @bind="RegisterLastName" /></label>
                </div>
                <div class="two-field-grid">
                    <label>Sexe
                        <select @bind="RegisterGender">
                            <option value="">Selectionnez</option>
                            <option value="Female">Femme</option>
                            <option value="Male">Homme</option>
                        </select>
                    </label>
                    <label>Date de naissance<InputDate @bind-Value="RegisterBirthDate" /></label>
                </div>
            </div>

            <div class="register-fieldset">
                <span>Contact</span>
                <label>Tel<input type="tel" placeholder="+225 07 00 00 00 00" @bind="RegisterPhoneNumber" /></label>
                <label>Adresse
                    <input list="abidjan-neighborhoods" placeholder="Ex: Cocody Angre" value="@RegisterAddress" @oninput="OnAddressChanged" />
                    <datalist id="abidjan-neighborhoods">
                        @foreach (var area in AbidjanAreas)
                        {
                            <option value="@area"></option>
                        }
                    </datalist>
                </label>
            </div>

            <div class="register-fieldset opportunity-fieldset">
                <span>Opportunites proches</span>
                <p class="opportunity-help">wélé vous propose jusqu'a 5 entreprises qui acceptent les candidatures interimaires dans votre domaine. Une seule entreprise recevra votre demande : la premiere est selectionnee par defaut, vous pouvez en choisir une autre.</p>
                @if (IsLoadingOpportunities)
                {
                    <div class="opportunity-empty">Recherche des entreprises compatibles...</div>
                }
                else if (SelectedCompetencies.Count == 0)
                {
                    <div class="opportunity-empty">Ajoutez d'abord au moins un service ou une prestation.</div>
                }
                else if (CompanyOpportunities.Count == 0)
                {
                    <div class="opportunity-empty">Aucune entreprise compatible trouvee pour le moment. Essayez une zone plus large ou un service proche.</div>
                }
                else
                {
                    <div class="opportunity-list">
                        @foreach (var opportunity in CompanyOpportunities)
                        {
                            <label class="opportunity-card @(SelectedOpportunityCompanyIds.Contains(opportunity.CompanyId) ? "selected" : string.Empty)">
                                    <input type="radio"
                                           name="selected-company-opportunity"
                                           checked="@SelectedOpportunityCompanyIds.Contains(opportunity.CompanyId)"
                                           @onchange="@(() => SelectOpportunity(opportunity.CompanyId))" />
                                <span>
                                    <strong>@opportunity.CompanyName</strong>
                                    <small>@opportunity.ProximityLabel</small>
                                </span>
                                <em>@string.Join(", ", opportunity.MatchingPrestations.Count > 0 ? opportunity.MatchingPrestations : opportunity.MatchingServices)</em>
                            </label>
                        }
                    </div>
                }
            </div>

            <div class="register-fieldset">
                <span>Securite</span>
                <div class="two-field-grid">
                    <label>Mot de passe<input type="password" placeholder="Minimum 8 caracteres" @bind="RegisterPassword" /></label>
                    <label>Confirmation<input type="password" placeholder="Retapez le mot de passe" @bind="RegisterConfirmPassword" /></label>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(RegisterMessage))
            {
                <p class="field-message">@RegisterMessage</p>
            }

            <button type="button" class="primary-action" @onclick="RegisterAsync" disabled="@IsBusy">Creer mon compte</button>
        </div>
    </section>

</main>
}

@code {
    [SupplyParameterFromQuery(Name = "code")]
    public string? LegacyInvitationCode { get; set; }

    private string PageHeadline => "Creer votre compte interimaire";
    private string PageSubtitle => "Renseignez vos informations, choisissez une entreprise compatible et envoyez votre candidature.";
    private string RegisterFirstName { get; set; } = string.Empty;
    private string RegisterLastName { get; set; } = string.Empty;
    private string RegisterPhoneNumber { get; set; } = string.Empty;
    private DateTime? RegisterBirthDate { get; set; }
    private string RegisterAddress { get; set; } = string.Empty;
    private string RegisterGender { get; set; } = string.Empty;
    private string RegisterPassword { get; set; } = string.Empty;
    private string RegisterConfirmPassword { get; set; } = string.Empty;
    private IReadOnlyList<ProviderOnboardingOptionResponse> AllOnboardingOptions { get; set; } = [];
    private IReadOnlyList<ProviderCompanyOpportunityResponse> CompanyOpportunities { get; set; } = [];
    private List<SelectedCompetency> SelectedCompetencies { get; } = [];
    private HashSet<Guid> SelectedOpportunityCompanyIds { get; } = [];
    private bool IsLoadingOpportunities { get; set; }
    private bool IsServiceSuggestionOpen { get; set; }
    private string? ServiceMessage { get; set; }
    private static readonly string[] AbidjanAreas =
    [
        "Abobo - Abobo Baoule",
        "Abobo - Avocatier",
        "Abobo - PK18",
        "Adjame - 220 logements",
        "Adjame - Williamsville",
        "Anyama - Centre",
        "Attecoube - Locodjro",
        "Bingerville - Centre",
        "Cocody - Angre",
        "Cocody - Deux Plateaux",
        "Cocody - Riviera 2",
        "Cocody - Riviera 3",
        "Cocody - Riviera Palmeraie",
        "Cocody - Mermoz",
        "Koumassi - Centre",
        "Koumassi - Remblais",
        "Marcory - Zone 4",
        "Marcory - Residentiel",
        "Plateau - Centre",
        "Port-Bouet - Vridi",
        "Port-Bouet - Gonzagueville",
        "Treichville - Avenue 16",
        "Yopougon - Ananeraie",
        "Yopougon - Maroc",
        "Yopougon - Niangon",
        "Yopougon - Selmer"
    ];
    private string ServiceEntry { get; set; } = string.Empty;
    private bool IsBusy { get; set; }
    private bool IsRegistrationComplete { get; set; }
    private string SubmittedCompanyName { get; set; } = "l’entreprise sélectionnée";
    private string? RegisterMessage { get; set; }
    private string ProviderAppUrl => $"wele-provider://login?phone={Uri.EscapeDataString(RegisterPhoneNumber.Trim())}";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(LegacyInvitationCode))
        {
            Navigation.NavigateTo($"/activation?code={Uri.EscapeDataString(LegacyInvitationCode.Trim())}", replace: true);
            return;
        }

        AllOnboardingOptions = await Api.GetOnboardingOptionsAsync(null);
    }

    private async Task RegisterAsync()
    {
        RegisterMessage = null;
        if (RegisterBirthDate is null)
        {
            RegisterMessage = "Renseignez une date de naissance valide.";
            return;
        }

        if (SelectedCompetencies.Count == 0)
        {
            RegisterMessage = "Ajoutez au moins un service ou une prestation.";
            return;
        }

        if (string.IsNullOrWhiteSpace(RegisterGender))
        {
            RegisterMessage = "Selectionnez le sexe du prestataire.";
            return;
        }

        if (SelectedOpportunityCompanyIds.Count == 0)
        {
            RegisterMessage = "Selectionnez une entreprise proche pour envoyer votre demande.";
            return;
        }

        IsBusy = true;
        var selectedCompany = CompanyOpportunities.FirstOrDefault(opportunity =>
            SelectedOpportunityCompanyIds.Contains(opportunity.CompanyId));
        var request = new ProviderSelfRegistrationRequest(
            RegisterFirstName,
            RegisterLastName,
            RegisterPhoneNumber,
            DateOnly.FromDateTime(RegisterBirthDate.Value),
            RegisterAddress,
            RegisterGender,
            SelectedCompetencies.Max(competency => competency.YearsOfExperience),
            null,
            null,
            5,
            RegisterPassword,
            RegisterConfirmPassword,
            BuildSelectedServiceRequests(),
            BuildProposedServiceNames(),
            BuildSelectedCandidateSelections(),
            SelectedOpportunityCompanyIds.ToList());
        var result = await Api.RegisterSelfAsync(request);
        IsBusy = false;
        if (!result.IsSuccess)
        {
            RegisterMessage = result.ErrorMessage ?? "Creation impossible.";
            return;
        }

        SubmittedCompanyName = selectedCompany?.CompanyName ?? "l’entreprise sélectionnée";
        IsRegistrationComplete = true;
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    private void OnServiceEntryChanged(ChangeEventArgs args)
    {
        ServiceEntry = args.Value?.ToString() ?? string.Empty;
        IsServiceSuggestionOpen = true;
        ServiceMessage = null;
    }

    private void OpenServiceSuggestions() => IsServiceSuggestionOpen = true;

    private async Task HandleServiceEntryKeyUp(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or ",")
        {
            await AddTypedServiceAsync();
        }
    }

    private IReadOnlyList<ProviderOnboardingOptionResponse> GetVisibleOnboardingOptions()
    {
        var normalizedQuery = NormalizeCompletionValue(ServiceEntry);
        if (string.IsNullOrWhiteSpace(normalizedQuery))
        {
            return [];
        }

        return AllOnboardingOptions
            .Where(option => !SelectedCompetencies.Any(selected => selected.Key == BuildOptionKey(option)))
            .Where(option =>
                NormalizeCompletionValue(option.Label).Contains(normalizedQuery, StringComparison.Ordinal)
                || NormalizeCompletionValue(option.ServiceName).Contains(normalizedQuery, StringComparison.Ordinal)
                || (!string.IsNullOrWhiteSpace(option.PrestationName)
                    && NormalizeCompletionValue(option.PrestationName).Contains(normalizedQuery, StringComparison.Ordinal)))
            .GroupBy(option => BuildOptionKey(option), StringComparer.Ordinal)
            .Select(group => group.First())
            .Take(12)
            .ToList();
    }

    private bool CanProposeTypedService()
    {
        var entry = ServiceEntry.Trim();
        return entry.Length >= 3 && FindExactOption(entry) is null;
    }

    private async Task SelectOnboardingOptionAsync(ProviderOnboardingOptionResponse option)
    {
        await AddCompetencyAsync(new SelectedCompetency
        {
            Key = BuildOptionKey(option),
            Label = option.Label,
            Option = option
        });
    }

    private async Task AddTypedServiceAsync()
    {
        var entry = ServiceEntry.Trim();
        if (entry.Length < 3)
        {
            ServiceMessage = "Tapez au moins 3 caracteres.";
            return;
        }

        var exactOption = FindExactOption(entry);
        if (exactOption is not null)
        {
            await SelectOnboardingOptionAsync(exactOption);
            return;
        }

        await AddCompetencyAsync(new SelectedCompetency
        {
            Key = $"proposed:{NormalizeCompletionValue(entry)}",
            Label = entry,
            IsProposed = true
        });
    }

    private async Task AddCompetencyAsync(SelectedCompetency competency)
    {
        if (SelectedCompetencies.Count >= 10)
        {
            ServiceMessage = "Vous pouvez ajouter jusqu'a 10 competences.";
            return;
        }

        if (SelectedCompetencies.Any(selected => selected.Key == competency.Key))
        {
            ServiceMessage = "Cette competence est deja ajoutee.";
            return;
        }

        SelectedCompetencies.Add(competency);
        ServiceEntry = string.Empty;
        IsServiceSuggestionOpen = false;
        ServiceMessage = null;
        SelectedOpportunityCompanyIds.Clear();
        await LoadOpportunitiesAsync();
    }

    private async Task RemoveCompetencyAsync(string key)
    {
        SelectedCompetencies.RemoveAll(competency => competency.Key == key);
        SelectedOpportunityCompanyIds.Clear();
        await LoadOpportunitiesAsync();
    }

    private void UpdateCompetencyYears(string key, ChangeEventArgs args)
    {
        var competency = SelectedCompetencies.FirstOrDefault(item => item.Key == key);
        if (competency is null)
        {
            return;
        }

        competency.YearsOfExperience = int.TryParse(args.Value?.ToString(), out var years)
            ? Math.Clamp(years, 0, 60)
            : 0;
    }

    private async Task OnAddressChanged(ChangeEventArgs args)
    {
        RegisterAddress = args.Value?.ToString() ?? string.Empty;
        SelectedOpportunityCompanyIds.Clear();
        await LoadOpportunitiesAsync();
    }

    private async Task LoadOpportunitiesAsync()
    {
        CompanyOpportunities = [];
        if (SelectedCompetencies.Count == 0)
        {
            return;
        }

        IsLoadingOpportunities = true;
        try
        {
            var requests = SelectedCompetencies.Select(competency =>
                Api.GetOnboardingOpportunitiesAsync(
                    competency.Option?.Type,
                    competency.Option?.Id ?? Guid.Empty,
                    competency.Label,
                    RegisterAddress));

            var results = await Task.WhenAll(requests);
            CompanyOpportunities = results
                .SelectMany(opportunities => opportunities)
                .GroupBy(opportunity => opportunity.CompanyId)
                .Select(group =>
                {
                    var first = group.First();
                    return new ProviderCompanyOpportunityResponse(
                        first.CompanyId,
                        first.CompanyName,
                        first.City,
                        first.Address,
                        group.SelectMany(item => item.MatchingServices)
                            .Distinct(StringComparer.OrdinalIgnoreCase)
                            .ToList(),
                        group.SelectMany(item => item.MatchingPrestations)
                            .Distinct(StringComparer.OrdinalIgnoreCase)
                            .ToList(),
                        first.ProximityLabel,
                        first.Status);
                })
                .Take(5)
                .ToList();
        }
        finally
        {
            IsLoadingOpportunities = false;
        }

        if (CompanyOpportunities.Count > 0)
        {
            SelectedOpportunityCompanyIds.Add(CompanyOpportunities[0].CompanyId);
        }
    }

    private void SelectOpportunity(Guid companyId)
    {
        SelectedOpportunityCompanyIds.Clear();
        SelectedOpportunityCompanyIds.Add(companyId);
    }

    private ProviderOnboardingOptionResponse? FindExactOption(string entry)
    {
        if (string.IsNullOrWhiteSpace(entry))
        {
            return null;
        }

        var normalizedEntry = NormalizeCompletionValue(entry);
        return AllOnboardingOptions.FirstOrDefault(option =>
                NormalizeCompletionValue(option.Label) == normalizedEntry
                || NormalizeCompletionValue(option.ServiceName) == normalizedEntry
                || IsSameServicePrestationLabel(option, normalizedEntry)
                || (!string.IsNullOrWhiteSpace(option.PrestationName)
                    && NormalizeCompletionValue(option.PrestationName) == normalizedEntry));
    }

    private static bool IsSameServicePrestationLabel(ProviderOnboardingOptionResponse option, string normalizedEntry)
    {
        if (string.IsNullOrWhiteSpace(option.PrestationName))
        {
            return false;
        }

        var combined = NormalizeCompletionValue($"{option.ServiceName} {option.PrestationName}");
        return combined == normalizedEntry || normalizedEntry.Contains(combined, StringComparison.Ordinal);
    }

    private IReadOnlyList<ProviderCandidateServiceRequest> BuildSelectedServiceRequests()
    {
        return SelectedCompetencies
            .Where(competency => competency.Option is not null)
            .GroupBy(competency => competency.Option!.ServiceId)
            .Select(group => new ProviderCandidateServiceRequest(
                group.Key,
                "Confirmed",
                group.Max(competency => competency.YearsOfExperience)))
            .ToList();
    }

    private IReadOnlyList<ProviderCandidateSelectionRequest> BuildSelectedCandidateSelections()
    {
        return SelectedCompetencies
            .Where(competency => competency.Option is not null)
            .GroupBy(competency => BuildOptionKey(competency.Option!), StringComparer.Ordinal)
            .Select(group =>
            {
                var first = group.First();
                return new ProviderCandidateSelectionRequest(
                    first.Option!.Type,
                    first.Option.Id,
                    "Confirmed",
                    group.Max(competency => competency.YearsOfExperience));
            })
            .ToList();
    }

    private IReadOnlyList<string> BuildProposedServiceNames()
    {
        return SelectedCompetencies
            .Where(competency => competency.IsProposed)
            .Select(competency => competency.Label.Trim())
            .Where(label => !string.IsNullOrWhiteSpace(label))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string BuildOptionKey(ProviderOnboardingOptionResponse option) =>
        $"{option.Type}:{option.Id:N}";

    private static string GetOptionKindLabel(ProviderOnboardingOptionResponse option) =>
        string.Equals(option.Type, "Prestation", StringComparison.OrdinalIgnoreCase)
            ? $"Prestation - {option.ServiceName}"
            : "Service";

    private static bool IsSameService(string left, string right)
    {
        return IsSameCompletionValue(left, right);
    }

    private static bool IsSameCompletionValue(string left, string right)
    {
        return NormalizeCompletionValue(left) == NormalizeCompletionValue(right);
    }

    private static string NormalizeCompletionValue(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var normalized = value.Trim().Normalize(System.Text.NormalizationForm.FormD);
        var builder = new System.Text.StringBuilder(normalized.Length);
        foreach (var character in normalized)
        {
            var category = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(character);
            if (category != System.Globalization.UnicodeCategory.NonSpacingMark)
            {
                builder.Append(char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : ' ');
            }
        }

        return string.Join(' ', builder
            .ToString()
            .Normalize(System.Text.NormalizationForm.FormC)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
    }

    private sealed class SelectedCompetency
    {
        public string Key { get; init; } = string.Empty;
        public string Label { get; init; } = string.Empty;
        public bool IsProposed { get; init; }
        public ProviderOnboardingOptionResponse? Option { get; init; }
        public int YearsOfExperience { get; set; }
    }
}
