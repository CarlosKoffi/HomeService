<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Company.Mobile.Pages.ProvidersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*" Padding="20,20,20,0" RowSpacing="16">
        <VerticalStackLayout Spacing="3">
            <Label Text="ÉQUIPE" Style="{StaticResource Eyebrow}" />
            <Label Text="Prestataires" Style="{StaticResource ScreenTitle}" />
            <Label Text="Validez les candidatures et gardez votre équipe à portée de main." Style="{StaticResource Muted}" />
        </VerticalStackLayout>

        <RefreshView x:Name="RefreshHost" Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="0,0,0,28" Spacing="14">
                    <Grid x:Name="PendingHeader" ColumnDefinitions="*,Auto" IsVisible="False" Margin="0,2,0,0">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="À VALIDER" Style="{StaticResource Eyebrow}" />
                            <Label Text="Nouvelles candidatures" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource BlueWash}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="10,5" VerticalOptions="Center">
                            <Label x:Name="PendingCountLabel" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout x:Name="PendingCandidatesLayout" Spacing="11" BindableLayout.ItemsSource="{Binding PendingApprovals}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PremiumCard}">
                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border WidthRequest="50" HeightRequest="50" BackgroundColor="{StaticResource BlueWash}" StrokeThickness="0" StrokeShape="RoundRectangle 25">
                                                <Image Source="icon_user.svg" WidthRequest="24" HeightRequest="24" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding FullName}" Style="{StaticResource CardTitle}" />
                                                <Label Text="{Binding ServiceLabel}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding TypeLabel}" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Warning}" VerticalOptions="Start" />
                                        </Grid>

                                        <Label Text="{Binding ExperienceLabel}" FontSize="13" FontAttributes="Bold" />
                                        <Label Text="{Binding MessageLabel}" Style="{StaticResource Muted}" IsVisible="{Binding HasMessage}" />
                                        <Label Text="{Binding DetailLabel}" FontSize="11" TextColor="{StaticResource MutedInk}" />

                                        <Button Text="Voir le dossier complet" Style="{StaticResource SecondaryButton}" CommandParameter="{Binding .}" Clicked="OnCandidateDetailClicked" />

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Button Text="Refuser" Style="{StaticResource SecondaryButton}" CommandParameter="{Binding .}" Clicked="OnRejectCandidateClicked" />
                                            <Button Grid.Column="1" Text="Accepter" CommandParameter="{Binding .}" Clicked="OnApproveCandidateClicked" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView x:Name="SectionsSeparator" IsVisible="False" HeightRequest="1" BackgroundColor="{StaticResource Line}" Margin="0,5" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="MON ÉQUIPE" Style="{StaticResource Eyebrow}" />
                            <Label Text="Prestataires rattachés" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Label x:Name="TeamCountLabel" Grid.Column="1" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource MutedInk}" VerticalOptions="Center" />
                    </Grid>

                    <Label x:Name="TeamEmptyLabel" Text="Aucun prestataire n’est encore rattaché à cette entreprise." Style="{StaticResource Muted}" Margin="0,4,0,8" IsVisible="False" />

                    <VerticalStackLayout x:Name="TeamLayout" Spacing="11" BindableLayout.ItemsSource="{Binding Providers}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PremiumCard}">
                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border WidthRequest="50" HeightRequest="50" BackgroundColor="{StaticResource BlueWash}" StrokeThickness="0" StrokeShape="RoundRectangle 25">
                                                <Image Source="icon_user.svg" WidthRequest="25" HeightRequest="25" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding FullName}" Style="{StaticResource CardTitle}" />
                                                <Label Text="{Binding ServiceLabel}" Style="{StaticResource Muted}" />
                                                <Label Text="{Binding MissionLabel}" Style="{StaticResource Muted}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding AvailabilityLabel}" FontSize="10" FontAttributes="Bold" TextColor="{Binding AvailabilityColor}" VerticalOptions="Start" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Button Text="Appeler" Style="{StaticResource SecondaryButton}" CommandParameter="{Binding .}" Clicked="OnCallClicked" />
                                            <Button Grid.Column="1" Text="Message" Style="{StaticResource SecondaryButton}" CommandParameter="{Binding .}" Clicked="OnMessageClicked" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
