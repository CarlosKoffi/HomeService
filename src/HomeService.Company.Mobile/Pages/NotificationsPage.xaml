<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Company.Mobile.Pages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*" Padding="20,20,20,0" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <VerticalStackLayout Spacing="3">
                <Label Text="CENTRE D’ACTIONS" Style="{StaticResource Eyebrow}" />
                <Label Text="Alertes" Style="{StaticResource ScreenTitle}" />
                <Label x:Name="UnreadLabel" Style="{StaticResource Muted}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="End">
                <Image Source="app_bell.svg" WidthRequest="28" HeightRequest="28" HorizontalOptions="End" />
                <Button x:Name="MarkAllReadButton" Text="Tout lire" FontSize="10" Padding="9,4"
                        HeightRequest="30" MinimumHeightRequest="30" IsVisible="False" Clicked="OnMarkAllReadClicked" />
            </VerticalStackLayout>
        </Grid>
        <RefreshView x:Name="RefreshHost" Grid.Row="1" Refreshing="OnRefreshing">
            <CollectionView x:Name="NotificationsView" SelectionMode="Single" SelectionChanged="OnNotificationSelected" EmptyView="Aucune alerte pour le moment.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,10" Stroke="{Binding StrokeColor}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{Binding IconBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 21">
                                    <Image Source="{Binding Icon}" WidthRequest="22" HeightRequest="22" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding Message}" Style="{StaticResource Muted}" />
                                    <Label Text="{Binding TimeLabel}" FontSize="11" TextColor="{StaticResource MutedInk}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" IsVisible="{Binding IsUnread}" BackgroundColor="{StaticResource WeleBlue}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="7,4" VerticalOptions="Start">
                                    <Label Text="Nouveau" FontSize="8" FontAttributes="Bold" TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
