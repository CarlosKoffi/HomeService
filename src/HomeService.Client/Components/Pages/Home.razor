@page "/"
@implements IDisposable
@using HomeService.Client.Services
@using HomeService.Contracts.Clients
@using HomeService.Contracts.Cms
@using HomeService.Contracts.Services
@inject PublicWebsiteApiClient ApiClient
@inject IConfiguration Configuration

<PageTitle>Wélé — Le bon service, au bon moment</PageTitle>
<HeadContent>
    <meta name="description" content="Wélé vous met en relation avec des professionnels vérifiés pour votre maison, votre bien-être et votre quotidien à Abidjan." />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href="https://wele.africa/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CI" />
    <meta property="og:site_name" content="Wélé" />
    <meta property="og:title" content="Wélé — Le bon service, au bon moment" />
    <meta property="og:description" content="Des services fiables à Abidjan auprès de professionnels vérifiés." />
    <meta property="og:url" content="https://wele.africa/" />
    <meta property="og:image" content="https://media.wele.africa/website/client/wele-client-hero-v2.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Wélé — Le bon service, au bon moment" />
    <meta name="twitter:description" content="Des services fiables à Abidjan auprès de professionnels vérifiés." />
    <meta name="twitter:image" content="https://media.wele.africa/website/client/wele-client-hero-v2.webp" />
    @((MarkupString)"<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Wélé\",\"url\":\"https://wele.africa/\",\"logo\":\"https://wele.africa/images/wele-logo-client.png\",\"areaServed\":{\"@type\":\"City\",\"name\":\"Abidjan\"}}</script>")
</HeadContent>

<div class="client-site @(mobileMenuOpen ? "menu-is-open" : string.Empty)">
    <header class="client-header">
        <a class="client-brand" href="#accueil" aria-label="Accueil Wélé" @onclick="CloseMenu">
            <img src="images/wele-logo-client.png" alt="Wélé" width="732" height="216" />
        </a>

        <button class="client-menu-button" type="button" aria-label="Ouvrir le menu" aria-expanded="@mobileMenuOpen" @onclick="ToggleMenu">
            <span></span><span></span><span></span>
        </button>

        <nav class="client-navigation @(mobileMenuOpen ? "is-open" : string.Empty)" aria-label="Navigation principale">
            <div class="client-nav-main">
                <details class="client-services-dropdown">
                    <summary>
                        Nos services
                        <span class="client-nav-chevron" aria-hidden="true">
                            <svg viewBox="0 0 16 16" focusable="false"><path d="m3.5 6 4.5 4 4.5-4" /></svg>
                        </span>
                    </summary>
                    <div class="client-services-menu">
                        <strong>Services les plus demandés</strong>
                        @foreach (var service in PopularServices)
                        {
                            <a href="@($"/services/{ServiceSeoCatalog.ToSlug(service.Name)}")" @onclick="CloseMenu">
                                <span>@GetInitials(service.Name)</span>@service.Name
                            </a>
                        }
                        <a class="client-services-menu-all" href="/services" @onclick="CloseMenu">Voir tous les services <b aria-hidden="true">→</b></a>
                    </div>
                </details>
                <a href="https://pro.wele.africa">Devenir prestataire</a>
                <a href="https://entreprise.wele.africa">Pour les entreprises</a>
                <a href="#a-propos" @onclick="CloseMenu">À propos</a>
            </div>
            <div class="client-nav-actions">
                <span class="client-locale">CI · FR</span>
                <a href="#aide" @onclick="CloseMenu">Aide</a>
                <a href="#telecharger" @onclick="CloseMenu">Connexion</a>
                <a class="client-nav-cta" href="#telecharger" @onclick="CloseMenu">S’inscrire</a>
            </div>
        </nav>
    </header>

    <section class="client-hero" id="accueil">
        <div class="client-hero-copy">
            <span class="client-location">● @ClientContent.Hero.Label</span>
            <h1>@ClientContent.Hero.Headline</h1>
            <p>@ClientContent.Hero.Subtitle</p>
            <div class="client-hero-actions">
                <a class="client-button client-button-blue" href="@ClientContent.Hero.PrimaryCta.Url">@ClientContent.Hero.PrimaryCta.Label</a>
                <a class="client-text-link" href="@ClientContent.Hero.SecondaryCta.Url">@ClientContent.Hero.SecondaryCta.Label <span>→</span></a>
            </div>
        </div>
        <div class="client-hero-media">
            <img src="@ResolveContentUrl(ClientContent.Hero.ImageUrl, HeroImageUrl)" alt="@ClientContent.Hero.ImageAlt" width="1672" height="941" fetchpriority="high" decoding="async" onerror="this.onerror=null;this.src='images/wele-client-hero-v2.webp'" />
        </div>
    </section>

    <section class="client-booking-wrap" id="commander" aria-labelledby="booking-title">
        <div class="client-booking-card">
            <div class="client-booking-tabs" role="group" aria-label="Choisir le moment de l’intervention">
                <button type="button" class="@(selectedMode == "Instant" ? "active" : string.Empty)" @onclick="SelectInstant">Dès que possible</button>
                <button type="button" class="@(selectedMode == "Scheduled" ? "active" : string.Empty)" @onclick="SelectScheduled">Sur rendez-vous</button>
            </div>

            <h2 id="booking-title" class="visually-hidden">Vérifier la disponibilité d’un service</h2>
            <div class="client-booking-fields">
                <label>
                    <span>Service</span>
                    <input type="search"
                           value="@serviceQuery"
                           @oninput="HandleServiceInput"
                           @onfocus="ShowServiceSuggestions"
                           placeholder="Quel service recherchez-vous ?"
                           autocomplete="off"
                           aria-autocomplete="list"
                           aria-controls="service-suggestions" />
                    @if (showServiceSuggestions && filteredServices.Count > 0)
                    {
                        <div class="client-suggestion-list" id="service-suggestions" role="listbox">
                            @foreach (var service in filteredServices)
                            {
                                <button type="button" role="option" @onclick="() => SelectService(service)">
                                    <span class="client-suggestion-mark">@GetInitials(service.Name)</span>
                                    <span><strong>@service.Name</strong><small>@GetServiceDetail(service)</small></span>
                                </button>
                            }
                        </div>
                    }
                </label>
                <label class="client-address-field">
                    <span>Adresse</span>
                    <input type="search"
                           value="@interventionAddress"
                           @oninput="HandleAddressInput"
                           @onfocus="ShowAddressSuggestions"
                           placeholder="Où intervenir ?"
                           autocomplete="off"
                           aria-autocomplete="list"
                           aria-controls="address-suggestions" />
                    @if (showAddressSuggestions && addressSuggestions.Count > 0)
                    {
                        <div class="client-suggestion-list client-address-suggestions" id="address-suggestions" role="listbox">
                            @foreach (var suggestion in addressSuggestions)
                            {
                                <button type="button" role="option" @onclick="() => SelectAddressAsync(suggestion)">
                                    <span class="client-pin-mark">⌖</span>
                                    <span><strong>@suggestion.MainText</strong><small>@suggestion.SecondaryText</small></span>
                                </button>
                            }
                            <small class="client-google-attribution">Adresses proposées par Google</small>
                        </div>
                    }
                </label>
                @if (selectedMode == "Scheduled")
                {
                    <label class="client-date-field">
                        <span>Date</span>
                        <input type="date" @bind="appointmentDate" min="@MinimumDate" />
                    </label>
                    <label class="client-slot-field">
                        <span>Créneau d’arrivée</span>
                        <select @bind="appointmentSlot">
                            @foreach (var slot in AppointmentSlots)
                            {
                                <option value="@slot.Value">@slot.Label</option>
                            }
                        </select>
                    </label>
                }
                <button class="client-button client-button-black client-check-button" type="button" disabled="@isCheckingAvailability" @onclick="CheckAvailabilityAsync">
                    @(isCheckingAvailability ? "Vérification…" : "Voir les disponibilités")
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <p class="client-form-error" role="alert">@formError</p>
            }

            @if (availability is not null)
            {
                <div class="client-availability-result @(availability.HasMatchingProfessionals ? "is-positive" : "is-searching")" role="status">
                    <span class="client-result-icon">@(availability.HasMatchingProfessionals ? "✓" : "↗")</span>
                    <div>
                        <strong>@availability.Headline</strong>
                        <p>@availability.Message</p>
                    </div>
                    <a class="client-button client-button-blue" href="#telecharger">Continuer dans l’application</a>
                </div>
            }
        </div>

        <div class="client-trust-strip" aria-label="Engagements Wélé">
            <span>
                <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 20 6v5c0 5.1-3.4 8.5-8 10-4.6-1.5-8-4.9-8-10V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></i>
                <strong>@GetListItem(ClientContent.Hero.ProofItems, 0, "Professionnels vérifiés et notés")</strong>
            </span>
            <span>
                <i aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="3"/><path d="M8 10V8a4 4 0 0 1 8 0v2"/><path d="M12 14v2"/></svg></i>
                <strong>@GetListItem(ClientContent.Hero.ProofItems, 1, "Paiement sécurisé")</strong>
            </span>
            <span>
                <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z"/><circle cx="12" cy="10" r="2"/><path d="M3 12H1m22 0h-2"/></svg></i>
                <strong>@GetListItem(ClientContent.Hero.ProofItems, 2, "Service suivi en direct")</strong>
            </span>
            <span>
                <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><path d="M4 14h3v5H5a2 2 0 0 1-2-2v-1a2 2 0 0 1 1-2Zm16 0h-3v5h2a2 2 0 0 0 2-2v-1a2 2 0 0 0-1-2Z"/><path d="M17 19c-.8 1.3-2.5 2-5 2"/></svg></i>
                <strong>@GetListItem(ClientContent.Hero.ProofItems, 3, "Assistance réactive")</strong>
            </span>
        </div>
    </section>

    <section class="client-section client-services-section" id="services">
        <div class="client-section-heading">
            <span>@ClientContent.Services.Label</span>
            <h2>@ClientContent.Services.Headline</h2>
            <p>@ClientContent.Services.Subtitle</p>
        </div>

        <div class="client-service-grid">
            @foreach (var card in landingServiceCards)
            {
                <article class="client-service-card">
                    @if (!string.IsNullOrWhiteSpace(card.ImageUrl))
                    {
                        <img src="@ResolvePublicMediaUrl(card.ImageUrl)" alt="@card.Title" loading="lazy" decoding="async" />
                    }
                    else
                    {
                        <div class="client-service-placeholder @card.Tone"><span>@card.ShortLabel</span></div>
                    }
                    <div>
                        <h3>@card.Title</h3>
                        <p>@card.Description</p>
                        @if (!string.IsNullOrWhiteSpace(card.Slug))
                        {
                            <a href="@($"/services/{card.Slug}")">Découvrir <span>→</span></a>
                        }
                        else
                        {
                            <a href="#commander" @onclick="() => SelectLandingService(card.ServiceId)">Découvrir <span>→</span></a>
                        }
                    </div>
                </article>
            }
        </div>
        @if (services.Count > 0)
        {
            <div class="client-service-directory" aria-label="Tous les services Wélé">
                <strong>Tous les services disponibles</strong>
                <div>
                    @foreach (var service in services)
                    {
                        <a href="@($"/services/{ServiceSeoCatalog.ToSlug(service.Name)}")">@service.Name <span>→</span></a>
                    }
                </div>
            </div>
        }
    </section>

    <section class="client-section client-steps-section" id="fonctionnement">
        <div class="client-section-heading compact">
            <span>@ClientContent.Steps.Label</span>
            <h2>@ClientContent.Steps.Headline</h2>
            <p>@ClientContent.Steps.Subtitle</p>
        </div>
        <div class="client-steps-grid">
            @foreach (var step in ClientContent.Steps.Items)
            {
                <article><span>@step.Number</span><h3>@step.Title</h3><p>@step.Text</p></article>
            }
        </div>
    </section>

    <section class="client-section client-confidence-section" id="a-propos">
        <div class="client-confidence-copy">
            <span>@ClientContent.Confidence.Label</span>
            <h2>@ClientContent.Confidence.Headline</h2>
            <p>@ClientContent.Confidence.Subtitle</p>
            <ul>
                <li><b>Professionnels contrôlés</b><small>Les profils et pièces nécessaires sont vérifiés.</small></li>
                <li><b>Vos informations protégées</b><small>Les coordonnées utiles sont masquées après la mission.</small></li>
                <li><b>Une équipe à vos côtés</b><small>Un litige ou un imprévu peut être analysé par Wélé.</small></li>
            </ul>
            <a class="client-button client-button-blue" href="@ClientContent.Confidence.PrimaryCta.Url">@ClientContent.Confidence.PrimaryCta.Label</a>
        </div>
        <div class="client-confidence-media">
            <img src="@ResolveContentUrl(ClientContent.Confidence.ImageUrl, TrustTeamImageUrl)" alt="@ClientContent.Confidence.ImageAlt" width="972" height="1619" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='images/wele-trust-team-v2.webp'" />
            <div class="client-rating-card"><strong>4,8/5</strong><span>★★★★★</span><small>Avis après intervention</small></div>
        </div>
    </section>

    <section class="client-section client-repeat-section">
        <div>
            <span>@ClientContent.Repeat.Label</span>
            <h2>@ClientContent.Repeat.Headline</h2>
            <p>@ClientContent.Repeat.Subtitle</p>
            <a class="client-button client-button-black" href="@ClientContent.Repeat.PrimaryCta.Url">@ClientContent.Repeat.PrimaryCta.Label</a>
        </div>
        <div class="client-repeat-card">
            <img class="client-repeat-avatar" src="@WithAssetVersion(ResolveContentUrl(ClientContent.Repeat.ProfileImageUrl, "images/awa-kouame-profile.webp"), "awa-teal-20260814")" alt="@ClientContent.Repeat.ProfileImageAlt" width="384" height="384" loading="lazy" decoding="async" />
            <div><strong>@ClientContent.Repeat.ProfileName</strong><small>@ClientContent.Repeat.ProfileService · @ClientContent.Repeat.ProfileRating</small></div>
            <span class="client-repeat-verified">@ClientContent.Repeat.ProfileBadge</span>
        </div>
    </section>

    <section class="client-app-section" id="telecharger">
        <div class="client-phone-stage" aria-label="Aperçu de l’application Wélé">
            <div class="client-phone-shell">
                <div class="client-phone-top">
                    <div><strong>Bonjour Aïcha 👋</strong><small>Votre quotidien, simplifié.</small></div>
                    <span class="client-phone-bell" aria-label="2 notifications non lues">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.3 21a2 2 0 0 0 3.4 0"/><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/></svg>
                        <i>2</i>
                    </span>
                </div>
                <div class="client-phone-search">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
                    <span>Que recherchez-vous aujourd’hui ?</span>
                </div>
                <div class="client-phone-section-heading"><small>Pour ma maison</small><em>Voir plus&nbsp; →</em></div>
                <div class="client-phone-services">
                    <span><b><img src="images/services/menage-balai-v2.webp" alt="" /></b>Ménage</span>
                    <span><b><img src="@ResolvePublicMediaUrl("/assets/services/blanchisserie.png")" alt="" /></b>Blanchisserie</span>
                    <span><b><img src="images/services/climatisation-premium-v2.webp" alt="" /></b>Climatisation</span>
                </div>
                <div class="client-phone-section-heading client-phone-wellbeing-heading"><small>Pour mon bien-être</small><em>Voir plus&nbsp; →</em></div>
                <div class="client-phone-services client-phone-wellbeing-services">
                    <span><b><img src="@ResolvePublicMediaUrl("/assets/services/barbier.png")" alt="" /></b>Barbier</span>
                    <span><b><img src="@ResolvePublicMediaUrl("/assets/services/coiffure.png")" alt="" /></b>Coiffure</span>
                    <span><b><img src="@ResolvePublicMediaUrl("/assets/services/estheticienne.png")" alt="" /></b>Esthéticienne</span>
                </div>
                <div class="client-phone-section-heading client-phone-missions-heading"><small>Mes demandes</small><em>Voir tout&nbsp; →</em></div>
                <div class="client-phone-missions">
                    <div class="client-phone-mission">
                        <span class="client-phone-mission-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg></span>
                        <div><b>Entretien climatisation</b><span>Riviera 3 · Aujourd’hui, 15:30</span></div>
                        <em class="is-live">En route</em>
                    </div>
                    <div class="client-phone-mission">
                        <span class="client-phone-mission-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg></span>
                        <div><b>Ménage à domicile</b><span>Cocody · Demain, 09:30</span></div>
                        <em>Confirmée</em>
                    </div>
                </div>
                <div class="client-phone-nav">
                    <span class="active"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></svg><small>Accueil</small></span>
                    <span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg><small>Demandes</small></span>
                    <span class="create"><b>+</b></span>
                    <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/><path d="M8 9h8M8 13h5"/></svg><small>Messages</small></span>
                    <span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><small>Profil</small></span>
                </div>
            </div>
        </div>
        <div class="client-app-copy">
            <span>@ClientContent.App.Label</span>
            <h2>@ClientContent.App.Headline</h2>
            <p>@ClientContent.App.Subtitle</p>
            <div class="client-app-benefits">
                @foreach (var benefit in ClientContent.App.Benefits)
                {
                    <span>@benefit</span>
                }
            </div>
            <div class="client-store-actions">
                <a class="client-store-button" href="/telecharger/android" aria-label="Télécharger Wélé sur Google Play">
                    <svg class="client-store-logo google-play-logo" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="#34A853" d="M3 2.7v18.6L13.8 12 3 2.7Z"/>
                        <path fill="#4285F4" d="m3 2.7 13.5 7.8-2.7 1.5L3 2.7Z"/>
                        <path fill="#EA4335" d="M13.8 12 16.5 13.5 3 21.3 13.8 12Z"/>
                        <path fill="#FBBC04" d="m16.5 10.5 4 2.3-4 2.3-2.7-1.6 2.7-3Z"/>
                    </svg>
                    <span><small>Disponible sur</small><strong>Google Play</strong></span>
                </a>
                <span class="client-store-button disabled" aria-label="Wélé sera prochainement disponible sur l’App Store">
                    <svg class="client-store-logo apple-logo" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="currentColor" d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.22-.07 2.07.67 2.79.67.71 0 2.05-.89 3.45-.76 1.18.05 2.25.47 3.14 1.2-2.64 1.58-2.02 5.05.41 6.03-.48 1.26-1.1 2.5-1.79 3.83ZM12.03 7.25c-.15-1.87 1.39-3.41 3.14-3.56.24 2.16-1.96 3.78-3.14 3.56Z"/>
                    </svg>
                    <span><small>Bientôt sur</small><strong>App Store</strong></span>
                </span>
            </div>
            <div class="client-qr-grid">
                <a class="client-qr-card" href="/telecharger/android" aria-label="Télécharger Wélé pour Android">
                    <img src="images/qr-android.svg" alt="QR code de téléchargement Android" width="192" height="192" />
                    <span><small>Scannez avec votre téléphone</small><strong>Application Android</strong><em>Disponible maintenant</em></span>
                </a>
                <div class="client-qr-card is-coming" aria-label="Application Wélé pour iPhone bientôt disponible">
                    <img src="images/qr-ios.svg" alt="QR code Wélé pour iPhone" width="192" height="192" />
                    <span><small>Préparez votre iPhone</small><strong>Application iOS</strong><em>Bientôt disponible</em></span>
                </div>
            </div>
            <p class="client-download-note">Sur ordinateur, scannez le QR code. Sur téléphone, touchez directement le bouton de votre store.</p>
        </div>
    </section>

    <section class="client-section client-pathways">
        <article>
            <span>@ClientContent.Pathways.ProviderHeadline</span>
            <h2>@ClientContent.Pathways.ProviderSubtitle</h2>
            <a href="@ClientContent.Pathways.ProviderCta.Url">@ClientContent.Pathways.ProviderCta.Label <span>→</span></a>
        </article>
        <article>
            <span>@ClientContent.Pathways.CompanyHeadline</span>
            <h2>@ClientContent.Pathways.CompanySubtitle</h2>
            <a href="@ClientContent.Pathways.CompanyCta.Url">@ClientContent.Pathways.CompanyCta.Label <span>→</span></a>
        </article>
    </section>

    <footer class="client-footer" id="aide">
        <div class="client-footer-brand"><img src="images/wele-logo-client.png" alt="Wélé" width="732" height="216" /><p>@ClientContent.Footer.BrandText</p></div>
        @foreach (var column in ClientContent.Footer.Columns)
        {
            <div>
                <strong>@column.Title</strong>
                @foreach (var link in column.Links)
                {
                    <a href="@GetFooterLinkUrl(column.Title, link)">@link</a>
                }
            </div>
        }
        @if (PopularServices.Count > 0)
        {
            <div class="client-footer-popular">
                <strong>Services populaires à Abidjan</strong>
                <div>
                    @foreach (var service in PopularServices)
                    {
                        <a href="@($"/services/{ServiceSeoCatalog.ToSlug(service.Name)}")">@service.Name</a>
                    }
                    <a class="client-footer-all" href="/services">Tous nos services →</a>
                </div>
            </div>
        }
        <div class="client-footer-bottom"><span>@ClientContent.Footer.Copyright</span><span>@ClientContent.Footer.Baseline</span></div>
    </footer>
</div>

@code {
    private static readonly IReadOnlyList<AppointmentSlot> AppointmentSlots = Enumerable
        .Range(0, 20)
        .Select(index => TimeSpan.FromHours(8).Add(TimeSpan.FromMinutes(index * 30)))
        .Select(time => new AppointmentSlot(
            time.ToString(@"hh\:mm"),
            $"{time.ToString(@"hh\:mm")} – {time.Add(TimeSpan.FromMinutes(30)).ToString(@"hh\:mm")}"))
        .ToList();

    private IReadOnlyList<ServiceSummaryResponse> services = [];
    private IReadOnlyList<ServiceSummaryResponse> filteredServices = [];
    private IReadOnlyList<ClientAddressSuggestionResponse> addressSuggestions = [];
    private IReadOnlyList<LandingServiceCard> landingServiceCards = BuildFallbackCards();
    private ClientHomeCmsResponse ClientContent { get; set; } = ClientHomeCmsDefaults.Create();
    private IReadOnlyList<ServiceSummaryResponse> PopularServices => ServiceSeoCatalog.PopularServices(services);
    private string selectedMode = "Instant";
    private string serviceQuery = string.Empty;
    private Guid? selectedServiceId;
    private string interventionAddress = string.Empty;
    private DateTime appointmentDate = DateTime.Today.AddDays(1);
    private string appointmentSlot = "08:00";
    private string? formError;
    private bool isCheckingAvailability;
    private bool mobileMenuOpen;
    private bool showServiceSuggestions;
    private bool showAddressSuggestions;
    private PublicServiceAvailabilityResponse? availability;
    private CancellationTokenSource? addressSearchCancellation;
    private readonly string placesSessionToken = Guid.NewGuid().ToString("N");

    private string MinimumDate => DateTime.Today.ToString("yyyy-MM-dd");
    private string PublicMediaBaseUrl => (Configuration["R2_PUBLIC_BASE_URL"]
        ?? Configuration["Media:PublicBaseUrl"]
        ?? "https://media.wele.africa").TrimEnd('/');
    private string HeroImageUrl => $"{PublicMediaBaseUrl}/website/client/wele-client-hero-v2.webp";
    private string TrustTeamImageUrl => $"{PublicMediaBaseUrl}/website/client/wele-trust-team-v2.webp";

    private string ResolveContentUrl(string? value, string fallbackUrl)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallbackUrl;
        }

        // Les contenus CMS historiques pointent encore vers les premières clés R2.
        // Les normaliser ici évite que Cloudflare resserve l'ancienne identité bleue.
        if (value.Contains("website/client/wele-client-hero", StringComparison.OrdinalIgnoreCase))
        {
            return HeroImageUrl;
        }

        if (value.Contains("website/client/wele-trust-team", StringComparison.OrdinalIgnoreCase))
        {
            return TrustTeamImageUrl;
        }

        if (Uri.TryCreate(value, UriKind.Absolute, out var absoluteUri))
        {
            return absoluteUri.ToString();
        }

        return value.StartsWith("/api/", StringComparison.OrdinalIgnoreCase)
            ? ApiClient.ToApiUrl(value)
            : ResolvePublicMediaUrl(value);
    }

    private string ResolvePublicMediaUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        if (value.StartsWith("/images/", StringComparison.OrdinalIgnoreCase))
        {
            return value;
        }

        if (value.StartsWith("images/", StringComparison.OrdinalIgnoreCase))
        {
            return $"/{value}";
        }

        if (Uri.TryCreate(value, UriKind.Absolute, out var absolute)
            && (absolute.Scheme == Uri.UriSchemeHttp || absolute.Scheme == Uri.UriSchemeHttps))
        {
            return absolute.ToString();
        }

        return $"{PublicMediaBaseUrl}/{value.TrimStart('/')}";
    }

    private static string WithAssetVersion(string url, string version) =>
        $"{url}{(url.Contains('?', StringComparison.Ordinal) ? '&' : '?')}v={Uri.EscapeDataString(version)}";

    protected override async Task OnInitializedAsync()
    {
        var contentTask = ApiClient.GetClientHomeContentAsync();
        var servicesTask = ApiClient.GetServicesAsync();
        await Task.WhenAll(contentTask, servicesTask);

        ClientContent = await contentTask ?? ClientHomeCmsDefaults.Create();
        services = (await servicesTask)
            .Where(service => service.IsActive)
            .OrderBy(service => service.Name)
            .ToList();
        filteredServices = services.Take(8).ToList();
        landingServiceCards = BuildLandingCards(services);
    }

    private static string GetListItem(IReadOnlyList<string> items, int index, string fallback)
        => index >= 0 && index < items.Count && !string.IsNullOrWhiteSpace(items[index]) ? items[index] : fallback;

    private static string GetFooterLinkUrl(string columnTitle, string link)
    {
        if (link.Contains('@', StringComparison.Ordinal))
        {
            return $"mailto:{link}";
        }

        if (columnTitle.Contains("Rejoindre", StringComparison.OrdinalIgnoreCase))
        {
            return link.Contains("entreprise", StringComparison.OrdinalIgnoreCase)
                ? "https://entreprise.wele.africa"
                : "https://pro.wele.africa";
        }

        return columnTitle.Contains("Service", StringComparison.OrdinalIgnoreCase) ? "/services" : "#a-propos";
    }

    private void ToggleMenu() => mobileMenuOpen = !mobileMenuOpen;
    private void CloseMenu() => mobileMenuOpen = false;

    private void SelectInstant()
    {
        selectedMode = "Instant";
        availability = null;
    }

    private void SelectScheduled()
    {
        selectedMode = "Scheduled";
        availability = null;
    }

    private void SelectLandingService(Guid? serviceId)
    {
        if (serviceId.HasValue)
        {
            var service = services.FirstOrDefault(item => item.Id == serviceId.Value);
            if (service is not null)
            {
                SelectService(service);
            }
        }
    }

    private void HandleServiceInput(ChangeEventArgs args)
    {
        serviceQuery = args.Value?.ToString()?.TrimStart() ?? string.Empty;
        selectedServiceId = null;
        availability = null;
        var normalizedQuery = Normalize(serviceQuery);
        filteredServices = services
            .Where(service => string.IsNullOrWhiteSpace(normalizedQuery)
                || Normalize(service.Name).Contains(normalizedQuery, StringComparison.Ordinal)
                || service.Prestations.Any(prestation => Normalize(prestation.Name).Contains(normalizedQuery, StringComparison.Ordinal)))
            .Take(8)
            .ToList();
        showServiceSuggestions = true;
    }

    private void ShowServiceSuggestions()
    {
        filteredServices = string.IsNullOrWhiteSpace(serviceQuery)
            ? services.Take(8).ToList()
            : filteredServices;
        showServiceSuggestions = true;
    }

    private void SelectService(ServiceSummaryResponse service)
    {
        selectedServiceId = service.Id;
        serviceQuery = service.Name;
        filteredServices = [];
        showServiceSuggestions = false;
        availability = null;
    }

    private async Task HandleAddressInput(ChangeEventArgs args)
    {
        interventionAddress = args.Value?.ToString()?.TrimStart() ?? string.Empty;
        availability = null;
        addressSearchCancellation?.Cancel();
        addressSearchCancellation?.Dispose();
        addressSearchCancellation = new CancellationTokenSource();
        if (interventionAddress.Trim().Length < 3)
        {
            addressSuggestions = [];
            showAddressSuggestions = false;
            return;
        }

        var cancellationToken = addressSearchCancellation.Token;
        try
        {
            await Task.Delay(260, cancellationToken);
            addressSuggestions = await ApiClient.SearchAddressesAsync(
                interventionAddress.Trim(),
                placesSessionToken,
                cancellationToken);
            showAddressSuggestions = addressSuggestions.Count > 0;
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void ShowAddressSuggestions() => showAddressSuggestions = addressSuggestions.Count > 0;

    private async Task SelectAddressAsync(ClientAddressSuggestionResponse suggestion)
    {
        var details = await ApiClient.GetPlaceDetailsAsync(suggestion.PlaceId, placesSessionToken);
        interventionAddress = details?.AddressLine ?? suggestion.FullText;
        addressSuggestions = [];
        showAddressSuggestions = false;
        availability = null;
    }

    private async Task CheckAvailabilityAsync()
    {
        formError = null;
        availability = null;
        if (!selectedServiceId.HasValue)
        {
            formError = "Choisissez d’abord un service.";
            return;
        }

        if (string.IsNullOrWhiteSpace(interventionAddress))
        {
            formError = "Indiquez l’adresse de l’intervention.";
            return;
        }

        DateTimeOffset? scheduledFor = null;
        if (selectedMode == "Scheduled")
        {
            var time = TimeSpan.Parse(appointmentSlot);
            var localDate = DateTime.SpecifyKind(appointmentDate.Date.Add(time), DateTimeKind.Unspecified);
            scheduledFor = new DateTimeOffset(localDate, TimeSpan.Zero);
            if (scheduledFor <= DateTimeOffset.UtcNow.AddMinutes(15))
            {
                formError = "Choisissez un créneau situé au moins 15 minutes dans le futur.";
                return;
            }
        }

        isCheckingAvailability = true;
        try
        {
            var result = await ApiClient.CheckAvailabilityAsync(new PublicServiceAvailabilityRequest(
                selectedServiceId.Value,
                interventionAddress.Trim(),
                selectedMode,
                scheduledFor));
            if (result.IsSuccess)
            {
                availability = result.Value;
            }
            else
            {
                formError = result.ErrorMessage;
            }
        }
        finally
        {
            isCheckingAvailability = false;
        }
    }

    private static IReadOnlyList<LandingServiceCard> BuildLandingCards(IReadOnlyList<ServiceSummaryResponse> catalog)
    {
        if (catalog.Count == 0)
        {
            return BuildFallbackCards();
        }

        var used = new HashSet<Guid>();
        return new[]
        {
            FindCard(catalog, used, "Ménage", "Un intérieur propre et soigné, ponctuellement ou régulièrement.", "MN", "tone-home", "/images/services/menage-balai-v2.webp", "menage"),
            FindCard(catalog, used, "Blanchisserie", "Lavage, séchage et soin de votre linge, sans contrainte.", "BL", "tone-home", "/assets/services/blanchisserie.png", "blanch", "repass", "linge"),
            FindCard(catalog, used, "Climatisation", "Entretien, diagnostic et remise en service de votre climatisation.", "CL", "tone-cold", "/images/services/climatisation-premium-v2.webp", "clim"),
            FindCard(catalog, used, "Beauté à domicile", "Coiffure et soins réalisés chez vous, sur rendez-vous.", "BT", "tone-beauty", "/assets/services/coiffure.png", "coiff", "esthet", "beaute")
        };
    }

    private static LandingServiceCard FindCard(
        IReadOnlyList<ServiceSummaryResponse> catalog,
        ISet<Guid> used,
        string title,
        string description,
        string shortLabel,
        string tone,
        string fallbackImageUrl,
        params string[] keywords)
    {
        var match = catalog.FirstOrDefault(service =>
            !used.Contains(service.Id)
            && keywords.Any(keyword => Normalize(service.Name).Contains(keyword, StringComparison.Ordinal)));
        if (match is not null)
        {
            used.Add(match.Id);
        }

        return new LandingServiceCard(
            title,
            description,
            shortLabel,
            tone,
            match?.Id,
            fallbackImageUrl,
            match is null ? null : ServiceSeoCatalog.ToSlug(match.Name));
    }

    private static IReadOnlyList<LandingServiceCard> BuildFallbackCards() =>
    [
        new("Ménage", "Un intérieur propre et soigné, ponctuellement ou régulièrement.", "MN", "tone-home", null, "/images/services/menage-balai-v2.webp", null),
        new("Blanchisserie", "Lavage, séchage et soin de votre linge, sans contrainte.", "BL", "tone-home", null, "/assets/services/blanchisserie.png", null),
        new("Climatisation", "Entretien, diagnostic et remise en service de votre climatisation.", "CL", "tone-cold", null, "/images/services/climatisation-premium-v2.webp", null),
        new("Beauté à domicile", "Coiffure et soins réalisés chez vous, sur rendez-vous.", "BT", "tone-beauty", null, "/assets/services/coiffure.png", null)
    ];

    private static string Normalize(string value) => string.Concat(value
        .ToLowerInvariant()
        .Normalize(System.Text.NormalizationForm.FormD)
        .Where(character => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(character) != System.Globalization.UnicodeCategory.NonSpacingMark));

    private static string GetInitials(string value) => string.Concat(value
        .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    private static string GetServiceDetail(ServiceSummaryResponse service) => service.Prestations.Count switch
    {
        0 => "Service Wélé",
        1 => service.Prestations[0].Name,
        _ => $"{service.Prestations.Count} prestations disponibles"
    };

    public void Dispose()
    {
        addressSearchCancellation?.Cancel();
        addressSearchCancellation?.Dispose();
    }

