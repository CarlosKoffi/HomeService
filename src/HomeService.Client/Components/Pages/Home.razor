    <footer class="client-footer" id="aide">
        <div class="client-footer-brand"><img src="images/wele-logo-dark.png" alt="Wélé" width="710" height="288" /><p>Le bon service, au bon moment.</p></div>
        <div><strong>Services</strong><a href="#services">Maison</a><a href="#services">Bien-être</a><a href="#services">Dépannage</a></div>
