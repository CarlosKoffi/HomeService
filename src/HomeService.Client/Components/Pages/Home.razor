@code {
    private static readonly IReadOnlyList<AppointmentSlot> AppointmentSlots = Enumerable
        .Range(0, 20)
        .Select(index => TimeSpan.FromHours(8).Add(TimeSpan.FromMinutes(index * 30)))
        .Select(time => new AppointmentSlot(
            time.ToString(@"hh\:mm"),
            $"{time.ToString(@"hh\:mm")} – {time.Add(TimeSpan.FromMinutes(30)).ToString(@"hh\:mm")}"))
        .ToList();

    private IReadOnlyList<ServiceSummaryResponse> services = [];
    private IReadOnlyList<ServiceSummaryResponse> filteredServices = [];
    private IReadOnlyList<ClientAddressSuggestionResponse> addressSuggestions = [];
    private IReadOnlyList<LandingServiceCard> landingServiceCards = BuildFallbackCards();
    private string selectedMode = "Instant";
    private string serviceQuery = string.Empty;
    private Guid? selectedServiceId;
    private string interventionAddress = string.Empty;
    private DateTime appointmentDate = DateTime.Today.AddDays(1);
    private string appointmentSlot = "08:00";
    private string? formError;
    private bool isCheckingAvailability;
    private bool mobileMenuOpen;
    private bool showServiceSuggestions;
    private bool showAddressSuggestions;
    private PublicServiceAvailabilityResponse? availability;
    private CancellationTokenSource? addressSearchCancellation;
    private readonly string placesSessionToken = Guid.NewGuid().ToString("N");

    private string MinimumDate => DateTime.Today.ToString("yyyy-MM-dd");
    private string PublicMediaBaseUrl => (Configuration["R2_PUBLIC_BASE_URL"]
        ?? Configuration["Media:PublicBaseUrl"]
        ?? "https://media.wele.africa").TrimEnd('/');
    private string HeroImageUrl => $"{PublicMediaBaseUrl}/website/client/wele-client-hero.png";
    private string TrustTeamImageUrl => $"{PublicMediaBaseUrl}/website/client/wele-trust-team.png";

    private string ResolvePublicMediaUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        if (Uri.TryCreate(value, UriKind.Absolute, out var absolute)
            && (absolute.Scheme == Uri.UriSchemeHttp || absolute.Scheme == Uri.UriSchemeHttps))
        {
            return absolute.ToString();
        }

        return $"{PublicMediaBaseUrl}/{value.TrimStart('/')}";
    }

    protected override async Task OnInitializedAsync()
    {
        services = (await ApiClient.GetServicesAsync())
            .Where(service => service.IsActive)
            .OrderBy(service => service.Name)
            .ToList();
        filteredServices = services.Take(8).ToList();
        landingServiceCards = BuildLandingCards(services);
    }

    private void ToggleMenu() => mobileMenuOpen = !mobileMenuOpen;
    private void CloseMenu() => mobileMenuOpen = false;

    private void SelectInstant()
    {
        selectedMode = "Instant";
        availability = null;
    }

    private void SelectScheduled()
    {
        selectedMode = "Scheduled";
        availability = null;
    }

    private void SelectLandingService(Guid? serviceId)
    {
        if (serviceId.HasValue)
        {
            var service = services.FirstOrDefault(item => item.Id == serviceId.Value);
            if (service is not null)
            {
                SelectService(service);
            }
        }
    }

    private void HandleServiceInput(ChangeEventArgs args)
    {
        serviceQuery = args.Value?.ToString()?.TrimStart() ?? string.Empty;
        selectedServiceId = null;
        availability = null;
        var normalizedQuery = Normalize(serviceQuery);
        filteredServices = services
            .Where(service => string.IsNullOrWhiteSpace(normalizedQuery)
                || Normalize(service.Name).Contains(normalizedQuery, StringComparison.Ordinal)
                || service.Prestations.Any(prestation => Normalize(prestation.Name).Contains(normalizedQuery, StringComparison.Ordinal)))
            .Take(8)
            .ToList();
        showServiceSuggestions = true;
    }

    private void ShowServiceSuggestions()
    {
        filteredServices = string.IsNullOrWhiteSpace(serviceQuery)
            ? services.Take(8).ToList()
            : filteredServices;
        showServiceSuggestions = true;
    }

    private void SelectService(ServiceSummaryResponse service)
    {
        selectedServiceId = service.Id;
        serviceQuery = service.Name;
        filteredServices = [];
        showServiceSuggestions = false;
        availability = null;
    }

    private async Task HandleAddressInput(ChangeEventArgs args)
    {
        interventionAddress = args.Value?.ToString()?.TrimStart() ?? string.Empty;
        availability = null;
        addressSearchCancellation?.Cancel();
        addressSearchCancellation?.Dispose();
        addressSearchCancellation = new CancellationTokenSource();
        if (interventionAddress.Trim().Length < 3)
        {
            addressSuggestions = [];
            showAddressSuggestions = false;
            return;
        }

        var cancellationToken = addressSearchCancellation.Token;
        try
        {
            await Task.Delay(260, cancellationToken);
            addressSuggestions = await ApiClient.SearchAddressesAsync(
                interventionAddress.Trim(),
                placesSessionToken,
                cancellationToken);
            showAddressSuggestions = addressSuggestions.Count > 0;
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void ShowAddressSuggestions() => showAddressSuggestions = addressSuggestions.Count > 0;

    private async Task SelectAddressAsync(ClientAddressSuggestionResponse suggestion)
    {
        var details = await ApiClient.GetPlaceDetailsAsync(suggestion.PlaceId, placesSessionToken);
        interventionAddress = details?.AddressLine ?? suggestion.FullText;
        addressSuggestions = [];
        showAddressSuggestions = false;
        availability = null;
    }

    private async Task CheckAvailabilityAsync()
    {
        formError = null;
        availability = null;
        if (!selectedServiceId.HasValue)
        {
            formError = "Choisissez d’abord un service.";
            return;
        }

        if (string.IsNullOrWhiteSpace(interventionAddress))
        {
            formError = "Indiquez l’adresse de l’intervention.";
            return;
        }

        DateTimeOffset? scheduledFor = null;
        if (selectedMode == "Scheduled")
        {
            var time = TimeSpan.Parse(appointmentSlot);
            var localDate = DateTime.SpecifyKind(appointmentDate.Date.Add(time), DateTimeKind.Unspecified);
            scheduledFor = new DateTimeOffset(localDate, TimeSpan.Zero);
            if (scheduledFor <= DateTimeOffset.UtcNow.AddMinutes(15))
            {
                formError = "Choisissez un créneau situé au moins 15 minutes dans le futur.";
                return;
            }
        }

        isCheckingAvailability = true;
        try
        {
            var result = await ApiClient.CheckAvailabilityAsync(new PublicServiceAvailabilityRequest(
                selectedServiceId.Value,
                interventionAddress.Trim(),
                selectedMode,
                scheduledFor));
            if (result.IsSuccess)
            {
                availability = result.Value;
            }
            else
            {
                formError = result.ErrorMessage;
            }
        }
        finally
        {
            isCheckingAvailability = false;
        }
    }

    private static IReadOnlyList<LandingServiceCard> BuildLandingCards(IReadOnlyList<ServiceSummaryResponse> catalog)
    {
        if (catalog.Count == 0)
        {
            return BuildFallbackCards();
        }

        var used = new HashSet<Guid>();
        return new[]
        {
            FindCard(catalog, used, "Ménage & repassage", "Un intérieur impeccable, ponctuellement ou régulièrement.", "MR", "tone-home", "/assets/services/blanchisserie.png", "menage", "blanch", "repass"),
            FindCard(catalog, used, "Climatisation", "Entretien, diagnostic et remise en service de votre climatisation.", "CL", "tone-cold", "/assets/services/climatisation.png", "clim"),
            FindCard(catalog, used, "Beauté à domicile", "Coiffure et soins réalisés chez vous, sur rendez-vous.", "BT", "tone-beauty", "/assets/services/coiffure.png", "coiff", "esthet", "beaute"),
            FindCard(catalog, used, "Dépannage auto", "Une aide professionnelle quand votre véhicule vous immobilise.", "DA", "tone-auto", "/assets/services/depannage-auto.png", "depannage auto", "auto")
        };
    }

    private static LandingServiceCard FindCard(
        IReadOnlyList<ServiceSummaryResponse> catalog,
        ISet<Guid> used,
        string title,
        string description,
        string shortLabel,
        string tone,
        string fallbackImageUrl,
        params string[] keywords)
    {
        var match = catalog.FirstOrDefault(service =>
            !used.Contains(service.Id)
            && keywords.Any(keyword => Normalize(service.Name).Contains(keyword, StringComparison.Ordinal)));
        if (match is not null)
        {
            used.Add(match.Id);
        }

        return new LandingServiceCard(
            title,
            description,
            shortLabel,
            tone,
            match?.Id,
            match?.ImageUrl ?? match?.IconUrl ?? fallbackImageUrl);
    }

    private static IReadOnlyList<LandingServiceCard> BuildFallbackCards() =>
    [
        new("Ménage & repassage", "Un intérieur impeccable, ponctuellement ou régulièrement.", "MR", "tone-home", null, "/assets/services/blanchisserie.png"),
        new("Climatisation", "Entretien, diagnostic et remise en service de votre climatisation.", "CL", "tone-cold", null, "/assets/services/climatisation.png"),
        new("Beauté à domicile", "Coiffure et soins réalisés chez vous, sur rendez-vous.", "BT", "tone-beauty", null, "/assets/services/coiffure.png"),
        new("Dépannage auto", "Une aide professionnelle quand votre véhicule vous immobilise.", "DA", "tone-auto", null, "/assets/services/depannage-auto.png")
    ];

    private static string Normalize(string value) => string.Concat(value
        .ToLowerInvariant()
        .Normalize(System.Text.NormalizationForm.FormD)
        .Where(character => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(character) != System.Globalization.UnicodeCategory.NonSpacingMark));

    private static string GetInitials(string value) => string.Concat(value
        .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    private static string GetServiceDetail(ServiceSummaryResponse service) => service.Prestations.Count switch
    {
        0 => "Service Wélé",
        1 => service.Prestations[0].Name,
        _ => $"{service.Prestations.Count} prestations disponibles"
    };

    public void Dispose()
    {
        addressSearchCancellation?.Cancel();
        addressSearchCancellation?.Dispose();
    }

    private sealed record AppointmentSlot(string Value, string Label);
    private sealed record LandingServiceCard(
        string Title,
        string Description,
        string ShortLabel,
        string Tone,
        Guid? ServiceId,
        string? ImageUrl);
}
