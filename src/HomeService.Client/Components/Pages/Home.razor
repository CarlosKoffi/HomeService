@page "/"
@implements IDisposable
@using HomeService.Client.Services
@using HomeService.Contracts.Clients
@using HomeService.Contracts.Services
@inject PublicWebsiteApiClient ApiClient
@inject IConfiguration Configuration

<PageTitle>Wélé — Le bon service, au bon moment</PageTitle>

<div class="client-site @(mobileMenuOpen ? "menu-is-open" : string.Empty)">
    <header class="client-header">
        <a class="client-brand" href="#accueil" aria-label="Accueil Wélé" @onclick="CloseMenu">
            <img src="images/wele-logo-dark.png" alt="Wélé" width="710" height="288" />
        </a>

        <button class="client-menu-button" type="button" aria-label="Ouvrir le menu" aria-expanded="@mobileMenuOpen" @onclick="ToggleMenu">
            <span></span><span></span><span></span>
        </button>

        <nav class="client-navigation @(mobileMenuOpen ? "is-open" : string.Empty)" aria-label="Navigation principale">
            <div class="client-nav-main">
                <a href="#services" @onclick="CloseMenu">Services</a>
                <a href="https://pro.wele.africa">Devenir prestataire</a>
                <a href="https://entreprise.wele.africa">Pour les entreprises</a>
                <a href="#a-propos" @onclick="CloseMenu">À propos</a>
            </div>
            <div class="client-nav-actions">
                <span class="client-locale">CI · FR</span>
                <a href="#aide" @onclick="CloseMenu">Aide</a>
                <a href="#telecharger" @onclick="CloseMenu">Connexion</a>
                <a class="client-nav-cta" href="#telecharger" @onclick="CloseMenu">S’inscrire</a>
            </div>
        </nav>
    </header>

    <section class="client-hero" id="accueil">
        <div class="client-hero-copy">
            <span class="client-location">● Abidjan, Côte d’Ivoire</span>
            <h1>Le bon service,<br />au bon moment.</h1>
            <p>Des professionnels vérifiés pour votre maison, votre bien-être et votre quotidien.</p>
            <div class="client-hero-actions">
                <a class="client-button client-button-blue" href="#commander">Commander un service</a>
                <a class="client-text-link" href="#services">Découvrir Wélé <span>→</span></a>
            </div>
        </div>
        <div class="client-hero-media">
            <img src="@HeroImageUrl" alt="Une cliente accueille une professionnelle Wélé à Abidjan" width="1672" height="941" fetchpriority="high" decoding="async" onerror="this.onerror=null;this.src='images/wele-client-hero.png'" />
            <div class="client-verified-chip"><span>✓</span> Professionnelle vérifiée</div>
        </div>
    </section>

    <section class="client-booking-wrap" id="commander" aria-labelledby="booking-title">
        <div class="client-booking-card">
            <div class="client-booking-tabs" role="group" aria-label="Choisir le moment de l’intervention">
                <button type="button" class="@(selectedMode == "Instant" ? "active" : string.Empty)" @onclick="SelectInstant">Dès que possible</button>
                <button type="button" class="@(selectedMode == "Scheduled" ? "active" : string.Empty)" @onclick="SelectScheduled">Sur rendez-vous</button>
            </div>

            <h2 id="booking-title" class="visually-hidden">Vérifier la disponibilité d’un service</h2>
            <div class="client-booking-fields">
                <label>
                    <span>Service</span>
                    <input type="search"
                           value="@serviceQuery"
                           @oninput="HandleServiceInput"
                           @onfocus="ShowServiceSuggestions"
                           placeholder="Quel service recherchez-vous ?"
                           autocomplete="off"
                           aria-autocomplete="list"
                           aria-controls="service-suggestions" />
                    @if (showServiceSuggestions && filteredServices.Count > 0)
                    {
                        <div class="client-suggestion-list" id="service-suggestions" role="listbox">
                            @foreach (var service in filteredServices)
                            {
                                <button type="button" role="option" @onclick="() => SelectService(service)">
                                    <span class="client-suggestion-mark">@GetInitials(service.Name)</span>
                                    <span><strong>@service.Name</strong><small>@GetServiceDetail(service)</small></span>
                                </button>
                            }
                        </div>
                    }
                </label>
                <label class="client-address-field">
                    <span>Adresse</span>
                    <input type="search"
                           value="@interventionAddress"
                           @oninput="HandleAddressInput"
                           @onfocus="ShowAddressSuggestions"
                           placeholder="Où intervenir ?"
                           autocomplete="off"
                           aria-autocomplete="list"
                           aria-controls="address-suggestions" />
                    @if (showAddressSuggestions && addressSuggestions.Count > 0)
                    {
                        <div class="client-suggestion-list client-address-suggestions" id="address-suggestions" role="listbox">
                            @foreach (var suggestion in addressSuggestions)
                            {
                                <button type="button" role="option" @onclick="() => SelectAddressAsync(suggestion)">
                                    <span class="client-pin-mark">⌖</span>
                                    <span><strong>@suggestion.MainText</strong><small>@suggestion.SecondaryText</small></span>
                                </button>
                            }
                            <small class="client-google-attribution">Adresses proposées par Google</small>
                        </div>
                    }
                </label>
                @if (selectedMode == "Scheduled")
                {
                    <label class="client-date-field">
                        <span>Date</span>
                        <input type="date" @bind="appointmentDate" min="@MinimumDate" />
                    </label>
                    <label class="client-slot-field">
                        <span>Créneau d’arrivée</span>
                        <select @bind="appointmentSlot">
                            @foreach (var slot in AppointmentSlots)
                            {
                                <option value="@slot.Value">@slot.Label</option>
                            }
                        </select>
                    </label>
                }
                <button class="client-button client-button-black client-check-button" type="button" disabled="@isCheckingAvailability" @onclick="CheckAvailabilityAsync">
                    @(isCheckingAvailability ? "Vérification…" : "Voir les disponibilités")
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <p class="client-form-error" role="alert">@formError</p>
            }

            @if (availability is not null)
            {
                <div class="client-availability-result @(availability.HasMatchingProfessionals ? "is-positive" : "is-searching")" role="status">
                    <span class="client-result-icon">@(availability.HasMatchingProfessionals ? "✓" : "↗")</span>
                    <div>
                        <strong>@availability.Headline</strong>
                        <p>@availability.Message</p>
                    </div>
                    <a class="client-button client-button-blue" href="#telecharger">Continuer dans l’application</a>
                </div>
            }
        </div>

        <div class="client-trust-strip" aria-label="Engagements Wélé">
            <span>
                <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 20 6v5c0 5.1-3.4 8.5-8 10-4.6-1.5-8-4.9-8-10V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></i>
                <strong>Professionnels vérifiés et notés</strong>
            </span>
            <span>
                <i aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="3"/><path d="M8 10V8a4 4 0 0 1 8 0v2"/><path d="M12 14v2"/></svg></i>
                <strong>Paiement sécurisé</strong>
            </span>
            <span>
                <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z"/><circle cx="12" cy="10" r="2"/><path d="M3 12H1m22 0h-2"/></svg></i>
                <strong>Service suivi en direct</strong>
            </span>
            <span>
                <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><path d="M4 14h3v5H5a2 2 0 0 1-2-2v-1a2 2 0 0 1 1-2Zm16 0h-3v5h2a2 2 0 0 0 2-2v-1a2 2 0 0 0-1-2Z"/><path d="M17 19c-.8 1.3-2.5 2-5 2"/></svg></i>
                <strong>Assistance réactive</strong>
            </span>
        </div>
    </section>

    <section class="client-section client-services-section" id="services">
        <div class="client-section-heading">
            <span>Les essentiels Wélé</span>
            <h2>Tout ce que Wélé peut faire pour vous.</h2>
            <p>Choisissez un univers, puis retrouvez les prestations réellement disponibles dans votre zone.</p>
        </div>

        <div class="client-service-grid">
            @foreach (var card in landingServiceCards)
            {
                <article class="client-service-card">
                    @if (!string.IsNullOrWhiteSpace(card.ImageUrl))
                    {
                        <img src="@ResolvePublicMediaUrl(card.ImageUrl)" alt="@card.Title" loading="lazy" decoding="async" />
                    }
                    else
                    {
                        <div class="client-service-placeholder @card.Tone"><span>@card.ShortLabel</span></div>
                    }
                    <div>
                        <h3>@card.Title</h3>
                        <p>@card.Description</p>
                        <a href="#commander" @onclick="() => SelectLandingService(card.ServiceId)">Découvrir <span>→</span></a>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="client-section client-steps-section" id="fonctionnement">
        <div class="client-section-heading compact">
            <span>Simple du début à la fin</span>
            <h2>Commandez en toute confiance.</h2>
        </div>
        <div class="client-steps-grid">
            <article><span>01</span><h3>Choisissez votre service</h3><p>Décrivez votre besoin, ajoutez l’adresse et choisissez maintenant ou sur rendez-vous.</p></article>
            <article><span>02</span><h3>Un professionnel vérifié accepte</h3><p>Nous cherchons l’entreprise et le professionnel compatibles avec votre demande.</p></article>
            <article><span>03</span><h3>Suivez, payez et évaluez</h3><p>Recevez les étapes importantes, payez au bon moment et partagez votre avis.</p></article>
        </div>
    </section>

    <section class="client-section client-confidence-section" id="a-propos">
        <div class="client-confidence-copy">
            <span>La confiance n’est pas une option</span>
            <h2>Votre quotidien mérite des professionnels fiables.</h2>
            <p>Identités vérifiées, compétences validées, avis clients, paiement sécurisé et assistance réactive : Wélé encadre chaque étape utile.</p>
            <ul>
                <li><b>Professionnels contrôlés</b><small>Les profils et pièces nécessaires sont vérifiés.</small></li>
                <li><b>Vos informations protégées</b><small>Les coordonnées utiles sont masquées après la mission.</small></li>
                <li><b>Une équipe à vos côtés</b><small>Un litige ou un imprévu peut être analysé par Wélé.</small></li>
            </ul>
            <a class="client-button client-button-blue" href="#telecharger">Découvrir l’application</a>
        </div>
        <div class="client-confidence-media">
            <img src="@TrustTeamImageUrl" alt="Une professionnelle et un professionnel Wélé" width="972" height="1619" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='images/wele-trust-team.png'" />
            <div class="client-rating-card"><strong>4,8/5</strong><span>★★★★★</span><small>Avis après intervention</small></div>
        </div>
    </section>

    <section class="client-section client-repeat-section">
        <div>
            <span>Votre historique devient utile</span>
            <h2>Un service vous a plu ?</h2>
            <p>Retrouvez votre entreprise favorite et relancez une demande en quelques secondes. Si elle est indisponible, Wélé continue la recherche pour vous.</p>
            <a class="client-button client-button-black" href="#telecharger">Commander à nouveau</a>
        </div>
        <div class="client-repeat-card">
            <img class="client-repeat-avatar" src="images/awa-kouame-profile.webp" alt="Portrait d’Awa Kouamé" width="384" height="384" loading="lazy" decoding="async" />
            <div><strong>Awa Kouamé</strong><small>Ménage & repassage · 4,9 ★</small></div>
            <span class="client-repeat-verified">Vérifiée</span>
        </div>
    </section>

    <section class="client-app-section" id="telecharger">
        <div class="client-phone-stage" aria-label="Aperçu de l’application Wélé">
            <div class="client-phone-shell">
                <div class="client-phone-top"><strong>wélé</strong><span>●</span></div>
                <p>Bonjour Aïcha 👋</p>
                <h3>Que recherchez-vous aujourd’hui ?</h3>
                <div class="client-phone-search">⌕ Rechercher un service</div>
                <small>Pour ma maison</small>
                <div class="client-phone-services">
