<!DOCTYPE html>
@inject IConfiguration Configuration

<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:locale" content="fr_CI" />
    <meta property="og:site_name" content="Wélé" />
    <link rel="preconnect" href="https://media.wele.africa" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["HomeService.Client.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    @if (!string.IsNullOrWhiteSpace(GoogleAnalyticsMeasurementId))
    {
        <meta name="wele-google-analytics-id" content="@GoogleAnalyticsMeasurementId" />
        <script src="@Assets["analytics.js"]"></script>
    }
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    private string GoogleAnalyticsMeasurementId =>
        Configuration["Analytics:GoogleMeasurementId"]
        ?? Configuration["GOOGLE_ANALYTICS_MEASUREMENT_ID"]
        ?? string.Empty;
}
