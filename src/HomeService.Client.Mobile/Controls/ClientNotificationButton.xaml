<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="HomeService.Client.Mobile.Controls.ClientNotificationButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HeightRequest="48"
    WidthRequest="48"
    HorizontalOptions="End"
    VerticalOptions="Center">
    <Grid HeightRequest="48" WidthRequest="48">
        <ImageButton
            Source="app_bell.svg"
            HeightRequest="40"
            WidthRequest="40"
            Padding="8"
            BackgroundColor="Transparent"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            AutomationId="NotificationsButton"
            Clicked="OnClicked" />
        <Border
            x:Name="UnreadBadge"
            IsVisible="False"
            BackgroundColor="#2166F3"
            StrokeThickness="0"
            HeightRequest="20"
            MinimumWidthRequest="20"
            Padding="4,0"
            HorizontalOptions="End"
            VerticalOptions="Start">
            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
            <Label x:Name="UnreadBadgeLabel" TextColor="White" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
        </Border>
    </Grid>
</ContentView>
