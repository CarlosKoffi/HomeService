<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="HomeService.Client.Mobile.Controls.WeleBrandMark"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="BrandView">
    <Image
        Source="https://media.wele.africa/website/client/wele-logo-horizontal.png"
        Aspect="AspectFit"
        HeightRequest="{Binding MarkHeight, Source={x:Reference BrandView}}"
        HorizontalOptions="{Binding MarkAlignment, Source={x:Reference BrandView}}" />
</ContentView>
