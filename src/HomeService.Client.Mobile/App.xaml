<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="HomeService.Client.Mobile.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <Color x:Key="Ink">#111827</Color>
        <Color x:Key="MutedInk">#6B7280</Color>
        <Color x:Key="WeleBlue">#2563EB</Color>
        <Color x:Key="WeleBlueDark">#0F172A</Color>
        <Color x:Key="Success">#059669</Color>
        <Color x:Key="Warning">#F97316</Color>
        <Color x:Key="Danger">#DC2626</Color>
        <Color x:Key="Line">#E5E7EB</Color>
        <Color x:Key="PageWash">#F8FAFC</Color>
        <Color x:Key="CardWash">#FFFFFF</Color>

        <Style TargetType="ContentPage">
            <Setter Property="BackgroundColor" Value="{StaticResource PageWash}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
        </Style>
        <Style x:Key="EyebrowLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.2" />
            <Setter Property="TextColor" Value="{StaticResource WeleBlue}" />
        </Style>
        <Style x:Key="ScreenTitleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="LineHeight" Value="1.05" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="CardTitleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="BodyLabel" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="1.25" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="MutedLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="1.25" />
            <Setter Property="TextColor" Value="{StaticResource MutedInk}" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource MutedInk}" />
            <Setter Property="MinimumHeightRequest" Value="46" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="23" />
            <Setter Property="MinimumHeightRequest" Value="48" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BackgroundColor" Value="{StaticResource WeleBlue}" />
            <Setter Property="TextColor" Value="White" />
        </Style>
    </Application.Resources>
</Application>
