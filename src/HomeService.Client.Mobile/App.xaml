<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="HomeService.Client.Mobile.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <Color x:Key="Ink">#111827</Color>
        <Color x:Key="MutedInk">#6B7280</Color>
        <Color x:Key="WeleBlue">#155EEF</Color>
        <Color x:Key="WeleBlueDark">#0F172A</Color>
        <Color x:Key="Success">#059669</Color>
        <Color x:Key="Warning">#F97316</Color>
        <Color x:Key="Danger">#DC2626</Color>
        <Color x:Key="Line">#E5E7EB</Color>
        <Color x:Key="PremiumLine">#DCE8FF</Color>
        <Color x:Key="BlueWash">#EEF4FF</Color>
        <Color x:Key="ListSecondary">#365F99</Color>
        <Color x:Key="PageWash">#FFFFFF</Color>
        <Color x:Key="CardWash">#FFFFFF</Color>

        <Style TargetType="ContentPage">
            <Setter Property="BackgroundColor" Value="{StaticResource PageWash}" />
        </Style>
        <Style TargetType="Shell">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="ForegroundColor" Value="{StaticResource Ink}" />
            <Setter Property="TabBarBackgroundColor" Value="White" />
            <Setter Property="TabBarForegroundColor" Value="{StaticResource WeleBlue}" />
            <Setter Property="TabBarUnselectedColor" Value="{StaticResource MutedInk}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="PlusJakartaSans" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="EyebrowLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.2" />
            <Setter Property="TextColor" Value="{StaticResource WeleBlue}" />
        </Style>
        <Style x:Key="ScreenTitleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="LineHeight" Value="1.05" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="SubpageTitleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="BackIconButton" TargetType="Button">
            <Setter Property="Text" Value="&#x2039;" />
            <Setter Property="FontSize" Value="27" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="WidthRequest" Value="32" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="MinimumHeightRequest" Value="40" />
        </Style>
        <Style x:Key="OutlineActionButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="{StaticResource WeleBlue}" />
            <Setter Property="BorderColor" Value="{StaticResource Line}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="MinimumHeightRequest" Value="48" />
        </Style>
        <Style x:Key="CompactListBorder" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource PremiumLine}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 17" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Padding" Value="13" />
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#182165E8" Offset="0,3" Radius="10" Opacity="0.12" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="BodyLabel" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="1.25" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="MutedLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="1.25" />
            <Setter Property="TextColor" Value="{StaticResource MutedInk}" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="FontFamily" Value="PlusJakartaSans" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource MutedInk}" />
            <Setter Property="MinimumHeightRequest" Value="52" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="Editor">
            <Setter Property="FontFamily" Value="PlusJakartaSans" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource MutedInk}" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="FontFamily" Value="PlusJakartaSans" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="TitleColor" Value="{StaticResource MutedInk}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinimumHeightRequest" Value="52" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FontFamily" Value="PlusJakartaSans" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="52" />
        </Style>
        <Style TargetType="TimePicker">
            <Setter Property="FontFamily" Value="PlusJakartaSans" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="52" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="PlusJakartaSans" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="52" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BackgroundColor" Value="{StaticResource WeleBlue}" />
            <Setter Property="TextColor" Value="White" />
        </Style>
    </Application.Resources>
</Application>
