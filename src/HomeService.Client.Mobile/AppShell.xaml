<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="HomeService.Client.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:HomeService.Client.Mobile.Pages"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="Wélé">
    <ShellContent
        Route="onboarding"
        ContentTemplate="{DataTemplate pages:OnboardingPage}"
        Shell.TabBarIsVisible="False" />
    <ShellContent
        Route="welcome"
        ContentTemplate="{DataTemplate pages:WelcomePage}"
        Shell.TabBarIsVisible="False" />
    <TabBar>
        <ShellContent Title="Accueil" Icon="nav_home.svg" Route="home" ContentTemplate="{DataTemplate pages:HomePage}" />
        <ShellContent x:Name="RequestsTab" Title="Demandes" Icon="nav_requests.svg" Route="requests" ContentTemplate="{DataTemplate pages:RequestsPage}" />
        <ShellContent x:Name="MessagesTab" Title="Messages" Icon="nav_messages.svg" Route="messages" ContentTemplate="{DataTemplate pages:MessagesPage}" />
        <ShellContent Title="Profil" Icon="nav_profile.svg" Route="profile" ContentTemplate="{DataTemplate pages:ProfilePage}" />
    </TabBar>
</Shell>
