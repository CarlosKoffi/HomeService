<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.MissionRatingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HomeService.Client.Mobile.Controls"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="White">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="22,18,22,30" Spacing="20">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                    <Button Style="{StaticResource BackIconButton}" Clicked="OnBackClicked" />
                    <Label Grid.Column="1" Text="Noter l’intervention" Style="{StaticResource SubpageTitleLabel}" />
                </Grid>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Comment s’est passée votre intervention ?" FontSize="19" FontAttributes="Bold" />
                    <Label Text="Touchez les étoiles pour évaluer chaque point." Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>

                <Border Stroke="#E5E7EB" BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="16">
                    <VerticalStackLayout Spacing="15">
                        <controls:StarRatingView x:Name="PunctualityRating" Title="Ponctualité" />
                        <BoxView HeightRequest="1" Color="#EEF0F3" />
                        <controls:StarRatingView x:Name="QualityRating" Title="Qualité du travail" />
                        <BoxView HeightRequest="1" Color="#EEF0F3" />
                        <controls:StarRatingView x:Name="PresentationRating" Title="Présentation" />
                        <BoxView HeightRequest="1" Color="#EEF0F3" />
                        <controls:StarRatingView x:Name="PolitenessRating" Title="Courtoisie" />
                        <BoxView HeightRequest="1" Color="#EEF0F3" />
                        <controls:StarRatingView x:Name="CleanlinessRating" Title="Respect des lieux" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Commentaire (optionnel)" FontSize="14" FontAttributes="Bold" />
                        <Label x:Name="CommentCountLabel" Grid.Column="1" Text="0/500" FontSize="11" TextColor="{StaticResource MutedInk}" />
                    </Grid>
                    <Border Stroke="#DDE2EA" BackgroundColor="#FAFBFC" StrokeShape="RoundRectangle 14" Padding="12">
                        <Editor
                            x:Name="CommentEditor"
                            Placeholder="Très professionnel, rapide et efficace..."
                            AutoSize="TextChanges"
                            MinimumHeightRequest="105"
                            MaxLength="500"
                            TextChanged="OnCommentChanged" />
                    </Border>
                </VerticalStackLayout>

                <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="22,12,22,22" BackgroundColor="White">
            <Button Text="Continuer" Clicked="OnContinueClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
