<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HomeService.Client.Mobile.Pages.PaymentMethodsPage"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:controls="clr-namespace:HomeService.Client.Mobile.Controls" Shell.TabBarIsVisible="False" Title="Moyens de paiement">
 <Grid RowDefinitions="*,72" BackgroundColor="White">
  <Grid Padding="20,16,20,20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
   <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Button Style="{StaticResource BackIconButton}" Clicked="OnBackClicked"/><Label Grid.Column="1" Text="Moyens de paiement" Style="{StaticResource SubpageTitleLabel}"/></Grid>
   <Button Grid.Row="1" Text="+  Ajouter un numéro ou une carte" Style="{StaticResource OutlineActionButton}" Clicked="OnAddClicked"/>
   <Grid Grid.Row="2">
    <CollectionView x:Name="MethodsView" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate>
     <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="16" Margin="0,0,0,12">
      <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True"><Setter Property="BackgroundColor" Value="#F8FAFF"/><Setter Property="Stroke" Value="{StaticResource WeleBlue}"/></DataTrigger></Border.Triggers>
      <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMethodTapped" CommandParameter="{Binding .}"/></Border.GestureRecognizers>
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="56,*,Auto" ColumnSpacing="14" RowSpacing="12">
       <Border BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 12" HeightRequest="54" WidthRequest="54" Padding="7"><Grid><Image Source="{Binding LogoSource}" Aspect="AspectFit"/><Label Text="{Binding IconText}" IsVisible="{Binding ShowFallback}" TextColor="{StaticResource WeleBlue}" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Grid></Border>
       <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center"><Label Text="{Binding Label}" FontAttributes="Bold" FontSize="15"/><Label Text="{Binding Reference}" FontSize="12" TextColor="{StaticResource MutedInk}"/></VerticalStackLayout>
       <Border Grid.Column="2" BackgroundColor="#EEF4FF" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,6" IsVisible="{Binding IsDefault}" VerticalOptions="Start"><Label Text="Par défaut" FontSize="11" TextColor="{StaticResource WeleBlue}"/></Border>
       <Button Grid.Row="1" Grid.Column="2" Text="Supprimer" FontSize="11" TextColor="{StaticResource Danger}" BackgroundColor="Transparent" Padding="8,4" MinimumWidthRequest="0" MinimumHeightRequest="0" HorizontalOptions="End" Clicked="OnDeleteClicked" CommandParameter="{Binding .}"/>
      </Grid>
     </Border>
    </DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <VerticalStackLayout x:Name="EmptyState" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center" IsVisible="False"><Label Text="Aucun moyen de paiement" FontSize="17" FontAttributes="Bold"/><Label Text="Ajoutez Mobile Money ou une carte pour confirmer votre intervention." Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center"/></VerticalStackLayout>
   </Grid>
   <VerticalStackLayout Grid.Row="3" Spacing="7"><Label Text="Choisissez le numéro et le réseau à utiliser pour cette intervention." FontSize="12" TextColor="{StaticResource MutedInk}"/><Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" IsVisible="False"/><Button x:Name="ContinueButton" Text="Utiliser ce numéro et ce réseau" IsEnabled="False" Clicked="OnContinueClicked"/></VerticalStackLayout>
  </Grid>
  <controls:ClientBottomNavigation Grid.Row="1" ActiveTab="profile"/>
 </Grid>
</ContentPage>
