<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HomeService.Client.Mobile.Pages.PaymentCheckoutPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False" BackgroundColor="White">
    <Grid RowDefinitions="*,Auto" Padding="24,22,24,24">
        <ScrollView>
            <VerticalStackLayout Spacing="22">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Button Text="‹" FontSize="28" BackgroundColor="Transparent" TextColor="#111827" WidthRequest="44" Clicked="OnBackClicked" />
                    <Label Grid.Column="1" Text="Paiement" FontSize="28" FontAttributes="Bold" VerticalTextAlignment="Center" />
                </Grid>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Détail de la facture" FontSize="18" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto"><Label x:Name="ServiceLabel" TextColor="#6B7280" /><Label Grid.Column="1" x:Name="ServiceAmountLabel" FontAttributes="Bold" /></Grid>
                    <Grid x:Name="PartsRow" ColumnDefinitions="*,Auto" IsVisible="False"><Label Text="Pièces et déplacement" TextColor="#6B7280" /><Label Grid.Column="1" x:Name="PartsAmountLabel" FontAttributes="Bold" /></Grid>
                    <BoxView HeightRequest="1" Color="#E5E7EB" />
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Total à payer" FontSize="17" FontAttributes="Bold" /><Label Grid.Column="1" x:Name="TotalLabel" FontSize="18" FontAttributes="Bold" TextColor="#2563EB" /></Grid>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="3">
                    <Label Text="Choisir le numéro et le réseau" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Un même numéro peut être proposé sur plusieurs réseaux Mobile Money." FontSize="12" TextColor="#6B7280" />
                </VerticalStackLayout>
                <CollectionView x:Name="MethodsView" SelectionMode="None">
                    <CollectionView.ItemTemplate><DataTemplate>
                        <Border Stroke="#E5E7EB" StrokeShape="RoundRectangle 12" Padding="12" Margin="0,0,0,8">
                            <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True"><Setter Property="Stroke" Value="#2563EB" /><Setter Property="StrokeThickness" Value="2" /><Setter Property="BackgroundColor" Value="#F8FAFF" /></DataTrigger></Border.Triggers>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMethodTapped" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                                <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeShape="RoundRectangle 9" HeightRequest="46" WidthRequest="46" Padding="5"><Grid><Image Source="{Binding LogoSource}" Aspect="AspectFit" /><Label Text="{Binding Fallback}" IsVisible="{Binding ShowFallback}" TextColor="#2563EB" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Grid></Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="{Binding Label}" FontAttributes="Bold" /><Label Text="{Binding Reference}" FontSize="12" TextColor="#6B7280" /></VerticalStackLayout>
                                <Label Grid.Column="2" Text="✓" FontSize="20" TextColor="#2563EB" IsVisible="{Binding IsSelected}" VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate></CollectionView.ItemTemplate>
                </CollectionView>
                <Label x:Name="ErrorLabel" TextColor="#DC2626" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1" x:Name="PayButton" Text="Payer" HeightRequest="56" FontAttributes="Bold" Clicked="OnPayClicked" />
    </Grid>
</ContentPage>
