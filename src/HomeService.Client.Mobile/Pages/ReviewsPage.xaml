<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HomeService.Client.Mobile.Pages.ReviewsPage"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:HomeService.Client.Mobile.Controls" Shell.TabBarIsVisible="False" Title="Mes avis">
 <Grid RowDefinitions="*,72">
 <Grid Padding="20,18,20,24" RowDefinitions="Auto,*" RowSpacing="18">
  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Button Text="‹" FontSize="28" BackgroundColor="Transparent" TextColor="{StaticResource Ink}" Padding="0" WidthRequest="32" Clicked="OnBackClicked"/><Label Grid.Column="1" Text="Mes avis" FontSize="20" FontAttributes="Bold" VerticalTextAlignment="Center"/></Grid>
  <Grid Grid.Row="1"><CollectionView x:Name="ReviewsView" SelectionMode="Single" SelectionChanged="OnSelected"><CollectionView.ItemTemplate><DataTemplate><Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="14" Margin="0,0,0,10"><VerticalStackLayout Spacing="5"><Label Text="{Binding Title}" FontAttributes="Bold"/><Label Text="{Binding MissionNumber}" TextColor="{StaticResource WeleBlue}"/><Label Text="Touchez pour consulter la mission et votre évaluation." Style="{StaticResource MutedLabel}"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><Label x:Name="EmptyState" Text="Vos avis apparaîtront ici après vos interventions." Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" IsVisible="False"/></Grid>
 </Grid>
 <controls:ClientBottomNavigation Grid.Row="1" ActiveTab="profile" />
 </Grid>
</ContentPage>
