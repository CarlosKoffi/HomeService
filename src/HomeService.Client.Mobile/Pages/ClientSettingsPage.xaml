<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HomeService.Client.Mobile.Pages.ClientSettingsPage"
 xmlns:controls="clr-namespace:HomeService.Client.Mobile.Controls" Shell.TabBarIsVisible="False"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Paramètres">
 <Grid RowDefinitions="*,72" BackgroundColor="White">
  <Grid Padding="20,16,20,20" RowDefinitions="Auto,*,Auto" RowSpacing="14">
   <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Button Style="{StaticResource BackIconButton}" Clicked="OnBackClicked"/><Label Grid.Column="1" Text="Paramètres" Style="{StaticResource SubpageTitleLabel}"/></Grid>
   <VerticalStackLayout Grid.Row="1" Spacing="0">
    <Grid Padding="4,14" ColumnDefinitions="32,*,Auto"><Label Text="◎" TextColor="{StaticResource MutedInk}"/><Label Grid.Column="1" Text="Langue"/><Label Grid.Column="2" Text="Français   ›" TextColor="{StaticResource MutedInk}"/></Grid><BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}"/>
    <Grid Padding="4,14" ColumnDefinitions="32,*,Auto"><Label Text="◐" TextColor="{StaticResource MutedInk}"/><Label Grid.Column="1" Text="Thème"/><Label Grid.Column="2" Text="Clair   ›" TextColor="{StaticResource MutedInk}"/></Grid><BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}"/>
    <Grid Padding="4,14" ColumnDefinitions="32,*,Auto"><Label Text="◉" TextColor="{StaticResource MutedInk}"/><Label Grid.Column="1" Text="Sécurité"/><Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource MutedInk}"/></Grid><BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}"/>
    <Grid Padding="4,14" ColumnDefinitions="32,*,Auto"><Label Text="◇" TextColor="{StaticResource MutedInk}"/><Label Grid.Column="1" Text="Confidentialité"/><Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource MutedInk}"/></Grid><BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}"/>
    <Grid Padding="4,14" ColumnDefinitions="32,*,Auto"><Label Text="?" TextColor="{StaticResource MutedInk}"/><Label Grid.Column="1" Text="Aide et support"/><Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource MutedInk}"/></Grid><BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}"/>
    <Grid Padding="4,14" ColumnDefinitions="32,*,Auto"><Label Text="i" TextColor="{StaticResource MutedInk}"/><Label Grid.Column="1" Text="À propos de Wélé"/><Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource MutedInk}"/></Grid>
   </VerticalStackLayout>
   <Button Grid.Row="2" Text="Se déconnecter" Style="{StaticResource OutlineActionButton}" TextColor="{StaticResource Danger}" BorderColor="{StaticResource Danger}" Clicked="OnLogoutClicked"/>
  </Grid>
  <controls:ClientBottomNavigation Grid.Row="1" ActiveTab="profile" />
 </Grid>
</ContentPage>
