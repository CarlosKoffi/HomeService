<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.MessagesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HomeService.Client.Mobile.Controls"
    Shell.TabBarIsVisible="False"
    Title="Messages">
    <Grid RowDefinitions="*,72" BackgroundColor="White">
        <Grid Padding="20,18" RowDefinitions="Auto,*" RowSpacing="18">
            <Grid ColumnDefinitions="*,40" ColumnSpacing="10">
                <VerticalStackLayout Spacing="5">
                    <Label Text="MESSAGES" Style="{StaticResource EyebrowLabel}" />
                    <Label Text="Conversations" Style="{StaticResource ScreenTitleLabel}" FontSize="24" />
                    <Label Text="Choisissez une demande pour ouvrir ses échanges." Style="{StaticResource MutedLabel}" />
                    <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" IsVisible="False" Margin="0,6,0,0" />
                </VerticalStackLayout>
                <controls:ClientNotificationButton Grid.Column="1" Margin="0,6,0,0" />
            </Grid>

            <RefreshView Grid.Row="1" x:Name="MessagesRefreshView" Refreshing="OnRefreshing">
                <CollectionView x:Name="ConversationsView"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="12,40" Spacing="8" HorizontalOptions="Center">
                            <Label Text="Aucune conversation" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Text="Vos échanges apparaîtront ici dès votre première demande." Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="14" Margin="0,0,0,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnConversationTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Ink}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding MissionNumber}" FontSize="12" TextColor="{StaticResource WeleBlue}" />
                                        <Label Text="{Binding Hint}" Style="{StaticResource MutedLabel}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding DateLabel}" FontSize="11" TextColor="{StaticResource MutedInk}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="›" FontSize="28" TextColor="{StaticResource MutedInk}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
        <controls:ClientBottomNavigation Grid.Row="1" ActiveTab="messages" />
    </Grid>
</ContentPage>
