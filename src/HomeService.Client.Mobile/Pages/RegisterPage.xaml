<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="White"
    Title="Créer un compte">
    <ScrollView>
        <VerticalStackLayout
            Padding="24,38,24,28"
            Spacing="22"
            HorizontalOptions="Fill"
            MaximumWidthRequest="390">
            <Label
                Text="Créer un compte"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#09090B" />

            <VerticalStackLayout Spacing="13">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Nom complet" FontSize="10" TextColor="#374151" />
                    <Border x:Name="FullNameBorder" HeightRequest="40" Stroke="#DCE1E8" BackgroundColor="White" StrokeShape="RoundRectangle 6" Padding="11,0">
                        <Entry x:Name="FullNameEntry" Placeholder="Carlos Konan" FontSize="12" MinimumHeightRequest="0" HeightRequest="38" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Téléphone" FontSize="10" TextColor="#374151" />
                    <Border x:Name="PhoneBorder" HeightRequest="40" Stroke="#DCE1E8" BackgroundColor="White" StrokeShape="RoundRectangle 6" Padding="11,0">
                        <Entry x:Name="PhoneEntry" Placeholder="07 12 34 56 78" Keyboard="Telephone" FontSize="12" MinimumHeightRequest="0" HeightRequest="38" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Email (optionnel)" FontSize="10" TextColor="#374151" />
                    <Border x:Name="EmailBorder" HeightRequest="40" Stroke="#DCE1E8" BackgroundColor="White" StrokeShape="RoundRectangle 6" Padding="11,0">
                        <Entry x:Name="EmailEntry" Placeholder="carlos@gmail.com" Keyboard="Email" FontSize="12" MinimumHeightRequest="0" HeightRequest="38" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Mot de passe" FontSize="10" TextColor="#374151" />
                    <Border x:Name="PasswordBorder" HeightRequest="40" Stroke="#DCE1E8" BackgroundColor="White" StrokeShape="RoundRectangle 6" Padding="11,0">
                        <Grid ColumnDefinitions="*,28">
                            <Entry
                                x:Name="PasswordEntry"
                                Placeholder="Minimum 8 caractères"
                                IsPassword="True"
                                FontSize="12"
                                MinimumHeightRequest="0"
                                HeightRequest="38" />
                            <Button
                                Grid.Column="1"
                                Text="◉"
                                FontSize="12"
                                MinimumHeightRequest="0"
                                HeightRequest="30"
                                Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="#6B7280"
                                Clicked="OnTogglePasswordClicked" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="22,*" ColumnSpacing="8">
                    <CheckBox x:Name="TermsCheckBox" IsChecked="True" Color="{StaticResource WeleBlue}" Scale="0.78" />
                    <Label
                        Grid.Column="1"
                        Text="J'accepte les CGU et la politique de confidentialité."
                        FontSize="9"
                        VerticalTextAlignment="Center" />
                </Grid>

                <Button
                    Text="Créer mon compte"
                    CornerRadius="6"
                    FontSize="12"
                    MinimumHeightRequest="0"
                    HeightRequest="42"
                    Clicked="OnRegisterClicked" />
            </VerticalStackLayout>

            <Label
                x:Name="ErrorLabel"
                TextColor="{StaticResource Danger}"
                FontSize="11"
                FontAttributes="Bold"
                IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
