<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Compte client">
    <ScrollView>
        <VerticalStackLayout Padding="22,24,22,28" Spacing="22">
            <VerticalStackLayout Spacing="8">
                <Label Text="wélé" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" />
                <Label Text="Creer un compte" Style="{StaticResource ScreenTitleLabel}" />
                <Label Text="Demandez un service, suivez l'intervention et retrouvez vos factures." Style="{StaticResource BodyLabel}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14">
                <VerticalStackLayout Spacing="7">
                    <Label Text="Nom complet" FontSize="13" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 14" Padding="14,0">
                            <Entry x:Name="FirstNameEntry" Placeholder="Prenom" />
                        </Border>
                        <Border Grid.Column="1" Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 14" Padding="14,0">
                            <Entry x:Name="LastNameEntry" Placeholder="Nom" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="7">
                    <Label Text="Telephone" FontSize="13" FontAttributes="Bold" />
                    <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 14" Padding="14,0">
                        <Entry x:Name="PhoneEntry" Placeholder="07 12 34 56 78" Keyboard="Telephone" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="7">
                    <Label Text="Email optionnel" FontSize="13" FontAttributes="Bold" />
                    <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 14" Padding="14,0">
                        <Entry x:Name="EmailEntry" Placeholder="carlos@email.com" Keyboard="Email" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="7">
                    <Label Text="Mot de passe" FontSize="13" FontAttributes="Bold" />
                    <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 14" Padding="14,0">
                        <Entry x:Name="PasswordEntry" Placeholder="Minimum 8 caracteres" IsPassword="True" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="7">
                    <Label Text="Confirmation" FontSize="13" FontAttributes="Bold" />
                    <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 14" Padding="14,0">
                        <Entry x:Name="ConfirmPasswordEntry" Placeholder="Retapez le mot de passe" IsPassword="True" />
                    </Border>
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="8">
                    <CheckBox IsChecked="True" Color="{StaticResource WeleBlue}" />
                    <Label Text="J'accepte les conditions d'utilisation." FontSize="12" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Button Text="Creer mon compte" Clicked="OnRegisterClicked" />
            </VerticalStackLayout>

            <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" FontAttributes="Bold" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
