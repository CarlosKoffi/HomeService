<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Compte client">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="NOUVEAU CLIENT" Style="{StaticResource EyebrowLabel}" />
            <Label Text="Creer votre compte" Style="{StaticResource ScreenTitleLabel}" />
            <Label Text="Un compte suffit pour demander un service, suivre la mission et parler avec l'equipe." Style="{StaticResource BodyLabel}" />

            <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 24" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Prenom" FontAttributes="Bold" />
                            <Entry x:Name="FirstNameEntry" Placeholder="Awa" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Nom" FontAttributes="Bold" />
                            <Entry x:Name="LastNameEntry" Placeholder="Kone" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="Telephone" FontAttributes="Bold" />
                    <Entry x:Name="PhoneEntry" Placeholder="Ex: 0707127068" Keyboard="Telephone" />
                    <Label Text="Email" FontAttributes="Bold" />
                    <Entry x:Name="EmailEntry" Placeholder="optionnel" Keyboard="Email" />
                    <Label Text="Mot de passe" FontAttributes="Bold" />
                    <Entry x:Name="PasswordEntry" Placeholder="Minimum 8 caracteres" IsPassword="True" />
                    <Label Text="Confirmation" FontAttributes="Bold" />
                    <Entry x:Name="ConfirmPasswordEntry" Placeholder="Retapez le mot de passe" IsPassword="True" />
                    <Button Text="Creer mon compte" Clicked="OnRegisterClicked" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
