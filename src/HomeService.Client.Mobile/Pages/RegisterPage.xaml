<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="White"
    Title="Créer un compte">
    <ScrollView>
        <VerticalStackLayout Padding="24,76,24,32" Spacing="28">
            <Label
                Text="Créer un compte"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#09090B" />

            <VerticalStackLayout Spacing="15">
                <VerticalStackLayout Spacing="7">
                    <Label Text="Nom complet" FontSize="12" TextColor="#374151" />
                    <Border Stroke="#D1D5DB" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="14,0">
                        <Entry x:Name="FullNameEntry" Placeholder="Carlos Konan" HeightRequest="50" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="7">
                    <Label Text="Téléphone" FontSize="12" TextColor="#374151" />
                    <Border Stroke="#D1D5DB" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="14,0">
                        <Entry x:Name="PhoneEntry" Placeholder="07 12 34 56 78" Keyboard="Telephone" HeightRequest="50" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="7">
                    <Label Text="Email (optionnel)" FontSize="12" TextColor="#374151" />
                    <Border Stroke="#D1D5DB" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="14,0">
                        <Entry x:Name="EmailEntry" Placeholder="carlos@gmail.com" Keyboard="Email" HeightRequest="50" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="7">
                    <Label Text="Mot de passe" FontSize="12" TextColor="#374151" />
                    <Border Stroke="#D1D5DB" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="14,0">
                        <Grid ColumnDefinitions="*,36">
                            <Entry
                                x:Name="PasswordEntry"
                                Placeholder="Minimum 8 caractères"
                                IsPassword="True"
                                HeightRequest="50" />
                            <Button
                                Grid.Column="1"
                                Text="◉"
                                FontSize="15"
                                Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="#6B7280"
                                Clicked="OnTogglePasswordClicked" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="TermsCheckBox" IsChecked="True" Color="{StaticResource WeleBlue}" />
                    <Label
                        Text="J'accepte les CGU et la politique de confidentialité."
                        FontSize="11"
                        VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Button
                    Text="Créer mon compte"
                    CornerRadius="8"
                    HeightRequest="52"
                    Clicked="OnRegisterClicked" />
            </VerticalStackLayout>

            <Label
                x:Name="ErrorLabel"
                TextColor="{StaticResource Danger}"
                FontSize="12"
                FontAttributes="Bold"
                IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
