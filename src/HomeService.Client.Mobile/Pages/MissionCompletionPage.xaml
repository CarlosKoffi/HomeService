<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.MissionCompletionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="White">
    <Grid RowDefinitions="*,Auto">
        <Grid
            Grid.Row="0"
            Padding="18,10,18,4"
            RowDefinitions="Auto,*,Auto,Auto,Auto"
            RowSpacing="8">
            <Grid Grid.Row="0" ColumnDefinitions="36,*" ColumnSpacing="8">
                <Button Style="{StaticResource BackIconButton}" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="Intervention terminée" Style="{StaticResource SubpageTitleLabel}" />
            </Grid>

            <Image
                Grid.Row="1"
                Source="intervention_complete_team.png"
                MaximumHeightRequest="205"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                Aspect="AspectFit"
                SemanticProperties.Description="Une technicienne et un technicien Wélé sourient après une intervention réussie" />

            <VerticalStackLayout Grid.Row="2" Spacing="3" HorizontalOptions="Fill">
                <Label Text="Mission accomplie !" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <Label
                    x:Name="CompletionMessageLabel"
                    Text="Votre prestataire a terminé l’intervention. Dites-nous comment cela s’est passé."
                    Style="{StaticResource MutedLabel}"
                    FontSize="13"
                    LineHeight="1.2"
                    MaxLines="2"
                    LineBreakMode="TailTruncation"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border
                Grid.Row="3"
                x:Name="ProviderCard"
                Stroke="#DCE7FF"
                BackgroundColor="#F6F9FF"
                StrokeShape="RoundRectangle 15"
                Padding="11,9">
                <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
                    <Border HeightRequest="40" WidthRequest="40" StrokeThickness="0" BackgroundColor="#E6EEFF" StrokeShape="RoundRectangle 13">
                        <Label Text="✓" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label x:Name="ProviderNameLabel" Text="Votre prestataire" FontSize="14" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label x:Name="ServiceLabel" Text="Intervention terminée avec succès" Style="{StaticResource MutedLabel}" FontSize="12" MaxLines="1" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Grid.Row="4" x:Name="ErrorLabel" FontSize="12" TextColor="{StaticResource Danger}" HorizontalTextAlignment="Center" IsVisible="False" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="18,8,18,14" Spacing="8" BackgroundColor="White">
            <Button Text="Noter le prestataire" HeightRequest="50" MinimumHeightRequest="50" Clicked="OnRateClicked" />
            <Button Text="Voir la facture" HeightRequest="50" MinimumHeightRequest="50" Style="{StaticResource OutlineActionButton}" Clicked="OnInvoiceClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
