<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HomeService.Client.Mobile.Pages.MissionChatPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:HomeService.Client.Mobile.Controls" Shell.TabBarIsVisible="False" Title="Conversation" BackgroundColor="White">
 <Grid RowDefinitions="*,72"><Grid Padding="20,14,20,8" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
  <Grid ColumnDefinitions="32,42,*,40" ColumnSpacing="8"><Button Style="{StaticResource BackIconButton}" Clicked="OnBackClicked"/><Border Grid.Column="1" HeightRequest="40" WidthRequest="40" BackgroundColor="#EAF1FF" StrokeThickness="0" StrokeShape="RoundRectangle 20"><Image Source="nav_profile.svg" HeightRequest="21" WidthRequest="21"/></Border><VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center"><Label Text="Conversation" FontSize="15" FontAttributes="Bold"/><Label x:Name="MissionContextLabel" Text="Chargement..." FontSize="11" TextColor="{StaticResource MutedInk}" LineBreakMode="TailTruncation"/></VerticalStackLayout><controls:ClientNotificationButton Grid.Column="3"/></Grid>
  <Label Grid.Row="1" x:Name="ErrorLabel" TextColor="{StaticResource Danger}" FontSize="12" IsVisible="False"/>
  <RefreshView Grid.Row="2" x:Name="ChatRefreshView" Refreshing="OnRefreshing"><CollectionView x:Name="MessagesView" SelectionMode="None"><CollectionView.EmptyView><VerticalStackLayout Padding="12,44" Spacing="6"><Label Text="Aucun message" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Écrivez le premier message concernant cette demande." Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center"/></VerticalStackLayout></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><Grid Padding="0,4"><Border MaximumWidthRequest="290" HorizontalOptions="Start" BackgroundColor="#F2F4F7" StrokeThickness="0" StrokeShape="RoundRectangle 14,14,14,4" Padding="12,9"><Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True"><Setter Property="HorizontalOptions" Value="End"/><Setter Property="BackgroundColor" Value="{StaticResource WeleBlue}"/><Setter Property="StrokeShape" Value="RoundRectangle 14,14,4,14"/></DataTrigger></Border.Triggers><VerticalStackLayout Spacing="4"><Label Text="{Binding Body}" FontSize="13"><Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True"><Setter Property="TextColor" Value="White"/></DataTrigger></Label.Triggers></Label><Label Text="{Binding SentAt}" FontSize="10" TextColor="{StaticResource MutedInk}" HorizontalTextAlignment="End"><Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True"><Setter Property="TextColor" Value="#DCE8FF"/></DataTrigger></Label.Triggers></Label></VerticalStackLayout></Border></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></RefreshView>
  <Grid Grid.Row="3" ColumnDefinitions="*,42" ColumnSpacing="8" Padding="0,4,0,0"><Border Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 18" Padding="12,0"><Entry x:Name="MessageEntry" Placeholder="Écrire un message..." FontSize="13" BackgroundColor="Transparent" ReturnType="Send" Completed="OnMessageCompleted"/></Border><Button x:Name="SendButton" Grid.Column="1" Text="➤" FontSize="16" HeightRequest="42" WidthRequest="42" CornerRadius="21" Padding="0" Clicked="OnSendClicked"/></Grid>
 </Grid><controls:ClientBottomNavigation Grid.Row="1" ActiveTab="messages"/></Grid>
</ContentPage>
