<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.MissionChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HomeService.Client.Mobile.Controls"
    Shell.TabBarIsVisible="False"
    Title="Conversation"
    BackgroundColor="White">
    <Grid RowDefinitions="*,72">
        <Grid Padding="20,18,20,8" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="32,42,*" ColumnSpacing="8">
                <Button Style="{StaticResource BackIconButton}" Clicked="OnBackClicked" />
                <Grid Grid.Column="1" HeightRequest="40" WidthRequest="40">
                    <Border
                        x:Name="ProviderAvatarFallback"
                        BackgroundColor="#EAF1FF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20">
                        <Image Source="nav_profile.svg" HeightRequest="21" WidthRequest="21" />
                    </Border>
                    <Border
                        x:Name="ProviderAvatarPhotoBorder"
                        BackgroundColor="White"
                        Stroke="{StaticResource PremiumLine}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="0"
                        IsVisible="False">
                        <Image
                            x:Name="ProviderAvatarPhoto"
                            Aspect="AspectFill"
                            HeightRequest="40"
                            WidthRequest="40" />
                    </Border>
                </Grid>
                <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                    <Label
                        x:Name="ConversationTitleLabel"
                        Text="Conversation"
                        FontSize="15"
                        FontAttributes="Bold"
                        LineBreakMode="TailTruncation" />
                    <Label
                        x:Name="MissionContextLabel"
                        Text="Chargement..."
                        FontSize="11"
                        TextColor="{StaticResource MutedInk}"
                        LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Grid>

            <Label
                Grid.Row="1"
                x:Name="ErrorLabel"
                TextColor="{StaticResource Danger}"
                FontSize="12"
                IsVisible="False" />

            <RefreshView
                Grid.Row="2"
                x:Name="ChatRefreshView"
                Refreshing="OnRefreshing">
                <CollectionView x:Name="MessagesView" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="12,44" Spacing="6">
                            <Label
                                Text="Aucun message"
                                FontSize="16"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Écrivez le premier message concernant cette demande."
                                Style="{StaticResource MutedLabel}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,4" ColumnDefinitions="30,*" ColumnSpacing="8">
                                <Grid
                                    HeightRequest="28"
                                    WidthRequest="28"
                                    VerticalOptions="End"
                                    IsVisible="{Binding ShowProviderIdentity}">
                                    <Border
                                        BackgroundColor="#EAF1FF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        IsVisible="{Binding ShowProviderFallback}">
                                        <Image Source="nav_profile.svg" HeightRequest="15" WidthRequest="15" />
                                    </Border>
                                    <Border
                                        BackgroundColor="White"
                                        Stroke="{StaticResource PremiumLine}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="0"
                                        IsVisible="{Binding ShowProviderPhoto}">
                                        <Image
                                            Source="{Binding ProviderPhoto}"
                                            Aspect="AspectFill"
                                            HeightRequest="28"
                                            WidthRequest="28" />
                                    </Border>
                                </Grid>

                                <Border
                                    Grid.Column="1"
                                    MaximumWidthRequest="290"
                                    HorizontalOptions="Start"
                                    BackgroundColor="#F2F4F7"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14,14,14,4"
                                    Padding="12,9">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                            <Setter Property="HorizontalOptions" Value="End" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource WeleBlue}" />
                                            <Setter Property="StrokeShape" Value="RoundRectangle 14,14,4,14" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label
                                            Text="{Binding Sender}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource WeleBlue}"
                                            IsVisible="{Binding ShowSender}" />
                                        <Label Text="{Binding Body}" FontSize="13">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label
                                            Text="{Binding SentAt}"
                                            FontSize="10"
                                            TextColor="{StaticResource MutedInk}"
                                            HorizontalTextAlignment="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="TextColor" Value="#DCE8FF" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <Grid Grid.Row="3" ColumnDefinitions="*,42" ColumnSpacing="8" Padding="0,4,0,0">
                <Border Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 18" Padding="12,0">
                    <Entry
                        x:Name="MessageEntry"
                        Placeholder="Écrire un message..."
                        FontSize="13"
                        BackgroundColor="Transparent"
                        ReturnType="Send"
                        Completed="OnMessageCompleted" />
                </Border>
                <Button
                    x:Name="SendButton"
                    Grid.Column="1"
                    Text="➤"
                    FontSize="16"
                    HeightRequest="42"
                    WidthRequest="42"
                    CornerRadius="21"
                    Padding="0"
                    Clicked="OnSendClicked" />
            </Grid>
        </Grid>
        <controls:ClientBottomNavigation Grid.Row="1" ActiveTab="messages" />
    </Grid>
</ContentPage>
