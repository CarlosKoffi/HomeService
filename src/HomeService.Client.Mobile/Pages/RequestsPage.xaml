<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.RequestsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HomeService.Client.Mobile.Controls"
    Shell.TabBarIsVisible="False"
    Title="Demandes">
    <Grid RowDefinitions="*,72">
    <RefreshView x:Name="Refresh" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="20,18,20,28" Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Mes demandes" Style="{StaticResource ScreenTitleLabel}" />
                        <Label Text="Suivez les interventions, devis et paiements." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                    <controls:ClientNotificationButton Grid.Column="1" />
                </Grid>

                <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 22" Padding="12">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="5">
                        <Button x:Name="AllButton" Text="Toutes" Clicked="OnAllClicked" MinimumHeightRequest="40" HeightRequest="40" FontSize="11" Padding="3,0" />
                        <Button x:Name="ActiveButton" Grid.Column="1" Text="En cours" BackgroundColor="White" TextColor="{StaticResource Ink}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnActiveClicked" MinimumHeightRequest="40" HeightRequest="40" FontSize="11" Padding="3,0" />
                        <Button x:Name="PastButton" Grid.Column="2" Text="Passées" BackgroundColor="White" TextColor="{StaticResource Ink}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnPastClicked" MinimumHeightRequest="40" HeightRequest="40" FontSize="11" Padding="3,0" />
                        <Button x:Name="CanceledButton" Grid.Column="3" Text="Annulées" BackgroundColor="White" TextColor="{StaticResource Ink}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnCanceledClicked" MinimumHeightRequest="40" HeightRequest="40" FontSize="11" Padding="3,0" />
                    </Grid>
                </Border>

                <CollectionView x:Name="MissionsView" SelectionMode="Single" SelectionChanged="OnMissionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 18" Padding="12" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="50,*,88" ColumnSpacing="10">
                                    <Border BackgroundColor="#EFF6FF" StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="50" WidthRequest="50">
                                        <Image Source="{Binding IconSource}" Aspect="AspectFit" HeightRequest="38" WidthRequest="38" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" LineBreakMode="WordWrap" MaxLines="2" />
                                        <Label Text="{Binding Schedule}" FontSize="11" TextColor="{StaticResource MutedInk}" LineBreakMode="NoWrap" />
                                        <Label Text="{Binding Address}" FontSize="11" TextColor="{StaticResource MutedInk}" LineBreakMode="WordWrap" MaxLines="2" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center" Spacing="7">
                                        <Border BackgroundColor="{Binding StatusBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="7,5">
                                            <Label Text="{Binding StatusLabel}" FontSize="10" TextColor="{Binding StatusColor}" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                                        </Border>
                                        <Label Text="{Binding Amount}" FontSize="11" TextColor="{StaticResource WeleBlue}" FontAttributes="Bold" HorizontalTextAlignment="End" LineBreakMode="WordWrap" MaxLines="2" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border x:Name="EmptyState" Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 22" Padding="18" IsVisible="False">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Aucune demande" Style="{StaticResource CardTitleLabel}" />
                        <Label Text="Vos demandes apparaîtront ici après envoi." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
    <controls:ClientBottomNavigation Grid.Row="1" ActiveTab="requests" />
    </Grid>
</ContentPage>
