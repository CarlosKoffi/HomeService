<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.RequestsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HomeService.Client.Mobile.Controls"
    Shell.TabBarIsVisible="False"
    Title="Demandes">
    <Grid RowDefinitions="*,72">
    <RefreshView x:Name="Refresh" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="20,10,20,28" Spacing="16">
                <Grid ColumnDefinitions="Auto,*,48" ColumnSpacing="8" HeightRequest="48">
                    <Button
                        x:Name="BackButton"
                        Style="{StaticResource BackIconButton}"
                        IsVisible="False"
                        Clicked="OnBackClicked" />
                    <Label Grid.Column="1" Text="Mes demandes" Style="{StaticResource ScreenTitleLabel}" VerticalTextAlignment="Center" />
                    <controls:ClientNotificationButton Grid.Column="2" />
                </Grid>
                <Label Text="Suivez les interventions, devis et paiements." Style="{StaticResource MutedLabel}" Margin="0,-12,0,0" />

                <Border StrokeThickness="0" BackgroundColor="{StaticResource BlueWash}" StrokeShape="RoundRectangle 14" Padding="4">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="5">
                        <Button x:Name="AllButton" Text="Toutes" BackgroundColor="Transparent" TextColor="{StaticResource ListSecondary}" BorderWidth="0" Clicked="OnAllClicked" MinimumHeightRequest="38" HeightRequest="38" CornerRadius="11" FontSize="10" Padding="2,0" />
                        <Button x:Name="ActiveButton" Grid.Column="1" Text="En cours" BackgroundColor="White" TextColor="{StaticResource WeleBlue}" BorderWidth="0" Clicked="OnActiveClicked" MinimumHeightRequest="38" HeightRequest="38" CornerRadius="11" FontSize="10" Padding="2,0" />
                        <Button x:Name="PastButton" Grid.Column="2" Text="Terminées" BackgroundColor="Transparent" TextColor="{StaticResource ListSecondary}" BorderWidth="0" Clicked="OnPastClicked" MinimumHeightRequest="38" HeightRequest="38" CornerRadius="11" FontSize="10" Padding="2,0" />
                        <Button x:Name="CanceledButton" Grid.Column="3" Text="Annulées" BackgroundColor="Transparent" TextColor="{StaticResource ListSecondary}" BorderWidth="0" Clicked="OnCanceledClicked" MinimumHeightRequest="38" HeightRequest="38" CornerRadius="11" FontSize="10" Padding="2,0" />
                    </Grid>
                </Border>

                <CollectionView x:Name="MissionsView" SelectionMode="Single" SelectionChanged="OnMissionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CompactListBorder}">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="50,*,88" ColumnSpacing="10" RowSpacing="10">
                                    <Border BackgroundColor="White" Stroke="{StaticResource PremiumLine}" StrokeThickness="1" StrokeShape="RoundRectangle 13" HeightRequest="50" WidthRequest="50" Padding="4">
                                        <Image Source="{Binding IconSource}" Aspect="AspectFit" HeightRequest="40" WidthRequest="40" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" LineBreakMode="WordWrap" MaxLines="2" />
                                        <Label Text="{Binding Schedule}" FontSize="11" TextColor="{StaticResource ListSecondary}" LineBreakMode="NoWrap" />
                                        <Label Text="{Binding Address}" FontSize="11" TextColor="{StaticResource ListSecondary}" LineBreakMode="WordWrap" MaxLines="2" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center" Spacing="7">
                                        <Border BackgroundColor="{Binding StatusBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="7,5">
                                            <Label Text="{Binding StatusLabel}" FontSize="10" TextColor="{Binding StatusColor}" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                                        </Border>
                                        <Label Text="{Binding Amount}" FontSize="11" TextColor="{StaticResource WeleBlue}" FontAttributes="Bold" HorizontalTextAlignment="End" LineBreakMode="WordWrap" MaxLines="2" />
                                    </VerticalStackLayout>
                                    <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                            Text="Commander à nouveau"
                                            IsVisible="{Binding CanReorder}"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnReorderClicked"
                                            HorizontalOptions="End"
                                            HeightRequest="38"
                                            Padding="14,0"
                                            FontSize="11"
                                            BackgroundColor="White"
                                            BorderColor="{StaticResource WeleBlue}"
                                            BorderWidth="1"
                                            TextColor="{StaticResource WeleBlue}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border x:Name="EmptyState" Stroke="{StaticResource PremiumLine}" BackgroundColor="White" StrokeShape="RoundRectangle 18" Padding="18" IsVisible="False">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Aucune demande" Style="{StaticResource CardTitleLabel}" />
                        <Label Text="Vos demandes apparaîtront ici après envoi." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
    <controls:ClientBottomNavigation Grid.Row="1" ActiveTab="requests" />
    </Grid>
</ContentPage>
