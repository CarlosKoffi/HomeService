<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HomeService.Client.Mobile.Pages.ProfilePage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Profil" BackgroundColor="White">
 <ScrollView><VerticalStackLayout Padding="22,22,22,30" Spacing="0">
  <Label Text="Mon profil" FontSize="20" FontAttributes="Bold" Margin="0,0,0,24"/>
  <Border x:Name="LoggedOutCard" Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="18"><VerticalStackLayout Spacing="10"><Label Text="Connectez-vous" FontSize="18" FontAttributes="Bold"/><Label Text="Accédez à vos informations et à vos demandes." Style="{StaticResource MutedLabel}"/><Button Text="Se connecter" Clicked="OnLoginClicked"/><Button Text="Créer un compte" BackgroundColor="White" TextColor="{StaticResource Ink}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnRegisterClicked"/></VerticalStackLayout></Border>
  <VerticalStackLayout x:Name="LoggedInSection" Spacing="0" IsVisible="False">
   <Grid ColumnDefinitions="54,*" ColumnSpacing="14" Margin="0,0,0,22"><Border BackgroundColor="#EAF1FF" StrokeThickness="0" StrokeShape="RoundRectangle 27" HeightRequest="54" WidthRequest="54"><Label x:Name="InitialsLabel" TextColor="{StaticResource WeleBlue}" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"><Label x:Name="NameLabel" FontSize="17" FontAttributes="Bold"/><Label x:Name="PhoneLabel" FontSize="13" TextColor="{StaticResource MutedInk}"/></VerticalStackLayout></Grid>
   <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}"/>
   <Grid Padding="4,16" ColumnDefinitions="34,*,Auto"><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnInformationClicked"/></Grid.GestureRecognizers><Label Text="ID" FontSize="10" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center"/><Label Grid.Column="1" Text="Mes informations" FontSize="14" VerticalTextAlignment="Center"/><Label Grid.Column="2" Text="›" FontSize="22"/></Grid><BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}"/>
   <Grid Padding="4,16" ColumnDefinitions="34,*,Auto"><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnAddressesClicked"/></Grid.GestureRecognizers><Label Text="⌖" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center"/><Label Grid.Column="1" Text="Mes adresses" FontSize="14" VerticalTextAlignment="Center"/><Label Grid.Column="2" Text="›" FontSize="22"/></Grid><BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}"/>
   <Grid Padding="4,16" ColumnDefinitions="34,*,Auto"><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnPaymentMethodsClicked"/></Grid.GestureRecognizers><Label Text="CB" FontSize="10" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center"/><Label Grid.Column="1" Text="Moyens de paiement" FontSize="14" VerticalTextAlignment="Center"/><Label Grid.Column="2" Text="›" FontSize="22"/></Grid><BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}"/>
   <Grid Padding="4,16" ColumnDefinitions="34,*,Auto"><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRequestsClicked"/></Grid.GestureRecognizers><Label Text="☰" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center"/><Label Grid.Column="1" Text="Mes demandes" FontSize="14" VerticalTextAlignment="Center"/><Label Grid.Column="2" Text="›" FontSize="22"/></Grid><BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}"/>
   <Grid Padding="4,16" ColumnDefinitions="34,*,Auto"><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnReviewsClicked"/></Grid.GestureRecognizers><Label Text="★" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center"/><Label Grid.Column="1" Text="Mes avis" FontSize="14" VerticalTextAlignment="Center"/><Label Grid.Column="2" Text="›" FontSize="22"/></Grid><BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}"/>
   <Grid Padding="4,16" ColumnDefinitions="34,*,Auto"><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnNotificationsClicked"/></Grid.GestureRecognizers><Label Text="!" TextColor="{StaticResource WeleBlue}" FontAttributes="Bold" VerticalTextAlignment="Center"/><Label Grid.Column="1" Text="Notifications" FontSize="14" VerticalTextAlignment="Center"/><Label Grid.Column="2" Text="›" FontSize="22"/></Grid><BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}"/>
   <Grid Padding="4,16" ColumnDefinitions="34,*,Auto"><Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnSettingsClicked"/></Grid.GestureRecognizers><Label Text="⚙" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center"/><Label Grid.Column="1" Text="Paramètres" FontSize="14" VerticalTextAlignment="Center"/><Label Grid.Column="2" Text="›" FontSize="22"/></Grid>
  </VerticalStackLayout>
 </VerticalStackLayout></ScrollView>
</ContentPage>
