<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HomeService.Client.Mobile.Controls"
    Shell.TabBarIsVisible="False"
    Title="Profil"
    BackgroundColor="White">
    <Grid RowDefinitions="*,72">
    <ScrollView BackgroundColor="White">
        <VerticalStackLayout Padding="20,18,20,28" Spacing="0">
            <Grid ColumnDefinitions="*,40" Margin="0,0,0,22">
                <Label Text="Mon profil" FontSize="18" FontAttributes="Bold" VerticalTextAlignment="Center" />
                <controls:ClientNotificationButton Grid.Column="1" />
            </Grid>

            <Border x:Name="LoggedOutCard" Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 14" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Connectez-vous" FontSize="17" FontAttributes="Bold" />
                    <Label Text="Accédez à vos informations et à vos demandes." Style="{StaticResource MutedLabel}" />
                    <Button Text="Se connecter" Clicked="OnLoginClicked" />
                    <Button Text="Créer un compte" BackgroundColor="White" TextColor="{StaticResource Ink}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnRegisterClicked" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="LoggedInSection" Spacing="0" IsVisible="False">
                <Grid ColumnDefinitions="56,*" ColumnSpacing="14" Margin="0,0,0,18">
                    <Grid HeightRequest="56" WidthRequest="56">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnProfilePhotoClicked" /></Grid.GestureRecognizers>
                        <Border BackgroundColor="#EAF1FF" StrokeThickness="0" StrokeShape="RoundRectangle 28">
                            <Image x:Name="ProfilePhotoImage" Source="nav_profile.svg" Aspect="AspectFill" />
                        </Border>
                        <Border BackgroundColor="{StaticResource WeleBlue}" Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 11"
                                HeightRequest="22" WidthRequest="22" HorizontalOptions="End" VerticalOptions="End">
                            <Label Text="+" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label x:Name="NameLabel" FontSize="15" FontAttributes="Bold" />
                        <Label x:Name="PhoneLabel" FontSize="11" TextColor="{StaticResource MutedInk}" />
                        <Label Text="Touchez la photo pour la modifier" FontSize="10" TextColor="{StaticResource WeleBlue}" />
                    </VerticalStackLayout>
                </Grid>
                <Label x:Name="PhotoStatusLabel" IsVisible="False" FontSize="11" Margin="0,-8,0,14" />

                <Grid Padding="0,13" ColumnDefinitions="30,*,Auto">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnInformationClicked" /></Grid.GestureRecognizers>
                    <Image Source="profile_information.svg" HeightRequest="17" WidthRequest="17" />
                    <Label Grid.Column="1" Text="Mes informations" FontSize="13" VerticalTextAlignment="Center" />
                    <Image Grid.Column="2" Source="chevron_right.svg" HeightRequest="14" WidthRequest="14" />
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}" />
                <Grid Padding="0,13" ColumnDefinitions="30,*,Auto">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnAddressesClicked" /></Grid.GestureRecognizers>
                    <Image Source="profile_address.svg" HeightRequest="17" WidthRequest="17" />
                    <Label Grid.Column="1" Text="Mes adresses" FontSize="13" VerticalTextAlignment="Center" />
                    <Image Grid.Column="2" Source="chevron_right.svg" HeightRequest="14" WidthRequest="14" />
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}" />
                <Grid Padding="0,13" ColumnDefinitions="30,*,Auto">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnPaymentMethodsClicked" /></Grid.GestureRecognizers>
                    <Image Source="profile_payment.svg" HeightRequest="17" WidthRequest="17" />
                    <Label Grid.Column="1" Text="Moyens de paiement" FontSize="13" VerticalTextAlignment="Center" />
                    <Image Grid.Column="2" Source="chevron_right.svg" HeightRequest="14" WidthRequest="14" />
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}" />
                <Grid Padding="0,13" ColumnDefinitions="30,*,Auto">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRequestsClicked" /></Grid.GestureRecognizers>
                    <Image Source="nav_requests.svg" HeightRequest="17" WidthRequest="17" />
                    <Label Grid.Column="1" Text="Mes demandes" FontSize="13" VerticalTextAlignment="Center" />
                    <Image Grid.Column="2" Source="chevron_right.svg" HeightRequest="14" WidthRequest="14" />
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}" />
                <Grid Padding="0,13" ColumnDefinitions="30,*,Auto">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnReviewsClicked" /></Grid.GestureRecognizers>
                    <Image Source="profile_review.svg" HeightRequest="17" WidthRequest="17" />
                    <Label Grid.Column="1" Text="Mes avis" FontSize="13" VerticalTextAlignment="Center" />
                    <Image Grid.Column="2" Source="chevron_right.svg" HeightRequest="14" WidthRequest="14" />
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}" />
                <Grid Padding="0,13" ColumnDefinitions="30,*,Auto">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnNotificationsClicked" /></Grid.GestureRecognizers>
                    <Image Source="app_bell.svg" HeightRequest="17" WidthRequest="17" />
                    <Label Grid.Column="1" Text="Notifications" FontSize="13" VerticalTextAlignment="Center" />
                    <Image Grid.Column="2" Source="chevron_right.svg" HeightRequest="14" WidthRequest="14" />
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}" />
                <Grid Padding="0,13" ColumnDefinitions="30,*,Auto">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnSettingsClicked" /></Grid.GestureRecognizers>
                    <Image Source="profile_settings.svg" HeightRequest="17" WidthRequest="17" />
                    <Label Grid.Column="1" Text="Paramètres" FontSize="13" VerticalTextAlignment="Center" />
                    <Image Grid.Column="2" Source="chevron_right.svg" HeightRequest="14" WidthRequest="14" />
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    <controls:ClientBottomNavigation Grid.Row="1" ActiveTab="profile" />
    </Grid>
</ContentPage>
