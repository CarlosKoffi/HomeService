<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HomeService.Client.Mobile.Pages.PaymentSuccessPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False" BackgroundColor="White">
    <Grid Padding="28">
        <VerticalStackLayout VerticalOptions="Center" Spacing="18">
            <Border HeightRequest="76" WidthRequest="76" BackgroundColor="#2563EB" StrokeThickness="0" StrokeShape="RoundRectangle 38" HorizontalOptions="Center">
                <Label Text="✓" TextColor="White" FontSize="42" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
            <Label Text="Paiement effectué !" FontSize="25" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <Label Text="Merci pour votre confiance." TextColor="#6B7280" HorizontalTextAlignment="Center" />
            <Button Text="Revenir à la mission" Clicked="OnMissionClicked" Margin="0,18,0,0" />
            <Button Text="Voir la facture" Style="{StaticResource OutlineActionButton}" Clicked="OnInvoiceClicked" />
            <Label x:Name="ErrorLabel" TextColor="#DC2626" IsVisible="False" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
