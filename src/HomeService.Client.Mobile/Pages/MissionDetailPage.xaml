<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.MissionDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HomeService.Client.Mobile.Controls"
    Shell.TabBarIsVisible="False"
    Title="Mission"
    BackgroundColor="White">
    <Grid RowDefinitions="*,72">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="20,18,20,32" Spacing="18">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="&#x2039;" WidthRequest="42" HeightRequest="42" Padding="0" BackgroundColor="White" TextColor="{StaticResource Ink}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Ma demande" Style="{StaticResource ScreenTitleLabel}" />
                    <Label x:Name="TitleLabel" Text="Chargement..." Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout x:Name="OverviewPanel" Spacing="18">
                <CollectionView x:Name="TimelineView" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="24,*,Auto" Padding="0,0,0,16" ColumnSpacing="8">
                                <Border BackgroundColor="{Binding DotColor}" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="11" WidthRequest="11" HorizontalOptions="Center" Margin="0,4,0,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="{Binding TextColor}" />
                                    <Label Text="{Binding Subtitle}" FontSize="12" TextColor="{StaticResource MutedInk}" IsVisible="{Binding HasSubtitle}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding TimeLabel}" FontSize="12" TextColor="{StaticResource MutedInk}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Border x:Name="OverviewActionCard" IsVisible="False" Stroke="#DCE7FF" BackgroundColor="#F5F8FF" StrokeShape="RoundRectangle 18" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="OverviewActionCaption" Text="Action requise" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" />
                        <Label x:Name="OverviewActionTitle" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                        <Label x:Name="OverviewActionAmount" IsVisible="False" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" LineBreakMode="NoWrap" />
                        <VerticalStackLayout x:Name="OverviewPriceBreakdown" IsVisible="False" Spacing="8" Margin="0,6,0,4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="Montant de la prestation" FontSize="13" TextColor="{StaticResource Ink}" />
                                <Label x:Name="OverviewServiceAmountLabel" Grid.Column="1" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label x:Name="OverviewServiceFeeLabel" Text="Frais de service (4 %)" FontSize="13" TextColor="{StaticResource Ink}" />
                                <Label x:Name="OverviewServiceFeeAmountLabel" Grid.Column="1" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,3" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="Total à payer" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                                <Label x:Name="OverviewTotalAmountLabel" Grid.Column="1" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" />
                            </Grid>
                        </VerticalStackLayout>
                        <Label x:Name="OverviewActionHelp" FontSize="13" TextColor="{StaticResource MutedInk}" LineHeight="1.25" LineBreakMode="WordWrap" />
                        <Label x:Name="OverviewActionCountdownLabel" IsVisible="False" FontSize="13" FontAttributes="Bold" TextColor="#B54708" LineBreakMode="WordWrap" />
                        <Button x:Name="OverviewConfirmButton" Text="Accepter et payer" IsVisible="False" Clicked="OnConfirmClicked" Margin="0,6,0,0" />
                        <Button x:Name="OverviewChoosePaymentButton" Text="Choisir un moyen de paiement" IsVisible="False" Clicked="OnChoosePaymentClicked" Margin="0,6,0,0" />
                        <Button x:Name="OverviewCompleteButton" Text="Valider la fin de mission" IsVisible="False" Clicked="OnCompleteClicked" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Voir les détails" Clicked="OnShowDetailsClicked" BackgroundColor="White" TextColor="{StaticResource WeleBlue}" BorderColor="{StaticResource Line}" BorderWidth="1" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="DetailPanel" IsVisible="False" Spacing="18">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Récapitulatif" Style="{StaticResource CardTitleLabel}" LineBreakMode="NoWrap" />
                    <Border BackgroundColor="#EFF6FF" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,9">
                        <Label x:Name="StatusLabel" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" FontSize="13" LineBreakMode="WordWrap" />
                    </Border>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Service" Style="{StaticResource MutedLabel}" />
                        <Label x:Name="ServiceLabel" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                        <VerticalStackLayout x:Name="PrestationPanel" Spacing="3" IsVisible="False" Margin="0,6,0,0">
                            <Label Text="Prestation" Style="{StaticResource MutedLabel}" />
                            <Label x:Name="PrestationLabel" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="OptionPanel" Spacing="3" IsVisible="False" Margin="0,6,0,0">
                            <Label Text="Option" Style="{StaticResource MutedLabel}" />
                            <Label x:Name="OptionLabel" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Label Text="Adresse" Style="{StaticResource MutedLabel}" Margin="0,8,0,0" />
                        <Label x:Name="AddressLabel" FontSize="15" TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                        <Label x:Name="DateCaptionLabel" Text="Date de la demande" Style="{StaticResource MutedLabel}" Margin="0,8,0,0" />
                        <Label x:Name="DateLabel" FontSize="15" TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label x:Name="WaitingLabel" Text="Recherche d'une entreprise disponible" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" LineHeight="1.25" />
                <Label x:Name="TrackingLabel" FontSize="13" TextColor="{StaticResource MutedInk}" LineHeight="1.25" />

                <Border x:Name="RoutePanel" IsVisible="False" Stroke="#C9D9FF" StrokeThickness="1" BackgroundColor="#F7FAFF" StrokeShape="RoundRectangle 18" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrackProviderTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                        <Border BackgroundColor="White" Stroke="#DCE6FF" StrokeThickness="1" StrokeShape="RoundRectangle 14" HeightRequest="44" WidthRequest="44">
                            <Label Text="&#x2316;" FontSize="22" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label x:Name="TrackProviderTitleLabel" Text="Voir où se trouve le prestataire" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                            <Label x:Name="RouteEtaLabel" Text="Position en cours de mise à jour" FontSize="12" TextColor="{StaticResource WeleBlue}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="&#x203A;" FontSize="28" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

                <Border x:Name="ProviderCard" Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="14" IsVisible="False">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProviderTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="58,*,Auto" ColumnSpacing="12">
                            <Grid HeightRequest="58" WidthRequest="58">
                                <Border BackgroundColor="#EFF6FF" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                                    <Image Source="nav_profile.svg" HeightRequest="24" WidthRequest="24" />
                                </Border>
                                <Image x:Name="ProviderPhoto" Aspect="AspectFill" IsVisible="False" />
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label x:Name="ProviderLabel" FontAttributes="Bold" />
                                <Label x:Name="ProviderPhoneLabel" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="3" HorizontalOptions="End" VerticalOptions="Center">
                                <Label x:Name="ProviderRatingLabel" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" />
                                <Label x:Name="ProviderEtaLabel" FontSize="12" TextColor="{StaticResource MutedInk}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button x:Name="ProviderChatButton" Text="Message" BackgroundColor="White" TextColor="{StaticResource WeleBlue}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnOpenChatClicked" />
                            <Button Grid.Column="1" x:Name="CallButton" Text="Appeler" BackgroundColor="#EFF6FF" TextColor="{StaticResource WeleBlue}" Clicked="OnCallClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="ProviderDetailPanel" IsVisible="False" Spacing="10">
                    <Label Text="Intervention" Style="{StaticResource CardTitleLabel}" />
                    <Label x:Name="ProviderDetailLabel" FontSize="14" TextColor="{StaticResource Ink}" LineHeight="1.35" />
                    <Button x:Name="ProviderDetailChatButton" Text="Contacter" BackgroundColor="White" TextColor="{StaticResource WeleBlue}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnOpenChatClicked" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="PricePaymentPanel" Spacing="10">
                    <Label Text="Prix et paiement" Style="{StaticResource CardTitleLabel}" />
                    <VerticalStackLayout Spacing="3"><Label Text="Montant" Style="{StaticResource MutedLabel}" /><Label x:Name="PriceLabel" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" FontSize="16" LineBreakMode="WordWrap" /></VerticalStackLayout>
                    <VerticalStackLayout Spacing="3" Margin="0,6,0,0"><Label Text="Paiement" Style="{StaticResource MutedLabel}" /><Label x:Name="PaymentLabel" FontAttributes="Bold" FontSize="14" LineBreakMode="WordWrap" /></VerticalStackLayout>
                    <Button x:Name="ChoosePaymentButton" Text="Choisir un moyen de paiement" IsVisible="False" Clicked="OnChoosePaymentClicked" />
                    <Label x:Name="MessageLabel" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Button x:Name="ConfirmButton" Text="Accepter et payer" IsVisible="False" Clicked="OnConfirmClicked" />
                    <Button x:Name="CompleteButton" Text="Valider la fin de mission" IsVisible="False" Clicked="OnCompleteClicked" />
                    <Button x:Name="CancelButton" Text="Annuler la mission" IsVisible="False" BackgroundColor="White" TextColor="{StaticResource Danger}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnCancelClicked" />
                </VerticalStackLayout>

                <Border x:Name="AdditionalQuotesCard" Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 18" Padding="14" IsVisible="False">
                    <VerticalStackLayout Spacing="10"><Label Text="Devis complémentaire" Style="{StaticResource CardTitleLabel}" /><CollectionView x:Name="AdditionalQuotesView" SelectionMode="Single" SelectionChanged="OnAdditionalQuoteSelected"><CollectionView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Padding="0,8"><VerticalStackLayout><Label Text="{Binding Title}" FontAttributes="Bold" /><Label Text="{Binding Description}" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding ActionLabel}" TextColor="{StaticResource WeleBlue}" FontAttributes="Bold" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout>
                </Border>

                <Border x:Name="PhotosCard" Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 18" Padding="14" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Photos de votre demande" Style="{StaticResource CardTitleLabel}" />
                        <CollectionView x:Name="PhotosView" SelectionMode="None" HeightRequest="150" ItemsLayout="HorizontalList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout WidthRequest="132" Margin="0,0,10,0" Spacing="5">
                                        <Border HeightRequest="112" Stroke="#E5E7EB" StrokeShape="RoundRectangle 12" Padding="0" BackgroundColor="#F4F6FA">
                                            <Grid>
                                                <Image Source="{Binding PreviewSource}" Aspect="AspectFill" />
                                                <Label Text="Photo indisponible" FontSize="10" TextColor="{StaticResource MutedInk}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" IsVisible="{Binding IsPreviewMissing}" />
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding Caption}" FontSize="11" TextColor="{StaticResource MutedInk}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
    <controls:ClientBottomNavigation Grid.Row="1" ActiveTab="requests" />
    </Grid>
</ContentPage>
