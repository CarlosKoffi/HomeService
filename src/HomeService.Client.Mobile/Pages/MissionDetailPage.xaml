<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.MissionDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mission">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,28" Spacing="16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="&#x2039;" WidthRequest="42" HeightRequest="42" Padding="0" BackgroundColor="White" TextColor="{StaticResource Ink}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" Spacing="3">
                    <Label Text="Détail de la demande" Style="{StaticResource ScreenTitleLabel}" />
                    <Label x:Name="TitleLabel" Text="Chargement..." Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="MISSION" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource MutedInk}" CharacterSpacing="1.1" />
                            <Label x:Name="ServiceLabel" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                            <Label x:Name="AddressLabel" FontSize="12" TextColor="{StaticResource MutedInk}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="#1D4ED8" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="10,6" VerticalOptions="Start">
                            <Label x:Name="StatusLabel" FontAttributes="Bold" TextColor="White" FontSize="12" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}" />
                    <Label x:Name="TrackingLabel" FontSize="13" TextColor="{StaticResource Ink}" LineHeight="1.25" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="ProviderCard" Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 22" Padding="16" IsVisible="False">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="58,*,Auto" ColumnSpacing="12">
                        <Grid HeightRequest="58" WidthRequest="58">
                            <Border BackgroundColor="#EFF6FF" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                                <Label Text="&#x1F464;" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="22" />
                            </Border>
                            <Image x:Name="ProviderPhoto" Aspect="AspectFill" IsVisible="False" />
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Votre professionnel" FontSize="12" TextColor="{StaticResource MutedInk}" />
                            <Label x:Name="ProviderLabel" FontAttributes="Bold" />
                            <Label x:Name="ProviderPhoneLabel" Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="3" HorizontalOptions="End" VerticalOptions="Center">
                            <Label x:Name="ProviderRatingLabel" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="End" />
                            <Label x:Name="ProviderEtaLabel" FontSize="12" TextColor="{StaticResource MutedInk}" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Message" BackgroundColor="White" TextColor="{StaticResource WeleBlue}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnOpenChatClicked" MinimumHeightRequest="46" />
                        <Button Grid.Column="1" x:Name="CallButton" Text="Appeler" BackgroundColor="#EFF6FF" TextColor="{StaticResource WeleBlue}" Clicked="OnCallClicked" MinimumHeightRequest="46" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 22" Padding="18">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Suivi de la mission" Style="{StaticResource CardTitleLabel}" />
                    <CollectionView x:Name="TimelineView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="26,*" Padding="0,0,0,12">
                                    <Border BackgroundColor="{Binding DotColor}" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="12" WidthRequest="12" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,4,0,0" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" TextColor="{Binding TextColor}" />
                                        <Label Text="{Binding Subtitle}" FontSize="12" TextColor="{StaticResource MutedInk}" IsVisible="{Binding HasSubtitle}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 22" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Prix et paiement" Style="{StaticResource CardTitleLabel}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Montant" Style="{StaticResource MutedLabel}" />
                        <Label Grid.Column="1" x:Name="PriceLabel" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Paiement" Style="{StaticResource MutedLabel}" />
                        <Label Grid.Column="1" x:Name="PaymentLabel" FontAttributes="Bold" />
                    </Grid>
                    <Button x:Name="ChoosePaymentButton" Text="Choisir un moyen de paiement" IsVisible="False" Clicked="OnChoosePaymentClicked" />
                    <Label x:Name="MessageLabel" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Button x:Name="ConfirmButton" Text="Accepter le devis et payer" IsVisible="False" Clicked="OnConfirmClicked" />
                <Button x:Name="CompleteButton" Text="Valider la fin de mission" IsVisible="False" Clicked="OnCompleteClicked" />
                <Button x:Name="CancelButton" Text="Annuler la mission" IsVisible="False" BackgroundColor="White" TextColor="{StaticResource Danger}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnCancelClicked" />
            </VerticalStackLayout>

            <Border x:Name="AdditionalQuotesCard" Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 22" Padding="18" IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Devis complémentaire" Style="{StaticResource CardTitleLabel}" />
                    <CollectionView x:Name="AdditionalQuotesView" SelectionMode="Single" SelectionChanged="OnAdditionalQuoteSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{StaticResource Line}" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 16" Padding="12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                                            <Label Text="{Binding Description}" Style="{StaticResource MutedLabel}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding ActionLabel}" TextColor="{StaticResource WeleBlue}" FontAttributes="Bold" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="PhotosCard" Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 22" Padding="18" IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Photos" Style="{StaticResource CardTitleLabel}" />
                    <CollectionView x:Name="PhotosView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{StaticResource Line}" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 16" Padding="12" Margin="0,0,0,8">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding FileName}" FontAttributes="Bold" />
                                        <Label Text="{Binding Caption}" Style="{StaticResource MutedLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
