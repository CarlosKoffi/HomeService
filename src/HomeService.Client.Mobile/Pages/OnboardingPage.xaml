<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.OnboardingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Title="Présentation">
    <Grid RowDefinitions="*,Auto" Padding="18,14,18,24" BackgroundColor="White">
        <CarouselView
            x:Name="SlidesView"
            ItemsSource="{Binding Slides}"
            IndicatorView="{x:Reference SlidesIndicator}"
            PositionChanged="OnPositionChanged">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0">
                        <Image
                            Source="{Binding ImageSource}"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            VerticalOptions="Fill" />
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <VerticalStackLayout Grid.Row="1" Spacing="16">
            <IndicatorView
                x:Name="SlidesIndicator"
                IndicatorColor="#DBEAFE"
                SelectedIndicatorColor="{StaticResource WeleBlue}"
                HorizontalOptions="Center" />
            <Button x:Name="NextButton" Text="Suivant" Clicked="OnNextClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
