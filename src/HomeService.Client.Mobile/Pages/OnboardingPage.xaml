<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.OnboardingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="White"
    Title="Présentation">
    <Grid>
        <Grid.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Left" Swiped="OnSwiped" />
            <SwipeGestureRecognizer Direction="Right" Swiped="OnSwiped" />
        </Grid.GestureRecognizers>
        <Grid
            Padding="28,34,28,24"
            RowDefinitions="Auto,Auto,*,Auto,Auto"
            RowSpacing="14"
            HorizontalOptions="Center"
            MaximumWidthRequest="440">
            <Label
                x:Name="BrandLabel"
                Text="wélé"
                FontSize="31"
                FontAttributes="Bold"
                TextColor="{StaticResource WeleBlue}" />

            <VerticalStackLayout Grid.Row="1" Spacing="12">
                <Label
                    x:Name="TitleLabel"
                    FontSize="28"
                    FontAttributes="Bold"
                    LineHeight="1.15"
                    TextColor="#080B16" />
                <Label
                    x:Name="LeadLabel"
                    FontSize="18"
                    FontAttributes="Bold"
                    LineHeight="1.3"
                    TextColor="#111827" />
                <Label
                    x:Name="BodyLabel"
                    FontSize="15"
                    LineHeight="1.45"
                    TextColor="#586174" />
            </VerticalStackLayout>

            <Grid
                x:Name="IllustrationViewport"
                Grid.Row="2"
                Margin="0,6,0,0"
                HeightRequest="240"
                IsClippedToBounds="True"
                VerticalOptions="Center">
                <Image
                    x:Name="IllustrationImage"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <Border
                    x:Name="TechnicianStatusCard"
                    Margin="0,0,0,2"
                    Padding="10,8"
                    WidthRequest="250"
                    HeightRequest="58"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    BackgroundColor="White"
                    Stroke="#E7EAF0"
                    StrokeThickness="1"
                    IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="9">
                        <Border
                            WidthRequest="38"
                            HeightRequest="38"
                            BackgroundColor="#EAF1FF"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="19" />
                            </Border.StrokeShape>
                            <Label
                                Text="MK"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource WeleBlue}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label
                                Text="Mohamed Kouyaté"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#080B16"
                                LineBreakMode="TailTruncation" />
                            <Label
                                Text="Technicien en route"
                                FontSize="9"
                                TextColor="#586174" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                            <Label
                                Text="12 min"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{StaticResource WeleBlue}"
                                HorizontalTextAlignment="End" />
                            <Label
                                Text="avant arrivée"
                                FontSize="8"
                                TextColor="#586174"
                                HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>

            <HorizontalStackLayout
                Grid.Row="3"
                HorizontalOptions="Center"
                Spacing="7">
                <Ellipse x:Name="DotOne" WidthRequest="8" HeightRequest="8" />
                <Ellipse x:Name="DotTwo" WidthRequest="8" HeightRequest="8" />
                <Ellipse x:Name="DotThree" WidthRequest="8" HeightRequest="8" />
            </HorizontalStackLayout>

            <Button
                x:Name="NextButton"
                Grid.Row="4"
                Text="Suivant"
                CornerRadius="7"
                HeightRequest="54"
                FontSize="16"
                FontAttributes="Bold"
                Clicked="OnNextClicked" />
        </Grid>
    </Grid>
</ContentPage>
