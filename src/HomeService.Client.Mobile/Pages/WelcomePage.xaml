<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Title="Bienvenue">
    <Grid RowDefinitions="*,Auto" Padding="22,28,22,28">
        <VerticalStackLayout Spacing="22" VerticalOptions="Center">
            <Label Text="wélé" FontSize="34" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" />
            <VerticalStackLayout Spacing="8">
                <Label Text="Bonjour" Style="{StaticResource ScreenTitleLabel}" />
                <Label Text="Connectez-vous ou creez votre compte pour commander un service." Style="{StaticResource BodyLabel}" />
            </VerticalStackLayout>

            <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 28" Padding="24" HeightRequest="230">
                <Grid>
                    <Border BackgroundColor="#EFF6FF" StrokeThickness="0" StrokeShape="RoundRectangle 100" HeightRequest="112" WidthRequest="112" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="&#x1F44B;" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="46" />
                    </Border>
                    <Border BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 18" Padding="12" HorizontalOptions="End" VerticalOptions="End">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Fiable. Rapide." FontAttributes="Bold" />
                            <Label Text="Professionnel." Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="12">
            <Button Text="Se connecter" Clicked="OnLoginClicked" />
            <Button Text="Creer un compte" BackgroundColor="White" TextColor="{StaticResource Ink}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnRegisterClicked" />
            <Label Text="En continuant, vous acceptez nos conditions d'utilisation." FontSize="12" TextColor="{StaticResource MutedInk}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
