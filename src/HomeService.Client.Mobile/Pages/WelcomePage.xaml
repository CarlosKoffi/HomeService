<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="White"
    Title="Bienvenue">
    <Grid
        Padding="24,40,24,28"
        RowDefinitions="Auto,*,Auto"
        HorizontalOptions="Fill"
        MaximumWidthRequest="430">
        <VerticalStackLayout Spacing="30">
            <Label
                Text="wélé"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{StaticResource WeleBlue}" />

            <VerticalStackLayout Spacing="10">
                <Label
                    Text="Bonjour 👋"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#09090B" />
                <Label
                    Text="Connectez-vous ou créez votre compte pour continuer."
                    FontSize="13"
                    LineHeight="1.35"
                    TextColor="#4B5563" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="1"
            Margin="0,28,0,0"
            Spacing="12">
            <Button
                Text="Se connecter"
                CornerRadius="7"
                HeightRequest="50"
                Clicked="OnLoginClicked" />
            <Button
                Text="Créer un compte"
                CornerRadius="7"
                HeightRequest="50"
                BackgroundColor="White"
                TextColor="#111827"
                BorderColor="#D1D5DB"
                BorderWidth="1"
                Clicked="OnRegisterClicked" />

            <Grid Margin="0,22,0,12" ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                <BoxView HeightRequest="1" Color="#E5E7EB" VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="ou continuer avec"
                    FontSize="12"
                    TextColor="#6B7280" />
                <BoxView Grid.Column="2" HeightRequest="1" Color="#E5E7EB" VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border
                    HeightRequest="56"
                    Padding="0"
                    Stroke="#E2E5EA"
                    StrokeShape="RoundRectangle 11">
                    <ImageButton
                        Source="auth_google.png"
                        Padding="17"
                        BackgroundColor="White"
                        AutomationId="GoogleSignInButton"
                        Clicked="OnGoogleClicked" />
                </Border>
                <Border
                    Grid.Column="1"
                    HeightRequest="56"
                    Padding="0"
                    Stroke="#E2E5EA"
                    StrokeShape="RoundRectangle 11">
                    <ImageButton
                        Source="auth_apple.png"
                        Padding="17"
                        BackgroundColor="White"
                        AutomationId="AppleSignInButton"
                        Clicked="OnAppleClicked" />
                </Border>
                <Border
                    Grid.Column="2"
                    HeightRequest="56"
                    Padding="0"
                    Stroke="#E2E5EA"
                    StrokeShape="RoundRectangle 11">
                    <ImageButton
                        Source="auth_phone.png"
                        Padding="17"
                        BackgroundColor="White"
                        AutomationId="PhoneSignInButton"
                        Clicked="OnPhoneClicked" />
                </Border>
            </Grid>
        </VerticalStackLayout>

        <Label
            Grid.Row="2"
            Text="En continuant, vous acceptez nos&#10;Conditions d’utilisation et Politique&#10;de confidentialité."
            FontSize="10"
            LineHeight="1.3"
            TextColor="#6B7280"
            HorizontalTextAlignment="Center" />
    </Grid>
</ContentPage>
