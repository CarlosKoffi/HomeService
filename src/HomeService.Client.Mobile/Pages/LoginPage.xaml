<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Connexion">
    <ScrollView>
        <VerticalStackLayout Padding="22,24,22,28" Spacing="22">
            <VerticalStackLayout Spacing="8">
                <Label Text="wélé" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" />
                <Label Text="Se connecter" Style="{StaticResource ScreenTitleLabel}" />
                <Label Text="Suivez vos demandes et parlez au professionnel depuis votre compte." Style="{StaticResource BodyLabel}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14">
                <VerticalStackLayout Spacing="7">
                    <Label Text="Telephone ou email" FontSize="13" FontAttributes="Bold" />
                    <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 14" Padding="14,0">
                        <Entry x:Name="PhoneEntry" Placeholder="07 12 34 56 78" Keyboard="Telephone" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Mot de passe" FontSize="13" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="Mot de passe oublie ?" FontSize="12" TextColor="{StaticResource WeleBlue}" />
                    </Grid>
                    <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 14" Padding="14,0">
                        <Entry x:Name="PasswordEntry" Placeholder="Votre mot de passe" IsPassword="True" />
                    </Border>
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="RememberCheckBox" IsChecked="True" Color="{StaticResource WeleBlue}" />
                    <Label Text="Rester connecte" FontSize="13" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Button Text="Se connecter" Clicked="OnLoginClicked" />
                <Button Text="Creer un compte" BackgroundColor="White" TextColor="{StaticResource Ink}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnRegisterClicked" />
            </VerticalStackLayout>

            <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" FontAttributes="Bold" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
