<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="White"
    Title="Connexion">
    <ScrollView>
        <VerticalStackLayout
            Padding="24,38,24,28"
            Spacing="24"
            HorizontalOptions="Fill"
            MaximumWidthRequest="390">
            <Label
                Text="Se connecter"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#09090B" />

            <VerticalStackLayout Spacing="14">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Téléphone ou email" FontSize="10" TextColor="#374151" />
                    <Border HeightRequest="40" Stroke="#DCE1E8" BackgroundColor="White" StrokeShape="RoundRectangle 6" Padding="11,0">
                        <Entry
                            x:Name="PhoneEntry"
                            Placeholder="07 12 34 56 78"
                            Keyboard="Email"
                            FontSize="12"
                            MinimumHeightRequest="0"
                            HeightRequest="38" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Mot de passe" FontSize="10" TextColor="#374151" />
                        <Label
                            Grid.Column="1"
                            Text="Mot de passe oublié ?"
                            FontSize="9"
                            FontAttributes="Bold"
                            TextColor="{StaticResource WeleBlue}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border HeightRequest="40" Stroke="#DCE1E8" BackgroundColor="White" StrokeShape="RoundRectangle 6" Padding="11,0">
                        <Grid ColumnDefinitions="*,28">
                            <Entry
                                x:Name="PasswordEntry"
                                Placeholder="Votre mot de passe"
                                IsPassword="True"
                                FontSize="12"
                                MinimumHeightRequest="0"
                                HeightRequest="38" />
                            <Button
                                Grid.Column="1"
                                Text="◉"
                                FontSize="12"
                                MinimumHeightRequest="0"
                                HeightRequest="30"
                                Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="#6B7280"
                                Clicked="OnTogglePasswordClicked" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Button
                    Text="Se connecter"
                    Margin="0,3,0,0"
                    CornerRadius="6"
                    FontSize="12"
                    MinimumHeightRequest="0"
                    HeightRequest="42"
                    Clicked="OnLoginClicked" />
            </VerticalStackLayout>

            <Label
                x:Name="ErrorLabel"
                TextColor="{StaticResource Danger}"
                FontSize="11"
                FontAttributes="Bold"
                IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
