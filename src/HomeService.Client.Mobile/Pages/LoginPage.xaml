<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="White"
    Title="Connexion">
    <ScrollView>
        <VerticalStackLayout
            Padding="24,58,24,32"
            Spacing="28"
            HorizontalOptions="Fill"
            MaximumWidthRequest="430">
            <Label
                Text="Se connecter"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#09090B" />

            <VerticalStackLayout Spacing="17">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Téléphone ou email" FontSize="11" TextColor="#374151" />
                    <Border Stroke="#D1D5DB" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="14,0">
                        <Entry
                            x:Name="PhoneEntry"
                            Placeholder="07 12 34 56 78"
                            Keyboard="Email"
                            HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Mot de passe" FontSize="11" TextColor="#374151" />
                        <Label
                            Grid.Column="1"
                            Text="Mot de passe oublié ?"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource WeleBlue}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border Stroke="#D1D5DB" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="14,0">
                        <Grid ColumnDefinitions="*,36">
                            <Entry
                                x:Name="PasswordEntry"
                                Placeholder="Votre mot de passe"
                                IsPassword="True"
                                HeightRequest="48" />
                            <Button
                                Grid.Column="1"
                                Text="◉"
                                FontSize="15"
                                Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="#6B7280"
                                Clicked="OnTogglePasswordClicked" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Button
                    Text="Se connecter"
                    Margin="0,4,0,0"
                    CornerRadius="7"
                    HeightRequest="50"
                    Clicked="OnLoginClicked" />
            </VerticalStackLayout>

            <Label
                x:Name="ErrorLabel"
                TextColor="{StaticResource Danger}"
                FontSize="12"
                FontAttributes="Bold"
                IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
