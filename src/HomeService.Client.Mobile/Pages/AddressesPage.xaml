<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HomeService.Client.Mobile.Pages.AddressesPage"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:controls="clr-namespace:HomeService.Client.Mobile.Controls"
 xmlns:clients="clr-namespace:HomeService.Contracts.Clients;assembly=HomeService.Contracts"
 Shell.TabBarIsVisible="False" Title="Mes adresses" BackgroundColor="White">
 <Grid RowDefinitions="*,72">
  <Grid Padding="20,16,20,20" RowDefinitions="Auto,Auto,*" RowSpacing="14">
   <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
    <Button Style="{StaticResource BackIconButton}" Clicked="OnBackClicked"/>
    <Label Grid.Column="1" Text="Mes adresses" Style="{StaticResource SubpageTitleLabel}"/>
   </Grid>
   <Button Grid.Row="1" Text="+  Ajouter une adresse" Style="{StaticResource OutlineActionButton}" Clicked="OnAddClicked"/>
   <Grid Grid.Row="2">
    <CollectionView x:Name="AddressesView" SelectionMode="Single" SelectionChanged="OnAddressSelected">
     <CollectionView.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource CompactListBorder}">
       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <VerticalStackLayout Spacing="3"><Label Text="{Binding Label}" FontSize="15" FontAttributes="Bold"/><Label Text="{Binding AddressLine}" Style="{StaticResource MutedLabel}"/></VerticalStackLayout>
        <Label Grid.Column="1" Text="{Binding Status}" FontSize="12" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="End" VerticalTextAlignment="Center"/>
       </Grid>
      </Border>
     </DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>
    <Label x:Name="EmptyState" Text="Aucune adresse enregistrée." Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" IsVisible="False"/>
   </Grid>
  </Grid>
  <controls:ClientBottomNavigation Grid.Row="1" ActiveTab="profile" />
  <Grid x:Name="EditorOverlay" Grid.RowSpan="2" IsVisible="False" BackgroundColor="#66000000" Padding="16">
   <Border VerticalOptions="End" BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 18" Padding="18" Margin="0,80,0,0">
    <VerticalStackLayout Spacing="12">
     <Grid ColumnDefinitions="*,Auto"><Label x:Name="EditorTitle" Text="Nouvelle adresse" Style="{StaticResource SubpageTitleLabel}"/><Button Grid.Column="1" Text="×" FontSize="22" BackgroundColor="Transparent" TextColor="{StaticResource Ink}" Padding="8,0" Clicked="OnCloseEditorClicked"/></Grid>
     <Label Text="Nom de l'adresse" FontSize="12" FontAttributes="Bold"/><Border Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 10" Padding="12,2"><Entry x:Name="LabelEntry" Placeholder="Ex. Maison, Bureau" MaxLength="40"/></Border>
     <Label Text="Adresse" FontSize="12" FontAttributes="Bold"/>
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Border Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 10" Padding="12,2"><Entry x:Name="AddressEntry" Placeholder="Commune, quartier, rue..." MaxLength="160" TextChanged="OnAddressTextChanged"/></Border><Button Grid.Column="1" x:Name="LocateButton" Text="⌖" FontSize="22" WidthRequest="48" HeightRequest="48" Padding="0" BackgroundColor="#F4F7FF" TextColor="{StaticResource WeleBlue}" BorderColor="#DCE6FF" BorderWidth="1" CornerRadius="10" Clicked="OnLocateClicked"/></Grid>
     <Border x:Name="SuggestionsPanel" Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 10" Padding="0" IsVisible="False"><CollectionView x:Name="SuggestionsView" SelectionMode="Single" SelectionChanged="OnSuggestionSelected" MaximumHeightRequest="180"><CollectionView.ItemTemplate><DataTemplate x:DataType="clients:ClientAddressSuggestionResponse"><Grid Padding="12,9" RowDefinitions="Auto,Auto" RowSpacing="2"><Label Text="{Binding MainText}" FontSize="12" FontAttributes="Bold"/><Label Grid.Row="1" Text="{Binding SecondaryText}" FontSize="10" TextColor="#687386" LineBreakMode="TailTruncation"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></Border>
     <HorizontalStackLayout Spacing="8"><CheckBox x:Name="DefaultCheckBox" Color="{StaticResource WeleBlue}"/><Label Text="Utiliser par défaut" VerticalTextAlignment="Center"/></HorizontalStackLayout>
     <Label x:Name="EditorError" TextColor="{StaticResource Danger}" FontSize="12" IsVisible="False"/><Button x:Name="SaveButton" Text="Enregistrer l'adresse" Clicked="OnSaveClicked"/>
    </VerticalStackLayout>
   </Border>
  </Grid>
 </Grid>
</ContentPage>
