<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HomeService.Client.Mobile.Pages.AddressesPage"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Mes adresses">
 <Grid Padding="20,18,20,24" RowDefinitions="Auto,Auto,*" RowSpacing="16">
  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Button Text="‹" FontSize="28" BackgroundColor="Transparent" TextColor="{StaticResource Ink}" Padding="0" WidthRequest="32" Clicked="OnBackClicked"/><Label Grid.Column="1" Text="Mes adresses" FontSize="20" FontAttributes="Bold" VerticalTextAlignment="Center"/></Grid>
  <Button Grid.Row="1" Text="＋  Ajouter une adresse" BackgroundColor="White" TextColor="{StaticResource WeleBlue}" BorderColor="{StaticResource Line}" BorderWidth="1" HeightRequest="50" Clicked="OnAddClicked"/>
  <Grid Grid.Row="2">
   <CollectionView x:Name="AddressesView" SelectionMode="Single" SelectionChanged="OnAddressSelected"><CollectionView.ItemTemplate><DataTemplate>
    <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="14" Margin="0,0,0,10"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="4"><Label Text="{Binding Label}" FontAttributes="Bold"/><Label Text="{Binding AddressLine}" Style="{StaticResource MutedLabel}"/></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Status}" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center"/></Grid></Border>
   </DataTemplate></CollectionView.ItemTemplate></CollectionView>
   <Label x:Name="EmptyState" Text="Aucune adresse enregistrée." Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" IsVisible="False"/>
  </Grid>
 </Grid>
</ContentPage>
