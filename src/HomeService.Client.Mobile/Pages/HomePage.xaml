<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="White"
    Title="Accueil">
    <Grid RowDefinitions="*,62" MaximumWidthRequest="430" HorizontalOptions="Fill">
        <RefreshView x:Name="Refresh" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="18,20,18,24" Spacing="18">
                    <Grid ColumnDefinitions="*,32">
                        <Label x:Name="GreetingLabel" Text="Bonjour 👋" FontSize="14" FontAttributes="Bold" VerticalTextAlignment="Center" />
                        <Button Grid.Column="1" Text="♧" FontSize="17" FontAttributes="None" MinimumHeightRequest="0" HeightRequest="32" WidthRequest="32" Padding="0" BackgroundColor="Transparent" TextColor="#111827" Clicked="OnNotificationsClicked" />
                    </Grid>

                    <Border HeightRequest="38" Stroke="#EDF0F4" BackgroundColor="#F7F8FA" StrokeShape="RoundRectangle 10" Padding="11,0">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="6">
                            <Label Text="⌕" FontSize="16" TextColor="#8992A3" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Entry Grid.Column="1" x:Name="SearchEntry" Placeholder="Que recherchez-vous aujourd'hui ?" FontSize="10" MinimumHeightRequest="0" HeightRequest="36" ReturnType="Search" Completed="OnSearchCompleted" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Pour ma maison" FontSize="12" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Voir plus" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center" />
                        </Grid>
                        <CollectionView x:Name="HomeServicesView" HeightRequest="64" ItemsLayout="HorizontalList" SelectionMode="Single" SelectionChanged="OnServiceSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout WidthRequest="63" Spacing="4" Margin="0,0,5,0">
                                        <Border HeightRequest="38" WidthRequest="38" Padding="8" BackgroundColor="#F4F7FF" Stroke="#EDF1FA" StrokeShape="RoundRectangle 10" HorizontalOptions="Center">
                                            <Grid>
                                                <Image Source="{Binding IconUrl}" Aspect="AspectFit" IsVisible="{Binding HasIconUrl}" />
                                                <Label Text="{Binding IconFallback}" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" IsVisible="{Binding HasIconFallback}" />
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding Name}" FontSize="8" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Pour mon bien-être" FontSize="12" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Voir plus" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center" />
                        </Grid>
                        <CollectionView x:Name="WellbeingServicesView" HeightRequest="64" ItemsLayout="HorizontalList" SelectionMode="Single" SelectionChanged="OnServiceSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout WidthRequest="63" Spacing="4" Margin="0,0,5,0">
                                        <Border HeightRequest="38" WidthRequest="38" Padding="8" BackgroundColor="#F7F7FF" Stroke="#EFEFFC" StrokeShape="RoundRectangle 10" HorizontalOptions="Center">
                                            <Grid>
                                                <Image Source="{Binding IconUrl}" Aspect="AspectFit" IsVisible="{Binding HasIconUrl}" />
                                                <Label Text="{Binding IconFallback}" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" IsVisible="{Binding HasIconFallback}" />
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding Name}" FontSize="8" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Les plus demandés" FontSize="12" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Voir plus" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center" />
                        </Grid>
                        <CollectionView x:Name="PopularServicesView" HeightRequest="112" ItemsLayout="HorizontalList" SelectionMode="Single" SelectionChanged="OnServiceSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout WidthRequest="82" Spacing="5" Margin="0,0,8,0">
                                        <Border HeightRequest="72" Padding="0" BackgroundColor="#F2F4F7" Stroke="#E9EDF2" StrokeShape="RoundRectangle 9">
                                            <Grid>
                                                <Image Source="{Binding IconUrl}" Aspect="AspectFill" IsVisible="{Binding HasIconUrl}" />
                                                <Label Text="{Binding IconFallback}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" IsVisible="{Binding HasIconFallback}" />
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding Name}" FontSize="8" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="SearchResultsSection" Spacing="8" IsVisible="False">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Résultats" FontSize="12" FontAttributes="Bold" />
                            <Label x:Name="SearchCountLabel" Grid.Column="1" FontSize="9" TextColor="#6B7280" />
                        </Grid>
                        <CollectionView x:Name="SearchResultsView" SelectionMode="Single" SelectionChanged="OnSearchResultSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Stroke="#E9EDF2" StrokeShape="RoundRectangle 9" Padding="10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}" FontSize="10" FontAttributes="Bold" />
                                                <Label Text="{Binding Service}" FontSize="8" TextColor="#6B7280" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Price}" FontSize="9" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" BackgroundColor="White" Padding="8,5,8,3">
            <VerticalStackLayout Grid.Column="0" Spacing="1">
                <Label Text="⌂" FontSize="18" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" />
                <Label Text="Accueil" FontSize="8" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="1">
                <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnRequestsTapped" /></VerticalStackLayout.GestureRecognizers>
                <Label Text="▣" FontSize="17" TextColor="#6B7280" HorizontalTextAlignment="Center" />
                <Label Text="Demandes" FontSize="8" TextColor="#6B7280" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="+" FontSize="24" MinimumHeightRequest="0" HeightRequest="46" WidthRequest="46" Padding="0" CornerRadius="23" VerticalOptions="Start" TranslationY="-10" Clicked="OnCreateRequestClicked" />
            <VerticalStackLayout Grid.Column="3" Spacing="1">
                <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnMessagesTapped" /></VerticalStackLayout.GestureRecognizers>
                <Label Text="▢" FontSize="17" TextColor="#6B7280" HorizontalTextAlignment="Center" />
                <Label Text="Messages" FontSize="8" TextColor="#6B7280" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="4" Spacing="1">
                <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnProfileTapped" /></VerticalStackLayout.GestureRecognizers>
                <Label Text="♙" FontSize="17" TextColor="#6B7280" HorizontalTextAlignment="Center" />
                <Label Text="Profil" FontSize="8" TextColor="#6B7280" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
