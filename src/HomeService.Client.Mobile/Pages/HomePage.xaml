<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="White"
    Title="Accueil">
    <Grid RowDefinitions="*,72" HorizontalOptions="Fill">
        <RefreshView x:Name="Refresh" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="20,24,20,30" Spacing="22">
                    <Grid ColumnDefinitions="*,40">
                        <Label x:Name="GreetingLabel" Text="Bonjour" FontSize="17" FontAttributes="Bold" VerticalTextAlignment="Center" />
                        <ImageButton Grid.Column="1" Source="app_bell.png" HeightRequest="28" WidthRequest="28" Padding="3" BackgroundColor="Transparent" HorizontalOptions="End" Clicked="OnNotificationsClicked" />
                    </Grid>

                    <Border HeightRequest="46" Stroke="#EDF0F4" BackgroundColor="#F7F8FA" StrokeShape="RoundRectangle 12" Padding="13,0">
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="8">
                            <Image Source="app_search.png" HeightRequest="18" WidthRequest="18" />
                            <Entry Grid.Column="1" x:Name="SearchEntry" Placeholder="Que recherchez-vous aujourd'hui ?" FontSize="12" MinimumHeightRequest="0" HeightRequest="44" ReturnType="Search" Completed="OnSearchCompleted" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Pour ma maison" FontSize="15" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Voir plus" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center" />
                        </Grid>
                        <CollectionView x:Name="HomeServicesView" HeightRequest="78" ItemsLayout="HorizontalList" SelectionMode="Single" SelectionChanged="OnServiceSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout WidthRequest="72" Spacing="6" Margin="0,0,6,0">
                                        <Border HeightRequest="48" WidthRequest="48" Padding="10" BackgroundColor="#F4F7FF" Stroke="#EDF1FA" StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                                            <Grid>
                                                <Image Source="{Binding IconUrl}" Aspect="AspectFit" IsVisible="{Binding HasIconUrl}" />
                                                <Label Text="{Binding IconFallback}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" IsVisible="{Binding HasIconFallback}" />
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding Name}" FontSize="10" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Pour mon bien-être" FontSize="15" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Voir plus" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center" />
                        </Grid>
                        <CollectionView x:Name="WellbeingServicesView" HeightRequest="78" ItemsLayout="HorizontalList" SelectionMode="Single" SelectionChanged="OnServiceSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout WidthRequest="72" Spacing="6" Margin="0,0,6,0">
                                        <Border HeightRequest="48" WidthRequest="48" Padding="10" BackgroundColor="#F7F7FF" Stroke="#EFEFFC" StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                                            <Grid>
                                                <Image Source="{Binding IconUrl}" Aspect="AspectFit" IsVisible="{Binding HasIconUrl}" />
                                                <Label Text="{Binding IconFallback}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" IsVisible="{Binding HasIconFallback}" />
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding Name}" FontSize="10" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Les plus demandés" FontSize="15" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Voir plus" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center" />
                        </Grid>
                        <CollectionView x:Name="PopularServicesView" HeightRequest="146" ItemsLayout="HorizontalList" SelectionMode="Single" SelectionChanged="OnPopularSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout WidthRequest="106" Spacing="7" Margin="0,0,8,0">
                                        <Border HeightRequest="100" Padding="0" BackgroundColor="#F2F4F7" Stroke="#E9EDF2" StrokeShape="RoundRectangle 11">
                                            <Grid>
                                                <Image Source="{Binding IllustrationUrl}" Aspect="AspectFill" IsVisible="{Binding HasIllustration}" />
                                                <Label Text="{Binding Fallback}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" IsVisible="{Binding HasFallback}" />
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding Name}" FontSize="10" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="SearchResultsSection" Spacing="8" IsVisible="False">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Résultats" FontSize="12" FontAttributes="Bold" />
                            <Label x:Name="SearchCountLabel" Grid.Column="1" FontSize="9" TextColor="#6B7280" />
                        </Grid>
                        <CollectionView x:Name="SearchResultsView" SelectionMode="Single" SelectionChanged="OnSearchResultSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Stroke="#E9EDF2" StrokeShape="RoundRectangle 9" Padding="10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}" FontSize="10" FontAttributes="Bold" />
                                                <Label Text="{Binding Service}" FontSize="8" TextColor="#6B7280" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Price}" FontSize="9" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" BackgroundColor="White" Padding="10,8,10,5">
            <VerticalStackLayout Grid.Column="0" Spacing="3">
                <Image Source="nav_home.png" HeightRequest="23" WidthRequest="23" HorizontalOptions="Center" />
                <Label Text="Accueil" FontSize="10" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="3">
                <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnRequestsTapped" /></VerticalStackLayout.GestureRecognizers>
                <Image Source="nav_requests.png" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" />
                <Label Text="Demandes" FontSize="10" TextColor="#6B7280" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Border
                Grid.Column="2"
                HeightRequest="52"
                WidthRequest="52"
                Padding="0"
                BackgroundColor="{StaticResource WeleBlue}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 26"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                TranslationY="-13">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCreateRequestClicked" />
                </Border.GestureRecognizers>
                <Grid HeightRequest="52" WidthRequest="52">
                    <BoxView HeightRequest="2" WidthRequest="18" Color="White" HorizontalOptions="Center" VerticalOptions="Center" />
                    <BoxView HeightRequest="18" WidthRequest="2" Color="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>
            <VerticalStackLayout Grid.Column="3" Spacing="3">
                <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnMessagesTapped" /></VerticalStackLayout.GestureRecognizers>
                <Image Source="nav_messages.png" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" />
                <Label Text="Messages" FontSize="10" TextColor="#6B7280" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="4" Spacing="3">
                <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnProfileTapped" /></VerticalStackLayout.GestureRecognizers>
                <Image Source="nav_profile.png" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" />
                <Label Text="Profil" FontSize="10" TextColor="#6B7280" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
