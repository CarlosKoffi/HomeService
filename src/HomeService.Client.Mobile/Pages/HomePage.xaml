<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HomeService.Client.Mobile.Controls"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="White"
    Title="Accueil">
    <Grid RowDefinitions="*,72" HorizontalOptions="Fill">
        <RefreshView x:Name="Refresh" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="20,10,20,16" Spacing="13">
                    <Border
                        x:Name="LoadErrorPanel"
                        IsVisible="False"
                        Stroke="#FECACA"
                        BackgroundColor="#FEF2F2"
                        StrokeShape="RoundRectangle 10"
                        Padding="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label
                                x:Name="LoadErrorLabel"
                                FontSize="11"
                                TextColor="#991B1B"
                                VerticalTextAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Text="Reessayer"
                                FontSize="10"
                                Padding="12,5"
                                MinimumHeightRequest="0"
                                Clicked="OnRetryClicked" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,40" HeightRequest="40">
                        <Label x:Name="GreetingLabel" Text="Bonjour" FontSize="17" FontAttributes="Bold" VerticalTextAlignment="Center" />
                        <controls:ClientNotificationButton Grid.Column="1" />
                    </Grid>

                    <Border HeightRequest="42" Stroke="#EDF0F4" BackgroundColor="#F7F8FA" StrokeShape="RoundRectangle 12" Padding="13,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSearchTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="8">
                            <Image Source="app_search.png" HeightRequest="18" WidthRequest="18" />
                            <Entry Grid.Column="1" x:Name="SearchEntry" Placeholder="Que recherchez-vous aujourd'hui ?" FontSize="12" MinimumHeightRequest="0" HeightRequest="40" IsReadOnly="True" InputTransparent="True" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Pour ma maison" FontSize="15" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Voir plus  →" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnMoreHomeServicesTapped" /></Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <CollectionView
                            x:Name="HomeServicesView"
                            HeightRequest="134"
                            HorizontalScrollBarVisibility="Never"
                            SelectionMode="Single"
                            SelectionChanged="OnServiceSelected">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout
                                    Orientation="Horizontal"
                                    ItemSpacing="8"
                                    SnapPointsAlignment="Start"
                                    SnapPointsType="MandatorySingle" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        HeightRequest="126"
                                        WidthRequest="106"
                                        Padding="0"
                                        BackgroundColor="#FFFFFF"
                                        Stroke="#111827"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14">
                                        <Grid RowDefinitions="92,*">
                                            <Grid Margin="4,4,4,0">
                                                <Image Source="{Binding IconUrl}" Aspect="AspectFit" IsVisible="{Binding HasIconUrl}" />
                                                <Label Text="{Binding IconFallback}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" IsVisible="{Binding HasIconFallback}" />
                                            </Grid>
                                            <Label
                                                Grid.Row="1"
                                                Margin="8,0,8,6"
                                                Text="{Binding Name}"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Start"
                                                VerticalTextAlignment="Center"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Pour mon bien-être" FontSize="15" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Voir plus  →" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnMoreWellbeingServicesTapped" /></Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <CollectionView
                            x:Name="WellbeingServicesView"
                            HeightRequest="134"
                            HorizontalScrollBarVisibility="Never"
                            SelectionMode="Single"
                            SelectionChanged="OnServiceSelected">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout
                                    Orientation="Horizontal"
                                    ItemSpacing="8"
                                    SnapPointsAlignment="Start"
                                    SnapPointsType="MandatorySingle" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        HeightRequest="126"
                                        WidthRequest="106"
                                        Padding="0"
                                        BackgroundColor="#FFFFFF"
                                        Stroke="#111827"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14">
                                        <Grid RowDefinitions="92,*">
                                            <Grid Margin="4,4,4,0">
                                                <Image Source="{Binding IconUrl}" Aspect="AspectFit" IsVisible="{Binding HasIconUrl}" />
                                                <Label Text="{Binding IconFallback}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" IsVisible="{Binding HasIconFallback}" />
                                            </Grid>
                                            <Label
                                                Grid.Row="1"
                                                Margin="8,0,8,6"
                                                Text="{Binding Name}"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Start"
                                                VerticalTextAlignment="Center"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Les plus demandés" FontSize="15" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Voir plus" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnMorePopularTapped" /></Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <CollectionView x:Name="PopularServicesView" HeightRequest="122" SelectionMode="Single" SelectionChanged="OnPopularSelected">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="5">
                                        <Border HeightRequest="82" Padding="0" BackgroundColor="#F2F4F7" Stroke="#E9EDF2" StrokeShape="RoundRectangle 11" HorizontalOptions="Fill">
                                            <Grid>
                                                <Image Source="{Binding IllustrationUrl}" Aspect="AspectFill" IsVisible="{Binding HasIllustration}" />
                                                <Image Source="{Binding ServiceIconUrl}" Aspect="AspectFit" Margin="28" IsVisible="{Binding HasServiceIcon}" />
                                                <Label Text="{Binding Fallback}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" IsVisible="{Binding HasFallback}" />
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding Name}" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="Start" MaxLines="2" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="SearchResultsSection" Spacing="8" IsVisible="False">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Résultats" FontSize="12" FontAttributes="Bold" />
                            <Label x:Name="SearchCountLabel" Grid.Column="1" FontSize="9" TextColor="#6B7280" />
                        </Grid>
                        <CollectionView x:Name="SearchResultsView" SelectionMode="Single" SelectionChanged="OnSearchResultSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Stroke="#E9EDF2" StrokeShape="RoundRectangle 9" Padding="10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}" FontSize="10" FontAttributes="Bold" />
                                                <Label Text="{Binding Service}" FontSize="8" TextColor="#6B7280" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Price}" FontSize="9" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:ClientBottomNavigation Grid.Row="1" ActiveTab="home" ShowCreate="True" />

        <Grid x:Name="CatalogOverlay" Grid.RowSpan="2" IsVisible="False" BackgroundColor="#66000000" ZIndex="30">
            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseCatalogTapped" /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 22,22,0,0"
                    VerticalOptions="End" HeightRequest="560" Padding="20,18,20,20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCatalogPanelTapped" />
                    <SwipeGestureRecognizer Direction="Down" Swiped="OnCatalogSwiped" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                    <BoxView HeightRequest="4" WidthRequest="42" CornerRadius="2" Color="#D8DEE8" HorizontalOptions="Center" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="CatalogTitle" Text="Services" FontSize="20" FontAttributes="Bold" />
                            <Label x:Name="CatalogSubtitle" Text="Choisissez pour continuer" FontSize="11" TextColor="#687386" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Fermer" FontSize="11" Padding="12,6" BackgroundColor="Transparent" TextColor="{StaticResource WeleBlue}" Clicked="OnCloseCatalogClicked" />
                    </Grid>
                    <CollectionView x:Name="MoreServicesView" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnMoreServiceSelected">
                        <CollectionView.ItemTemplate><DataTemplate>
                            <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="12" Padding="0,10">
                                <Border HeightRequest="50" WidthRequest="50" Padding="8" BackgroundColor="#F4F7FF" Stroke="#E7ECF5" StrokeShape="RoundRectangle 10">
                                    <Grid><Image Source="{Binding IconUrl}" Aspect="AspectFit" IsVisible="{Binding HasIconUrl}" /><Label Text="{Binding IconFallback}" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" IsVisible="{Binding HasIconFallback}" /></Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"><Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" /><Label Text="{Binding Price}" FontSize="10" TextColor="#687386" /></VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="24" VerticalTextAlignment="Center" />
                            </Grid>
                        </DataTemplate></CollectionView.ItemTemplate>
                    </CollectionView>
                    <CollectionView x:Name="MorePopularView" Grid.Row="2" IsVisible="False" SelectionMode="Single" SelectionChanged="OnMorePopularSelected">
                        <CollectionView.ItemTemplate><DataTemplate>
                            <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="12" Padding="0,10">
                                <Border HeightRequest="62" WidthRequest="72" Padding="0" BackgroundColor="#F4F5F8" StrokeThickness="0" StrokeShape="RoundRectangle 10"><Grid><Image Source="{Binding IllustrationUrl}" Aspect="AspectFill" IsVisible="{Binding HasIllustration}" /><Image Source="{Binding ServiceIconUrl}" Margin="15" Aspect="AspectFit" IsVisible="{Binding HasServiceIcon}" /></Grid></Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"><Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" /><Label Text="{Binding ServiceName}" FontSize="10" TextColor="#687386" /><Label Text="{Binding Price}" FontSize="10" TextColor="{StaticResource WeleBlue}" /></VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="24" VerticalTextAlignment="Center" />
                            </Grid>
                        </DataTemplate></CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
