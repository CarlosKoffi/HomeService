<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.AddPaymentMethodPage"
    Shell.TabBarIsVisible="False"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HomeService.Client.Mobile.Controls"
    Title="Ajouter un moyen">
    <Grid RowDefinitions="*,72">
    <Grid Padding="20,18,20,24" RowDefinitions="Auto,*,Auto" RowSpacing="18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Button Text="‹" FontSize="28" BackgroundColor="Transparent" TextColor="{StaticResource Ink}" Padding="0" WidthRequest="32" Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="Ajouter un moyen" FontSize="20" FontAttributes="Bold" VerticalTextAlignment="Center" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">
                <Label Text="Operateur" FontAttributes="Bold" />
                <Picker x:Name="ProviderPicker" Title="Choisir un operateur" ItemDisplayBinding="{Binding Name}" SelectedIndexChanged="OnProviderChanged" />
                <Label x:Name="ReferenceLabel" Text="Numero Mobile Money" FontAttributes="Bold" />
                <Entry x:Name="ReferenceEntry" Placeholder="07 00 00 00 00" Keyboard="Telephone" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <CheckBox x:Name="DefaultCheckBox" IsChecked="True" />
                    <Label Grid.Column="1" Text="Utiliser par defaut" VerticalTextAlignment="Center" />
                </Grid>
                <Border BackgroundColor="#F5F7FA" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14">
                    <Label Text="Aucun paiement n'est effectue maintenant. Ce moyen sera utilise uniquement lorsque vous accepterez le prix propose." FontSize="12" TextColor="#687386" />
                </Border>
                <Label x:Name="CatalogErrorLabel" Text="Impossible de charger les operateurs de paiement." TextColor="{StaticResource Danger}" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" IsVisible="False" />
            <Button x:Name="SaveButton" Text="Enregistrer" HeightRequest="52" Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </Grid>
    <controls:ClientBottomNavigation Grid.Row="1" ActiveTab="profile" />
    </Grid>
</ContentPage>
