<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.CreateRequestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Nouvelle demande">
    <ScrollView>
        <VerticalStackLayout Padding="22,22,22,28" Spacing="18">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="‹" WidthRequest="44" HeightRequest="44" Padding="0" BackgroundColor="White" TextColor="{StaticResource Ink}" BorderColor="{StaticResource Line}" BorderWidth="1" Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" Spacing="3">
                    <Label Text="Nouvelle demande" Style="{StaticResource ScreenTitleLabel}" />
                    <Label x:Name="TitleLabel" Text="Service selectionne" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border BackgroundColor="{StaticResource WeleBlue}" StrokeShape="RoundRectangle 12" Padding="0" HeightRequest="5" />
                <Border Grid.Column="1" BackgroundColor="#DBEAFE" StrokeShape="RoundRectangle 12" Padding="0" HeightRequest="5" />
                <Border Grid.Column="2" BackgroundColor="#DBEAFE" StrokeShape="RoundRectangle 12" Padding="0" HeightRequest="5" />
            </Grid>

            <Border x:Name="PreparationCard" Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="14" IsVisible="False">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border BackgroundColor="#EFF6FF" Stroke="#DBEAFE" StrokeShape="RoundRectangle 16" HeightRequest="42" WidthRequest="42" Padding="8">
                        <Image x:Name="PreparationIcon" Aspect="AspectFit" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label x:Name="PreparationTitleLabel" Style="{StaticResource CardTitleLabel}" />
                        <Label x:Name="PreparationPriceLabel" TextColor="{StaticResource WeleBlue}" FontAttributes="Bold" />
                        <Label x:Name="PreparationHintLabel" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="7">
                        <Label Text="Decrivez votre besoin" FontSize="13" FontAttributes="Bold" />
                        <Border Stroke="{StaticResource Line}" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 14" Padding="12">
                            <Editor x:Name="DescriptionEditor" Placeholder="Ex: l'eau coule sous l'evier depuis ce matin..." AutoSize="TextChanges" MinimumHeightRequest="96" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="7">
                        <Label Text="Photos" FontSize="13" FontAttributes="Bold" />
                        <Label x:Name="PhotoHintLabel" Text="Ajoutez jusqu'a 3 photos si cela aide a comprendre le besoin." Style="{StaticResource MutedLabel}" />
                        <Button Text="+ Ajouter des photos" BackgroundColor="#EFF6FF" TextColor="{StaticResource WeleBlue}" BorderColor="#DBEAFE" BorderWidth="1" Clicked="OnAddPhotosClicked" />
                    </VerticalStackLayout>

                    <CollectionView x:Name="PhotosView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{StaticResource Line}" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 14" Padding="10" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding FileName}" FontAttributes="Bold" />
                                            <Label Text="{Binding SizeLabel}" Style="{StaticResource MutedLabel}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Status}" TextColor="{StaticResource WeleBlue}" FontAttributes="Bold" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="{StaticResource Line}" BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="7">
                        <Label Text="Adresse" FontSize="13" FontAttributes="Bold" />
                        <Picker x:Name="AddressPicker" Title="Adresse sauvegardee" ItemDisplayBinding="{Binding Label}" SelectedIndexChanged="OnAddressChanged" />
                        <Border Stroke="{StaticResource Line}" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 14" Padding="14,0">
                            <Entry x:Name="AddressEntry" Placeholder="Cocody, Riviera 3" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="7">
                        <Label Text="Date et heure" FontSize="13" FontAttributes="Bold" />
                        <Picker x:Name="ModePicker" SelectedIndexChanged="OnModeChanged">
                            <Picker.Items>
                                <x:String>Maintenant</x:String>
                                <x:String>Programmer</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <Grid x:Name="ScheduleGrid" ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="False">
                        <DatePicker x:Name="ScheduleDatePicker" />
                        <TimePicker Grid.Column="1" x:Name="ScheduleTimePicker" />
                    </Grid>

                    <VerticalStackLayout Spacing="7">
                        <Label Text="Paiement" FontSize="13" FontAttributes="Bold" />
                        <Picker x:Name="PaymentPicker">
                            <Picker.Items>
                                <x:String>Mobile Money</x:String>
                                <x:String>Carte bancaire</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="Envoyer la demande" Clicked="OnCreateClicked" />
            <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
