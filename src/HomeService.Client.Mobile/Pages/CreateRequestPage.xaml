<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HomeService.Client.Mobile.Pages.CreateRequestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
    xmlns:clients="clr-namespace:HomeService.Contracts.Clients;assembly=HomeService.Contracts"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="White"
    Title="Nouvelle demande">
    <Grid RowDefinitions="Auto,Auto,*" Padding="20,18,20,18">
        <Grid ColumnDefinitions="40,*" HeightRequest="44">
            <Button Text="‹" FontSize="28" WidthRequest="38" HeightRequest="38" Padding="0"
                    BackgroundColor="Transparent" TextColor="#111827" Clicked="OnBackClicked" />
            <Label x:Name="PageTitleLabel" Grid.Column="1" Text="Nouvelle demande" FontSize="17"
                   FontAttributes="Bold" VerticalTextAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="34,2,34,8">
            <BoxView Grid.ColumnSpan="3" HeightRequest="2" Color="#E4E8F0" VerticalOptions="Center" />
            <Border x:Name="StepOneCircle" Grid.Column="0" Style="{StaticResource StepActiveCircle}">
                <Label x:Name="StepOneCircleLabel" Text="1" Style="{StaticResource StepCircleText}" />
            </Border>
            <Border x:Name="StepTwoCircle" Grid.Column="1" Style="{StaticResource StepIdleCircle}">
                <Label x:Name="StepTwoCircleLabel" Text="2" Style="{StaticResource StepIdleText}" />
            </Border>
            <Border x:Name="StepThreeCircle" Grid.Column="2" Style="{StaticResource StepIdleCircle}">
                <Label x:Name="StepThreeCircleLabel" Text="3" Style="{StaticResource StepIdleText}" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid x:Name="StepOnePanel" RowDefinitions="*,Auto" RowSpacing="14">

                <ScrollView>
                    <VerticalStackLayout Spacing="18" Padding="0,6,0,76">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="Service souhaité" FontSize="13" FontAttributes="Bold" />
                            <Border BackgroundColor="#F4F5F8" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="14">
                                <VerticalStackLayout Spacing="3">
                                    <Label x:Name="TitleLabel" Text="Aucun service sélectionné" FontSize="13" FontAttributes="Bold" />
                                    <Button x:Name="SelectServiceButton"
                                            Text="Choisir un service"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource WeleBlue}"
                                            BackgroundColor="Transparent"
                                            Padding="0,5,0,0"
                                            HorizontalOptions="Start"
                                            Clicked="OnSelectServiceClicked" />
                                    <Button x:Name="SelectPrestationButton"
                                            Text="Selectionner une prestation"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource WeleBlue}"
                                            BackgroundColor="Transparent"
                                            Padding="0,5,0,0"
                                            HorizontalOptions="Start"
                                            IsVisible="False"
                                            Clicked="OnSelectPrestationClicked" />
                                    <Button x:Name="SelectOptionButton"
                                            Text="Selectionner une option"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource WeleBlue}"
                                            BackgroundColor="Transparent"
                                            Padding="0,5,0,0"
                                            HorizontalOptions="Start"
                                            IsVisible="False"
                                            Clicked="OnSelectOptionClicked" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <Border x:Name="PreparationCard" Stroke="#E7EAF0" BackgroundColor="White"
                                StrokeShape="RoundRectangle 12" Padding="10" IsVisible="False">
                            <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
                                <Border HeightRequest="96" WidthRequest="96" Padding="0" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10" BackgroundColor="#F4F6FA">
                                    <Image x:Name="PreparationIcon" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label x:Name="PreparationTitleLabel" FontSize="13" FontAttributes="Bold" />
                                    <Label x:Name="PreparationDescriptionLabel" FontSize="10" TextColor="#687386" MaxLines="3" />
                                    <Label x:Name="PreparationPriceLabel" FontSize="11" TextColor="{StaticResource WeleBlue}" FontAttributes="Bold" />
                                    <Label x:Name="PreparationHintLabel" FontSize="9" TextColor="#687386" MaxLines="2" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="Décrivez votre problème" FontSize="13" FontAttributes="Bold" />
                            <Border Stroke="#DDE2EA" BackgroundColor="White" StrokeShape="RoundRectangle 10" Padding="12">
                                <Editor x:Name="DescriptionEditor" Placeholder="Ex : l'eau ne s'écoule plus depuis ce matin..."
                                        FontSize="12" AutoSize="TextChanges" MinimumHeightRequest="88"
                                        MaxLength="250" TextChanged="OnDescriptionChanged" />
                            </Border>
                            <Label x:Name="DescriptionCountLabel" Text="0/250" FontSize="10" TextColor="#687386" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Photos (optionnel)" FontSize="13" FontAttributes="Bold" />
                            <Label x:Name="PhotoHintLabel" Text="Ajoutez des photos pour faciliter l'évaluation." FontSize="10" TextColor="#687386" />
                            <CollectionView x:Name="PhotosView" HeightRequest="92" ItemsLayout="HorizontalList" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border HeightRequest="86" WidthRequest="86" Margin="0,0,8,0" Stroke="#DDE2EA"
                                                StrokeShape="RoundRectangle 10" Padding="0">
                                            <Grid>
                                                <Image Source="{Binding PreviewSource}" Aspect="AspectFill" />
                                                <Button Text="×" FontSize="16" FontAttributes="Bold" TextColor="White"
                                                        BackgroundColor="#C62828" CornerRadius="14" HeightRequest="28" WidthRequest="28"
                                                        Padding="0" Margin="0,4,4,0" HorizontalOptions="End" VerticalOptions="Start"
                                                        CommandParameter="{Binding .}" Clicked="OnRemovePhotoClicked" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <Button Text="+ Ajouter une photo" HeightRequest="46" BackgroundColor="#F4F7FF"
                                    TextColor="{StaticResource WeleBlue}" BorderColor="#DCE6FF" BorderWidth="1"
                                    CornerRadius="10" Clicked="OnAddPhotosClicked" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
                <VerticalStackLayout Grid.Row="1" Spacing="6">
                    <Label x:Name="StepOneErrorLabel" TextColor="{StaticResource Danger}" FontSize="11" IsVisible="False" />
                    <Button x:Name="StepOneContinueButton" Text="Continuer" HeightRequest="50" Clicked="OnStepOneContinueClicked" />
                </VerticalStackLayout>
            </Grid>

            <Grid x:Name="StepTwoPanel" RowDefinitions="*,Auto" RowSpacing="14" IsVisible="False">
                <ScrollView>
                    <VerticalStackLayout Spacing="22" Padding="0,8,0,76">
                        <Label Text="Quand souhaitez-vous l'intervention ?" FontSize="16" FontAttributes="Bold" />
                        <Label Text="Choisissez l'option qui vous convient." FontSize="10" TextColor="#687386" Margin="0,-16,0,0" />

                        <VerticalStackLayout Spacing="10">
                            <Border x:Name="InstantModeCard" Stroke="#BFD1F0" BackgroundColor="#EEF4FF"
                                    StrokeShape="RoundRectangle 12" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnInstantModeTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="34,*,24" ColumnSpacing="10">
                                    <Label Text="&#x26A1;" FontSize="20" TextColor="#64748B" VerticalTextAlignment="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label x:Name="InstantModeTitle" Text="Dès que possible" FontSize="13"
                                               FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" />
                                        <Label Text="Nous recherchons immédiatement un prestataire disponible."
                                               FontSize="10" TextColor="#687386" MaxLines="2" />
                                    </VerticalStackLayout>
                                    <Border x:Name="InstantModeCheck" Grid.Column="2" HeightRequest="20" WidthRequest="20"
                                            Stroke="{StaticResource WeleBlue}" BackgroundColor="{StaticResource WeleBlue}"
                                            StrokeShape="RoundRectangle 10" Padding="0" VerticalOptions="Center">
                                        <Label x:Name="InstantModeCheckLabel" Text="✓" FontSize="10" TextColor="White"
                                               FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="ScheduledModeCard" Stroke="#DCE1E8" BackgroundColor="White"
                                    StrokeShape="RoundRectangle 12" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnScheduledModeTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="38,*,24" ColumnSpacing="10">
                                    <Border HeightRequest="29" WidthRequest="29"
                                            Stroke="#1769E8" StrokeThickness="1.4"
                                            StrokeShape="RoundRectangle 7"
                                            BackgroundColor="White"
                                            Padding="0" VerticalOptions="Center">
                                        <Grid RowDefinitions="8,*">
                                            <BoxView Color="#1769E8" />
                                            <Label Grid.Row="1" Text="12" FontSize="9"
                                                   FontAttributes="Bold" TextColor="#1769E8"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label x:Name="ScheduledModeTitle" Text="Sur rendez-vous" FontSize="13" FontAttributes="Bold" />
                                        <Label Text="Choisissez une date et un créneau qui vous conviennent."
                                               FontSize="10" TextColor="#687386" MaxLines="2" />
                                    </VerticalStackLayout>
                                    <Border x:Name="ScheduledModeCheck" Grid.Column="2" HeightRequest="20" WidthRequest="20"
                                            Stroke="#C8D0DC" BackgroundColor="White" StrokeShape="RoundRectangle 10"
                                            Padding="0" VerticalOptions="Center">
                                        <Label x:Name="ScheduledModeCheckLabel" Text="✓" FontSize="10" TextColor="White"
                                               FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                               IsVisible="False" />
                                    </Border>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="ScheduleGrid" Spacing="13" IsVisible="False">
                            <Border StrokeThickness="0" BackgroundColor="#F4F7FF" StrokeShape="RoundRectangle 9" Padding="11,9">
                                <Label Text="Le créneau correspond à la fenêtre d'arrivée estimée du prestataire."
                                       FontSize="10" TextColor="#516179" />
                            </Border>
                            <Label Text="Choisissez une date" FontSize="12" FontAttributes="Bold" />
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout x:Name="AppointmentDaysLayout" Spacing="8" />
                            </ScrollView>
                            <Label Text="Créneau d'arrivée souhaité" FontSize="12" FontAttributes="Bold" />
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout x:Name="AppointmentSlotsLayout" Spacing="8" />
                            </ScrollView>
                        </VerticalStackLayout>

                        <Border x:Name="UrgentOptionPanel" Stroke="#F2D5A7" BackgroundColor="#FFF9EF"
                                StrokeShape="RoundRectangle 10" Padding="12" IsVisible="False">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <CheckBox x:Name="UrgentCheckBox" Color="{StaticResource WeleBlue}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Intervention urgente" FontSize="12" FontAttributes="Bold" />
                                    <Label Text="Des frais supplementaires peuvent etre appliques."
                                           FontSize="10" TextColor="#687386" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Adresse de l'intervention" FontSize="13" FontAttributes="Bold" />
                            <Label x:Name="AddressEmptyLabel"
                                   Text="Aucune adresse enregistrée. Ajoutez votre adresse pour continuer."
                                   FontSize="12" TextColor="#687386" IsVisible="False" />
                            <Picker x:Name="AddressPicker" Title="Choisir une adresse enregistrée"
                                    ItemDisplayBinding="{Binding Label}" SelectedIndexChanged="OnAddressChanged"
                                    IsVisible="False" />
                            <Border x:Name="SelectedAddressBorder" Stroke="#DDE2EA" BackgroundColor="White"
                                    StrokeShape="RoundRectangle 10" Padding="14" IsVisible="False">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSelectedAddressTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="26,*,Auto" ColumnSpacing="10">
                                    <Image Source="nav_home.svg" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label x:Name="SelectedAddressLabel" FontSize="13" FontAttributes="Bold"
                                               TextColor="{StaticResource WeleBlue}" />
                                        <Label x:Name="SelectedAddressLineLabel" FontSize="12" TextColor="#687386" />
                                        <Label Text="✓ Adresse sélectionnée" FontSize="9" TextColor="{StaticResource Success}" />
                                    </VerticalStackLayout>
                                    <Label x:Name="SelectedAddressChevron"
                                           Grid.Column="2"
                                           Text="›"
                                           FontSize="28"
                                           TextColor="{StaticResource WeleBlue}"
                                           VerticalOptions="Center"
                                           IsVisible="False" />
                                </Grid>
                            </Border>
                            <Border x:Name="AddressMapBorder" HeightRequest="145" Stroke="#E4E8EF" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12" Padding="0" BackgroundColor="White" IsVisible="False">
                                <maps:Map x:Name="AddressMap" MapType="Street" IsShowingUser="False" />
                            </Border>
                            <Button x:Name="ShowNewAddressButton" Text="+ Ajouter une nouvelle adresse"
                                    BackgroundColor="Transparent" TextColor="{StaticResource WeleBlue}"
                                    HorizontalOptions="Start" Padding="0,8" Clicked="OnShowNewAddressClicked" />
                            <Border x:Name="NewAddressPanel" Stroke="#DDE2EA" BackgroundColor="White"
                                    StrokeShape="RoundRectangle 12" Padding="14" IsVisible="False">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="Nouvelle adresse" FontSize="13" FontAttributes="Bold" />
                                    <Entry x:Name="NewAddressLabelEntry" Placeholder="Ex. Maison, Bureau" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Entry x:Name="AddressEntry" Placeholder="Ex. Cocody, Riviera 3"
                                               TextChanged="OnAddressTextChanged" />
                                        <Button Grid.Column="1" x:Name="LocateAddressButton" Text="⌖"
                                                FontSize="22" WidthRequest="46" HeightRequest="46" Padding="0"
                                                BackgroundColor="#F4F7FF" TextColor="{StaticResource WeleBlue}"
                                                BorderColor="#DCE6FF" BorderWidth="1" CornerRadius="10"
                                                Clicked="OnLocateAddressClicked" />
                                    </Grid>
                                    <Border x:Name="AddressSuggestionsPanel" Stroke="#DDE2EA" BackgroundColor="White"
                                            StrokeShape="RoundRectangle 10" Padding="0" IsVisible="False">
                                        <CollectionView x:Name="AddressSuggestionsView"
                                                        SelectionMode="Single"
                                                        SelectionChanged="OnAddressSuggestionSelected"
                                                        MaximumHeightRequest="240">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="clients:ClientAddressSuggestionResponse">
                                                    <Grid Padding="12,10" RowDefinitions="Auto,Auto" RowSpacing="2">
                                                        <Label Text="{Binding MainText}" FontSize="12" FontAttributes="Bold" />
                                                        <Label Grid.Row="1" Text="{Binding SecondaryText}" FontSize="10"
                                                               TextColor="#687386" LineBreakMode="TailTruncation" />
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </Border>
                                    <Label Text="Touchez la cible pour utiliser votre position actuelle."
                                           FontSize="10" TextColor="#687386" />
                                    <Button x:Name="SaveAddressButton" Text="Enregistrer cette adresse"
                                            HeightRequest="46" Clicked="OnSaveAddressClicked" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <Picker x:Name="PaymentPicker" IsVisible="False">
                            <Picker.Items>
                                <x:String>Mobile Money</x:String>
                                <x:String>Carte bancaire</x:String>
                            </Picker.Items>
                        </Picker>
                        <Label x:Name="StepTwoErrorLabel"
                               TextColor="{StaticResource Danger}"
                               FontSize="12"
                               IsVisible="False" />
                    </VerticalStackLayout>
                </ScrollView>
                <Button Grid.Row="1" Text="Continuer" HeightRequest="50" Clicked="OnStepTwoContinueClicked" />
            </Grid>

            <Grid x:Name="StepThreePanel" RowDefinitions="Auto,*,Auto" RowSpacing="18" IsVisible="False">
                <Label Text="Récapitulatif" FontSize="18" FontAttributes="Bold" />
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Spacing="22" Padding="0,4,0,82">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Service" FontSize="11" TextColor="#687386" />
                                    <Label x:Name="SummaryServiceLabel" FontSize="13" FontAttributes="Bold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout x:Name="SummaryPrestationPanel" Spacing="4" IsVisible="False">
                                    <Label Text="Prestation" FontSize="11" TextColor="#687386" />
                                    <Label x:Name="SummaryPrestationLabel" FontSize="13" FontAttributes="Bold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout x:Name="SummaryOptionPanel" Spacing="4" IsVisible="False">
                                    <Label Text="Option" FontSize="11" TextColor="#687386" />
                                    <Label x:Name="SummaryOptionLabel" FontSize="13" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Modifier" FontSize="11" TextColor="{StaticResource WeleBlue}"
                                    BackgroundColor="Transparent" Clicked="OnModifyServiceClicked" />
                        </Grid>
                        <VerticalStackLayout x:Name="SummaryPricePanel" Spacing="4">
                            <Label Text="Prix estimé" FontSize="11" TextColor="#687386" />
                            <Label x:Name="SummaryPriceLabel"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource WeleBlue}" />
                            <Label x:Name="SummaryPriceHintLabel"
                                   FontSize="10"
                                   TextColor="#687386" />
                        </VerticalStackLayout>
                        <Border x:Name="ReorderCompanyPanel"
                                IsVisible="False"
                                Stroke="{StaticResource PremiumLine}"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 14"
                                Padding="13,11">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Entreprise choisie" FontSize="10" TextColor="#687386" />
                                <Label x:Name="ReorderCompanyLabel" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" />
                                <Label Text="Cette demande sera envoyée uniquement à cette entreprise." FontSize="10" TextColor="#687386" />
                            </VerticalStackLayout>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Adresse" FontSize="11" TextColor="#687386" />
                                <Label x:Name="SummaryAddressLabel" FontSize="13" FontAttributes="Bold" MaxLines="3" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Modifier" FontSize="11" TextColor="{StaticResource WeleBlue}"
                                    BackgroundColor="Transparent" Clicked="OnModifyScheduleClicked" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Date &amp; heure" FontSize="11" TextColor="#687386" />
                                <Label x:Name="SummaryScheduleLabel" FontSize="13" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Modifier" FontSize="11" TextColor="{StaticResource WeleBlue}"
                                    BackgroundColor="Transparent" Clicked="OnModifyScheduleClicked" />
                        </Grid>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Votre demande" FontSize="11" TextColor="#687386" />
                            <Label x:Name="SummaryDescriptionLabel" FontSize="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Moyen de paiement" FontSize="11" TextColor="#687386" />
                            <Label Text="A choisir apres l'envoi" FontSize="13" FontAttributes="Bold" />
                            <Label Text="Vous ne serez debite qu'apres validation du prix." FontSize="11" TextColor="#687386" />
                        </VerticalStackLayout>
                        <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" IsVisible="False" />
                    </VerticalStackLayout>
                </ScrollView>
                <VerticalStackLayout Grid.Row="2" Spacing="9">
                    <Button Text="Envoyer la demande" HeightRequest="50" Clicked="OnCreateClicked" />
                    <Label Text="Réponse en moyenne" FontSize="10" TextColor="#687386" HorizontalTextAlignment="Center" />
                    <Label Text="14 à 30 min" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource WeleBlue}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <Grid x:Name="ServicePickerOverlay"
              Grid.RowSpan="3"
              Margin="-20,-18,-20,-18"
              BackgroundColor="#730B1220"
              IsVisible="False"
              ZIndex="21">
            <Border VerticalOptions="End"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22,22,0,0"
                    Padding="20,18,20,24"
                    MaximumHeightRequest="650">
                <Border.GestureRecognizers>
                    <SwipeGestureRecognizer Direction="Down" Swiped="OnServicePickerSwiped" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                    <BoxView HeightRequest="4" WidthRequest="42" CornerRadius="2"
                             Color="{StaticResource PremiumLine}" HorizontalOptions="Center" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,40">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Choisir un service" FontSize="18" FontAttributes="Bold" />
                            <Label Text="Sélectionnez le besoin principal." FontSize="11" TextColor="{StaticResource ListSecondary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="&#215;" FontSize="24"
                                WidthRequest="40" HeightRequest="40" Padding="0"
                                BackgroundColor="Transparent" TextColor="#111827"
                                Clicked="OnCloseServicePickerClicked" />
                    </Grid>
                    <BoxView Grid.Row="2" HeightRequest="1" Color="{StaticResource PremiumLine}" />
                    <CollectionView x:Name="ServicePickerList" Grid.Row="3"
                                    SelectionMode="Single"
                                    SelectionChanged="OnServicePickerSelected">
                        <CollectionView.EmptyView>
                            <Label Text="Aucun service disponible pour le moment."
                                   Padding="0,24" TextColor="{StaticResource ListSecondary}"
                                   HorizontalTextAlignment="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{StaticResource PremiumLine}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14" BackgroundColor="White"
                                        Padding="10" Margin="0,5">
                                    <Border.Shadow>
                                        <Shadow Brush="#182165E8" Offset="0,3" Radius="9" Opacity="0.10" />
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                                        <Border HeightRequest="64" WidthRequest="64" Padding="0"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 11"
                                                BackgroundColor="White">
                                            <Grid>
                                                <Image Source="{Binding ImageSource}" Aspect="AspectFit" Margin="9" />
                                                <Label Text="{Binding Initials}" FontSize="14" FontAttributes="Bold"
                                                       TextColor="{StaticResource WeleBlue}"
                                                       HorizontalOptions="Center" VerticalOptions="Center"
                                                       IsVisible="{Binding ShowInitials}" />
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" MaxLines="2" />
                                            <Label Text="{Binding Description}" FontSize="10" TextColor="{StaticResource ListSecondary}" MaxLines="2" />
                                            <Label Text="{Binding PriceLabel}" FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource WeleBlue}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="&#8250;" FontSize="28"
                                               TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="PrestationPickerOverlay"
              Grid.RowSpan="3"
              Margin="-20,-18,-20,-18"
              BackgroundColor="#730B1220"
              IsVisible="False"
              ZIndex="20">
            <Border VerticalOptions="End"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22,22,0,0"
                    Padding="20,18,20,24"
                    MaximumHeightRequest="620">
                <Border.GestureRecognizers>
                    <SwipeGestureRecognizer Direction="Down" Swiped="OnPrestationPickerSwiped" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                    <BoxView HeightRequest="4" WidthRequest="42" CornerRadius="2"
                             Color="{StaticResource PremiumLine}" HorizontalOptions="Center" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,40">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Choisir une prestation" FontSize="18" FontAttributes="Bold" />
                            <Label x:Name="PrestationPickerServiceLabel" FontSize="11" TextColor="{StaticResource ListSecondary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="&#215;" FontSize="24"
                                WidthRequest="40" HeightRequest="40" Padding="0"
                                BackgroundColor="Transparent" TextColor="#111827"
                                Clicked="OnClosePrestationPickerClicked" />
                    </Grid>

                    <BoxView Grid.Row="2" HeightRequest="1" Color="{StaticResource PremiumLine}" />

                    <CollectionView x:Name="PrestationPickerList" Grid.Row="3"
                                    SelectionMode="Single"
                                    SelectionChanged="OnPrestationSelected">
                        <CollectionView.EmptyView>
                            <Label Text="Aucune prestation disponible pour ce service."
                                   Padding="0,24" TextColor="{StaticResource ListSecondary}"
                                   HorizontalTextAlignment="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{StaticResource PremiumLine}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14" BackgroundColor="White"
                                        Padding="10" Margin="0,5">
                                    <Border.Shadow>
                                        <Shadow Brush="#182165E8" Offset="0,3" Radius="9" Opacity="0.10" />
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="12">
                                        <Border HeightRequest="76" WidthRequest="76" Padding="0"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 11"
                                                BackgroundColor="White">
                                            <Grid>
                                                <Image Source="{Binding ImageSource}" Aspect="AspectFill" />
                                                <Label Text="{Binding Initials}" FontSize="15" FontAttributes="Bold"
                                                       TextColor="{StaticResource WeleBlue}"
                                                       HorizontalOptions="Center" VerticalOptions="Center"
                                                       IsVisible="{Binding ShowInitials}" />
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" MaxLines="2" />
                                            <Label Text="{Binding Description}" FontSize="10" TextColor="{StaticResource ListSecondary}" MaxLines="2" />
                                            <Label Text="{Binding PriceLabel}" FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource WeleBlue}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="&#8250;" FontSize="28"
                                               TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="OptionPickerOverlay"
              Grid.RowSpan="3" Margin="-20,-18,-20,-18"
              BackgroundColor="#730B1220" IsVisible="False" ZIndex="22">
            <Border VerticalOptions="End" BackgroundColor="White" StrokeThickness="0"
                    StrokeShape="RoundRectangle 22,22,0,0" Padding="20,18,20,24"
                    MaximumHeightRequest="600">
                <Border.GestureRecognizers>
                    <SwipeGestureRecognizer Direction="Down" Swiped="OnOptionPickerSwiped" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                    <BoxView HeightRequest="4" WidthRequest="42" CornerRadius="2" Color="{StaticResource PremiumLine}" HorizontalOptions="Center" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,40">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Choisir une option" FontSize="18" FontAttributes="Bold" />
                            <Label x:Name="OptionPickerPrestationLabel" FontSize="11" TextColor="{StaticResource ListSecondary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="&#215;" FontSize="24" WidthRequest="40" HeightRequest="40"
                                Padding="0" BackgroundColor="Transparent" TextColor="#111827"
                                Clicked="OnCloseOptionPickerClicked" />
                    </Grid>
                    <BoxView Grid.Row="2" HeightRequest="1" Color="{StaticResource PremiumLine}" />
                    <CollectionView x:Name="OptionPickerList" Grid.Row="3" SelectionMode="Single"
                                    SelectionChanged="OnOptionSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{StaticResource PremiumLine}" StrokeShape="RoundRectangle 14" BackgroundColor="White"
                                        Padding="14" Margin="0,5">
                                    <Border.Shadow>
                                        <Shadow Brush="#182165E8" Offset="0,3" Radius="9" Opacity="0.10" />
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" />
                                            <Label Text="{Binding Description}" FontSize="10" TextColor="{StaticResource ListSecondary}" MaxLines="2" />
                                            <Label Text="{Binding PriceLabel}" FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource WeleBlue}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="&#8250;" FontSize="28" TextColor="{StaticResource WeleBlue}" VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <ContentPage.Resources>
        <Style x:Key="StepActiveCircle" TargetType="Border">
            <Setter Property="HeightRequest" Value="22" />
            <Setter Property="WidthRequest" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BackgroundColor" Value="{StaticResource WeleBlue}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 11" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
        <Style x:Key="StepDoneCircle" TargetType="Border" BasedOn="{StaticResource StepActiveCircle}" />
        <Style x:Key="StepIdleCircle" TargetType="Border">
            <Setter Property="HeightRequest" Value="22" />
            <Setter Property="WidthRequest" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BackgroundColor" Value="#F0F2F6" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 11" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
        <Style x:Key="StepCircleText" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepIdleText" TargetType="Label" BasedOn="{StaticResource StepCircleText}">
            <Setter Property="TextColor" Value="#687386" />
        </Style>
    </ContentPage.Resources>
</ContentPage>
