@inherits LayoutComponentBase
@inject HomeService.Admin.Services.AdminSessionState SessionState
@inject NavigationManager Navigation

@if (IsPublicPage)
{
    @Body
}
else if (!HasCheckedSession)
{
    <div class="admin-auth-loading">
        <img src="images/wele-logo.png" alt="wele" />
        <p>Verification de votre session admin...</p>
    </div>
}
else
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4 admin-topbar">
                <div class="admin-console-title">
                    <img src="images/wele-logo.png" alt="wele" />
                    <span>
                        <strong>Console w&eacute;l&eacute;</strong>
                        <small>Pilotage plateforme</small>
                    </span>
                </div>
                <div class="admin-user-chip">
                    <span class="admin-user-status" aria-hidden="true"></span>
                    <span>
                        <small>Connect&eacute; en tant que</small>
                        <strong>@GetCurrentUserName()</strong>
                        <em>@GetCurrentUserRole() - @GetCurrentUserEmail()</em>
                    </span>
                    <button type="button" @onclick="SignOutAsync">Se d&eacute;connecter</button>
                </div>
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>

@code {
    private bool HasCheckedSession { get; set; }

    private bool IsPublicPage
    {
        get
        {
            var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
            return relativePath.StartsWith("admin-login", StringComparison.OrdinalIgnoreCase)
                || relativePath.StartsWith("admin-invitation", StringComparison.OrdinalIgnoreCase)
                || relativePath.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || IsPublicPage)
        {
            return;
        }

        await SessionState.InitializeAsync();
        HasCheckedSession = true;

        if (!SessionState.IsAuthenticated)
        {
            var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/admin-login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
            return;
        }

        StateHasChanged();
    }

    private async Task SignOutAsync()
    {
        await SessionState.SignOutAsync();
        Navigation.NavigateTo("/admin-login", forceLoad: true);
    }

    private string GetCurrentUserName()
    {
        return string.IsNullOrWhiteSpace(SessionState.CurrentUser?.FullName)
            ? "Administrateur"
            : SessionState.CurrentUser.FullName;
    }

    private string GetCurrentUserEmail()
    {
        return string.IsNullOrWhiteSpace(SessionState.CurrentUser?.Email)
            ? "email non renseigne"
            : SessionState.CurrentUser.Email;
    }

    private string GetCurrentUserRole()
    {
        return SessionState.CurrentUser?.IsSuperAdmin == true ? "Super admin" : "Admin";
    }
}
