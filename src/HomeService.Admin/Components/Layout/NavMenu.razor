@using HomeService.Admin.Services
@using HomeService.Domain.Enums
@inject AdminSessionState SessionState

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img src="images/wele-logo.png" alt="wélé" />
            <span>Console</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Ouvrir le menu" aria-label="Ouvrir le menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column" aria-label="Navigation principale">
        @if (CanView(AdminModuleKey.Dashboard))
        {
            <NavGroup Title="Pilotage">
                <NavItem Href="" Label="Tableau de bord" Icon="dashboard" Match="NavLinkMatch.All" />
            </NavGroup>
        }

        @if (CanView(AdminModuleKey.Clients))
        {
            <NavGroup Title="Clients">
                <NavItem Href="clients" Label="Clients particuliers" Icon="clients" />
                <NavItem Href="business-clients" Label="Clients entreprises" Icon="business-clients" />
            </NavGroup>
        }

        @if (CanViewCompaniesGroup)
        {
            <NavGroup Title="Entreprises partenaires">
                @if (CanView(AdminModuleKey.CompanyApplications))
                {
                    <NavItem Href="company-applications" Label="Dossiers à valider" Icon="applications" />
                }
                @if (CanView(AdminModuleKey.CompanyManagement))
                {
                    <NavItem Href="companies" Label="Entreprises actives" Icon="companies" />
                }
            </NavGroup>
        }

        @if (CanViewProvidersGroup)
        {
            <NavGroup Title="Prestataires & qualité">
                @if (CanView(AdminModuleKey.ProviderReview))
                {
                    <NavItem Href="providers" Label="Prestataires" Icon="providers" />
                }
                @if (CanView(AdminModuleKey.MissionSettings))
                {
                    <NavItem Href="quality" Label="Contrôle qualité" Icon="quality" />
                }
                @if (CanView(AdminModuleKey.Services))
                {
                    <NavItem Href="mission-test" Label="Test prestataire" Icon="test" />
                }
            </NavGroup>
        }

        @if (CanViewOperationsGroup)
        {
            <NavGroup Title="Opérations">
                @if (CanView(AdminModuleKey.Missions))
                {
                    <NavItem Href="missions" Label="Missions" Icon="missions" />
                }
                @if (CanView(AdminModuleKey.Payments))
                {
                    <NavItem Href="payments" Label="Encaissements" Icon="payments" />
                }
                @if (CanView(AdminModuleKey.Notifications))
                {
                    <NavItem Href="notifications" Label="Notifications" Icon="notifications" />
                }
                @if (CanView(AdminModuleKey.ContactRequests))
                {
                    <NavItem Href="contact-requests" Label="Demandes de contact" Icon="contact" />
                }
            </NavGroup>
        }

        @if (CanViewCatalogGroup)
        {
            <NavGroup Title="Catalogue & contenu">
                @if (CanView(AdminModuleKey.Services))
                {
                    <NavItem Href="service-proposals" Label="Services & prestations" Icon="services" />
                }
                @if (CanView(AdminModuleKey.Cms))
                {
                    <NavItem Href="cms" Label="Pages & contenus" Icon="cms" />
                }
                @if (CanView(AdminModuleKey.Localization))
                {
                    <NavItem Href="localization" Label="Traductions" Icon="translations" />
                }
            </NavGroup>
        }

        @if (CanViewAdministrationGroup)
        {
            <NavGroup Title="Configuration & sécurité">
                @if (CanView(AdminModuleKey.MissionSettings))
                {
                    <NavItem Href="mission-settings" Label="Paramètres missions" Icon="settings" />
                }
                @if (CanView(AdminModuleKey.Services))
                {
                    <NavItem Href="payment-providers" Label="Moyens de paiement" Icon="payment-providers" />
                }
                @if (CanView(AdminModuleKey.AdminAccess))
                {
                    <NavItem Href="access-control" Label="Admins & rôles" Icon="access" />
                }
                @if (CanView(AdminModuleKey.Audit))
                {
                    <NavItem Href="audit-logs" Label="Journal d’audit" Icon="logs" />
                }
            </NavGroup>
        }
    </nav>
</div>

@code {
    private bool CanViewCompaniesGroup =>
        CanView(AdminModuleKey.CompanyApplications) || CanView(AdminModuleKey.CompanyManagement);

    private bool CanViewProvidersGroup =>
        CanView(AdminModuleKey.ProviderReview) || CanView(AdminModuleKey.MissionSettings) || CanView(AdminModuleKey.Services);

    private bool CanViewOperationsGroup =>
        CanView(AdminModuleKey.Missions) || CanView(AdminModuleKey.Payments) ||
        CanView(AdminModuleKey.Notifications) || CanView(AdminModuleKey.ContactRequests);

    private bool CanViewCatalogGroup =>
        CanView(AdminModuleKey.Services) || CanView(AdminModuleKey.Cms) || CanView(AdminModuleKey.Localization);

    private bool CanViewAdministrationGroup =>
        CanView(AdminModuleKey.MissionSettings) || CanView(AdminModuleKey.Services) ||
        CanView(AdminModuleKey.AdminAccess) || CanView(AdminModuleKey.Audit);

    private bool CanView(AdminModuleKey moduleKey)
    {
        if (SessionState.CurrentUser?.IsSuperAdmin == true)
        {
            return true;
        }

        return SessionState.CurrentUser?.Permissions.Any(permission =>
            string.Equals(permission.ModuleKey, moduleKey.ToString(), StringComparison.Ordinal)
            && string.Equals(permission.Action, AdminPermissionAction.View.ToString(), StringComparison.Ordinal)) == true;
    }
}
