@code {
    private AdminPaymentListResponse? Snapshot { get; set; }
    private IReadOnlyList<AdminCompanyPayoutResponse> CompanyPayouts { get; set; } = [];
    private IReadOnlyList<AdminCompanyPayoutDestinationResponse> PayoutDestinations { get; set; } = [];
    private string SelectedPeriod { get; set; } = "month";
    private string ActiveFinanceFocus { get; set; } = "all";
    private string? SelectedPaymentStatus { get; set; }
    private string? SelectedPaymentMethod { get; set; }
    private string? SearchTerm { get; set; }
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }
    private Dictionary<Guid, string> CashProofReferences { get; } = [];
    private PendingFinancialAction? PendingAction { get; set; }
    private string FinancialMfaCode { get; set; } = string.Empty;
    private string? FinancialConfirmationMessage { get; set; }
    private bool FinancialConfirmationError { get; set; }
    private bool IsFinancialActionSubmitting { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            Snapshot = await ApiClient.GetAdminPaymentsAsync(SelectedPeriod, SelectedPaymentStatus, SelectedPaymentMethod, SearchTerm);
            CompanyPayouts = await ApiClient.GetAdminCompanyPayoutsAsync();
            PayoutDestinations = await ApiClient.GetAdminCompanyPayoutDestinationsAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = $"Impossible de charger les encaissements. Detail: {exception.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private static string Money(int amount) => $"{amount:N0} XOF";
    private static string FormatRate(int basisPoints) => basisPoints <= 0 ? "taux non defini" : $"{basisPoints / 100m:0.##}%";
    private static string GetPaymentTitle(AdminPaymentMissionResponse payment)
        => string.IsNullOrWhiteSpace(payment.PrestationName)
            ? payment.ServiceName
            : $"{payment.ServiceName} - {payment.PrestationName}";
    private static string FormatDate(DateTimeOffset value) => value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    private static string FormatOptionalDate(DateTimeOffset? value) => value is null ? "date inconnue" : FormatDate(value.Value);
    private string GetCashProofReference(Guid payoutId) => CashProofReferences.GetValueOrDefault(payoutId, string.Empty);
    private void SetCashProofReference(Guid payoutId, string? value) => CashProofReferences[payoutId] = value?.TrimStart() ?? string.Empty;
    private string ShareOfPaid(int amount)
    {
        var paidAmount = Snapshot?.Stats.PaidAmount ?? 0;
        if (paidAmount <= 0)
        {
            return "0%";
        }

        return $"{amount * 100m / paidAmount:0}%";
    }

    private void OpenMission(Guid missionId) => Navigation.NavigateTo($"/missions/{missionId}");
    private void OpenCompany(Guid companyId) => Navigation.NavigateTo($"/companies/{companyId}");
    private void OpenProvider(Guid providerId) => Navigation.NavigateTo($"/providers/{providerId}");

    private void OpenDestinationVerification(AdminCompanyPayoutDestinationResponse destination)
    {
        PendingAction = new PendingFinancialAction(
            FinancialActionKind.VerifyDestination,
            destination.Id,
            destination.CompanyName,
            destination.MaskedIdentifier,
            0,
            null);
        ResetFinancialConfirmation();
    }

    private void OpenPayoutConfirmation(AdminCompanyPayoutResponse payout, FinancialActionKind kind)
    {
        var proofReference = kind == FinancialActionKind.CompleteCash
            ? GetCashProofReference(payout.Id).Trim()
            : null;
        if (kind == FinancialActionKind.CompleteCash && string.IsNullOrWhiteSpace(proofReference))
        {
            ErrorMessage = "La référence du reçu ou de la preuve est obligatoire pour un retrait cash.";
            return;
        }

        PendingAction = new PendingFinancialAction(
            kind,
            payout.Id,
            payout.CompanyName,
            payout.Reference,
            payout.NetAmount,
            proofReference);
        ResetFinancialConfirmation();
    }

    private async Task ConfirmFinancialActionAsync()
    {
        if (PendingAction is null || string.IsNullOrWhiteSpace(FinancialMfaCode))
        {
            FinancialConfirmationMessage = "Saisissez le code affiché dans Authenticator.";
            FinancialConfirmationError = true;
            return;
        }

        IsFinancialActionSubmitting = true;
        try
        {
            var code = FinancialMfaCode.Trim();
            var result = PendingAction.Kind switch
            {
                FinancialActionKind.VerifyDestination => await ApiClient.VerifyCompanyPayoutDestinationAsync(PendingAction.ResourceId, code),
                FinancialActionKind.Approve => await ApiClient.ApproveCompanyPayoutAsync(PendingAction.ResourceId, code),
                FinancialActionKind.Reject => await ApiClient.RejectCompanyPayoutAsync(
                    PendingAction.ResourceId,
                    "Rejet manuel après contrôle administratif.",
                    code),
                FinancialActionKind.CompleteCash => await ApiClient.CompleteCashCompanyPayoutAsync(
                    PendingAction.ResourceId,
                    PendingAction.ProofReference!,
                    code),
                _ => new AdminFinancialApiResult(false, null, "Action inconnue.")
            };

            if (!result.IsSuccess)
            {
                FinancialConfirmationMessage = result.ErrorMessage;
                FinancialConfirmationError = true;
                return;
            }

            FinancialConfirmationMessage = result.Response?.Message ?? "Confirmation enregistrée.";
            FinancialConfirmationError = false;
            if (result.Response?.Completed == true)
            {
                if (PendingAction.Kind == FinancialActionKind.CompleteCash)
                {
                    CashProofReferences.Remove(PendingAction.ResourceId);
                }

                PendingAction = null;
            }

            await LoadAsync();
        }
        finally
        {
            IsFinancialActionSubmitting = false;
        }
    }

    private void CloseFinancialConfirmation() => PendingAction = null;
    private void ResetFinancialConfirmation() { FinancialMfaCode = string.Empty; FinancialConfirmationMessage = null; FinancialConfirmationError = false; }
    private string GetPendingActionTitle() => PendingAction?.Kind switch { FinancialActionKind.VerifyDestination => "Vérifier le compte bénéficiaire", FinancialActionKind.Approve => "Approuver le reversement", FinancialActionKind.Reject => "Rejeter le reversement", FinancialActionKind.CompleteCash => "Confirmer la remise d’espèces", _ => "Confirmer l’action" };
    private string GetPendingActionExplanation() => PendingAction?.Kind switch { FinancialActionKind.VerifyDestination => "Contrôlez l’identité du bénéficiaire et la destination avant de la valider.", FinancialActionKind.Approve => "Cette validation autorise le traitement du reversement.", FinancialActionKind.Reject => "Le montant réservé sera rendu au solde de l’entreprise.", FinancialActionKind.CompleteCash => "Deux administrateurs distincts doivent confirmer la remise avant le débit définitif.", _ => string.Empty };

    private enum FinancialActionKind { VerifyDestination, Approve, Reject, CompleteCash }
    private sealed record PendingFinancialAction(FinancialActionKind Kind, Guid ResourceId, string CompanyName, string Reference, int Amount, string? ProofReference);

    private static string TranslatePayoutMethod(string method) => method switch
    {
        "MobileMoney" => "Mobile Money",
        "BankTransfer" => "Virement bancaire",
        "Cash" => "Retrait agence",
        _ => method
    };

    private static string TranslatePayoutStatus(string status) => status switch
    {
        "Submitted" => "À valider",
        "Approved" => "Approuvé",
        "Processing" => "En cours",
        "Paid" => "Payé",
        "Failed" => "Échec",
        "Rejected" => "Rejeté",
        _ => status
    };

    private static string GetPayoutStatusClass(string status) => status switch
    {
        "Paid" => "status-success",
        "Failed" or "Rejected" => "status-danger",
        _ => "status-warning"
    };

    private async Task ApplyFinanceFocusAsync(string focus)
    {
        ActiveFinanceFocus = focus;
        SelectedPaymentStatus = null;
        SelectedPaymentMethod = null;

        switch (focus)
        {
            case "wele":
            case "payout":
                SelectedPaymentStatus = "Collected";
                break;
            case "mobile":
                SelectedPaymentMethod = "MobileMoney";
                SelectedPaymentStatus = "Collected";
                break;
            case "card":
                SelectedPaymentMethod = "Card";
                SelectedPaymentStatus = "Collected";
                break;
            case "risk":
                SelectedPaymentStatus = "Risk";
                break;
        }

        await LoadAsync();
    }

    private string GetFinanceFocusClass(string focus)
        => ActiveFinanceFocus == focus ? "active" : string.Empty;

    private static string TranslatePaymentStatus(string status) => status switch
    {
        "Paid" => "Encaisse",
        "Pending" => "En attente",
        "Authorized" => "Autorise",
        "Failed" => "Echec",
        "Refunded" => "Rembourse",
        _ => status
    };

    private static string TranslatePaymentMethod(string method) => method switch
    {
        "MobileMoney" => "Mobile Money",
        "Cash" => "Cash",
        "Card" => "Carte bancaire",
        _ => method
    };

    private static string GetPaymentStatusClass(string status) => status switch
    {
        "Paid" => "status-pill ok",
        "Failed" or "Refunded" => "status-pill danger",
        _ => "status-pill pending"
    };
}
