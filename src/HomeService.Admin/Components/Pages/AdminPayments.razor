@page "/payments"
@using HomeService.Admin.Services
@using HomeService.Contracts.Admin
@inject PlatformApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Encaissements</PageTitle>

<div class="admin-page-heading">
    <div>
        <p class="eyebrow">Finance</p>
        <h1>Encaissements</h1>
        <p class="lead">Suivez les paiements, la carte bancaire, Mobile Money et le chiffre d'affaires wele.</p>
    </div>
    <button type="button" class="secondary-action" @onclick="LoadAsync" disabled="@IsLoading">Actualiser</button>
</div>

@if (Snapshot is not null)
{
    <section class="payment-command-strip" aria-label="Filtres rapides finance">
        <button type="button" class="@GetFinanceFocusClass("all")" @onclick='() => ApplyFinanceFocusAsync("all")'>
            <span>Tous</span>
            <strong>@Money(Snapshot.Stats.TotalAmount)</strong>
        </button>
        <button type="button" class="@GetFinanceFocusClass("wele")" @onclick='() => ApplyFinanceFocusAsync("wele")'>
            <span>CA wele</span>
            <strong>@Money(Snapshot.Stats.PlatformCommissionAmount)</strong>
        </button>
        <button type="button" class="@GetFinanceFocusClass("payout")" @onclick='() => ApplyFinanceFocusAsync("payout")'>
            <span>A reverser</span>
            <strong>@Money(Snapshot.Stats.CompanyPayoutAmount)</strong>
        </button>
        <button type="button" class="@GetFinanceFocusClass("mobile")" @onclick='() => ApplyFinanceFocusAsync("mobile")'>
            <span>Mobile Money</span>
            <strong>@Money(Snapshot.Stats.MobileMoneyAmount)</strong>
        </button>
        <button type="button" class="@GetFinanceFocusClass("card")" @onclick='() => ApplyFinanceFocusAsync("card")'>
            <span>Carte bancaire</span>
            <strong>@Money(Snapshot.Stats.CardAmount)</strong>
        </button>
        <button type="button" class="@GetFinanceFocusClass("risk")" @onclick='() => ApplyFinanceFocusAsync("risk")'>
            <span>Litiges / remboursements</span>
            <strong>@Money(Snapshot.Stats.DisputedAmount + Snapshot.Stats.RefundAmount)</strong>
        </button>
    </section>

    <section class="admin-metric-grid compact payment-admin-metrics">
        <article class="payment-admin-revenue">
            <div>
                <span>CA wele</span>
                <strong>@Money(Snapshot.Stats.PlatformCommissionAmount)</strong>
                <small>Commission encaissee ou bloquee</small>
            </div>
            <i aria-hidden="true">%</i>
        </article>
        <article>
            <span>Reversement entreprises</span>
            <strong>@Money(Snapshot.Stats.CompanyPayoutAmount)</strong>
            <small>Montant net a reverser</small>
        </article>
        <article>
            <span>Total encaisse</span>
            <strong>@Money(Snapshot.Stats.PaidAmount)</strong>
            <small>Paye ou autorise - @Snapshot.Stats.TransactionCount transaction(s)</small>
        </article>
        <article class="payment-channel-card">
            <div>
                <span>Carte bancaire</span>
                <strong>@Money(Snapshot.Stats.CardAmount)</strong>
                <small>@ShareOfPaid(Snapshot.Stats.CardAmount) du total encaisse</small>
            </div>
            <i aria-hidden="true">CB</i>
        </article>
        <article class="payment-channel-card">
            <div>
                <span>Mobile Money</span>
                <strong>@Money(Snapshot.Stats.MobileMoneyAmount)</strong>
                <small>@ShareOfPaid(Snapshot.Stats.MobileMoneyAmount) du total encaisse</small>
            </div>
            <i aria-hidden="true">MM</i>
        </article>
        <article>
            <span>En attente</span>
            <strong>@Money(Snapshot.Stats.PendingAmount)</strong>
            <small>Commission previsionnelle @Money(Snapshot.Stats.PendingPlatformCommissionAmount)</small>
        </article>
        <article>
            <span>Litiges et remboursements</span>
            <strong>@Money(Snapshot.Stats.DisputedAmount)</strong>
            <small>Remboursements @Money(Snapshot.Stats.RefundAmount)</small>
        </article>
    </section>
}

<section class="operator-list payout-operations">
    <header>
        <div>
            <h2>Reversements entreprises</h2>
            <p>Contrôle des bénéficiaires, validation et preuve de remise.</p>
        </div>
    </header>

    @if (PayoutDestinations.Any(item => item.IsActive && !item.IsVerified))
    {
        <div class="payout-review-grid">
            @foreach (var destination in PayoutDestinations.Where(item => item.IsActive && !item.IsVerified))
            {
                <article class="payout-review-card">
                    <div>
                        <strong>@destination.CompanyName</strong>
                        <p>@destination.BeneficiaryName · @destination.ProviderCode · @destination.MaskedIdentifier</p>
                        <small>@destination.Method · ajouté le @FormatDate(destination.CreatedAt)</small>
                    </div>
                    <button type="button" class="secondary-action" @onclick="() => VerifyDestinationAsync(destination.Id)">Vérifier</button>
                </article>
            }
        </div>
    }

    @if (CompanyPayouts.Count == 0)
    {
        <article class="admin-empty-row"><strong>Aucun reversement</strong><p>Les demandes entreprises apparaîtront ici à leur échéance.</p></article>
    }
    else
    {
        @foreach (var payout in CompanyPayouts)
        {
            <article class="operator-row payout-admin-row">
                <div>
                    <strong>@payout.CompanyName</strong>
                    <p>@payout.Reference · @TranslatePayoutMethod(payout.Method) · @payout.Destination</p>
                    <small>Brut @Money(payout.GrossAmount) · frais @Money(payout.FeeAmount)</small>
                </div>
                <div class="operator-kpis">
                    <span>Net entreprise</span>
                    <strong>@Money(payout.NetAmount)</strong>
                    <span class="@GetPayoutStatusClass(payout.Status)">@TranslatePayoutStatus(payout.Status)</span>
                </div>
                <div class="payment-admin-actions payout-actions">
                    @if (payout.Status == "Submitted")
                    {
                        <button type="button" @onclick="() => ApprovePayoutAsync(payout.Id)">Approuver</button>
                        <button type="button" @onclick="() => RejectPayoutAsync(payout.Id)">Rejeter</button>
                    }
                    @if (payout.Method == "Cash" && (payout.Status == "Submitted" || payout.Status == "Approved"))
                    {
                        <input @bind="CashProofReference" placeholder="Référence preuve / reçu" />
                        <button type="button" @onclick="() => CompleteCashPayoutAsync(payout.Id)">Confirmer la remise</button>
                    }
                </div>
            </article>
        }
    }
</section>

<section class="toolbar operator-toolbar">
    <label>
        Periode
        <select @bind="SelectedPeriod">
            <option value="week">Semaine</option>
            <option value="month">Mois</option>
            <option value="year">Annee</option>
        </select>
    </label>
    <label>
        Statut paiement
        <select @bind="SelectedPaymentStatus">
            <option value="">Tous</option>
            <option value="Collected">Encaisse ou bloque</option>
            <option value="Risk">Litige ou remboursement</option>
            <option value="Paid">Encaisse</option>
            <option value="Pending">En attente</option>
            <option value="Authorized">Autorise</option>
            <option value="Failed">Echec</option>
            <option value="Refunded">Rembourse</option>
        </select>
    </label>
    <label>
        Mode
        <select @bind="SelectedPaymentMethod">
            <option value="">Tous</option>
            <option value="MobileMoney">Mobile Money</option>
            <option value="Card">Carte bancaire</option>
            <option value="Cash">Cash</option>
        </select>
    </label>
    <label>
        Recherche
        <input type="search" @bind="SearchTerm" @bind:event="oninput" placeholder="Numero mission, client, entreprise, prestataire, service" />
    </label>
    <button type="button" class="secondary-action" @onclick="LoadAsync" disabled="@IsLoading">Appliquer</button>
</section>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p class="admin-message error-message">@ErrorMessage</p>
}

<section class="operator-list">
    <header>
        <div>
            <h2>Transactions missions</h2>
            <p>@(Snapshot?.Items.Count ?? 0) ligne(s) affichee(s)</p>
        </div>
    </header>

    @if (IsLoading)
    {
        <article class="operator-row">
            <div>
                <strong>Chargement...</strong>
                <p>Lecture des encaissements depuis l'API.</p>
            </div>
        </article>
    }
    else if (Snapshot is null || Snapshot.Items.Count == 0)
    {
        <article class="admin-empty-row">
            <strong>Aucun encaissement</strong>
            <p>Aucun resultat pour les filtres actuels. Changez la periode, le mode de paiement ou recherchez un numero mission.</p>
        </article>
    }
    else
    {
        @foreach (var payment in Snapshot.Items)
        {
            <article class="operator-row payment-row">
                <div>
                    <strong>@GetPaymentTitle(payment)</strong>
                    <p>@payment.CustomerName - @payment.CustomerPhoneNumber</p>
                    <small>@payment.MissionNumber - @(payment.CompanyName ?? "Entreprise non affectee")</small>
                </div>
                <div class="operator-meta">
                    <span class="@GetPaymentStatusClass(payment.PaymentStatus)">@TranslatePaymentStatus(payment.PaymentStatus)</span>
                    <small>@TranslatePaymentMethod(payment.PaymentMethod)</small>
                </div>
                <div class="operator-kpis">
                    <span>@(payment.ProviderName ?? "Prestataire non affecte")</span>
                    <span>@Money(payment.Amount)</span>
                    <span>Commission @Money(payment.PlatformCommissionAmount) (@FormatRate(payment.PlatformCommissionRateBasisPoints))</span>
                    <span>Entreprise @Money(payment.CompanyPayoutAmount)</span>
                </div>
                <div class="payment-admin-side">
                    <strong>@FormatDate(payment.ScheduledFor ?? payment.CreatedAt)</strong>
                    @if (payment.RefundAmount > 0)
                    {
                        <small>Remboursement @Money(payment.RefundAmount)</small>
                    }
                    @if (payment.CancellationFeeAmount > 0)
                    {
                        <small>Annulation @Money(payment.CancellationFeeAmount)</small>
                    }
                    @if (payment.TransportFeeAmount > 0)
                    {
                        <small>Transport @Money(payment.TransportFeeAmount)</small>
                    }
                    <div class="payment-admin-actions">
                        <button type="button" @onclick="() => OpenMission(payment.MissionId)">Mission</button>
                        @if (payment.CompanyId is not null)
                        {
                            <button type="button" @onclick="() => OpenCompany(payment.CompanyId.Value)">Entreprise</button>
                        }
                        @if (payment.ProviderId is not null)
                        {
                            <button type="button" @onclick="() => OpenProvider(payment.ProviderId.Value)">Prestataire</button>
                        }
                    </div>
                </div>
            </article>
        }
    }
</section>

<style>
    .payout-operations{margin-bottom:24px}.payout-review-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;padding:18px}.payout-review-card{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:16px;border:1px solid #e3eaf5;border-radius:16px;background:#f8faff}.payout-review-card p,.payout-review-card small{margin:4px 0;color:#667085}.payout-admin-row{grid-template-columns:minmax(260px,1.5fr) minmax(180px,.7fr) minmax(240px,1fr)}.payout-actions{display:flex;flex-wrap:wrap;gap:8px}.payout-actions input{min-height:38px;border:1px solid #d7dfec;border-radius:9px;padding:0 10px}.status-success,.status-danger,.status-warning{display:inline-flex;width:max-content;padding:5px 9px;border-radius:999px;font-weight:800;font-size:12px}.status-success{background:#ecfdf3;color:#067647}.status-danger{background:#fef3f2;color:#b42318}.status-warning{background:#fff7ed;color:#c2410c}
    @@media(max-width:900px){.payout-admin-row{grid-template-columns:1fr}.payout-review-card{align-items:flex-start;flex-direction:column}}
</style>

@code {
    private AdminPaymentListResponse? Snapshot { get; set; }
    private IReadOnlyList<AdminCompanyPayoutResponse> CompanyPayouts { get; set; } = [];
    private IReadOnlyList<AdminCompanyPayoutDestinationResponse> PayoutDestinations { get; set; } = [];
    private string SelectedPeriod { get; set; } = "month";
    private string ActiveFinanceFocus { get; set; } = "all";
    private string? SelectedPaymentStatus { get; set; }
    private string? SelectedPaymentMethod { get; set; }
    private string? SearchTerm { get; set; }
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }
    private string CashProofReference { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            Snapshot = await ApiClient.GetAdminPaymentsAsync(SelectedPeriod, SelectedPaymentStatus, SelectedPaymentMethod, SearchTerm);
            CompanyPayouts = await ApiClient.GetAdminCompanyPayoutsAsync();
            PayoutDestinations = await ApiClient.GetAdminCompanyPayoutDestinationsAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = $"Impossible de charger les encaissements. Detail: {exception.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private static string Money(int amount) => $"{amount:N0} XOF";
    private static string FormatRate(int basisPoints) => basisPoints <= 0 ? "taux non defini" : $"{basisPoints / 100m:0.##}%";
    private static string GetPaymentTitle(AdminPaymentMissionResponse payment)
        => string.IsNullOrWhiteSpace(payment.PrestationName)
            ? payment.ServiceName
            : $"{payment.ServiceName} - {payment.PrestationName}";
    private static string FormatDate(DateTimeOffset value) => value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    private string ShareOfPaid(int amount)
    {
        var paidAmount = Snapshot?.Stats.PaidAmount ?? 0;
        if (paidAmount <= 0)
        {
            return "0%";
        }

        return $"{amount * 100m / paidAmount:0}%";
    }

    private void OpenMission(Guid missionId) => Navigation.NavigateTo($"/missions/{missionId}");
    private void OpenCompany(Guid companyId) => Navigation.NavigateTo($"/companies/{companyId}");
    private void OpenProvider(Guid providerId) => Navigation.NavigateTo($"/providers/{providerId}");

    private async Task VerifyDestinationAsync(Guid destinationId)
    {
        var result = await ApiClient.VerifyCompanyPayoutDestinationAsync(destinationId);
        ErrorMessage = result.IsSuccess ? null : result.ErrorMessage;
        await LoadAsync();
    }

    private async Task ApprovePayoutAsync(Guid payoutId)
    {
        var result = await ApiClient.ApproveCompanyPayoutAsync(payoutId);
        ErrorMessage = result.IsSuccess ? null : result.ErrorMessage;
        await LoadAsync();
    }

    private async Task RejectPayoutAsync(Guid payoutId)
    {
        var result = await ApiClient.RejectCompanyPayoutAsync(payoutId, "Rejet manuel après contrôle administratif.");
        ErrorMessage = result.IsSuccess ? null : result.ErrorMessage;
        await LoadAsync();
    }

    private async Task CompleteCashPayoutAsync(Guid payoutId)
    {
        if (string.IsNullOrWhiteSpace(CashProofReference))
        {
            ErrorMessage = "La référence du reçu ou de la preuve est obligatoire pour un retrait cash.";
            return;
        }

        var result = await ApiClient.CompleteCashCompanyPayoutAsync(payoutId, CashProofReference.Trim());
        ErrorMessage = result.IsSuccess ? null : result.ErrorMessage;
        if (result.IsSuccess) CashProofReference = string.Empty;
        await LoadAsync();
    }

    private static string TranslatePayoutMethod(string method) => method switch
    {
        "MobileMoney" => "Mobile Money",
        "BankTransfer" => "Virement bancaire",
        "Cash" => "Retrait agence",
        _ => method
    };

    private static string TranslatePayoutStatus(string status) => status switch
    {
        "Submitted" => "À valider",
        "Approved" => "Approuvé",
        "Processing" => "En cours",
        "Paid" => "Payé",
        "Failed" => "Échec",
        "Rejected" => "Rejeté",
        _ => status
    };

    private static string GetPayoutStatusClass(string status) => status switch
    {
        "Paid" => "status-success",
        "Failed" or "Rejected" => "status-danger",
        _ => "status-warning"
    };

    private async Task ApplyFinanceFocusAsync(string focus)
    {
        ActiveFinanceFocus = focus;
        SelectedPaymentStatus = null;
        SelectedPaymentMethod = null;

        switch (focus)
        {
            case "wele":
            case "payout":
                SelectedPaymentStatus = "Collected";
                break;
            case "mobile":
                SelectedPaymentMethod = "MobileMoney";
                SelectedPaymentStatus = "Collected";
                break;
            case "card":
                SelectedPaymentMethod = "Card";
                SelectedPaymentStatus = "Collected";
                break;
            case "risk":
                SelectedPaymentStatus = "Risk";
                break;
        }

        await LoadAsync();
    }

    private string GetFinanceFocusClass(string focus)
        => ActiveFinanceFocus == focus ? "active" : string.Empty;

    private static string TranslatePaymentStatus(string status) => status switch
    {
        "Paid" => "Encaisse",
        "Pending" => "En attente",
        "Authorized" => "Autorise",
        "Failed" => "Echec",
        "Refunded" => "Rembourse",
        _ => status
    };

    private static string TranslatePaymentMethod(string method) => method switch
    {
        "MobileMoney" => "Mobile Money",
        "Cash" => "Cash",
        "Card" => "Carte bancaire",
        _ => method
    };

    private static string GetPaymentStatusClass(string status) => status switch
    {
        "Paid" => "status-pill ok",
        "Failed" or "Refunded" => "status-pill danger",
        _ => "status-pill pending"
    };
}
