@page "/quality"
@using HomeService.Admin.Services
@using HomeService.Contracts.Admin
@using HomeService.Contracts.Services
@inject PlatformApiClient ApiClient

<PageTitle>Qualité terrain</PageTitle>

<section class="admin-page-heading quality-heading">
    <div>
        <p class="eyebrow">Excellence opérationnelle</p>
        <h1>Qualité terrain</h1>
        <p class="lead">Créez simplement les contrôles demandés au prestataire : validation, photo, texte ou mesure.</p>
    </div>
    <button type="button" class="secondary-action" @onclick="LoadAsync" disabled="@IsBusy">Actualiser</button>
</section>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <p class="admin-message success-message">@Message</p>
}
@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p class="admin-message error-message">@ErrorMessage</p>
}

@if (Snapshot is null)
{
    <section class="quality-loading"><strong>Chargement du pilotage qualité...</strong></section>
}
else
{
    <section class="quality-kpis">
        <article><span>Checklists actives</span><strong>@Snapshot.Stats.ActiveTemplates</strong><small>Une version figée par mission</small></article>
        <article><span>Audits à traiter</span><strong>@Snapshot.Stats.PendingAudits</strong><small>Contrôles terrain échantillonnés</small></article>
        <article><span>Qualifications en attente</span><strong>@Snapshot.Stats.PendingQualifications</strong><small>Validation par prestation</small></article>
        <article class="risk"><span>Prestataires sous revue</span><strong>@Snapshot.Stats.ProvidersUnderReview</strong><small>@Snapshot.Stats.FailedAudits audit(s) échoué(s)</small></article>
    </section>

    <section class="quality-panel templates-panel">
        <header class="templates-header">
            <div>
                <p class="eyebrow">Standards terrain</p>
                <h2>Checklists par prestation</h2>
                <p>Les modifications s'appliquent aux prochaines missions. L'historique déjà effectué reste intact.</p>
            </div>
            <button type="button" class="primary-action compact-action" @onclick="StartTemplateCreation">+ Nouvelle checklist</button>
        </header>

        @if (IsCreatingTemplate)
        {
            <section class="new-template-card">
                <div class="editor-section-heading">
                    <div><span class="step-number">1</span><div><strong>Choisir la prestation</strong><small>La nouvelle checklist remplacera l'ancienne version active pour ce périmètre.</small></div></div>
                    <button type="button" class="icon-action" title="Fermer" @onclick="CancelTemplateCreation">×</button>
                </div>
                <div class="template-form-grid">
                    <label>Service
                        <select @bind="NewTemplate.ServiceId" @bind:after="OnNewTemplateServiceChanged">
                            <option value="@Guid.Empty">Choisir un service</option>
                            @foreach (var service in Services.Where(service => service.IsActive))
                            {
                                <option value="@service.Id">@service.Name</option>
                            }
                        </select>
                    </label>
                    <label>Prestation
                        <select @bind="NewTemplate.ServicePrestationId" disabled="@(NewTemplate.ServiceId == Guid.Empty)">
                            <option value="">Socle commun au service</option>
                            @foreach (var prestation in NewTemplatePrestations)
                            {
                                <option value="@prestation.Id">@prestation.Name</option>
                            }
                        </select>
                    </label>
                    <label>Nom de la checklist
                        <input @bind="NewTemplate.Name" placeholder="Ex. Contrôle ménage standard" />
                    </label>
                    <label class="wide-field">Description <span>(facultatif)</span>
                        <input @bind="NewTemplate.Description" placeholder="À quoi sert cette checklist ?" />
                    </label>
                </div>
                <label class="inline-check"><input type="checkbox" @bind="NewTemplate.CopyFromServiceDefault" /> Reprendre les contrôles du socle commun</label>
                <div class="editor-footer">
                    <button type="button" class="secondary-action" @onclick="CancelTemplateCreation">Annuler</button>
                    <button type="button" class="primary-action" @onclick="CreateTemplateAsync" disabled="@IsSaving">Créer et ajouter les contrôles</button>
                </div>
            </section>
        }

        <div class="template-grid">
            @foreach (var template in Snapshot.Templates)
            {
                <article class="template-card @(template.IsActive ? "" : "inactive") @(EditingTemplate?.Id == template.Id ? "selected" : "")">
                    <div class="template-title">
                        <div><span>@template.ServiceName</span><h3>@(template.ServicePrestationName ?? "Socle commun")</h3></div>
                        <span class="version">v@template.Version</span>
                    </div>
                    <p>@template.Name</p>
                    <div class="template-stages">
                        <span>@template.Items.Count(item => item.IsActive && item.Stage == "BeforeStart") avant</span>
                        <span>@template.Items.Count(item => item.IsActive && item.Stage == "DuringMission") pendant</span>
                        <span>@template.Items.Count(item => item.IsActive && item.Stage == "BeforeCompletion") final</span>
                    </div>
                    <div class="template-summary">
                        <strong>@template.Items.Count(item => item.IsActive)</strong>
                        <span>contrôle(s)</span>
                        <small class="status-pill @(template.IsActive ? "active" : "")">@(template.IsActive ? "Active" : "Archivée")</small>
                    </div>
                    <button type="button" class="template-edit" @onclick="() => StartTemplateEdit(template)">Modifier la checklist</button>
                </article>
            }
        </div>
    </section>

    @if (EditingTemplate is not null)
    {
        <section class="quality-panel checklist-editor">
            <header class="editor-header">
                <div>
                    <p class="eyebrow">Éditeur simple</p>
                    <h2>@EditingTemplate.ServiceName · @(EditingTemplate.ServicePrestationName ?? "Socle commun")</h2>
                    <p>Ajoutez les actions dans l'ordre où le prestataire devra les faire.</p>
                </div>
                <button type="button" class="icon-action" title="Fermer" @onclick="CloseTemplateEditor">×</button>
            </header>

            <div class="template-identity">
                <label>Nom affiché
                    <input @bind="EditingTemplate.Name" />
                </label>
                <label>Description <span>(facultatif)</span>
                    <input @bind="EditingTemplate.Description" />
                </label>
                <label class="inline-check active-switch"><input type="checkbox" @bind="EditingTemplate.IsActive" /> Checklist active pour les prochaines missions</label>
            </div>

            <div class="control-list-heading">
                <div><span class="step-number">2</span><div><strong>Composer les contrôles</strong><small>Case à cocher, choix Oui/Non, image, texte ou nombre.</small></div></div>
                <button type="button" class="add-control" @onclick="AddBlankItem">+ Ajouter un contrôle</button>
            </div>

            @if (EditingTemplate.Items.Count == 0)
            {
                <button type="button" class="empty-controls" @onclick="AddBlankItem">
                    <span>＋</span><strong>Ajouter le premier contrôle</strong><small>Vous choisirez ensuite ce que le prestataire doit fournir.</small>
                </button>
            }

            @foreach (var item in EditingTemplate.Items.OrderBy(item => item.SortOrder).ToList())
            {
                <article class="control-editor-card @(item.IsActive ? "" : "inactive")">
                    <div class="control-order">
                        <button type="button" title="Monter" @onclick="() => MoveItem(item, -1)">↑</button>
                        <span>@(EditingTemplate.Items.OrderBy(candidate => candidate.SortOrder).ToList().IndexOf(item) + 1)</span>
                        <button type="button" title="Descendre" @onclick="() => MoveItem(item, 1)">↓</button>
                    </div>
                    <div class="control-content">
                        <div class="control-topline">
                            <label class="control-label">Consigne donnée au prestataire
                                <input @bind="item.Label" placeholder="Ex. Prendre une photo de la zone nettoyée" />
                            </label>
                            <label class="stage-field">Moment
                                <select @bind="item.Stage">
                                    @foreach (var stage in Stages)
                                    {
                                        <option value="@stage.Value">@stage.Label</option>
                                    }
                                </select>
                            </label>
                        </div>

                        <div class="response-picker">
                            <span>Réponse attendue</span>
                            <div class="response-options">
                                @foreach (var responseType in ResponseTypes)
                                {
                                    <button type="button" class="response-option @(item.ResponseType == responseType.Value ? "selected" : "")" @onclick="() => SelectResponseType(item, responseType.Value)">
                                        <b>@responseType.Icon</b><span>@responseType.Label</span><small>@responseType.Help</small>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="control-details-grid">
                            <label class="wide-field">Aide ou précision <span>(facultatif)</span>
                                <input @bind="item.Guidance" placeholder="Ex. La photo doit montrer toute la pièce" />
                            </label>
                            @if (AvailableOptions.Count > 0)
                            {
                                <label>Option concernée <span>(facultatif)</span>
                                    <select @bind="item.ServiceOptionId">
                                        <option value="">Toutes les options</option>
                                        @foreach (var option in AvailableOptions)
                                        {
                                            <option value="@option.Id">@option.Name</option>
                                        }
                                    </select>
                                </label>
                            }
                        </div>

                        <div class="control-settings">
                            <label class="inline-check"><input type="checkbox" @bind="item.IsRequired" /> Obligatoire</label>
                            <label class="inline-check"><input type="checkbox" @bind="item.RequiresEvidenceOnIssue" /> Demander une preuve en cas de problème</label>
                            @if (!item.IsActive)
                            {
                                <label class="inline-check"><input type="checkbox" @bind="item.IsActive" /> Réactiver ce contrôle</label>
                            }
                            <span class="control-preview">Dans l'app : <strong>@ResponseLabel(item.ResponseType)</strong></span>
                        </div>
                    </div>
                    <div class="control-delete">
                        @if (PendingDeleteItemId == item.LocalId)
                        {
                            <span>Supprimer ?</span>
                            <button type="button" class="danger-action" @onclick="() => RemoveItemAsync(item)">Oui</button>
                            <button type="button" @onclick="CancelItemDeletion">Non</button>
                        }
                        else
                        {
                            <button type="button" class="delete-icon" title="Supprimer ce contrôle" @onclick="() => AskItemDeletion(item)">Supprimer</button>
                        }
                    </div>
                </article>
            }

            <footer class="editor-footer editor-save-bar">
                <div>
                    @if (PendingDeleteTemplateId == EditingTemplate.Id)
                    {
                        <span>Confirmer la suppression de cette checklist ?</span>
                        <button type="button" class="danger-action" @onclick="DeleteTemplateAsync">Oui, supprimer</button>
                        <button type="button" class="secondary-action" @onclick="CancelTemplateDeletion">Annuler</button>
                    }
                    else
                    {
                        <button type="button" class="delete-template" @onclick="AskTemplateDeletion">Supprimer la checklist</button>
                    }
                </div>
                <div>
                    <button type="button" class="secondary-action" @onclick="CloseTemplateEditor">Fermer</button>
                    <button type="button" class="primary-action" @onclick="SaveTemplateAsync" disabled="@IsSaving">@(IsSaving ? "Enregistrement..." : "Enregistrer les modifications")</button>
                </div>
            </footer>
        </section>
    }

    <section class="quality-grid">
        <article class="quality-panel">
            <header><div><p class="eyebrow">Action prioritaire</p><h2>Audits à vérifier</h2></div><span class="quality-count">@Snapshot.PendingAudits.Count</span></header>
            @if (Snapshot.PendingAudits.Count == 0)
            {
                <div class="quality-empty"><strong>File d'audit vide</strong><p>Les prochains contrôles aléatoires apparaîtront ici.</p></div>
            }
            @foreach (var audit in Snapshot.PendingAudits.Take(8))
            {
                <div class="quality-row">
                    <div class="quality-avatar">@Initials(audit.ProviderName)</div>
                    <div class="quality-main"><strong>@audit.ProviderName</strong><span>@audit.ServiceName · @audit.ServicePrestationName</span><small>@audit.MissionNumber · @audit.CompletedChecklistItems/@audit.TotalChecklistItems contrôles · @audit.EvidenceCount photo(s)</small></div>
                    <div class="quality-actions">
                        <button type="button" class="approve" @onclick="() => DecideAuditAsync(audit.Id, true)">Conforme</button>
                        <button type="button" class="reject" @onclick="() => DecideAuditAsync(audit.Id, false)">Écart</button>
                    </div>
                </div>
            }
        </article>

        <article class="quality-panel">
            <header><div><p class="eyebrow">Habilitation</p><h2>Qualifications</h2></div><span class="quality-count">@Snapshot.Stats.PendingQualifications</span></header>
            @if (PendingQualifications.Count == 0)
            {
                <div class="quality-empty"><strong>Aucune qualification en attente</strong><p>Les nouvelles compétences soumises apparaîtront ici.</p></div>
            }
            @foreach (var qualification in PendingQualifications.Take(8))
            {
                <div class="quality-row">
                    <div class="quality-avatar soft">@Initials(qualification.ProviderName)</div>
                    <div class="quality-main"><strong>@qualification.ProviderName</strong><span>@qualification.ServiceName · @qualification.ServicePrestationName</span><small>Examen théorique et pratique à valider</small></div>
                    <div class="quality-actions">
                        <button type="button" class="approve" @onclick="() => ApproveQualificationAsync(qualification.Id)">Qualifier</button>
                        <button type="button" @onclick="() => RequireTrainingAsync(qualification.Id)">Former</button>
                    </div>
                </div>
            }
        </article>
    </section>

    <section class="quality-panel">
        <header><div><p class="eyebrow">Classement</p><h2>Entreprises les plus fiables</h2></div></header>
        <div class="leaderboard">
            @foreach (var company in Snapshot.TopCompanies.Take(10).Select((value, index) => new { value, index }))
            {
                <div><span class="rank">@(company.index + 1)</span><strong>@company.value.CompanyName</strong><span>@company.value.ServiceName · @company.value.ServicePrestationName</span><b>@company.value.Score/100</b></div>
            }
        </div>
    </section>
}

@code {
    private static readonly IReadOnlyList<SelectChoice> Stages =
    [
        new("BeforeStart", "Avant de commencer", ""),
        new("DuringMission", "Pendant la mission", ""),
        new("BeforeCompletion", "Avant de terminer", "")
    ];

    private static readonly IReadOnlyList<SelectChoice> ResponseTypes =
    [
        new("Confirmation", "Case à cocher", "✓", "Confirmer que c'est fait"),
        new("YesNo", "Oui / Non", "◉", "Choisir une réponse"),
        new("Photo", "Ajouter une image", "▣", "Prendre ou importer une photo"),
        new("ShortText", "Ajouter un texte", "Aa", "Saisir une remarque"),
        new("Number", "Ajouter un nombre", "12", "Saisir une mesure"),
        new("Choice", "Réponse courte", "⌁", "Saisir une option ou un état")
    ];

    private AdminQualityDashboardResponse? Snapshot;
    private IReadOnlyList<AdminProviderQualificationResponse> PendingQualifications = [];
    private IReadOnlyList<ServiceSummaryResponse> Services = [];
    private TemplateEditorDraft? EditingTemplate;
    private NewTemplateDraft NewTemplate = new();
    private bool IsCreatingTemplate;
    private bool IsBusy = true;
    private bool IsSaving;
    private Guid? PendingDeleteItemId;
    private Guid? PendingDeleteTemplateId;
    private string? Message;
    private string? ErrorMessage;

    private IReadOnlyList<ServicePrestationSummaryResponse> NewTemplatePrestations =>
        Services.FirstOrDefault(service => service.Id == NewTemplate.ServiceId)?.Prestations.Where(item => item.IsActive).OrderBy(item => item.SortOrder).ToList() ?? [];

    private IReadOnlyList<ServiceOptionSummaryResponse> AvailableOptions
    {
        get
        {
            if (EditingTemplate?.ServicePrestationId is not Guid prestationId) return [];
            return Services.SelectMany(service => service.Prestations)
                .FirstOrDefault(prestation => prestation.Id == prestationId)?.Options?
                .Where(option => option.IsActive).OrderBy(option => option.SortOrder).ToList() ?? [];
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsBusy = true;
        Message = null;
        ErrorMessage = null;
        try
        {
            await RefreshDataAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Impossible de charger la qualité. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task RefreshDataAsync()
    {
        Snapshot = await ApiClient.GetAdminQualityDashboardAsync();
        PendingQualifications = await ApiClient.GetQualityQualificationsAsync("PendingReview");
        Services = await ApiClient.GetAdminServicesAsync();
    }

    private void StartTemplateCreation()
    {
        IsCreatingTemplate = true;
        NewTemplate = new NewTemplateDraft();
        EditingTemplate = null;
        ClearFeedback();
    }

    private void CancelTemplateCreation() => IsCreatingTemplate = false;

    private void OnNewTemplateServiceChanged()
    {
        NewTemplate.ServicePrestationId = null;
        if (NewTemplate.ServiceId != Guid.Empty && string.IsNullOrWhiteSpace(NewTemplate.Name))
        {
            var service = Services.FirstOrDefault(item => item.Id == NewTemplate.ServiceId);
            NewTemplate.Name = service is null ? string.Empty : $"Contrôle qualité {service.Name}";
        }
    }

    private async Task CreateTemplateAsync()
    {
        ClearFeedback();
        if (NewTemplate.ServiceId == Guid.Empty)
        {
            ErrorMessage = "Choisissez d'abord un service.";
            return;
        }
        if (string.IsNullOrWhiteSpace(NewTemplate.Name))
        {
            ErrorMessage = "Donnez un nom à la checklist.";
            return;
        }

        IsSaving = true;
        try
        {
            var created = await ApiClient.CreateQualityTemplateAsync(new(
                NewTemplate.ServiceId,
                NewTemplate.ServicePrestationId,
                NewTemplate.Name.Trim(),
                Clean(NewTemplate.Description),
                NewTemplate.CopyFromServiceDefault));
            await RefreshDataAsync();
            IsCreatingTemplate = false;
            var refreshed = created is null ? null : Snapshot?.Templates.FirstOrDefault(item => item.Id == created.Id);
            if (refreshed is not null) StartTemplateEdit(refreshed);
            Message = "Checklist créée. Vous pouvez maintenant ajouter ses contrôles.";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void StartTemplateEdit(AdminQualityChecklistTemplateResponse template)
    {
        EditingTemplate = new TemplateEditorDraft
        {
            Id = template.Id,
            ServiceId = template.ServiceId,
            ServiceName = template.ServiceName,
            ServicePrestationId = template.ServicePrestationId,
            ServicePrestationName = template.ServicePrestationName,
            Name = template.Name,
            Description = template.Description,
            IsActive = template.IsActive,
            Items = template.Items.OrderBy(item => item.SortOrder).Select(item => new ItemEditorDraft
            {
                Id = item.Id,
                LocalId = item.Id,
                Label = item.Label,
                Guidance = item.Guidance,
                Stage = item.Stage,
                ResponseType = item.ResponseType,
                IsRequired = item.IsRequired,
                RequiresEvidenceOnIssue = item.RequiresEvidenceOnIssue,
                ServiceOptionId = item.ServiceOptionId,
                SortOrder = item.SortOrder,
                IsActive = item.IsActive
            }).ToList()
        };
        IsCreatingTemplate = false;
        PendingDeleteItemId = null;
        PendingDeleteTemplateId = null;
        ClearFeedback();
    }

    private void CloseTemplateEditor()
    {
        EditingTemplate = null;
        PendingDeleteItemId = null;
        PendingDeleteTemplateId = null;
    }

    private void AddBlankItem()
    {
        if (EditingTemplate is null) return;
        var sortOrder = EditingTemplate.Items.Count == 0 ? 10 : EditingTemplate.Items.Max(item => item.SortOrder) + 10;
        EditingTemplate.Items.Add(new ItemEditorDraft { LocalId = Guid.NewGuid(), SortOrder = sortOrder });
    }

    private static void SelectResponseType(ItemEditorDraft item, string responseType)
    {
        item.ResponseType = responseType;
        if (responseType == "Photo") item.RequiresEvidenceOnIssue = false;
    }

    private void MoveItem(ItemEditorDraft item, int direction)
    {
        if (EditingTemplate is null) return;
        var ordered = EditingTemplate.Items.OrderBy(candidate => candidate.SortOrder).ToList();
        var currentIndex = ordered.IndexOf(item);
        var targetIndex = currentIndex + direction;
        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= ordered.Count) return;
        (ordered[currentIndex].SortOrder, ordered[targetIndex].SortOrder) = (ordered[targetIndex].SortOrder, ordered[currentIndex].SortOrder);
    }

    private void AskItemDeletion(ItemEditorDraft item) => PendingDeleteItemId = item.LocalId;
    private void CancelItemDeletion() => PendingDeleteItemId = null;

    private async Task RemoveItemAsync(ItemEditorDraft item)
    {
        if (EditingTemplate is null) return;
        ClearFeedback();
        try
        {
            if (item.Id != Guid.Empty)
            {
                var result = await ApiClient.DeleteQualityTemplateItemAsync(item.Id);
                Message = result?.Message ?? "Contrôle supprimé.";
            }
            EditingTemplate.Items.Remove(item);
            PendingDeleteItemId = null;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task SaveTemplateAsync()
    {
        if (EditingTemplate is null) return;
        ClearFeedback();
        if (string.IsNullOrWhiteSpace(EditingTemplate.Name))
        {
            ErrorMessage = "Le nom de la checklist est obligatoire.";
            return;
        }
        if (EditingTemplate.Items.Any(item => item.IsActive && string.IsNullOrWhiteSpace(item.Label)))
        {
            ErrorMessage = "Chaque contrôle actif doit contenir une consigne.";
            return;
        }

        IsSaving = true;
        try
        {
            var templateId = EditingTemplate.Id;
            await ApiClient.UpdateQualityTemplateAsync(templateId, new(
                EditingTemplate.Name.Trim(),
                Clean(EditingTemplate.Description),
                EditingTemplate.IsActive));

            var orderedItems = EditingTemplate.Items.OrderBy(item => item.SortOrder).ToList();
            for (var index = 0; index < orderedItems.Count; index++)
            {
                var item = orderedItems[index];
                item.SortOrder = (index + 1) * 10;
                if (item.Id == Guid.Empty)
                {
                    if (!item.IsActive) continue;
                    await ApiClient.CreateQualityTemplateItemAsync(templateId, new(
                        null,
                        item.Label.Trim(),
                        Clean(item.Guidance),
                        item.Stage,
                        item.ResponseType,
                        item.IsRequired,
                        item.RequiresEvidenceOnIssue,
                        item.ServiceOptionId,
                        item.SortOrder));
                }
                else
                {
                    await ApiClient.UpdateQualityTemplateItemAsync(item.Id, new(
                        item.Label.Trim(),
                        Clean(item.Guidance),
                        item.Stage,
                        item.ResponseType,
                        item.IsRequired,
                        item.RequiresEvidenceOnIssue,
                        item.SortOrder,
                        item.IsActive,
                        item.ServiceOptionId));
                }
            }

            await RefreshDataAsync();
            var refreshed = Snapshot?.Templates.FirstOrDefault(item => item.Id == templateId);
            if (refreshed is not null) StartTemplateEdit(refreshed);
            Message = "Checklist enregistrée. Elle sera utilisée pour les prochaines missions.";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void AskTemplateDeletion()
    {
        if (EditingTemplate is not null) PendingDeleteTemplateId = EditingTemplate.Id;
    }

    private void CancelTemplateDeletion() => PendingDeleteTemplateId = null;

    private async Task DeleteTemplateAsync()
    {
        if (EditingTemplate is null) return;
        ClearFeedback();
        try
        {
            var result = await ApiClient.DeleteQualityTemplateAsync(EditingTemplate.Id);
            CloseTemplateEditor();
            await RefreshDataAsync();
            Message = result?.Message ?? "Checklist supprimée.";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task DecideAuditAsync(Guid id, bool passed)
    {
        ClearFeedback();
        try
        {
            await ApiClient.ReviewQualityAuditAsync(id, new(passed, passed ? 90 : 45, passed ? "Audit conforme." : "Écart constaté, prestataire à revoir."));
            await RefreshDataAsync();
            Message = "Audit enregistré.";
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }

    private async Task ReviewQualificationAsync(Guid id, string status)
    {
        ClearFeedback();
        try
        {
            await ApiClient.ReviewQualityQualificationAsync(id, new(status, null, null, status == "Approved" ? "Qualification validée." : "Formation pratique requise.", null));
            await RefreshDataAsync();
            Message = "Qualification mise à jour.";
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }

    private Task ApproveQualificationAsync(Guid id) => ReviewQualificationAsync(id, "Approved");
    private Task RequireTrainingAsync(Guid id) => ReviewQualificationAsync(id, "TrainingRequired");

    private void ClearFeedback()
    {
        Message = null;
        ErrorMessage = null;
    }

    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string Initials(string value) => string.Join(string.Empty, value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
    private static string ResponseLabel(string value) => value switch
    {
        "Photo" => "Ajout d'une image",
        "Automatic" => "Automatique",
        "YesNo" => "Choix Oui / Non",
        "Confirmation" => "Case à cocher",
        "ShortText" => "Ajout d'un texte",
        "Number" => "Saisie d'un nombre",
        "Choice" => "Réponse courte",
        _ => value
    };

    private sealed record SelectChoice(string Value, string Label, string Icon = "", string Help = "");

    private sealed class NewTemplateDraft
    {
        public Guid ServiceId { get; set; }
        public Guid? ServicePrestationId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool CopyFromServiceDefault { get; set; } = true;
    }

    private sealed class TemplateEditorDraft
    {
        public Guid Id { get; init; }
        public Guid ServiceId { get; init; }
        public string ServiceName { get; init; } = string.Empty;
        public Guid? ServicePrestationId { get; init; }
        public string? ServicePrestationName { get; init; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool IsActive { get; set; }
        public List<ItemEditorDraft> Items { get; set; } = [];
    }

    private sealed class ItemEditorDraft
    {
        public Guid Id { get; set; }
        public Guid LocalId { get; set; }
        public string Label { get; set; } = string.Empty;
        public string? Guidance { get; set; }
        public string Stage { get; set; } = "DuringMission";
        public string ResponseType { get; set; } = "Confirmation";
        public bool IsRequired { get; set; } = true;
        public bool RequiresEvidenceOnIssue { get; set; }
        public Guid? ServiceOptionId { get; set; }
        public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;
    }
