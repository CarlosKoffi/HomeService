@page "/notifications"
@using HomeService.Admin.Services
@using HomeService.Contracts.Notifications
@inject PlatformApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Notifications</PageTitle>

<div class="admin-page-heading">
    <div>
        <h1>Notifications</h1>
        <p class="lead">Portail entreprise et application sont automatiques. Configurez seulement les envois email et WhatsApp par type de notification.</p>
    </div>
    <button type="button" class="secondary-action" @onclick="LoadAsync">Actualiser</button>
</div>

<nav class="notification-section-nav" aria-label="Navigation notifications">
    <button type="button"
            class="@GetSectionButtonClass("overview")"
            @onclick='() => SetSection("overview")'>
        Vue d'ensemble
        <span>@TotalOpenNotifications</span>
    </button>
    <button type="button"
            class="@GetSectionButtonClass("portal")"
            @onclick='() => SetSection("portal")'>
        Portail entreprise
        <span>@UnreadPortalNotifications</span>
    </button>
    <button type="button"
            class="@GetSectionButtonClass("external")"
            @onclick='() => SetSection("external")'>
        Email / WhatsApp
        <span>@ExternalNotifications.Count</span>
    </button>
    <button type="button"
            class="@GetSectionButtonClass("app")"
            @onclick='() => SetSection("app")'>
        Application
        <span>@AppNotifications.Count</span>
    </button>
    <button type="button"
            class="@GetSectionButtonClass("rules")"
            @onclick='() => SetSection("rules")'>
        Regles
        <span>@DeliveryRules.Count</span>
    </button>
    <button type="button"
            class="@GetSectionButtonClass("templates")"
            @onclick='() => SetSection("templates")'>
        Modeles
        <span>@NotificationTemplates.Count</span>
    </button>
</nav>

<section class="notification-admin-guide" aria-label="Organisation des notifications">
    <article>
        <span>Suivi</span>
        <strong>Files et portail</strong>
        <p>On surveille les messages deja crees: portail entreprise, application mobile, email et WhatsApp.</p>
    </article>
    <article>
        <span>Regles</span>
        <strong>Canaux par evenement</strong>
        <p>Portail et application sont automatiques. Email et WhatsApp restent activables selon le type de notification.</p>
    </article>
    <article>
        <span>Modeles</span>
        <strong>Textes administrables</strong>
        <p>Les textes utilisent des variables comme {NomEntreprise}, {NumeroMission} ou {Montant}.</p>
    </article>
</section>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p class="admin-message admin-message-error">@ErrorMessage</p>
}

@if (ActiveNotificationSection == "overview")
{
    <section class="notification-command-center">
        <article>
            <span>Portail non lues</span>
            <strong>@UnreadPortalNotifications</strong>
            <small>entreprises</small>
        </article>
        <article>
            <span>Externes a envoyer</span>
            <strong>@ExternalNotifications.Count(notification => notification.Status == "Pending")</strong>
            <small>email / WhatsApp</small>
        </article>
        <article>
            <span>Application</span>
            <strong>@AppNotifications.Count(notification => notification.Status is "Pending" or "Failed")</strong>
            <small>clients / prestataires</small>
        </article>
        <article>
            <span>Envoyees</span>
            <strong>@CountByStatus("Sent")</strong>
            <small>tous canaux</small>
        </article>
        <article>
            <span>En erreur</span>
            <strong>@CountByStatus("Failed")</strong>
            <small>tous canaux</small>
        </article>
        <article>
            <span>Annulees</span>
            <strong>@CountByStatus("Cancelled")</strong>
            <small>tous canaux</small>
        </article>
    </section>

    <section class="notification-overview-panel">
        <article>
            <span>Action rapide</span>
            <strong>Messages portail</strong>
            <p>Consultez ce que les entreprises voient dans leur espace et remettez un message en non lu si besoin.</p>
            <button type="button" @onclick='() => SetSection("portal")'>Ouvrir le portail</button>
        </article>
        <article>
            <span>Suivi externe</span>
            <strong>Files email et WhatsApp</strong>
            <p>Renvoyez, annulez ou marquez comme envoyees les notifications externes en attente.</p>
            <button type="button" @onclick='() => SetSection("external")'>Voir les envois</button>
        </article>
        <article>
            <span>Application</span>
            <strong>Messages client et prestataire</strong>
            <p>Suivez les messages qui partiront vers l'application mobile quand le canal sera branche.</p>
            <button type="button" @onclick='() => SetSection("app")'>Voir l'application</button>
        </article>
        <article>
            <span>Parametrage</span>
            <strong>Regles de diffusion</strong>
            <p>Email et WhatsApp restent configurables. Portail et application sont automatiques selon le destinataire.</p>
            <button type="button" @onclick='() => SetSection("rules")'>Configurer</button>
        </article>
    </section>
}

@if (ActiveNotificationSection == "rules")
{
    <section class="notification-rules-panel">
        <div class="notification-rules-head">
            <div>
                <span>Regles de diffusion</span>
                <strong>Canaux par type de notification</strong>
                <p>Le portail s'applique aux entreprises. L'application s'applique aux clients et prestataires. Email et WhatsApp restent configurables.</p>
            </div>
            <small>@FilteredDeliveryRules.Count / @DeliveryRules.Count type(s)</small>
        </div>

        <nav class="notification-subnav notification-group-nav" aria-label="Filtrer les regles par groupe metier">
            @foreach (var group in NotificationGroups)
            {
                <button type="button" class="@GetRuleGroupButtonClass(group.Key)" @onclick="() => SetRuleGroup(group.Key)">
                    @group.Label <span>@CountRulesByGroup(group.Key)</span>
                </button>
            }
        </nav>

        <section class="notification-group-summary" aria-label="Synthese du groupe de regles">
            <div>
                <span>Groupe actif</span>
                <strong>@GetActiveGroupLabel(ActiveRuleGroup)</strong>
                <p>@GetGroupDescription(ActiveRuleGroup)</p>
            </div>
            <dl>
                <div><dt>Portail</dt><dd>@CountRulesByGroupAndChannel(ActiveRuleGroup, "Portal")</dd></div>
                <div><dt>Application</dt><dd>@CountRulesByGroupAndChannel(ActiveRuleGroup, "MobileApp")</dd></div>
                <div><dt>Email</dt><dd>@CountRulesByGroupAndChannel(ActiveRuleGroup, "Email")</dd></div>
                <div><dt>WhatsApp</dt><dd>@CountRulesByGroupAndChannel(ActiveRuleGroup, "WhatsApp")</dd></div>
            </dl>
        </section>

        <section class="notification-search-strip" aria-label="Recherche dans les regles">
            <label>
                Rechercher une regle
                <input type="search"
                       @bind="RuleSearchTerm"
                       @bind:event="oninput"
                       placeholder="Evenement, libelle, audience..." />
            </label>
            <button type="button" class="light-action" @onclick="ClearRuleFilters">
                Reinitialiser
            </button>
        </section>

        <nav class="notification-subnav" aria-label="Filtrer les regles par destinataire">
            <button type="button" class="@GetRuleAudienceButtonClass("All")" @onclick='() => SetRuleAudience("All")'>
                Tous <span>@CountRulesInCurrentContext(audience: "All")</span>
            </button>
            <button type="button" class="@GetRuleAudienceButtonClass("Company")" @onclick='() => SetRuleAudience("Company")'>
                Entreprises <span>@CountRulesInCurrentContext(audience: "Company")</span>
            </button>
            <button type="button" class="@GetRuleAudienceButtonClass("Provider")" @onclick='() => SetRuleAudience("Provider")'>
                Prestataires <span>@CountRulesInCurrentContext(audience: "Provider")</span>
            </button>
            <button type="button" class="@GetRuleAudienceButtonClass("Customer")" @onclick='() => SetRuleAudience("Customer")'>
                Clients <span>@CountRulesInCurrentContext(audience: "Customer")</span>
            </button>
            <button type="button" class="@GetRuleAudienceButtonClass("Mixed")" @onclick='() => SetRuleAudience("Mixed")'>
                Mixtes <span>@CountRulesInCurrentContext(audience: "Mixed")</span>
            </button>
        </nav>

        <div class="notification-template-toolbar">
            <div>
                <span>Domaine</span>
                <nav class="notification-subnav compact" aria-label="Filtrer les regles par domaine">
                    <button type="button" class="@GetRuleTopicButtonClass("All")" @onclick='() => SetRuleTopic("All")'>Tous <span>@CountRulesInCurrentContext(topic: "All")</span></button>
                    <button type="button" class="@GetRuleTopicButtonClass("Applications")" @onclick='() => SetRuleTopic("Applications")'>Dossiers <span>@CountRulesInCurrentContext(topic: "Applications")</span></button>
                    <button type="button" class="@GetRuleTopicButtonClass("Missions")" @onclick='() => SetRuleTopic("Missions")'>Missions <span>@CountRulesInCurrentContext(topic: "Missions")</span></button>
                    <button type="button" class="@GetRuleTopicButtonClass("Payments")" @onclick='() => SetRuleTopic("Payments")'>Paiements <span>@CountRulesInCurrentContext(topic: "Payments")</span></button>
                    <button type="button" class="@GetRuleTopicButtonClass("Disputes")" @onclick='() => SetRuleTopic("Disputes")'>Litiges <span>@CountRulesInCurrentContext(topic: "Disputes")</span></button>
                    <button type="button" class="@GetRuleTopicButtonClass("Access")" @onclick='() => SetRuleTopic("Access")'>Acces <span>@CountRulesInCurrentContext(topic: "Access")</span></button>
                </nav>
            </div>
            <div>
                <span>Canal</span>
                <nav class="notification-subnav compact" aria-label="Filtrer les regles par canal">
                    <button type="button" class="@GetRuleChannelButtonClass("All")" @onclick='() => SetRuleChannel("All")'>Tous <span>@CountRulesInCurrentContext(channel: "All")</span></button>
                    <button type="button" class="@GetRuleChannelButtonClass("Portal")" @onclick='() => SetRuleChannel("Portal")'>Portail <span>@CountRulesInCurrentContext(channel: "Portal")</span></button>
                    <button type="button" class="@GetRuleChannelButtonClass("MobileApp")" @onclick='() => SetRuleChannel("MobileApp")'>Application <span>@CountRulesInCurrentContext(channel: "MobileApp")</span></button>
                    <button type="button" class="@GetRuleChannelButtonClass("Email")" @onclick='() => SetRuleChannel("Email")'>Email <span>@CountRulesInCurrentContext(channel: "Email")</span></button>
                    <button type="button" class="@GetRuleChannelButtonClass("WhatsApp")" @onclick='() => SetRuleChannel("WhatsApp")'>WhatsApp <span>@CountRulesInCurrentContext(channel: "WhatsApp")</span></button>
                </nav>
            </div>
        </div>

        @if (DeliveryRules.Count == 0 && IsLoading)
        {
            <article class="notification-rule-row">
                <p>Chargement des regles...</p>
            </article>
        }
        else
        {
            @foreach (var rule in FilteredDeliveryRules)
            {
                <article class="notification-rule-row">
                    <div class="notification-rule-copy">
                        <span>@TranslateAudience(rule.Audience)</span>
                        <strong>@rule.Label</strong>
                        <small>@rule.EventKey</small>
                    </div>
                    <div class="notification-channel-grid">
                        <label class="@GetRuleChannelClass(rule.PortalEnabled, rule.Audience == "Company" || rule.Audience == "Mixed")">
                            <input type="checkbox"
                                   checked="@rule.PortalEnabled"
                                   disabled />
                            <span>Portail</span>
                            <small>@GetInternalChannelHint(rule, "Portal")</small>
                        </label>
                        <label class="@GetRuleChannelClass(rule.MobileAppEnabled, rule.Audience != "Company")">
                            <input type="checkbox"
                                   checked="@rule.MobileAppEnabled"
                                   disabled />
                            <span>Application</span>
                            <small>@GetInternalChannelHint(rule, "MobileApp")</small>
                        </label>
                        <label class="@GetRuleChannelClass(rule.EmailEnabled, true)">
                            <input type="checkbox"
                                   checked="@rule.EmailEnabled"
                                   @onchange='eventArgs => ToggleRuleChannelAsync(rule, "Email", eventArgs)' />
                            <span>Email</span>
                            <small>Configurable</small>
                        </label>
                        <label class="@GetRuleChannelClass(rule.WhatsAppEnabled, true)">
                            <input type="checkbox"
                                   checked="@rule.WhatsAppEnabled"
                                   @onchange='eventArgs => ToggleRuleChannelAsync(rule, "WhatsApp", eventArgs)' />
                            <span>WhatsApp</span>
                            <small>Configurable</small>
                        </label>
                    </div>
                </article>
            }
        }
    </section>
}

@if (ActiveNotificationSection == "templates")
{
    <section class="notification-template-layout">
        <aside class="notification-variable-panel">
            <span>Variables disponibles</span>
            <strong>Aide de redaction</strong>
            <p>Inserez une variable entre accolades. Elle sera remplacee automatiquement au moment de l'envoi.</p>
            <dl>
                <dt>{NomEntreprise}</dt><dd>Nom de l'entreprise concernee.</dd>
                <dt>{NomPrestataire}</dt><dd>Nom du prestataire ou candidat.</dd>
                <dt>{NomClient}</dt><dd>Nom du client si la notification le concerne.</dd>
                <dt>{Service}</dt><dd>Service ou prestation demandee.</dd>
                <dt>{DescriptionService}</dt><dd>Description courte du service.</dd>
                <dt>{NumeroMission}</dt><dd>Numero lisible de mission.</dd>
                <dt>{Montant}</dt><dd>Montant affiche au destinataire.</dd>
                <dt>{DateMission}</dt><dd>Date ou heure de mission.</dd>
                <dt>{LienAction}</dt><dd>Lien d'action genere par la plateforme.</dd>
                <dt>{Note}</dt><dd>Commentaire saisi par l'admin ou l'entreprise.</dd>
            </dl>
        </aside>

        <section class="notification-template-list">
            <div class="notification-rules-head">
                <div>
                    <span>Modeles de messages</span>
                    <strong>Textes par evenement et canal</strong>
                    <p>Mobile, portail, email et WhatsApp utilisent la meme logique. Les liens et donnees sensibles restent generes par la plateforme.</p>
                </div>
                <div class="notification-inline-actions">
                    <small>@FilteredNotificationTemplates.Count / @NotificationTemplates.Count modele(s)</small>
                    <button type="button" @onclick="ToggleTemplateCreate">
                        @(ShowTemplateCreate ? "Fermer" : "Nouveau modele")
                    </button>
                </div>
            </div>

            <nav class="notification-subnav notification-group-nav" aria-label="Filtrer les modeles par groupe metier">
                @foreach (var group in NotificationGroups)
                {
                    <button type="button" class="@GetTemplateGroupButtonClass(group.Key)" @onclick="() => SetTemplateGroup(group.Key)">
                        @group.Label <span>@CountTemplatesByGroup(group.Key)</span>
                    </button>
                }
            </nav>

            <section class="notification-group-summary compact-summary" aria-label="Synthese du groupe de modeles">
                <div>
                    <span>Groupe actif</span>
                    <strong>@GetActiveGroupLabel(ActiveTemplateGroup)</strong>
                    <p>@GetGroupDescription(ActiveTemplateGroup)</p>
                </div>
                <dl>
                    <div><dt>Portail</dt><dd>@CountTemplatesByGroupAndChannel(ActiveTemplateGroup, "Portal")</dd></div>
                    <div><dt>Application</dt><dd>@CountTemplatesByGroupAndChannel(ActiveTemplateGroup, "MobilePush")</dd></div>
                    <div><dt>Email</dt><dd>@CountTemplatesByGroupAndChannel(ActiveTemplateGroup, "Email")</dd></div>
                    <div><dt>WhatsApp</dt><dd>@CountTemplatesByGroupAndChannel(ActiveTemplateGroup, "WhatsApp")</dd></div>
                </dl>
            </section>

            <section class="notification-search-strip" aria-label="Recherche dans les modeles">
                <label>
                    Rechercher un modele
                    <input type="search"
                           @bind="TemplateSearchTerm"
                           @bind:event="oninput"
                           placeholder="Evenement, libelle, sujet, contenu..." />
                </label>
                <button type="button" class="light-action" @onclick="ClearTemplateFilters">
                    Reinitialiser
                </button>
            </section>

            <div class="notification-template-toolbar">
                <div>
                    <span>Domaine</span>
                    <nav class="notification-subnav compact" aria-label="Filtrer les modeles par domaine">
                        <button type="button" class="@GetTemplateTopicButtonClass("All")" @onclick='() => SetTemplateTopic("All")'>Tous <span>@CountTemplatesInCurrentContext(topic: "All")</span></button>
                        <button type="button" class="@GetTemplateTopicButtonClass("Applications")" @onclick='() => SetTemplateTopic("Applications")'>Dossiers <span>@CountTemplatesInCurrentContext(topic: "Applications")</span></button>
                        <button type="button" class="@GetTemplateTopicButtonClass("Missions")" @onclick='() => SetTemplateTopic("Missions")'>Missions <span>@CountTemplatesInCurrentContext(topic: "Missions")</span></button>
                        <button type="button" class="@GetTemplateTopicButtonClass("Payments")" @onclick='() => SetTemplateTopic("Payments")'>Paiements <span>@CountTemplatesInCurrentContext(topic: "Payments")</span></button>
                        <button type="button" class="@GetTemplateTopicButtonClass("Disputes")" @onclick='() => SetTemplateTopic("Disputes")'>Litiges <span>@CountTemplatesInCurrentContext(topic: "Disputes")</span></button>
                        <button type="button" class="@GetTemplateTopicButtonClass("Access")" @onclick='() => SetTemplateTopic("Access")'>Acces <span>@CountTemplatesInCurrentContext(topic: "Access")</span></button>
                    </nav>
                </div>
                <div>
                    <span>Destinataire</span>
                    <nav class="notification-subnav compact" aria-label="Filtrer les modeles par destinataire">
                        <button type="button" class="@GetTemplateAudienceButtonClass("All")" @onclick='() => SetTemplateAudience("All")'>Tous <span>@CountTemplatesInCurrentContext(audience: "All")</span></button>
                        <button type="button" class="@GetTemplateAudienceButtonClass("Company")" @onclick='() => SetTemplateAudience("Company")'>Entreprises <span>@CountTemplatesInCurrentContext(audience: "Company")</span></button>
                        <button type="button" class="@GetTemplateAudienceButtonClass("Provider")" @onclick='() => SetTemplateAudience("Provider")'>Prestataires <span>@CountTemplatesInCurrentContext(audience: "Provider")</span></button>
                        <button type="button" class="@GetTemplateAudienceButtonClass("Customer")" @onclick='() => SetTemplateAudience("Customer")'>Clients <span>@CountTemplatesInCurrentContext(audience: "Customer")</span></button>
                        <button type="button" class="@GetTemplateAudienceButtonClass("Mixed")" @onclick='() => SetTemplateAudience("Mixed")'>Mixtes <span>@CountTemplatesInCurrentContext(audience: "Mixed")</span></button>
                    </nav>
                </div>
                <div>
                    <span>Canal</span>
                    <nav class="notification-subnav compact" aria-label="Filtrer les modeles par canal">
                        <button type="button" class="@GetTemplateChannelButtonClass("All")" @onclick='() => SetTemplateChannel("All")'>Tous <span>@CountTemplatesInCurrentContext(channel: "All")</span></button>
                        <button type="button" class="@GetTemplateChannelButtonClass("Portal")" @onclick='() => SetTemplateChannel("Portal")'>Portail <span>@CountTemplatesInCurrentContext(channel: "Portal")</span></button>
                        <button type="button" class="@GetTemplateChannelButtonClass("MobilePush")" @onclick='() => SetTemplateChannel("MobilePush")'>Application <span>@CountTemplatesInCurrentContext(channel: "MobilePush")</span></button>
                        <button type="button" class="@GetTemplateChannelButtonClass("Email")" @onclick='() => SetTemplateChannel("Email")'>Email <span>@CountTemplatesInCurrentContext(channel: "Email")</span></button>
                        <button type="button" class="@GetTemplateChannelButtonClass("WhatsApp")" @onclick='() => SetTemplateChannel("WhatsApp")'>WhatsApp <span>@CountTemplatesInCurrentContext(channel: "WhatsApp")</span></button>
                    </nav>
                </div>
            </div>

            @if (ShowTemplateCreate)
            {
                <article class="notification-template-create">
                    <div>
                        <span>Nouveau modele</span>
                        <strong>Ajouter un cas specifique</strong>
                        <p>A utiliser seulement si un evenement n'existe pas encore dans le catalogue standard.</p>
                    </div>
                    <div class="notification-template-create-grid">
                        <label>
                            Evenement
                            <input @bind="NewTemplate.EventKey" @bind:event="oninput" placeholder="Ex: MissionRefundApproved" />
                        </label>
                        <label>
                            Audience
                            <select @bind="NewTemplate.Audience">
                                <option value="Company">Entreprise</option>
                                <option value="Provider">Prestataire</option>
                                <option value="Customer">Client</option>
                                <option value="Mixed">Mixte</option>
                            </select>
                        </label>
                        <label>
                            Canal
                            <select @bind="NewTemplate.Channel">
                                <option value="Portal">Portail</option>
                                <option value="MobilePush">Application</option>
                                <option value="Email">Email</option>
                                <option value="WhatsApp">WhatsApp</option>
                            </select>
                        </label>
                        <label>
                            Libelle
                            <input @bind="NewTemplate.Label" @bind:event="oninput" placeholder="Nom visible en admin" />
                        </label>
                        <label>
                            Sujet
                            <input @bind="NewTemplate.SubjectTemplate" @bind:event="oninput" placeholder="Sujet ou titre de notification" />
                        </label>
                        <label>
                            Message
                            <textarea rows="2" @bind="NewTemplate.BodyTemplate" @bind:event="oninput" placeholder="Message avec variables si besoin"></textarea>
                        </label>
                    </div>
                    <button type="button" class="primary-action" @onclick="CreateTemplateAsync">Creer le modele</button>
                </article>
            }

            @foreach (var template in FilteredNotificationTemplates)
            {
                <article class="notification-template-card">
                    <header>
                        <div>
                            <span>@TranslateAudience(template.Audience) - @TranslateTemplateChannel(template.Channel)</span>
                            <strong>@template.Label</strong>
                            <small>@template.EventKey</small>
                        </div>
                        <label class="notification-template-active">
                            <input type="checkbox"
                                   checked="@template.IsActive"
                                   @onchange="eventArgs => UpdateTemplateAsync(template, isActive: IsChecked(eventArgs))" />
                            Actif
                        </label>
                    </header>
                    <div class="notification-template-editor">
                        <label>
                            Sujet
                            <input value="@template.SubjectTemplate"
                                   @onchange="eventArgs => UpdateTemplateAsync(template, subjectTemplate: eventArgs.Value?.ToString())" />
                        </label>
                        <label>
                            Message
                            <textarea rows="3"
                                      @onchange="eventArgs => UpdateTemplateAsync(template, bodyTemplate: eventArgs.Value?.ToString())">@template.BodyTemplate</textarea>
                        </label>
                    </div>
                    <small class="notification-template-variables">@template.AvailableVariables</small>
                </article>
            }
        </section>
    </section>
}

@if (ActiveNotificationSection == "portal")
{
    <section class="notification-command-center compact">
        <article>
            <span>Visibles</span>
            <strong>@FilteredCompanyPortalNotifications.Count</strong>
            <small>filtre actif</small>
        </article>
        <article>
            <span>Non lues</span>
            <strong>@CountFilteredPortalReadState(false)</strong>
            <small>entreprises</small>
        </article>
        <article>
            <span>Lues</span>
            <strong>@CountFilteredPortalReadState(true)</strong>
            <small>entreprises</small>
        </article>
        <article>
            <span>Alertes</span>
            <strong>@CountFilteredPortalAlerts()</strong>
            <small>orange / rouge</small>
        </article>
    </section>

    <section class="notification-filters notification-portal-search">
        <label>
            Recherche portail
            <input @bind="SearchTerm" @bind:event="oninput" placeholder="Entreprise, titre, message..." />
        </label>
        <label>
            Lecture
            <select @bind="PortalReadFilter">
                <option value="">Toutes</option>
                <option value="Unread">Non lues</option>
                <option value="Read">Lues</option>
            </select>
        </label>
    </section>

    <section class="notification-rules-panel portal-notification-admin-panel">
        <div class="notification-rules-head">
            <div>
                <span>Portail entreprise</span>
                <strong>Messages envoyes automatiquement au portail entreprise</strong>
                <p>Ces notifications sont visibles par l'entreprise dans son portail. Le renvoi les remet en non lues et les remonte dans son fil.</p>
            </div>
            <small>@CompanyPortalNotifications.Count message(s)</small>
        </div>

        @if (IsLoading)
        {
            <article class="notification-rule-row">
                <p>Chargement des notifications portail...</p>
            </article>
        }
        else if (FilteredCompanyPortalNotifications.Count == 0)
        {
            <article class="notification-rule-row">
                <p>Aucune notification portail ne correspond aux filtres.</p>
            </article>
        }
        else
        {
            @foreach (var notification in FilteredCompanyPortalNotifications)
            {
                <article class="@GetPortalNotificationClass(notification)">
                    <div class="notification-rule-copy">
                        <span>@notification.CompanyName</span>
                        <strong>@notification.Title</strong>
                        <small>@notification.Message</small>
                        <small>@TranslateNotificationTone(notification.Tone) - @notification.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <div class="notification-actions">
                        @if (notification.IsRead)
                        {
                            <button type="button"
                                    disabled="@IsBusy(notification.Id)"
                                    @onclick="() => MarkPortalNotificationUnreadAsync(notification)">
                                Remettre non lue
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    disabled="@IsBusy(notification.Id)"
