    private static bool CanCancel(NotificationOutboxMessageResponse notification)
    {
        return notification.Status is not "Sent" and not "Cancelled";
    }

    private static bool CanRetry(NotificationOutboxMessageResponse notification)
    {
        return notification.Status is not "Sent";
    }

    private static string GetRetryLabel(NotificationOutboxMessageResponse notification)
    {
        return notification.Status switch
        {
            "Pending" => "Renvoyer",
            "Cancelled" => "Remettre a envoyer",
            _ => "Relancer l'envoi"
        };
    }

    private static bool CanMarkSent(NotificationOutboxMessageResponse notification)
    {
        return notification.Status is "Pending" or "Failed";
    }

    private void ToggleCancel(Guid notificationId)
    {
        if (CancelNotificationId == notificationId)
        {
            CancelNotificationId = null;
            CancelReason = null;
            return;
        }

        CancelNotificationId = notificationId;
        CancelReason = null;
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private int CountByStatus(string status)
    {
        return QueuedNotifications.Count(notification => notification.Status == status);
    }

    private int CountFilteredExternalByStatus(string status)
    {
        return ExternalNotifications.Count(notification =>
            MatchesSearchAndChannel(notification)
            && string.Equals(notification.Status, status, StringComparison.OrdinalIgnoreCase));
    }

    private int CountFilteredAppByStatus(string status)
    {
        return AppNotifications.Count(notification =>
            MatchesSearchOnly(notification)
            && string.Equals(notification.Status, status, StringComparison.OrdinalIgnoreCase));
    }

    private int CountFilteredPortalReadState(bool isRead)
    {
        return CompanyPortalNotifications.Count(notification =>
            MatchesPortalSearch(notification)
            && notification.IsRead == isRead);
    }

    private int CountFilteredPortalAlerts()
    {
        return CompanyPortalNotifications.Count(notification =>
            MatchesPortalSearch(notification)
            && IsAlertTone(notification.Tone));
    }

    private string GetExternalCounterScope()
    {
        return string.IsNullOrWhiteSpace(ChannelFilter) ? "email / WhatsApp" : TranslateChannel(ChannelFilter);
    }

    private int CountRulesByAudience(string audience)
    {
        return DeliveryRules.Count(rule => string.Equals(rule.Audience, audience, StringComparison.OrdinalIgnoreCase));
    }

    private int CountRulesByChannel(string channel)
    {
        return DeliveryRules.Count(rule => RuleHasChannel(rule, channel));
    }

    private int CountRulesByGroup(string group)
    {
        return DeliveryRules.Count(rule => MatchesNotificationGroup(rule.EventKey, rule.Audience, group));
    }

    private int CountRulesByGroupAndChannel(string group, string channel)
    {
        return DeliveryRules.Count(rule => MatchesNotificationGroup(rule.EventKey, rule.Audience, group) && RuleHasChannel(rule, channel));
    }

    private int CountRulesByTopic(string topic)
    {
        return DeliveryRules.Count(rule => GetNotificationTopic(rule.EventKey) == topic);
    }

    private int CountRulesInCurrentContext(string? audience = null, string? topic = null, string? channel = null)
    {
        return DeliveryRules.Count(rule =>
            MatchesNotificationGroup(rule.EventKey, rule.Audience, ActiveRuleGroup)
            && (audience is null
                ? ActiveRuleAudience == "All" || string.Equals(rule.Audience, ActiveRuleAudience, StringComparison.OrdinalIgnoreCase)
                : audience == "All"
                ? true
                : string.Equals(rule.Audience, audience, StringComparison.OrdinalIgnoreCase))
            && (topic is null
                ? ActiveRuleTopic == "All" || GetNotificationTopic(rule.EventKey) == ActiveRuleTopic
                : topic == "All"
                ? true
                : GetNotificationTopic(rule.EventKey) == topic)
            && (channel is null
                ? ActiveRuleChannel == "All" || RuleHasChannel(rule, ActiveRuleChannel)
                : channel == "All"
                ? true
                : RuleHasChannel(rule, channel)));
    }

    private int CountTemplatesByAudience(string audience)
    {
        return NotificationTemplates.Count(template => string.Equals(template.Audience, audience, StringComparison.OrdinalIgnoreCase));
    }

    private int CountTemplatesByChannel(string channel)
    {
        return NotificationTemplates.Count(template => string.Equals(template.Channel, channel, StringComparison.OrdinalIgnoreCase));
    }

    private int CountTemplatesByGroup(string group)
    {
        return NotificationTemplates.Count(template => MatchesNotificationGroup(template.EventKey, template.Audience, group));
    }

    private int CountTemplatesByGroupAndChannel(string group, string channel)
    {
        return NotificationTemplates.Count(template =>
            MatchesNotificationGroup(template.EventKey, template.Audience, group)
            && string.Equals(template.Channel, channel, StringComparison.OrdinalIgnoreCase));
    }

    private int CountTemplatesByTopic(string topic)
    {
        return NotificationTemplates.Count(template => GetNotificationTopic(template.EventKey) == topic);
    }

    private int CountTemplatesInCurrentContext(string? audience = null, string? topic = null, string? channel = null)
    {
        return NotificationTemplates.Count(template =>
            MatchesNotificationGroup(template.EventKey, template.Audience, ActiveTemplateGroup)
            && (audience is null
                ? ActiveTemplateAudience == "All" || string.Equals(template.Audience, ActiveTemplateAudience, StringComparison.OrdinalIgnoreCase)
                : audience == "All"
                ? true
                : string.Equals(template.Audience, audience, StringComparison.OrdinalIgnoreCase))
            && (topic is null
                ? ActiveTemplateTopic == "All" || GetNotificationTopic(template.EventKey) == ActiveTemplateTopic
                : topic == "All"
                ? true
                : GetNotificationTopic(template.EventKey) == topic)
            && (channel is null
                ? ActiveTemplateChannel == "All" || string.Equals(template.Channel, ActiveTemplateChannel, StringComparison.OrdinalIgnoreCase)
                : channel == "All"
                ? true
                : string.Equals(template.Channel, channel, StringComparison.OrdinalIgnoreCase)));
    }

    private bool MatchesFilters(NotificationOutboxMessageResponse notification)
    {
        if (!string.IsNullOrWhiteSpace(StatusFilter)
            && !string.Equals(notification.Status, StatusFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return MatchesSearchAndChannel(notification);
    }

    private bool MatchesAppFilters(NotificationOutboxMessageResponse notification)
    {
        if (!string.IsNullOrWhiteSpace(StatusFilter)
            && !string.Equals(notification.Status, StatusFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return MatchesSearchOnly(notification);
    }

    private bool MatchesSearchAndChannel(NotificationOutboxMessageResponse notification)
    {
        if (!string.IsNullOrWhiteSpace(ChannelFilter)
            && !string.Equals(notification.Channel, ChannelFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return MatchesSearchOnly(notification);
    }

    private bool MatchesSearchOnly(NotificationOutboxMessageResponse notification)
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            return true;
        }

        var search = SearchTerm.Trim();
        return notification.Recipient.Contains(search, StringComparison.OrdinalIgnoreCase)
            || notification.Subject.Contains(search, StringComparison.OrdinalIgnoreCase)
            || notification.Body.Contains(search, StringComparison.OrdinalIgnoreCase)
            || (notification.RelatedEntityType?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private bool MatchesPortalFilters(AdminCompanyPortalNotificationResponse notification)
    {
        if (!MatchesPortalSearch(notification))
        {
            return false;
        }

        if (string.Equals(PortalReadFilter, "Unread", StringComparison.OrdinalIgnoreCase))
        {
            return !notification.IsRead;
        }

        if (string.Equals(PortalReadFilter, "Read", StringComparison.OrdinalIgnoreCase))
        {
            return notification.IsRead;
        }

        return true;
    }

    private bool MatchesPortalSearch(AdminCompanyPortalNotificationResponse notification)
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            return true;
        }

        var search = SearchTerm.Trim();
        return notification.CompanyName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || notification.Title.Contains(search, StringComparison.OrdinalIgnoreCase)
            || notification.Message.Contains(search, StringComparison.OrdinalIgnoreCase)
            || notification.Type.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesRuleChannel(NotificationDeliveryRuleResponse rule)
    {
        return ActiveRuleChannel == "All" || RuleHasChannel(rule, ActiveRuleChannel);
    }

    private bool MatchesRuleSearch(NotificationDeliveryRuleResponse rule)
    {
        if (string.IsNullOrWhiteSpace(RuleSearchTerm))
        {
            return true;
        }

        var search = RuleSearchTerm.Trim();
        return rule.EventKey.Contains(search, StringComparison.OrdinalIgnoreCase)
            || rule.Label.Contains(search, StringComparison.OrdinalIgnoreCase)
            || rule.Audience.Contains(search, StringComparison.OrdinalIgnoreCase)
            || (rule.SubjectTemplate?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (rule.BodyTemplate?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private bool MatchesTemplateSearch(NotificationTemplateResponse template)
    {
        if (string.IsNullOrWhiteSpace(TemplateSearchTerm))
        {
            return true;
        }

        var search = TemplateSearchTerm.Trim();
        return template.EventKey.Contains(search, StringComparison.OrdinalIgnoreCase)
            || template.Label.Contains(search, StringComparison.OrdinalIgnoreCase)
            || template.Audience.Contains(search, StringComparison.OrdinalIgnoreCase)
            || template.Channel.Contains(search, StringComparison.OrdinalIgnoreCase)
            || template.SubjectTemplate.Contains(search, StringComparison.OrdinalIgnoreCase)
            || template.BodyTemplate.Contains(search, StringComparison.OrdinalIgnoreCase)
            || (template.AvailableVariables?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private static bool RuleHasChannel(NotificationDeliveryRuleResponse rule, string channel)
    {
        return channel switch
        {
            "Portal" => rule.PortalEnabled,
            "MobileApp" => rule.MobileAppEnabled,
            "Email" => rule.EmailEnabled,
            "WhatsApp" => rule.WhatsAppEnabled,
            _ => true
        };
    }

    private static bool MatchesNotificationGroup(string eventKey, string audience, string group)
    {
        if (group == "All")
        {
            return true;
        }

        if (group is "Company" or "Provider" or "Customer")
        {
            return string.Equals(audience, group, StringComparison.OrdinalIgnoreCase)
                || string.Equals(audience, "Mixed", StringComparison.OrdinalIgnoreCase);
        }

        return GetNotificationTopic(eventKey) == group;
    }

