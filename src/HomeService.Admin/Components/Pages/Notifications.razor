    private static string TranslateNotificationTone(string tone) => tone switch
    {
        "success" => "Information positive",
        "warning" => "Action attendue",
        "danger" or "error" => "Attention",
        "pending" => "En attente",
        _ => "Information"
    };

    private static bool IsAlertTone(string tone)
    {
        return tone.Equals("warning", StringComparison.OrdinalIgnoreCase)
            || tone.Equals("danger", StringComparison.OrdinalIgnoreCase)
            || tone.Equals("error", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetNotificationTopic(string eventKey)
    {
        if (string.IsNullOrWhiteSpace(eventKey))
        {
            return "Other";
        }

        if (eventKey.Contains("Application", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Document", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Compliance", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Activation", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("ProviderProfile", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Interim", StringComparison.OrdinalIgnoreCase))
        {
            return "Applications";
        }

        if (eventKey.Contains("Payment", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Payout", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Commission", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Refund", StringComparison.OrdinalIgnoreCase))
        {
            return "Payments";
        }

        if (eventKey.Contains("Dispute", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Complaint", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Cancellation", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Cancel", StringComparison.OrdinalIgnoreCase))
        {
            return "Disputes";
        }

        if (eventKey.Contains("Mission", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Quote", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Assignment", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Provider", StringComparison.OrdinalIgnoreCase))
        {
            return "Missions";
        }

        if (eventKey.Contains("Login", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Password", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Code", StringComparison.OrdinalIgnoreCase)
            || eventKey.Contains("Token", StringComparison.OrdinalIgnoreCase))
        {
            return "Access";
        }

        return "Other";
    }

    private static string GetNotificationClass(string status)
    {
        return status switch
        {
            "Failed" => "status-rejected",
            "Sent" => "status-done",
            _ => "status-new"
        };
    }

