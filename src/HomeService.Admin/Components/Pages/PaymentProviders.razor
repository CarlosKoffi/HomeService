@page "/payment-providers"
@using HomeService.Admin.Services
@using HomeService.Contracts.Clients
@using Microsoft.AspNetCore.Components.Forms
@inject PlatformApiClient ApiClient

<PageTitle>Moyens de paiement</PageTitle>

<section class="admin-page-heading payment-catalog-heading">
    <div>
        <p class="eyebrow">Catalogue paiement</p>
        <h1>Moyens de paiement</h1>
        <p class="lead">Les opérateurs visibles dans l'application client, leurs informations et leurs logos.</p>
    </div>
    <button class="btn btn-primary" @onclick="NewProvider">Ajouter un moyen</button>
</section>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert @(IsError ? "alert-danger" : "alert-success")">@Message</div>
}

<section class="payment-provider-grid">
    @foreach (var provider in Providers)
    {
        <article class="payment-provider-card">
            <div class="payment-provider-brand">
                <span class="provider-logo-large">
                    <AdminMediaPreview Source="@provider.LogoUrl" Alt="@($"Logo {provider.Name}")" FallbackText="@Initials(provider.Name)" />
                </span>
                <span class="status-pill @(provider.IsActive ? "is-active" : "")">@(provider.IsActive ? "Visible" : "Masqué")</span>
            </div>
            <div class="payment-provider-copy">
                <h2>@provider.Name</h2>
                <p>@(string.IsNullOrWhiteSpace(provider.Description) ? "Aucune description renseignée." : provider.Description)</p>
                <small>@(provider.Method == "Card" ? "Carte bancaire" : "Mobile Money")</small>
            </div>
            <button class="btn btn-light" @onclick="() => Edit(provider)">Modifier</button>
        </article>
    }
</section>

@if (IsEditorOpen)
{
    <div class="admin-modal-backdrop" @onclick="CloseEditor">
        <section class="admin-modal payment-provider-modal" @onclick:stopPropagation="true">
            <header>
                <div>
                    <p class="eyebrow">@(Draft.Id.HasValue ? "Modification" : "Nouveau moyen")</p>
                    <h2>@(Draft.Id.HasValue ? Draft.Name : "Ajouter un moyen de paiement")</h2>
                </div>
                <button class="modal-close" aria-label="Fermer" @onclick="CloseEditor">×</button>
            </header>

            <div class="payment-provider-form">
                <div class="payment-provider-logo-editor">
                    <div class="payment-provider-preview">
                        <AdminMediaPreview Source="@Draft.LogoUrl" Alt="Aperçu du logo" FallbackText="Logo" Loading="eager" />
                    </div>
                    <label class="btn btn-light upload-button">
                        Changer le logo
                        <InputFile OnChange="UploadLogoAsync" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
                    </label>
                    <small>PNG, JPG, WebP ou SVG.</small>
                </div>

                <div class="payment-provider-fields">
                    <div class="field"><label>Nom affiché</label><input @bind="Draft.Name" placeholder="Ex. Orange Money" /></div>
                    <div class="field"><label>Code interne</label><input @bind="Draft.Code" placeholder="orange-money" /></div>
                    <div class="field field-wide"><label>Description</label><textarea @bind="Draft.Description" rows="3" placeholder="Courte explication visible dans le catalogue."></textarea></div>
                    <div class="field"><label>Type</label><select @bind="Draft.Method"><option value="MobileMoney">Mobile Money</option><option value="Card">Carte bancaire</option></select></div>
                    <div class="field"><label>Ordre d'affichage</label><input type="number" min="0" @bind="Draft.SortOrder" /></div>
                    <label class="switch-field field-wide"><input type="checkbox" @bind="Draft.IsActive" /><span>Visible dans l'application</span></label>
                </div>
            </div>

            <footer>
                <button class="btn btn-light" @onclick="CloseEditor">Annuler</button>
                <button class="btn btn-primary" @onclick="SaveAsync">Enregistrer</button>
            </footer>
        </section>
    </div>
}

@code {
    private IReadOnlyList<PaymentProviderResponse> Providers = [];
    private ProviderDraft Draft = new();
    private string? Message;
    private bool IsError;
    private bool IsEditorOpen;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => Providers = await ApiClient.GetPaymentProvidersAsync();
    private void NewProvider() { Draft = new(); IsEditorOpen = true; }
    private void CloseEditor() { IsEditorOpen = false; Draft = new(); }

    private async Task UploadLogoAsync(InputFileChangeEventArgs args)
    {
        try
        {
            var upload = await ApiClient.UploadCmsMediaAsync(args.File);
            if (upload is not null) Draft.LogoUrl = upload.Url;
        }
        catch (Exception ex) { Show(ex.Message, true); }
    }

    private async Task SaveAsync()
    {
        try
        {
            var request = new UpsertPaymentProviderRequest(Draft.Code, Draft.Name, Draft.Method, Draft.Description, Draft.LogoUrl, Draft.SortOrder, Draft.IsActive);
            if (Draft.Id is { } id) await ApiClient.UpdatePaymentProviderAsync(id, request);
            else await ApiClient.CreatePaymentProviderAsync(request);
            Show("Moyen de paiement enregistré.", false);
            CloseEditor();
            await LoadAsync();
        }
        catch (Exception ex) { Show(ex.Message, true); }
    }

    private void Edit(PaymentProviderResponse item)
    {
        Draft = new(item.Id, item.Code, item.Name, item.Method, item.Description, item.LogoUrl, item.SortOrder, item.IsActive);
        IsEditorOpen = true;
    }

    private void Show(string message, bool error) { Message = message; IsError = error; }
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));

    private sealed class ProviderDraft(Guid? id = null, string code = "", string name = "", string method = "MobileMoney", string? description = null, string? logoUrl = null, int sortOrder = 0, bool isActive = true)
    {
        public Guid? Id { get; set; } = id;
        public string Code { get; set; } = code;
        public string Name { get; set; } = name;
        public string Method { get; set; } = method;
        public string? Description { get; set; } = description;
        public string? LogoUrl { get; set; } = logoUrl;
        public int SortOrder { get; set; } = sortOrder;
        public bool IsActive { get; set; } = isActive;
    }
}
