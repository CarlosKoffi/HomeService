    private void OpenOptionManager(ServicePrestationSummaryResponse prestation)
    {
        ManagedPrestation = prestation;
        OptionDrafts.Clear();
        foreach (var option in prestation.Options ?? [])
        {
            OptionDrafts[option.Id] = OptionDraft.From(option);
        }

        NewOptionDraft = new OptionDraft
        {
            SortOrder = (prestation.Options?.Count ?? 0) + 1,
            Currency = prestation.Currency,
            PriceMinAmount = prestation.PriceMinAmount ?? prestation.NormalPriceAmount,
            PriceMaxAmount = prestation.PriceMaxAmount ?? prestation.PremiumPriceAmount
        };
    }

    private void CloseOptionManager()
    {
        ManagedPrestation = null;
        OptionDrafts.Clear();
    }

    private OptionDraft GetOptionDraft(ServiceOptionSummaryResponse option)
    {
        if (!OptionDrafts.TryGetValue(option.Id, out var draft))
        {
            draft = OptionDraft.From(option);
            OptionDrafts[option.Id] = draft;
        }

        return draft;
    }

    private async Task CreateOptionAsync()
    {
        if (ManagedPrestation is null || string.IsNullOrWhiteSpace(NewOptionDraft.Name))
        {
            Message = "Renseignez le nom de l'option.";
            return;
        }

        var prestationId = ManagedPrestation.Id;
        await RunMutationAsync(async () =>
        {
            await ApiClient.CreateServiceOptionAsync(prestationId, ToOptionRequest(NewOptionDraft));
            Message = "Option ajoutee.";
        });
        ReopenOptionManager(prestationId);
    }

    private async Task SaveOptionAsync(Guid optionId)
    {
        var prestationId = ManagedPrestation?.Id;
        if (prestationId is null || !OptionDrafts.TryGetValue(optionId, out var draft))
        {
            return;
        }

        await RunMutationAsync(async () =>
        {
            await ApiClient.UpdateServiceOptionAsync(optionId, ToOptionRequest(draft));
            Message = "Option modifiee.";
        });
        ReopenOptionManager(prestationId.Value);
    }

    private async Task ToggleOptionAsync(ServiceOptionSummaryResponse option)
    {
        var prestationId = ManagedPrestation?.Id;
        if (prestationId is null)
        {
            return;
        }

        await RunMutationAsync(async () =>
        {
            await ApiClient.SetServiceOptionActiveAsync(option.Id, !option.IsActive);
            Message = option.IsActive ? "Option desactivee." : "Option reactivee.";
        });
        ReopenOptionManager(prestationId.Value);
    }

    private void ReopenOptionManager(Guid prestationId)
    {
        var updated = Services.SelectMany(service => service.Prestations).FirstOrDefault(item => item.Id == prestationId);
        if (updated is not null)
        {
            OpenOptionManager(updated);
        }
    }

    private static UpsertServiceOptionRequest ToOptionRequest(OptionDraft draft)
    {
        var maximum = Math.Max(0, draft.PriceMaxAmount);
        var minimum = draft.IsFixedPrice ? maximum : Math.Max(0, draft.PriceMinAmount);
        return new UpsertServiceOptionRequest(
            draft.Name,
            draft.Description,
            draft.SortOrder,
            minimum,
            maximum,
            draft.IsFixedPrice,
            draft.Currency);
    }

    private async Task RunMutationAsync(Func<Task> action)
    {
        IsSaving = true;

        try
        {
            await action();
            await LoadServicesAsync();
        }
        catch (PlatformApiException exception)
        {
            Message = $"Action impossible. Detail: {exception.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private static string FormatPriceRange(int priceMinAmount, int priceMaxAmount, string currency)
    {
        var max = Math.Max(priceMinAmount, priceMaxAmount);
        return priceMinAmount == max
            ? $"{priceMinAmount:N0} {currency}"
            : $"{priceMinAmount:N0} - {max:N0} {currency}";
    }

