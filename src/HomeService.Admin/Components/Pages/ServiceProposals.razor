@code {
    private readonly Dictionary<Guid, PrestationDraft> Drafts = [];
    private readonly Dictionary<Guid, PrestationDraft> EditDrafts = [];
    private readonly Dictionary<Guid, ServiceDraft> ServiceEditDrafts = [];
    private readonly Dictionary<Guid, ProposalDraft> ProposalDrafts = [];
    private IReadOnlyList<ServiceSummaryResponse> Services = [];
    private IReadOnlyList<CompanyServiceProposalResponse> CompanyServiceProposals = [];
    private ServiceCatalogInsightListResponse? InsightSnapshot { get; set; }
    private ServiceDraft NewServiceDraft { get; set; } = new();
    private string Search { get; set; } = string.Empty;
    private string ServiceFilter { get; set; } = "all";
    private string StatusFilter { get; set; } = "all";
    private string SortFilter { get; set; } = "attention";
    private string? Message { get; set; }
    private Guid? EditingPrestationId { get; set; }
    private ServicePrestationSummaryResponse? ManagedPrestation { get; set; }
    private readonly Dictionary<Guid, OptionDraft> OptionDrafts = [];
    private OptionDraft NewOptionDraft { get; set; } = new();
    private Guid? EditingServiceId { get; set; }
    private Guid? ServicePendingDeletionId { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsSaving { get; set; }
    private ServiceAdminTab ActiveTab { get; set; } = ServiceAdminTab.Proposals;
    private Guid? SelectedProposalId { get; set; }

    private IReadOnlyList<ServiceCatalogInsightResponse> ServiceInsights
    {
        get
        {
            return InsightSnapshot?.Items ?? [];
        }
    }

    private IReadOnlyList<ServiceSummaryResponse> FilteredServices
    {
        get
        {
            var query = Services.AsEnumerable();

            query = StatusFilter switch
            {
                "active" => query.Where(service => service.IsActive),
                "inactive" => query.Where(service => !service.IsActive),
                _ => query
            };

            if (!string.IsNullOrWhiteSpace(Search))
            {
                var search = Search.Trim();
                query = query.Where(service =>
                    service.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || service.Prestations.Any(prestation => prestation.Name.Contains(search, StringComparison.OrdinalIgnoreCase)));
            }

            if (Guid.TryParse(ServiceFilter, out var serviceId))
            {
                query = query.Where(service => service.Id == serviceId);
            }

            return query.ToList();
        }
    }

    private IReadOnlyList<CompanyServiceProposalResponse> FilteredCompanyServiceProposals
    {
        get
        {
            var query = CompanyServiceProposals.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(Search))
            {
                var search = Search.Trim();
                query = query.Where(proposal =>
                    proposal.RawName.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || proposal.CompanyName.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || (proposal.MatchedServiceName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (proposal.MatchedServicePrestationName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || proposal.Suggestions.Any(suggestion =>
                        suggestion.ServiceName.Contains(search, StringComparison.OrdinalIgnoreCase)
                        || (suggestion.ServicePrestationName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)));
            }

            if (Guid.TryParse(ServiceFilter, out var serviceId))
            {
                query = query.Where(proposal => ProposalMatchesService(proposal, serviceId));
            }

            query = StatusFilter switch
            {
                "needs-review" => query.Where(proposal => proposal.MatchStatus == "NeedsAdminReview"),
                "pending-match" => query.Where(proposal => proposal.MatchStatus == "PendingMatch"),
                "matched" => query.Where(proposal => proposal.MatchStatus == "MatchedExisting"),
                _ => query
            };

            return SortFilter switch
            {
                "name" => query.OrderBy(proposal => proposal.RawName).ThenBy(proposal => proposal.CompanyName).ToList(),
                _ => query
                    .OrderBy(proposal => proposal.MatchStatus == "NeedsAdminReview" ? 0 : proposal.MatchStatus == "PendingMatch" ? 1 : 2)
                    .ThenBy(proposal => proposal.MatchScore ?? 0)
                    .ThenByDescending(proposal => proposal.CreatedAt)
                    .ToList()
            };
        }
    }

    private IReadOnlyList<ServiceCatalogInsightResponse> FilteredServiceInsights
    {
        get
        {
            var query = ServiceInsights.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(Search))
            {
                var search = Search.Trim();
                query = query.Where(service =>
                    service.ServiceName.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || service.Prestations.Any(prestation => prestation.ServicePrestationName.Contains(search, StringComparison.OrdinalIgnoreCase)));
            }

            if (Guid.TryParse(ServiceFilter, out var serviceId))
            {
                query = query.Where(service => service.ServiceId == serviceId);
            }

            query = StatusFilter switch
            {
                "gap" => query.Where(service => service.HasProviderGap || service.Prestations.Any(prestation => prestation.HasProviderGap)),
                "demand" => query.Where(service => service.HasDemandWithoutProviders),
                _ => query
            };

            return SortFilter switch
            {
                "missions" => query.OrderByDescending(service => service.MissionCount).ThenBy(service => service.ServiceName).ToList(),
                "revenue" => query.OrderByDescending(service => service.RevenueAmount).ThenBy(service => service.ServiceName).ToList(),
                "providers" => query.OrderByDescending(service => service.ActiveProviderCount).ThenByDescending(service => service.InterimProviderCount).ThenBy(service => service.ServiceName).ToList(),
                "name" => query.OrderBy(service => service.ServiceName).ToList(),
                _ => query
                    .OrderByDescending(service => service.HasDemandWithoutProviders)
                    .ThenByDescending(service => service.DisputedMissionCount)
                    .ThenByDescending(service => service.PendingProposalCount)
                    .ThenByDescending(service => service.HasProviderGap)
                    .ThenBy(service => service.ServiceName)
                    .ToList()
            };
        }
    }

    protected override Task OnInitializedAsync()
    {
        return LoadServicesAsync();
    }

    private async Task LoadServicesAsync()
    {
        IsLoading = true;
        Message = null;

        try
        {
            Services = await ApiClient.GetAdminServicesAsync();
            CompanyServiceProposals = (await ApiClient.GetCompanyServiceProposalsAsync())?.Items ?? [];
            InsightSnapshot = await ApiClient.GetServiceCatalogInsightsAsync();
        }
        catch (PlatformApiException exception)
        {
            Message = $"Impossible de charger le catalogue. Detail: {exception.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private ProposalDraft GetProposalDraft(CompanyServiceProposalResponse proposal)
    {
        if (!ProposalDrafts.TryGetValue(proposal.Id, out var draft))
        {
            var firstSuggestion = proposal.Suggestions
                .OrderByDescending(suggestion => suggestion.Score)
                .FirstOrDefault();

            draft = new ProposalDraft
            {
                ProposedName = BuildDefaultProposalName(proposal, firstSuggestion),
                Action = proposal.MatchedServiceId.HasValue || firstSuggestion is not null
                    ? ProposalAction.Attach
                    : ProposalAction.CreateService,
                Selection = proposal.MatchedServicePrestationId.HasValue
                    ? BuildPrestationSelection(proposal.MatchedServiceId!.Value, proposal.MatchedServicePrestationId.Value)
                    : proposal.MatchedServiceId.HasValue
                        ? BuildServiceSelection(proposal.MatchedServiceId.Value)
                        : firstSuggestion is not null
                            ? firstSuggestion.ServicePrestationId.HasValue
                                ? BuildPrestationSelection(firstSuggestion.ServiceId, firstSuggestion.ServicePrestationId.Value)
                                : BuildServiceSelection(firstSuggestion.ServiceId)
                        : string.Empty
            };

            draft.CreateUnderServiceId = proposal.MatchedServiceId?.ToString()
                ?? firstSuggestion?.ServiceId.ToString()
                ?? string.Empty;

            ProposalDrafts[proposal.Id] = draft;
        }

        return draft;
    }

    private void ApplySuggestion(Guid proposalId, CompanyServiceProposalSuggestionResponse suggestion)
    {
        var proposal = CompanyServiceProposals.FirstOrDefault(item => item.Id == proposalId);
        var draft = ProposalDrafts.TryGetValue(proposalId, out var existing) ? existing : new ProposalDraft();
        draft.Action = ProposalAction.Attach;
        draft.Selection = suggestion.ServicePrestationId.HasValue
            ? BuildPrestationSelection(suggestion.ServiceId, suggestion.ServicePrestationId.Value)
            : BuildServiceSelection(suggestion.ServiceId);
        draft.CreateUnderServiceId = suggestion.ServiceId.ToString();
        draft.ProposedName = proposal is null
            ? suggestion.ServicePrestationName ?? suggestion.ServiceName
            : BuildDefaultProposalName(proposal, suggestion);
        ProposalDrafts[proposalId] = draft;
    }

    private void OpenProposalDecision(Guid proposalId)
    {
        SelectedProposalId = proposalId;
    }

    private void CloseProposalDecision()
    {
        SelectedProposalId = null;
    }

    private static string BuildDefaultProposalName(
        CompanyServiceProposalResponse proposal,
        CompanyServiceProposalSuggestionResponse? suggestion)
    {
        if (proposal.MatchedServicePrestationName is not null)
        {
            return proposal.MatchedServicePrestationName;
        }

        if (suggestion?.ServicePrestationName is not null)
        {
            return suggestion.ServicePrestationName;
        }

        if (suggestion?.ServiceName is not null && proposal.RawName.Contains('-', StringComparison.Ordinal))
        {
            var parts = proposal.RawName.Split('-', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            return parts.LastOrDefault(part => !part.Equals(suggestion.ServiceName, StringComparison.OrdinalIgnoreCase))
                ?? proposal.RawName;
        }

        return proposal.RawName;
    }

    private Task ExecuteProposalActionAsync(CompanyServiceProposalResponse proposal)
    {
        var draft = GetProposalDraft(proposal);
        return draft.Action switch
        {
            ProposalAction.CreateService => CreateServiceFromProposalAsync(proposal),
            ProposalAction.CreatePrestation => CreatePrestationFromProposalAsync(proposal),
            ProposalAction.Reject => RejectProposalAsync(proposal),
            _ => AttachProposalAsync(proposal.Id)
        };
    }

    private async Task RejectProposalAsync(CompanyServiceProposalResponse proposal)
    {
        var draft = GetProposalDraft(proposal);
        if (string.IsNullOrWhiteSpace(draft.Description))
        {
        Message = "Indiquez le motif du refus.";
            return;
        }

        await RunMutationAsync(async () =>
        {
            var response = await ApiClient.RejectCompanyServiceProposalAsync(
                proposal.Id,
                new RejectCompanyServiceProposalRequest(draft.Description.Trim()));
            CompanyServiceProposals = response?.Items ?? [];
            Message = "Proposition refusee.";
            SelectedProposalId = null;
        });
    }

    private async Task AttachProposalAsync(Guid proposalId)
    {
        var draft = GetProposalDraft(CompanyServiceProposals.First(proposal => proposal.Id == proposalId));
        var selection = ParseSelection(draft.Selection);
        if (selection.ServiceId is null && selection.ServicePrestationId is null)
        {
            Message = "Selectionnez un rattachement avant de valider.";
            return;
        }

        await RunMutationAsync(async () =>
        {
            await ApiClient.AttachCompanyServiceProposalAsync(
                proposalId,
                new AttachCompanyServiceProposalRequest(selection.ServiceId, selection.ServicePrestationId));
            Message = "Libelle rattache au catalogue.";
            SelectedProposalId = null;
        });
    }

    private Task ReanalyseProposalsAsync()
    {
        return RunMutationAsync(async () =>
        {
            var response = await ApiClient.ReanalyseCompanyServiceProposalsAsync();
            CompanyServiceProposals = response?.Items ?? [];
            Message = "Les libelles ont ete compares au catalogue actuel.";
        });
    }

    private async Task CreatePrestationFromProposalAsync(CompanyServiceProposalResponse proposal)
    {
        var draft = GetProposalDraft(proposal);
        if (!Guid.TryParse(draft.CreateUnderServiceId, out var serviceId))
        {
            Message = "Selectionnez le service parent avant de creer la prestation.";
            return;
        }

        await RunMutationAsync(async () =>
        {
            await ApiClient.CreatePrestationFromCompanyServiceProposalAsync(
                proposal.Id,
                new CreatePrestationFromCompanyServiceProposalRequest(serviceId, CleanProposalName(draft, proposal), draft.Description));
            Message = "Prestation creee et libelle rattache.";
            SelectedProposalId = null;
        });
    }

    private async Task CreateServiceFromProposalAsync(CompanyServiceProposalResponse proposal)
    {
        var draft = GetProposalDraft(proposal);
        var serviceName = CleanProposalName(draft, proposal);
        if (string.IsNullOrWhiteSpace(serviceName))
        {
            Message = "Renseignez le nom du service a creer.";
            return;
        }

        await RunMutationAsync(async () =>
        {
            await ApiClient.CreateServiceFromCompanyServiceProposalAsync(
                proposal.Id,
                new CreateServiceFromCompanyServiceProposalRequest(
                    serviceName,
                    draft.Description,
                    draft.IconName,
                    draft.PriceMinAmount,
                    draft.PriceMaxAmount,
                    "XOF"));
            Message = "Service cree et proposition rattachee.";
            SelectedProposalId = null;
        });
    }

    private static string GetProposalActionLabel(ProposalAction action)
    {
        return action switch
        {
            ProposalAction.CreateService => "Creer le service",
            ProposalAction.CreatePrestation => "Creer la prestation",
            ProposalAction.Reject => "Refuser la proposition",
            _ => "Valider le rattachement"
        };
    }

    private static string GetProposalActionHelp(ProposalAction action)
    {
        return action switch
        {
            ProposalAction.CreateService => "Cree un nouveau metier principal.",
            ProposalAction.CreatePrestation => "Ajoute un detail sous un service existant.",
            ProposalAction.Reject => "Ecarte ce libelle du catalogue.",
            _ => "Lie le libelle a un element deja connu."
        };
    }

    private static string GetProposalActionSummary(ProposalAction action)
    {
        return action switch
        {
            ProposalAction.CreateService => "Le libelle deviendra un service visible dans le catalogue.",
            ProposalAction.CreatePrestation => "Le libelle sera ajoute sous le service parent choisi.",
            ProposalAction.Reject => "La proposition sera refusee et retiree de la file a traiter.",
            _ => "La proposition disparaitra de la file a verifier."
        };
    }

    private static string CleanProposalName(ProposalDraft draft, CompanyServiceProposalResponse proposal)
    {
        return string.IsNullOrWhiteSpace(draft.ProposedName)
            ? proposal.RawName
            : draft.ProposedName.Trim();
    }

    private static string BuildServiceSelection(Guid serviceId)
    {
        return $"service:{serviceId}";
    }

    private static string BuildPrestationSelection(Guid serviceId, Guid prestationId)
    {
        return $"prestation:{serviceId}:{prestationId}";
    }

    private static ProposalSelection ParseSelection(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return new ProposalSelection(null, null);
        }

        var parts = value.Split(':', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 2 && parts[0] == "service" && Guid.TryParse(parts[1], out var serviceId))
        {
            return new ProposalSelection(serviceId, null);
        }

        if (parts.Length == 3
            && parts[0] == "prestation"
            && Guid.TryParse(parts[1], out var parentServiceId)
            && Guid.TryParse(parts[2], out var prestationId))
        {
            return new ProposalSelection(parentServiceId, prestationId);
        }

        return new ProposalSelection(null, null);
    }

    private static string FormatSuggestion(CompanyServiceProposalSuggestionResponse suggestion)
    {
        return suggestion.ServicePrestationId.HasValue
            ? $"{suggestion.ServiceName} - {suggestion.ServicePrestationName}"
            : suggestion.ServiceName;
    }

    private static bool ProposalMatchesService(CompanyServiceProposalResponse proposal, Guid serviceId)
    {
        return proposal.MatchedServiceId == serviceId
            || proposal.Suggestions.Any(suggestion => suggestion.ServiceId == serviceId);
    }

    private static string GetProposalStatusLabel(string status)
    {
        return status switch
        {
            "PendingMatch" => "A analyser",
            "NeedsAdminReview" => "A verifier",
            "CreatedAsNewService" => "A reclasser",
            "MatchedExisting" => "Rattache",
            _ => status
        };
    }

    private static string GetProposalActionHint(
        CompanyServiceProposalResponse proposal,
        CompanyServiceProposalSuggestionResponse? suggestion)
    {
        if (proposal.MatchedServicePrestationName is not null)
        {
            return $"Prestation: {proposal.MatchedServicePrestationName}";
        }

        if (proposal.MatchedServiceName is not null)
        {
            return $"Service: {proposal.MatchedServiceName}";
        }

        if (suggestion?.ServicePrestationName is not null)
        {
            return $"Proposition: {suggestion.ServiceName} - {suggestion.ServicePrestationName}";
        }

        if (suggestion?.ServiceName is not null)
        {
            return $"Proposition: {suggestion.ServiceName}";
        }

        return "Decision manuelle";
    }

