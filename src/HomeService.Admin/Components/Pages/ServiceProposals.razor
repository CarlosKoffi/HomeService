@page "/service-proposals"
@using HomeService.Admin.Services
@using HomeService.Contracts.Services
@using HomeService.Domain.Common
@inject PlatformApiClient ApiClient

<PageTitle>Catalogue services</PageTitle>

<section class="admin-page-heading">
    <div>
        <p class="eyebrow">Catalogue operationnel</p>
        <h1>Services et prestations</h1>
        <p class="lead">
            Validez les libelles envoyes par les entreprises, rattachez-les au bon service ou creez un nouvel element catalogue.
        </p>
    </div>
    <div class="page-heading-actions">
        <button type="button" class="secondary-action" @onclick="LoadServicesAsync" disabled="@IsLoading">
            Actualiser
        </button>
        <button type="button" class="secondary-action" @onclick="ReanalyseProposalsAsync" disabled="@(IsLoading || IsSaving)">
            Reanalyser
        </button>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <p class="admin-message">@Message</p>
}

<section class="toolbar">
    <label>
        Recherche
        <input type="search" placeholder="Service ou prestation" @bind="Search" @bind:event="oninput" />
    </label>
    <label>
        Service
        <select @bind="ServiceFilter">
            <option value="all">Tous les services</option>
            @foreach (var service in Services.OrderBy(service => service.Name))
            {
                <option value="@service.Id">@service.Name</option>
            }
        </select>
    </label>
    <label>
        Affichage
        <select @bind="StatusFilter">
            <option value="all">Tous</option>
            @if (ActiveTab == ServiceAdminTab.Proposals)
            {
                <option value="needs-review">A verifier</option>
                <option value="pending-match">A analyser</option>
                <option value="matched">Rattaches</option>
            }
            else if (ActiveTab == ServiceAdminTab.Catalog)
            {
                <option value="active">Services actifs</option>
                <option value="inactive">Services inactifs</option>
            }
            else if (ActiveTab == ServiceAdminTab.Insights)
            {
                <option value="gap">A couvrir</option>
                <option value="demand">Demande sans offre</option>
            }
        </select>
    </label>
    <label>
        Tri
        <select @bind="SortFilter">
            <option value="attention">Priorite action</option>
            <option value="missions">Missions</option>
            <option value="revenue">CA termine</option>
            <option value="providers">Prestataires</option>
            <option value="name">Nom A-Z</option>
        </select>
    </label>
</section>

<section class="service-admin-overview">
    <article>
        <span>A verifier</span>
        <strong>@FilteredCompanyServiceProposals.Count</strong>
        <p>Libelles envoyes par les entreprises a rattacher au bon service.</p>
    </article>
    <article>
        <span>Catalogue</span>
        <strong>@Services.Count</strong>
        <p>Services principaux disponibles pour les sites et les workflows.</p>
    </article>
    <article>
        <span>Prestations</span>
        <strong>@Services.Sum(service => service.Prestations.Count)</strong>
        <p>Details operationnels rattaches a un service parent.</p>
    </article>
</section>

<nav class="service-admin-tabs" aria-label="Navigation catalogue services">
    <button type="button" class="@GetTabClass(ServiceAdminTab.Proposals)" @onclick="() => ActiveTab = ServiceAdminTab.Proposals">
        A classer
        @if (FilteredCompanyServiceProposals.Count > 0)
        {
            <span>@FilteredCompanyServiceProposals.Count</span>
        }
    </button>
    <button type="button" class="@GetTabClass(ServiceAdminTab.Catalog)" @onclick="() => ActiveTab = ServiceAdminTab.Catalog">
        Services
        <span>@Services.Count</span>
    </button>
    <button type="button" class="@GetTabClass(ServiceAdminTab.Create)" @onclick="() => ActiveTab = ServiceAdminTab.Create">
        Nouveau service
    </button>
    <button type="button" class="@GetTabClass(ServiceAdminTab.Insights)" @onclick="() => ActiveTab = ServiceAdminTab.Insights">
        Chiffres
    </button>
</nav>

@if (ActiveTab == ServiceAdminTab.Proposals)
{
<section class="service-admin-create orphan-proposals">
    <div class="proposal-panel-heading">
        <p class="eyebrow">A verifier</p>
        <h2>Classer les services demandes</h2>
        <p>Quand une entreprise tape un libelle inconnu, vous decidez ici s'il correspond a un service existant, a une prestation, ou a un nouveau service.</p>
    </div>

    @if (FilteredCompanyServiceProposals.Count == 0)
    {
        <div class="info-panel compact">
            <h3>Aucun libelle orphelin</h3>
            <p>Les services proposes sont tous rattaches au catalogue ou aucun resultat ne correspond aux filtres.</p>
        </div>
    }
    else
    {
        <div class="proposal-review-table" role="table" aria-label="Services proposes par les entreprises">
            <div class="proposal-review-row head" role="row">
                <span>Recu le</span>
                <span>Entreprise</span>
                <span>Libelle propose</span>
                <span>Suggestion</span>
                <span>Confiance</span>
                <span>Action</span>
            </div>
            @foreach (var proposal in FilteredCompanyServiceProposals)
            {
                var bestSuggestion = proposal.Suggestions.OrderByDescending(suggestion => suggestion.Score).FirstOrDefault();

                <article class="proposal-review-row" role="row" @key="proposal.Id">
                    <span class="proposal-date">@FormatDateTime(proposal.CreatedAt)</span>
                    <strong class="proposal-company-name">@proposal.CompanyName</strong>
                    <span class="proposal-name">
                        @proposal.RawName
                        <small class="status-pill pending">@GetProposalStatusLabel(proposal.MatchStatus)</small>
                    </span>
                    <span class="proposal-suggestion">@GetProposalActionHint(proposal, bestSuggestion)</span>
                    <span class="proposal-score">@(proposal.MatchScore?.ToString() ?? "-")</span>
                    <span class="proposal-row-actions">
                        @if (bestSuggestion is not null)
                        {
                            <button type="button" class="light-action" @onclick="() => ApplySuggestion(proposal.Id, bestSuggestion)">
                                Suggestion
                            </button>
                        }
                        <button type="button" @onclick="() => OpenProposalDecision(proposal.Id)">
                            Traiter
                        </button>
                    </span>
                </article>
            }
        </div>
    }
</section>
}

@if (SelectedProposalId is not null
    && CompanyServiceProposals.FirstOrDefault(proposal => proposal.Id == SelectedProposalId.Value) is { } selectedProposal)
{
    var draft = GetProposalDraft(selectedProposal);

    <div class="admin-modal-backdrop" @onclick="CloseProposalDecision">
        <section class="admin-modal proposal-decision-modal" @onclick:stopPropagation="true" aria-modal="true" role="dialog">
            <header>
                <div>
                    <span class="proposal-company">@selectedProposal.CompanyName</span>
                    <h2>Traiter le service propose</h2>
                    <p>@selectedProposal.RawName</p>
                </div>
                <button type="button" class="icon-button" @onclick="CloseProposalDecision">X</button>
            </header>

            @if (selectedProposal.Suggestions.Count > 0)
            {
                <div class="proposal-suggestions">
                    <span>Suggestions rapides</span>
                    @foreach (var suggestion in selectedProposal.Suggestions.Take(4))
                    {
                        <button type="button" class="light-action" @onclick="() => ApplySuggestion(selectedProposal.Id, suggestion)">
                            @FormatSuggestion(suggestion)
                        </button>
                    }
                </div>
            }

            <div class="proposal-decision-panel modal-panel">
                <div class="proposal-step-title">
                    <strong>Decision catalogue</strong>
                    <span>@GetProposalActionHelp(draft.Action)</span>
                </div>
                <label class="wide">
                    Nom final
                    <input type="text" @bind="draft.ProposedName" placeholder="Nom a utiliser dans le catalogue" />
                </label>
                <label>
                    Action
                    <select @bind="draft.Action">
                        <option value="@ProposalAction.Attach">Rattacher a l'existant</option>
                        <option value="@ProposalAction.CreatePrestation">Nouvelle prestation</option>
                        <option value="@ProposalAction.CreateService">Nouveau service</option>
                        <option value="@ProposalAction.Reject">Refuser la proposition</option>
                    </select>
                </label>
                <label class="wide">
                    @(draft.Action == ProposalAction.Reject ? "Motif du refus" : "Note interne")
                    <input type="text" @bind="draft.Description"
                           placeholder="@(draft.Action == ProposalAction.Reject ? "Expliquez pourquoi cette proposition est refusee" : "Optionnel, utile pour expliquer le classement")" />
                </label>

                @if (draft.Action == ProposalAction.Attach)
                {
                    <label class="wide">
                        Element du catalogue
                        <select @bind="draft.Selection">
                            <option value="">Choisir un service ou une prestation</option>
                            @foreach (var service in Services.Where(item => item.IsActive).OrderBy(item => item.Name))
                            {
                                <option value="@BuildServiceSelection(service.Id)">@service.Name</option>
                                @foreach (var prestation in service.Prestations.Where(item => item.IsActive).OrderBy(item => item.Name))
                                {
                                    <option value="@BuildPrestationSelection(service.Id, prestation.Id)">@service.Name - @prestation.Name</option>
                                }
                            }
                        </select>
                    </label>
                }
                else if (draft.Action == ProposalAction.CreatePrestation)
                {
                    <label class="wide">
                        Service parent
                        <select @bind="draft.CreateUnderServiceId">
                            <option value="">Choisir le service parent</option>
                            @foreach (var service in Services.Where(item => item.IsActive).OrderBy(item => item.Name))
                            {
                                <option value="@service.Id">@service.Name</option>
                            }
                        </select>
                    </label>
                }
                else if (draft.Action == ProposalAction.CreateService)
                {
                    <label>
                        Icone
                        <input type="text" @bind="draft.IconName" placeholder="Ex: briefcase" />
                    </label>
                    <label>
                        Prix min
                        <input type="number" min="0" step="100" @bind="draft.PriceMinAmount" />
                    </label>
                    <label>
                        Prix max
                        <input type="number" min="0" step="100" @bind="draft.PriceMaxAmount" />
                    </label>
                }

                <div class="proposal-primary-action wide">
                    <p>@GetProposalActionSummary(draft.Action)</p>
                    <button type="button" class="@(draft.Action == ProposalAction.Reject ? "danger-action" : null)" @onclick="() => ExecuteProposalActionAsync(selectedProposal)" disabled="@IsSaving">
                        @GetProposalActionLabel(draft.Action)
                    </button>
                </div>
            </div>
        </section>
    </div>
}

@if (ActiveTab == ServiceAdminTab.Create)
{
<section class="service-admin-create">
    <div>
        <p class="eyebrow">Nouveau service</p>
        <h2>Ajouter un service au catalogue</h2>
        <p>Ajoutez le service principal. Les prestations detaillees pourront ensuite etre rattachees dans sa fiche.</p>
    </div>
    <div class="service-admin-form compact catalog-create-form">
        <label>
            Nom
            <input type="text" placeholder="Ex: Depannage auto" @bind="NewServiceDraft.Name" />
        </label>
        <label>
            Categorie dans l'application
            <select @bind="NewServiceDraft.DisplayCategory">
                <option value="Home">Pour ma maison</option>
                <option value="Wellbeing">Pour mon bien-etre</option>
            </select>
        </label>
        <div class="service-icon-admin wide">
            <div class="service-icon-preview">
                <AdminMediaPreview Source="@NewServiceDraft.IconUrl" Alt="Visuel du service" FallbackText="Image indisponible" Loading="eager" />
            </div>
            <div class="catalog-icon-copy">
                <strong>Visuel du service</strong>
                <small>Ce visuel sera affiche dans l'application client.</small>
            </div>
            <label class="catalog-library-picker">
                Choisir dans la bibliotheque
                <select @bind="NewServiceDraft.IconUrl">
                    <option value="">Choisir un visuel</option>
                    @foreach (var icon in SuggestedServiceIcons)
                    {
                        <option value="@icon.Url">@icon.Label</option>
                    }
                </select>
            </label>
            <label class="catalog-upload catalog-file-picker">
                <span>Importer un fichier</span>
                <InputFile OnChange="file => UploadServiceIconAsync(NewServiceDraft, file.File)" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
                <small>PNG, JPG, WebP ou SVG.</small>
            </label>
        </div>
        <label>
            Prix minimum
            <input type="number" min="0" step="100" @bind="NewServiceDraft.NormalPriceAmount" />
        </label>
        <label>
            Prix maximum
            <input type="number" min="0" step="100" @bind="NewServiceDraft.PremiumPriceAmount" />
        </label>
        <label>
            Devise
            <input type="text" maxlength="8" @bind="NewServiceDraft.Currency" />
        </label>
        <label class="wide">
            Description
            <textarea rows="2" placeholder="Description courte du service." @bind="NewServiceDraft.Description"></textarea>
        </label>
        <button type="button" @onclick="CreateServiceAsync" disabled="@IsSaving">Ajouter le service</button>
    </div>
</section>
}

@if (IsLoading)
{
    <section class="info-panel">
        <div>
            <h2>Chargement du catalogue</h2>
            <p>Recuperation des services et prestations depuis l'API.</p>
        </div>
    </section>
}
else if (ActiveTab == ServiceAdminTab.Catalog && FilteredServices.Count == 0)
{
    <section class="info-panel">
        <div>
            <h2>Aucun service trouve</h2>
            <p>Modifiez la recherche ou rechargez le catalogue.</p>
        </div>
    </section>
}
else if (ActiveTab == ServiceAdminTab.Catalog)
{
    <section class="service-catalog service-catalog-refined">
        @foreach (var service in FilteredServices)
        {
            var draft = GetDraft(service.Id);
            var activePrestations = service.Prestations.Count(item => item.IsActive);

            <article class="service-catalog-card" @key="service.Id">
                <header>
                    <div>
                        <span class="catalog-icon">
                            <AdminMediaPreview Source="@service.IconUrl" Alt="@($"Visuel de {service.Name}")" FallbackText="Visuel" Loading="eager" />
                        </span>
                        <div>
                            <h2>@service.Name</h2>
                            <p>@(string.IsNullOrWhiteSpace(service.Description) ? "Service officiel du catalogue Wele." : service.Description)</p>
                        </div>
                    </div>
                    <div class="catalog-meta">
                        <span class="status-pill">@FormatDisplayCategory(service.DisplayCategory)</span>
                        <span class="@(service.IsActive ? "status-pill accepted" : "status-pill rejected")">
                            @(service.IsActive ? "Actif" : "Inactif")
                        </span>
                        <strong>@activePrestations/@service.Prestations.Count prestations actives</strong>
                        <small>@FormatPriceRange(service.PriceMinAmount ?? service.NormalPriceAmount, service.PriceMaxAmount ?? service.PremiumPriceAmount, service.Currency)</small>
                    </div>
                </header>

                <div class="prestation-admin-grid">
                    <div class="prestation-list">
                        @if (EditingServiceId == service.Id)
                        {
                            var serviceEditDraft = GetServiceEditDraft(service);
                            <div class="service-edit-panel catalog-service-edit-form catalog-service-editor">
                                <div class="catalog-editor-heading wide">
                                    <div>
                                        <span>Modification</span>
                                        <h3>Informations du service</h3>
                                    </div>
                                    <small>Les donnees techniques et les URL sont gerees automatiquement.</small>
                                </div>
                                <label class="catalog-service-name">
                                    Nom
                                    <input type="text" @bind="serviceEditDraft.Name" />
                                </label>
                                <label class="catalog-service-category">
                                    Categorie dans l'application
                                    <select @bind="serviceEditDraft.DisplayCategory">
                                        <option value="Home">Pour ma maison</option>
                                        <option value="Wellbeing">Pour mon bien-etre</option>
                                    </select>
                                </label>
                                <div class="service-icon-admin wide">
                                    <div class="service-icon-preview">
                                        <AdminMediaPreview Source="@serviceEditDraft.IconUrl" Alt="Visuel du service" FallbackText="Image indisponible" Loading="eager" />
                                    </div>
                                    <div class="catalog-icon-copy">
                                        <strong>Visuel du service</strong>
                                        <small>Visible dans l'application client. Les prestations peuvent avoir leur propre photo.</small>
                                    </div>
                                    <label class="catalog-library-picker">
                                        Choisir dans la bibliotheque
                                        <select @bind="serviceEditDraft.IconUrl">
                                            <option value="">Choisir un visuel</option>
                                            @foreach (var icon in SuggestedServiceIcons)
                                            {
                                                <option value="@icon.Url">@icon.Label</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="catalog-upload catalog-file-picker">
                                        <span>Importer un fichier</span>
                                        <InputFile OnChange="file => UploadServiceIconAsync(serviceEditDraft, file.File)" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
                                        <small>PNG, JPG, WebP ou SVG. Le fichier remplace le visuel actuel apres enregistrement.</small>
                                    </label>
                                </div>
                                <div class="catalog-editor-heading catalog-pricing-heading wide">
                                    <div>
                                        <span>Tarification</span>
                                        <h3>Fourchette indicative</h3>
                                    </div>
                                </div>
                                <label class="catalog-price-field">
                                    Prix minimum
                                    <input type="number" min="0" step="100" @bind="serviceEditDraft.NormalPriceAmount" />
                                </label>
                                <label class="catalog-price-field">
                                    Prix maximum
                                    <input type="number" min="0" step="100" @bind="serviceEditDraft.PremiumPriceAmount" />
                                </label>
                                <label class="catalog-currency-field">
                                    Devise
                                    <input type="text" maxlength="8" @bind="serviceEditDraft.Currency" />
                                </label>
                                <label class="wide">
                                    Description
                                    <textarea rows="2" @bind="serviceEditDraft.Description"></textarea>
                                </label>
                                <div class="easy-actions wide catalog-editor-actions">
                                    <button type="button" @onclick="() => UpdateServiceAsync(service.Id)" disabled="@IsSaving">Enregistrer service</button>
                                    <button type="button" class="light-action" @onclick="CancelServiceEdit">Annuler</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="easy-actions service-card-actions">
                                <button type="button" @onclick="() => StartServiceEdit(service)">Modifier le service</button>
                                @if (service.IsActive)
                                {
                                    <button type="button" class="light-action" @onclick="() => DeactivateServiceAsync(service.Id)" disabled="@IsSaving">Desactiver</button>
                                }
                                else
                                {
                                    <button type="button" @onclick="() => ActivateServiceAsync(service.Id)" disabled="@IsSaving">Reactiver</button>
                                }
                                @if (ServicePendingDeletionId == service.Id)
                                {
                                    <span class="section-help">Suppression definitive ?</span>
                                    <button type="button" class="danger-action" @onclick="() => DeleteServiceAsync(service.Id)" disabled="@IsSaving">Confirmer</button>
                                    <button type="button" class="light-action" @onclick="CancelServiceDeletion" disabled="@IsSaving">Annuler</button>
                                }
                                else
                                {
                                    <button type="button" class="danger-action" @onclick="() => RequestServiceDeletion(service.Id)" disabled="@IsSaving">Supprimer</button>
                                }
                            </div>
                        }

                        @if (service.Prestations.Count == 0)
                        {
                            <p class="section-help">Aucune prestation specifique pour ce service. Il peut rester simple si cela suffit au produit.</p>
                        }
                        else
                        {
                            @foreach (var prestation in service.Prestations.OrderBy(item => item.SortOrder).ThenBy(item => item.Name))
                            {
                                var isEditing = EditingPrestationId == prestation.Id;
                                var editDraft = GetEditDraft(prestation);

                                <div class="prestation-row" @key="prestation.Id">
                                    @if (isEditing)
                                    {
                                        <div class="prestation-edit catalog-prestation-edit-form">
                                            <label>
                                                Nom
                                                <input type="text" @bind="editDraft.Name" />
                                            </label>
                                            <label>
                                                Ordre
                                                <input type="number" min="0" @bind="editDraft.SortOrder" />
                                            </label>
                                            <label>
                                                Prix minimum
                                                <input type="number" min="0" step="100" @bind="editDraft.NormalPriceAmount" />
                                            </label>
                                            <label>
                                                Prix maximum
                                                <input type="number" min="0" step="100" @bind="editDraft.PremiumPriceAmount" />
                                            </label>
                                            <label class="catalog-checkbox">
                                                <input type="checkbox" @bind="editDraft.IsFixedPrice" />
                                                Prix fixe
                                            </label>
                                            <label>
                                                Devise
                                                <input type="text" maxlength="8" @bind="editDraft.Currency" />
                                            </label>
                                            <label class="wide">
                                                Description courte
                                                <input type="text" @bind="editDraft.Description" />
                                            </label>
                                            <label class="wide">
                                                URL illustration
                                                <input type="text" @bind="editDraft.IllustrationUrl" placeholder="/api/cms/media/..." />
                                            </label>
                                            <div class="catalog-media-editor wide">
                                                <div class="catalog-media-preview">
                                                    <AdminMediaPreview Source="@editDraft.IllustrationUrl" Alt="@($"Aperçu de {editDraft.Name}")" FallbackText="Photo facultative" Loading="eager" />
                                                </div>
                                                <label class="catalog-upload">
                                                    Importer une photo
                                                    <InputFile OnChange="file => UploadPrestationIllustrationAsync(editDraft, file.File)" accept="image/png,image/jpeg,image/webp" />
                                                </label>
                                            </div>
                                        </div>
                                        <div class="easy-actions">
                                            <button type="button" @onclick="() => UpdatePrestationAsync(prestation.Id)" disabled="@IsSaving">Enregistrer</button>
                                            <button type="button" class="light-action" @onclick="CancelEdit">Annuler</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="prestation-summary">
                                            <span class="prestation-thumbnail">
                                                <AdminMediaPreview Source="@prestation.IllustrationUrl" Alt="@($"Illustration de {prestation.Name}")" FallbackText="WE" />
                                            </span>
                                            <div>
                                                <strong>@prestation.Name</strong>
                                                <p>@(string.IsNullOrWhiteSpace(prestation.Description) ? "Aucune description." : prestation.Description)</p>
                                            </div>
                                        </div>
                                        <div class="prestation-state">
                                            <span class="@(prestation.IsActive ? "status-pill accepted" : "status-pill rejected")">
                                                @(prestation.IsActive ? "Active" : "Inactive")
                                            </span>
                                            <small>Ordre @prestation.SortOrder</small>
                                            <small>@FormatPriceRange(prestation.PriceMinAmount ?? prestation.NormalPriceAmount, prestation.PriceMaxAmount ?? prestation.PremiumPriceAmount, prestation.Currency)</small>
                                        </div>
                                        <div class="easy-actions">
                                            <button type="button" @onclick="() => StartEdit(prestation)">Modifier</button>
                                            <button type="button" class="light-action" @onclick="() => OpenOptionManager(prestation)">
                                                Options (@(prestation.Options?.Count ?? 0))
                                            </button>
                                            @if (prestation.IsActive)
                                            {
                                                <button type="button" class="light-action" @onclick="() => DeactivatePrestationAsync(prestation.Id)" disabled="@IsSaving">Desactiver</button>
                                            }
                                            else
                                            {
                                                <button type="button" @onclick="() => ActivatePrestationAsync(prestation.Id)" disabled="@IsSaving">Reactiver</button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <details class="service-admin-form service-admin-add-form">
                        <summary>
                            <span>Ajouter une prestation</span>
                            <small>Ouvrir le formulaire</small>
                        </summary>
                        <div class="catalog-add-prestation-grid">
                            <label class="catalog-add-name">
                                Nom
                                <input type="text" placeholder="Ex: Tondre le gazon" @bind="draft.Name" />
                            </label>
                            <label class="catalog-add-description">
                                Description courte
                                <textarea rows="3" placeholder="Expliquez clairement ce que couvre la prestation." @bind="draft.Description"></textarea>
                            </label>
                            <label>
                                Ordre d'affichage
                                <input type="number" min="0" @bind="draft.SortOrder" />
                            </label>
                            <label>
                                Prix minimum
                                <input type="number" min="0" step="100" @bind="draft.NormalPriceAmount" />
                            </label>
                            <label>
                                Prix maximum
                                <input type="number" min="0" step="100" @bind="draft.PremiumPriceAmount" />
                            </label>
                            <label class="catalog-checkbox catalog-add-fixed-price">
                                <input type="checkbox" @bind="draft.IsFixedPrice" />
                                Prix fixe
                            </label>
                            <label>
