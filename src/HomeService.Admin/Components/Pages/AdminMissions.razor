@page "/missions"
@using HomeService.Admin.Services
@using HomeService.Contracts.Admin
@using Microsoft.AspNetCore.Components.Web
@inject PlatformApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Missions</PageTitle>

<div class="admin-page-heading">
    <div>
        <p class="eyebrow">Operations</p>
        <h1>Missions</h1>
        <p class="lead">Surveillez les missions, les paiements, les litiges et le journal complet des actions.</p>
    </div>
    <div class="admin-heading-actions">
        <button type="button" class="secondary-action" @onclick="OpenMissionSettings">Parametres missions</button>
        <button type="button" class="secondary-action" @onclick="LoadAsync" disabled="@IsLoading">Actualiser</button>
    </div>
</div>

@if (Snapshot is not null)
{
    <section class="admin-metric-grid compact">
        <article>
            <span>Total</span>
            <strong>@Snapshot.Stats.TotalMissions</strong>
        </article>
        <article>
            <span>Ouvertes</span>
            <strong>@Snapshot.Stats.OpenMissions</strong>
        </article>
        <article>
            <span>Rendez-vous</span>
            <strong>@Snapshot.Stats.ScheduledMissions</strong>
        </article>
        <article>
            <span>Litiges</span>
            <strong>@Snapshot.Stats.DisputedMissions</strong>
        </article>
    </section>
}

<nav class="mission-quick-filters" aria-label="Filtres rapides missions">
    <button type="button" class="@GetQuickFilterClass(null)" @onclick="() => ApplyStatusFilter(null)">
        Toutes
    </button>
    <button type="button" class="@GetQuickFilterClass("Disputed")" @onclick='() => ApplyStatusFilter("Disputed")'>
        Litiges
    </button>
    <button type="button" class="@GetQuickFilterClass("Cancelled")" @onclick='() => ApplyStatusFilter("Cancelled")'>
        Annulees
    </button>
    <button type="button" class="@GetQuickFilterClass("Started")" @onclick='() => ApplyStatusFilter("Started")'>
        En cours
    </button>
    <button type="button" class="@GetQuickFilterClass("Completed")" @onclick='() => ApplyStatusFilter("Completed")'>
        Terminees
    </button>
    <button type="button" class="@GetQuickFilterClass("Accepted")" @onclick='() => ApplyStatusFilter("Accepted")'>
        Acceptees
    </button>
</nav>

<section class="toolbar operator-toolbar">
    <div class="operator-toolbar-intro">
        <strong>Recherche rapide</strong>
        <span>Filtrez par statut, numero de mission, client, entreprise, prestataire ou service.</span>
    </div>
    <label>
        Statut
        <select @bind="SelectedStatus" @bind:after="LoadAsync">
            <option value="">Toutes</option>
            <option value="Created">Creees</option>
            <option value="Assigned">Affectees</option>
            <option value="Accepted">Acceptees</option>
            <option value="Started">En cours</option>
            <option value="Completed">Terminees</option>
            <option value="Cancelled">Annulees</option>
            <option value="Disputed">Litiges</option>
            <option value="Resolved">Resolues</option>
        </select>
    </label>
    <label>
        Recherche
        <input type="search" @bind="SearchTerm" @bind:event="oninput" @onkeydown="OnSearchKeyDownAsync" placeholder="Numero mission, client, entreprise, prestataire, service" />
    </label>
    <div class="operator-toolbar-actions">
        <button type="button" class="primary-action" @onclick="LoadAsync" disabled="@IsLoading">Rechercher</button>
        @if (HasActiveFilters)
        {
            <button type="button" class="secondary-action" @onclick="ResetFiltersAsync" disabled="@IsLoading">Reinitialiser</button>
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <p class="admin-message">@Message</p>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p class="admin-message error-message">@ErrorMessage</p>
}

<section class="operator-list">
    <header>
        <div>
            <h2>Suivi missions</h2>
            <p>@(Snapshot?.Items.Count ?? 0) mission(s) affichee(s). Ouvrez un dossier pour voir le journal, les messages, les paiements et les decisions de litige.</p>
        </div>
    </header>

    @if (IsLoading)
    {
        <article class="operator-row">
            <div>
                <strong>Chargement...</strong>
                <p>Lecture des missions depuis l'API.</p>
            </div>
        </article>
    }
    else if (Snapshot is null || Snapshot.Items.Count == 0)
    {
        <article class="admin-empty-row">
            <strong>Aucune mission</strong>
            <p>Aucun resultat pour les filtres actuels. Essayez un autre statut, un numero mission, un client ou une entreprise.</p>
        </article>
    }
    else
    {
        @foreach (var mission in Snapshot.Items)
        {
            <article class="operator-row mission-row">
                <div>
                    <span class="mission-number-chip">@mission.MissionNumber</span>
                    <strong>@FormatMissionTitle(mission.ServiceName, mission.PrestationName)</strong>
                    <p>@mission.CustomerName - @mission.CustomerPhoneNumber</p>
                    <small>@(mission.CompanyName ?? "Entreprise non affectee") - @(mission.ServiceAddress ?? "Adresse non renseignee")</small>
                </div>
                <div class="operator-meta">
                    <span class="@GetMissionStatusClass(mission.Status)">@TranslateMissionStatus(mission.Status)</span>
                    <small>@TranslatePaymentMethod(mission.PaymentMethod) / @TranslatePaymentStatus(mission.PaymentStatus)</small>
                </div>
                <div class="operator-kpis">
                    <span>@(mission.ProviderName ?? "Prestataire non affecte")</span>
                    <span>@FormatMoney(mission.Amount, mission.Currency)</span>
                    <span>@FormatDate(mission.ScheduledFor)</span>
                </div>
                <div class="mission-admin-action">
                    @if (SelectedMissionId == mission.Id)
                    {
                        @if (SelectedAction == "cancel")
                        {
                            <input type="text" @bind="CancellationNote" placeholder="Note annulation obligatoire" />
                            <input type="number" min="0" step="100" @bind="CancellationFeeAmount" placeholder="Frais retenus" />
                            <button type="button" class="danger-action" @onclick="() => ConfirmCancelAsync(mission.Id)" disabled="@IsActionBusy">Confirmer</button>
                        }
                        else
                        {
                            <select @bind="DisputeReason">
                                @foreach (var reason in DisputeReasons)
                                {
                                    <option value="@reason.Value">@reason.Label</option>
                                }
                            </select>
                            <input type="text" @bind="DisputeNote" placeholder="Note litige obligatoire" />
                            <button type="button" @onclick="() => ConfirmDisputeAsync(mission.Id)" disabled="@IsActionBusy">Confirmer</button>
                        }
                        <button type="button" class="light-action" @onclick="CancelDispute">Annuler</button>
                    }
                    else
                    {
                        <button type="button" @onclick="() => OpenMission(mission.Id)">Voir dossier</button>
                        @if (CanOpenDispute(mission.Status))
                        {
                            <button type="button" class="light-action" @onclick="() => StartDispute(mission.Id)">Litige</button>
                        }
                        @if (CanCancelMission(mission.Status))
                        {
                            <button type="button" class="danger-action" @onclick="() => StartCancel(mission.Id)">Annuler</button>
                        }
                    }
                </div>
            </article>
        }
    }
</section>

@code {
    private AdminMissionListResponse? Snapshot { get; set; }
    private string? SelectedStatus { get; set; }
    private string? SearchTerm { get; set; }
    private Guid? SelectedMissionId { get; set; }
    private string? SelectedAction { get; set; }
    private string DisputeReason { get; set; } = "Other";
    private string? DisputeNote { get; set; }
    private string? CancellationNote { get; set; }
    private int? CancellationFeeAmount { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsActionBusy { get; set; }
    private string? Message { get; set; }
    private string? ErrorMessage { get; set; }
    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(SelectedStatus) || !string.IsNullOrWhiteSpace(SearchTerm);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            Snapshot = await ApiClient.GetAdminMissionsAsync(SelectedStatus, SearchTerm);
        }
        catch (Exception exception)
        {
            ErrorMessage = $"Impossible de charger les missions. Detail: {exception.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void StartDispute(Guid missionId)
    {
        SelectedMissionId = missionId;
        SelectedAction = "dispute";
        DisputeReason = "Other";
        DisputeNote = null;
        CancellationNote = null;
        CancellationFeeAmount = null;
        Message = null;
        ErrorMessage = null;
    }

    private void StartCancel(Guid missionId)
    {
        SelectedMissionId = missionId;
        SelectedAction = "cancel";
        DisputeNote = null;
        DisputeReason = "Other";
        CancellationNote = null;
        CancellationFeeAmount = null;
        Message = null;
        ErrorMessage = null;
    }

    private void CancelDispute()
    {
        SelectedMissionId = null;
        SelectedAction = null;
        DisputeNote = null;
        CancellationNote = null;
        CancellationFeeAmount = null;
    }

    private void OpenMission(Guid missionId)
    {
        Navigation.NavigateTo($"/missions/{missionId}");
    }

    private void OpenMissionSettings()
    {
        Navigation.NavigateTo("/mission-settings");
    }

    private async Task ApplyStatusFilter(string? status)
    {
        SelectedStatus = status;
        await LoadAsync();
    }

    private async Task ResetFiltersAsync()
    {
        SelectedStatus = null;
        SearchTerm = null;
        await LoadAsync();
    }

    private async Task OnSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await LoadAsync();
        }
    }

    private async Task ConfirmDisputeAsync(Guid missionId)
    {
        if (string.IsNullOrWhiteSpace(DisputeNote))
        {
            ErrorMessage = "Ajoutez une note avant de signaler un litige. Elle servira au suivi admin.";
            return;
        }

        IsActionBusy = true;
        ErrorMessage = null;
        Message = null;

        try
        {
            Snapshot = await ApiClient.MarkAdminMissionDisputedAsync(missionId, DisputeReason, DisputeNote);
            SelectedStatus = "Disputed";
            SelectedMissionId = null;
            DisputeNote = null;
            DisputeReason = "Other";
            Message = "Mission marquee en litige.";
        }
        catch (Exception exception)
        {
            ErrorMessage = $"Action impossible. Detail: {exception.Message}";
        }
        finally
        {
            IsActionBusy = false;
        }
    }

    private async Task ConfirmCancelAsync(Guid missionId)
    {
        if (string.IsNullOrWhiteSpace(CancellationNote))
        {
            ErrorMessage = "Ajoutez une note avant d'annuler la mission. Elle servira au journal de suivi.";
            return;
        }

        IsActionBusy = true;
        ErrorMessage = null;
        Message = null;

        try
        {
            await ApiClient.CancelAdminMissionAsync(missionId, "Other", CancellationNote, CancellationFeeAmount);
            SelectedStatus = "Cancelled";
            SelectedMissionId = null;
            SelectedAction = null;
            CancellationNote = null;
            CancellationFeeAmount = null;
            Message = "Mission annulee par l'administration.";
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = $"Annulation impossible. Detail: {exception.Message}";
        }
        finally
        {
            IsActionBusy = false;
        }
    }

    private static string FormatMoney(int? amount, string currency) => amount is null ? "Aucun prix" : $"{amount:N0} {currency}";
    private static string FormatDate(DateTimeOffset? value) => value?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Non planifie";

    private static string TranslateMissionStatus(string status) => status switch
    {
        "Created" => "Creee",
        "SearchingProvider" => "Recherche",
        "Offered" => "Proposee",
        "Assigned" => "Affectee",
        "Accepted" => "Acceptee",
        "OnTheWay" => "En route",
        "Started" => "En cours",
        "Completed" => "Terminee",
        "Cancelled" => "Annulee",
        "Disputed" => "Litige",
        "Resolved" => "Resolue",
        _ => status
    };

    private static string TranslatePaymentStatus(string status) => status switch
    {
        "Paid" => "Encaisse",
        "Pending" => "En attente",
        "Authorized" => "Autorise",
        "Failed" => "Echec",
        "Refunded" => "Rembourse",
        _ => status
    };

    private static string TranslatePaymentMethod(string method) => method switch
    {
        "MobileMoney" => "Mobile Money",
        "Card" => "Carte bancaire",
        "Cash" => "Cash",
        _ => method
    };

    private static string GetMissionStatusClass(string status) => status switch
    {
        "Completed" or "Resolved" => "status-pill ok",
        "Cancelled" or "Disputed" => "status-pill danger",
        _ => "status-pill pending"
    };

    private static bool CanOpenDispute(string status)
    {
        return status is not ("Disputed" or "Cancelled" or "Resolved");
    }

    private static bool CanCancelMission(string status)
    {
        return status is not ("Disputed" or "Completed" or "Cancelled" or "Resolved");
    }

    private static string FormatMissionTitle(string serviceName, string? prestationName)
        => string.IsNullOrWhiteSpace(prestationName) ? serviceName : $"{serviceName} - {prestationName}";

    private string GetQuickFilterClass(string? status)
    {
        var isActive = string.IsNullOrWhiteSpace(status)
            ? string.IsNullOrWhiteSpace(SelectedStatus)
            : string.Equals(SelectedStatus, status, StringComparison.OrdinalIgnoreCase);

        return isActive ? "active" : string.Empty;
    }

    private static readonly IReadOnlyList<(string Value, string Label)> DisputeReasons =
    [
        ("CustomerAbsent", "Client absent"),
        ("AccessRefused", "Acces refuse"),
        ("CustomerUnavailable", "Client indisponible"),
        ("ProviderNoShow", "Prestataire absent"),
        ("ProviderUnavailable", "Prestataire indisponible"),
        ("CompanyUnavailable", "Entreprise indisponible"),
        ("Other", "Autre motif")
    ];
}
