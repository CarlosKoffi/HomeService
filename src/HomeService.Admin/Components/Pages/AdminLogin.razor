@page "/admin-login"
@using HomeService.Admin.Services
@inject AdminSessionState SessionState
@inject NavigationManager Navigation
@inject ILogger<AdminLogin> Logger

<PageTitle>Connexion admin</PageTitle>

<main class="admin-login-page">
    <section class="admin-login-card">
        <div class="admin-login-brand">
            <img src="images/wele-logo.png" alt="wélé" />
            <div>
                <strong>Console wélé</strong>
                <span>Acces reserve aux administrateurs</span>
            </div>
        </div>

        <h1>Connexion admin</h1>
        <p>Connectez-vous avec votre compte interne pour piloter la plateforme.</p>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <p class="admin-message error-message">@ErrorMessage</p>
        }

        <div class="admin-login-form">
            <label>
                Email admin
                <input type="email" @bind="Email" placeholder="admin@wele.ci" autocomplete="username" />
            </label>
            <label>
                Mot de passe
                <input type="password" @bind="Password" placeholder="Votre mot de passe" autocomplete="current-password" @onkeydown="HandleKeyDownAsync" />
            </label>
            <label>
                Code Authenticator
                <input type="text" inputmode="numeric" maxlength="9" @bind="MfaCode" placeholder="Requis après activation" autocomplete="one-time-code" @onkeydown="HandleKeyDownAsync" />
                <small>Laissez vide si vous n’avez pas encore activé Authenticator.</small>
            </label>
            <button type="button" class="primary-action" @onclick="SignInAsync" disabled="@IsBusy">Se connecter</button>
        </div>
    </section>
</main>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string MfaCode { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }
    private bool IsBusy { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await SessionState.InitializeAsync();
        if (SessionState.IsAuthenticated)
        {
            Navigation.NavigateTo(
                SessionState.CurrentUser?.MfaEnrollmentRequired == true ? "/admin-security" : SafeReturnUrl(),
                forceLoad: true);
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SignInAsync();
        }
    }

    private async Task SignInAsync()
    {
        if (IsBusy)
        {
            return;
        }

        IsBusy = true;
        ErrorMessage = null;

        bool signedIn;
        try
        {
            signedIn = await SessionState.SignInAsync(Email, Password, MfaCode);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Admin sign-in could not be finalized for {AdminEmail}.", Email);
            ErrorMessage = $"La connexion n'a pas pu etre finalisee ({GetDiagnosticCode(exception)}). Actualisez la page puis reessayez.";
            return;
        }
        finally
        {
            IsBusy = false;
        }

        if (!signedIn)
        {
            ErrorMessage = SessionState.LastSignInError ?? "Email, mot de passe ou code incorrect.";
            return;
        }

        // Keep the navigation outside the catch block. During server-side rendering,
        // Blazor can use a NavigationException as control flow to complete redirects.
        // A full reload also lets the protected layout restore the freshly persisted session.
        Navigation.NavigateTo(
            SessionState.CurrentUser?.MfaEnrollmentRequired == true ? "/admin-security" : SafeReturnUrl(),
            forceLoad: true);
    }

    private string SafeReturnUrl()
    {
        return string.IsNullOrWhiteSpace(ReturnUrl) || ReturnUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? "/"
            : ReturnUrl;
    }

    private static string GetDiagnosticCode(Exception exception)
    {
        var typeName = exception.GetType().Name;
        return typeName switch
        {
            "JSException" => "session navigateur",
            "JSDisconnectedException" => "connexion navigateur interrompue",
            "InvalidOperationException" => "session non disponible",
            _ => "erreur inattendue"
        };
    }
}
