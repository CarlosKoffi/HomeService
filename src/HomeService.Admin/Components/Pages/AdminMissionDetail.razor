    private static string TranslatePaymentStatus(string status) => status switch { "Paid" => "Encaisse", "Pending" => "En attente", "Authorized" => "Autorise", "Failed" => "Echec", "Refunded" => "Rembourse", _ => status };
    private static string TranslatePaymentMethod(string method) => method switch
    {
        "MobileMoney" => "Mobile Money",
        "Card" => "Carte bancaire",
        "Cash" => "Cash",
        _ => method
    };
    private static string TranslateAssignmentStatus(string status) => status switch { "Offered" => "Proposee", "Accepted" => "Acceptee", "Refused" => "Refusee", "Expired" => "Expiree", "Started" => "En cours", "Completed" => "Terminee", "Cancelled" => "Annulee", _ => status };
    private static string TranslateLocationStatus(string status) => status switch { "Verified" => "verifiee", "OutsideTolerance" => "hors zone", "MissingProviderLocation" => "position manquante", "MissingMissionLocation" => "mission sans position", "LowAccuracy" => "precision faible", "InvalidProviderLocation" => "position invalide", _ => "non verifiee" };
    private static string TranslateSenderType(string senderType) => senderType switch { "Customer" => "Client", "Provider" => "Prestataire", "Company" => "Entreprise", "Platform" => "wélé", _ => senderType };

    private static string TranslateDisputeStatus(string status) => status switch { "Open" => "Ouvert", "Resolved" => "Resolue", "Cancelled" => "Annulee", _ => status };
    private static string TranslateDisputeReason(string reason) => reason switch { "CustomerAbsent" => "Client absent", "AccessRefused" => "Acces refuse", "CustomerUnavailable" => "Client indisponible", "ProviderNoShow" => "Prestataire absent", "ProviderUnavailable" => "Prestataire indisponible", "CompanyUnavailable" => "Entreprise indisponible", "Other" => "Autre", _ => reason };
    private static string TranslateDisputeResolution(string? resolution) => resolution switch { "RefundCustomer" => "Remboursement total client", "PartialRefund" => "Remboursement partiel", "PayCompany" => "Paiement entreprise maintenu", "NoAction" => "Aucune action financiere", "Other" => "Decision specifique", _ => "En attente de decision" };

    private static string GetMissionStatusClass(string status) => status switch { "Completed" or "Resolved" => "status-pill ok", "Cancelled" or "Disputed" => "status-pill danger", _ => "status-pill pending" };
    private static string GetAssignmentStatusClass(string status) => status switch { "Accepted" or "Completed" => "status-pill ok", "Refused" or "Expired" or "Cancelled" => "status-pill danger", _ => "status-pill pending" };
    private static string GetDisputeStatusClass(string status) => status switch { "Resolved" => "status-pill ok", "Cancelled" => "status-pill danger", _ => "status-pill pending" };
    private static string GetFinancialLineClass(int amount) => amount < 0 ? "mission-finance-line negative" : "mission-finance-line";
    private static bool CanOpenDispute(string status) => status is not ("Disputed" or "Cancelled" or "Resolved");
    private static bool CanCancelMission(string status) => status is not ("Started" or "Disputed" or "Completed" or "Cancelled" or "Resolved");
    private static bool CanDispatchOffers(string status) => status is "Created" or "SearchingProvider" or "Offered";
    private static string GetTimelineItemClass(string tone) => tone switch
    {
        "ok" => "mission-timeline-item ok",
        "danger" => "mission-timeline-item danger",
        "money" => "mission-timeline-item money",
        _ => "mission-timeline-item"
    };

    private static IReadOnlyList<MissionTimelineItem> BuildMissionTimeline(AdminMissionDetailResponse mission)
    {
        var items = new List<MissionTimelineItem>
        {
            new("01", "Demande creee", $"{mission.CustomerName} a demande {FormatMissionTitle(mission.ServiceName, mission.PrestationName)}.", mission.CreatedAt, "neutral")
        };

        if (mission.ScheduledFor is not null)
        {
            items.Add(new("02", "Rendez-vous prevu", $"Intervention planifiee au {FormatDate(mission.ScheduledFor)}.", mission.ScheduledFor.Value, "neutral"));
        }

        if (mission.CompanyQuotedAt is not null)
        {
            items.Add(new("03", "Devis entreprise", $"{mission.CompanyName ?? "Entreprise"} a propose {FormatMoney(mission.CompanyQuotedAmount, mission.Currency)}.", mission.CompanyQuotedAt.Value, "money"));
        }

        if (mission.CustomerQuoteAcceptedAt is not null)
        {
            items.Add(new("04", "Devis accepte", $"Le client a accepte le prix de {FormatMoney(mission.CompanyQuotedAmount ?? mission.FinalTotalAmount, mission.Currency)}.", mission.CustomerQuoteAcceptedAt.Value, "ok"));
        }

        if (mission.ProviderAcceptedAt is not null)
        {
            items.Add(new("05", "Prestataire accepte", $"{mission.ProviderName ?? "Prestataire"} a accepte la mission.", mission.ProviderAcceptedAt.Value, "ok"));
        }

        if (mission.CustomerConfirmedAt is not null)
        {
            items.Add(new("06", "Client confirme", "Le client a confirme l'intervention.", mission.CustomerConfirmedAt.Value, "ok"));
        }

        if (mission.ContactDetailsReleasedAt is not null)
        {
            items.Add(new("07", "Contacts visibles", "Les contacts client et prestataire ont ete ouverts apres confirmation.", mission.ContactDetailsReleasedAt.Value, "neutral"));
        }

        foreach (var assignment in mission.Assignments)
        {
            items.Add(new("A", $"Affectation {TranslateAssignmentStatus(assignment.Status)}", $"{assignment.ProviderName} - {assignment.CompanyName}. Expire le {FormatDate(assignment.ExpiresAt)}.", assignment.ExpiresAt, GetAssignmentTone(assignment.Status)));

            if (assignment.RespondedAt is not null)
            {
                items.Add(new("A", "Reponse prestataire", $"{assignment.ProviderName}: {TranslateAssignmentStatus(assignment.Status)}{FormatOptionalReason(assignment.RefusalReason)}.", assignment.RespondedAt.Value, GetAssignmentTone(assignment.Status)));
            }

            if (assignment.ArrivalVerifiedAt is not null)
            {
                items.Add(new("A", "Arrivee controlee", $"{assignment.ProviderName}: arrivee {TranslateLocationStatus(assignment.ArrivalVerificationStatus)} ({FormatDistance(assignment.ArrivalDistanceMeters, assignment.ArrivalToleranceMeters)}).", assignment.ArrivalVerifiedAt.Value, assignment.ArrivalVerificationStatus == "Verified" ? "ok" : "danger"));
            }

            if (assignment.StartedAt is not null)
            {
                items.Add(new("A", "Mission demarree", $"{assignment.ProviderName} a declare le debut de prestation.", assignment.StartedAt.Value, "ok"));
            }

            if (assignment.CompletedAt is not null)
            {
                items.Add(new("A", "Mission terminee", string.IsNullOrWhiteSpace(assignment.CompletionNote) ? "Fin de prestation declaree." : assignment.CompletionNote, assignment.CompletedAt.Value, "ok"));
            }
        }

        foreach (var dispute in mission.Disputes)
        {
            items.Add(new("L", "Litige ouvert", $"{TranslateDisputeReason(dispute.Reason)} - {dispute.Description}", dispute.OpenedAt, "danger"));

            if (dispute.ResolvedAt is not null)
            {
                var refund = dispute.RefundAmount is > 0
                    ? $" Remboursement: {FormatMoney(dispute.RefundAmount, dispute.Currency)}."
                    : string.Empty;
                items.Add(new("L", "Litige resolu", $"{TranslateDisputeResolution(dispute.Resolution)}.{refund} {dispute.ResolutionNote}", dispute.ResolvedAt.Value, "ok"));
            }
        }

        foreach (var message in mission.Messages)
        {
            items.Add(new("M", $"Message {TranslateSenderType(message.SenderType)}", message.Body, message.CreatedAt, "neutral"));
        }

        if (mission.CancelledAt is not null)
        {
            items.Add(new("X", "Mission annulee", $"{TranslateCancellationActor(mission.CancelledBy)} - {TranslateDisputeReason(mission.CancellationReason ?? "Other")}. {mission.CancellationComment}", mission.CancelledAt.Value, "danger"));
        }

        if (mission.PaymentStatus is "Paid" or "Authorized" or "Refunded" or "Failed")
        {
            items.Add(new("P", $"Paiement {TranslatePaymentStatus(mission.PaymentStatus)}", $"{TranslatePaymentMethod(mission.PaymentMethod)} - commission wélé {FormatMoney(mission.PlatformCommissionAmount, mission.Currency)} - reversement {FormatMoney(mission.CompanyPayoutAmount, mission.Currency)}.", mission.CustomerQuoteAcceptedAt ?? mission.CreatedAt, "money"));
        }

        return items
            .OrderByDescending(item => item.OccurredAt)
            .ThenBy(item => item.Step)
            .ToList();
    }

    private static string GetAssignmentTone(string status) => status switch
    {
        "Accepted" or "Started" or "Completed" => "ok",
        "Refused" or "Expired" or "Cancelled" => "danger",
        _ => "neutral"
    };

