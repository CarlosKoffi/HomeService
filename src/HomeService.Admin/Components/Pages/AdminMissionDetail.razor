@page "/missions/{MissionId:guid}"
@using HomeService.Admin.Services
@using HomeService.Contracts.Admin
@inject PlatformApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Dossier mission</PageTitle>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p class="admin-message error-message">@ErrorMessage</p>
}

@if (!string.IsNullOrWhiteSpace(Message))
{
    <p class="admin-message">@Message</p>
}

@if (IsLoading)
{
    <section class="info-panel">
        <div>
            <h1>Chargement...</h1>
            <p>Ouverture du dossier mission.</p>
        </div>
    </section>
}
else if (Mission is null)
{
    <section class="info-panel">
        <div>
            <h1>Mission introuvable</h1>
            <p>La mission n'existe plus ou n'est pas accessible.</p>
        </div>
        <button type="button" class="secondary-action" @onclick="BackToList">Retour missions</button>
    </section>
}
else
{
    <div class="admin-page-heading mission-admin-hero">
        <div>
            <button type="button" class="link-action" @onclick="BackToList">Retour aux missions</button>
            <p class="eyebrow">Dossier mission</p>
            <h1>@FormatMissionTitle(Mission.ServiceName, Mission.PrestationName)</h1>
            <p class="lead">@Mission.MissionNumber - @Mission.CustomerName - @(Mission.ServiceAddress ?? "Adresse non renseignee")</p>
        </div>
        <div class="company-admin-status">
            <span class="@GetMissionStatusClass(Mission.Status)">@TranslateMissionStatus(Mission.Status)</span>
            <small>@TranslateMissionMode(Mission.Mode) - @FormatDate(Mission.ScheduledFor)</small>
        </div>
    </div>

    <section class="admin-metric-grid compact">
        <article>
            <span>Prix client</span>
            <strong>@FormatMoney(CustomerChargedAmount, Mission.Currency)</strong>
        </article>
        <article>
            <span>Paiement</span>
            <strong>@TranslatePaymentStatus(Mission.PaymentStatus)</strong>
        </article>
        <article>
            <span>Commission</span>
            <strong>@FormatMoney(Mission.PlatformCommissionAmount, Mission.Currency)</strong>
        </article>
        <article>
            <span>Remboursement</span>
            <strong>@FormatMoney(Mission.RefundAmount, Mission.Currency)</strong>
        </article>
        <article>
            <span>Contact</span>
            <strong>@(Mission.CanRevealContactDetails ? "Libre" : "Masque")</strong>
        </article>
    </section>

    <section class="company-control-strip">
        <button type="button" class='@GetTabClass("summary")' @onclick='() => SelectTab("summary")'>Resume</button>
        <button type="button" class='@GetTabClass("finances")' @onclick='() => SelectTab("finances")'>Finances</button>
        <button type="button" class='@GetTabClass("assignments")' @onclick='() => SelectTab("assignments")'>Affectations</button>
        <button type="button" class='@GetTabClass("messages")' @onclick='() => SelectTab("messages")'>Messages</button>
        <button type="button" class='@GetTabClass("logs")' @onclick='() => SelectTab("logs")'>Journal</button>
    </section>

    @if (SelectedTab == "summary")
    {
        <section class="company-detail-grid">
            <article>
                <h2>Client</h2>
                <dl class="detail-list">
                    <div><dt>Nom</dt><dd>@Mission.CustomerName</dd></div>
                    <div><dt>Numero mission</dt><dd>@Mission.MissionNumber</dd></div>
                    <div><dt>Telephone</dt><dd>@Mission.CustomerPhoneNumber</dd></div>
                    <div><dt>Adresse</dt><dd>@(Mission.ServiceAddress ?? "Non renseignee")</dd></div>
                    <div><dt>Coordonnees</dt><dd>@FormatLocation(Mission.ServiceLatitude, Mission.ServiceLongitude)</dd></div>
                </dl>
            </article>
            <article>
                <h2>Entreprise et prestataire</h2>
                <dl class="detail-list">
                    <div><dt>Entreprise</dt><dd>@(Mission.CompanyName ?? "Non affectee")</dd></div>
                    <div><dt>Prestataire</dt><dd>@(Mission.ProviderName ?? "Non affecte")</dd></div>
                    <div><dt>Acceptation presta</dt><dd>@FormatDate(Mission.ProviderAcceptedAt)</dd></div>
                    <div><dt>Confirmation client</dt><dd>@FormatDate(Mission.CustomerConfirmedAt)</dd></div>
                </dl>
            </article>
            <article class="mission-photo-panel">
                <h2>Photos de la demande</h2>
                @if (Mission.Attachments.Count == 0)
                {
                    <p class="admin-empty">Aucune photo transmise pour cette mission.</p>
                }
                else
                {
                    <div class="mission-photo-grid">
                        @foreach (var attachment in Mission.Attachments)
                        {
                            <a class="mission-photo-item" href="@ApiClient.GetAdminClientAttachmentPreviewUrl(attachment.Id)" target="_blank" title="Ouvrir @attachment.OriginalFileName">
                                @if (attachment.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                                {
                                    <AdminMediaPreview Source="@ApiClient.GetAdminClientAttachmentPreviewUrl(attachment.Id)"
                                                       IsResolved="true"
                                                       Alt="@(attachment.Caption ?? attachment.OriginalFileName)"
                                                       FallbackText="Photo indisponible" />
                                }
                                <span>@(attachment.Caption ?? attachment.OriginalFileName)</span>
                            </a>
                        }
                    </div>
                }
            </article>
            <article>
                <h2>Prix et paiement</h2>
                <dl class="detail-list">
                    <div><dt>Mode</dt><dd>@TranslatePaymentMethod(Mission.PaymentMethod)</dd></div>
                    <div><dt>Statut</dt><dd>@TranslatePaymentStatus(Mission.PaymentStatus)</dd></div>
                    <div><dt>Devis entreprise</dt><dd>@FormatMoney(Mission.CompanyQuotedAmount, Mission.Currency)</dd></div>
                    <div><dt>Frais de mise en relation</dt><dd>@FormatMoney(Mission.CustomerServiceFeeAmount, Mission.Currency)</dd></div>
                    <div><dt>Total paye par le client</dt><dd>@FormatMoney(CustomerChargedAmount, Mission.Currency)</dd></div>
                    <div><dt>Justification</dt><dd>@(Mission.CompanyQuoteJustification ?? "Aucune")</dd></div>
                    <div><dt>Transport</dt><dd>@FormatMoney(Mission.TransportFeeAmount, Mission.Currency)</dd></div>
                    <div><dt>Annulation</dt><dd>@FormatMoney(Mission.CancellationFeeAmount, Mission.Currency)</dd></div>
                </dl>
            </article>
            <article>
                <h2>Action admin</h2>
                @if (CanDispatchOffers(Mission.Status))
                {
                    <div class="mission-dispute-box mission-dispatch-box">
                        <strong>Relance entreprises</strong>
                        <p>Renvoie cette mission aux entreprises eligibles si aucune offre ouverte n'existe deja.</p>
                        <label class="inline-check">
                            <input type="checkbox" @bind="DispatchAsUrgent" />
                            Traiter comme urgence
                        </label>
                        <button type="button" class="light-action" @onclick="DispatchOffersAsync" disabled="@IsActionBusy">
                            Relancer les entreprises
                        </button>
                    </div>
                }
                @if (CanOpenDispute(Mission.Status) || CanCancelMission(Mission.Status))
                {
                    @if (CanOpenDispute(Mission.Status))
                    {
                        <div class="mission-dispute-box">
                            <label>
                                Motif du litige
                                <select @bind="DisputeReason">
                                    @foreach (var reason in DisputeReasons)
                                    {
                                        <option value="@reason.Value">@reason.Label</option>
                                    }
                                </select>
                            </label>
                            <label>
                                Note litige
                                <textarea @bind="DisputeNote" placeholder="Expliquez le probleme avant de passer la mission en litige."></textarea>
                            </label>
                            <button type="button" @onclick="MarkDisputedAsync" disabled="@IsActionBusy">Signaler un litige</button>
                        </div>
                    }
                    @if (CanCancelMission(Mission.Status))
                    {
                        <div class="mission-dispute-box mission-cancel-box">
                            <label>
                                Motif d'annulation
                                <select @bind="CancellationReason">
                                    @foreach (var reason in MissionOperationReasons)
                                    {
                                        <option value="@reason.Value">@reason.Label</option>
                                    }
                                </select>
                            </label>
                            <label>
                                Annulation admin
                                <textarea @bind="CancellationNote" placeholder="Expliquez pourquoi l'administration annule cette mission."></textarea>
                            </label>
                            <label>
                                Frais retenus au client
                                <input type="number" min="0" step="100" @bind="CancellationFeeAmount" placeholder="0" />
                            </label>
                            <label>
                                Pourcentage rembourse
                                <input type="number" min="0" max="100" step="1" @bind="CancellationRefundPercent" placeholder="100" />
                            </label>
                            <label class="inline-check">
                                <input type="checkbox" @bind="IncludeCustomerServiceFeeInCancellationRefund" />
                                Inclure les frais de mise en relation dans ce remboursement exceptionnel
                            </label>
                            <p class="mission-dispute-hint">
                                Remboursement prepare : @FormatMoney(CancellationRefundPreviewAmount, Mission.Currency).
                                La decision est propre a ce dossier.
                            </p>
                            <button type="button" class="danger-action" @onclick="CancelMissionAsync" disabled="@IsActionBusy">Annuler la mission</button>
                        </div>
                    }
                }
                else if (Mission.Status == "Disputed")
                {
                    <div class="mission-dispute-box">
                        @if (Mission.Disputes.Count > 0)
                        {
                            var currentDispute = Mission.Disputes
                                .Where(dispute => dispute.Status == "Open")
                                .OrderByDescending(dispute => dispute.OpenedAt)
                                .FirstOrDefault()
                                ?? Mission.Disputes.OrderByDescending(dispute => dispute.OpenedAt).First();

                            <div class="mission-dispute-current">
                                <span>Litige ouvert le @FormatDate(currentDispute.OpenedAt)</span>
                                <strong>@TranslateDisputeReason(currentDispute.Reason)</strong>
                                <p>@currentDispute.Description</p>
                            </div>
                        }
                        <div class="mission-refund-summary">
                            <div>
                                <span>Base de calcul</span>
                                <strong>@FormatMoney(RefundReferenceAmount, Mission.Currency)</strong>
                                <small>Montant mission, avec les frais client uniquement si l'admin les inclut.</small>
                            </div>
                            <div>
                                <span>Remboursement prepare</span>
                                <strong>@FormatMoney(PreviewRefundAmount, Mission.Currency)</strong>
                                <small>@GetRefundPreviewLabel()</small>
                            </div>
                        </div>
                        <label>
                            Decision admin
                            <select value="@ResolutionType" @onchange="OnResolutionTypeChanged">
                                <option value="PartialRefund">Remboursement partiel</option>
                                <option value="RefundCustomer">Remboursement total</option>
                                <option value="PayCompany">Payer l'entreprise</option>
                                <option value="NoAction">Cloturer sans action financiere</option>
                                <option value="Other">Autre decision</option>
                            </select>
                        </label>
                        @if (RequiresRefundInput)
                        {
                            <label class="inline-check">
                                <input type="checkbox" @bind="IncludeCustomerServiceFeeInDisputeRefund" />
                                Inclure les frais de mise en relation dans ce remboursement exceptionnel
                            </label>
                            <div class="mission-refund-actions">
                                <button type="button" class="light-action" @onclick="PrepareFullRefund" disabled="@IsActionBusy">
                                    Rembourser 100%
                                </button>
                                <button type="button" class="light-action" @onclick="ClearRefundDecision" disabled="@IsActionBusy">
                                    Vider le remboursement
                                </button>
                            </div>
                            <div class="mission-refund-grid">
                                <label>
                                    Pourcentage rembourse
                                    <input type="number" min="0" max="100" step="1" @bind="RefundPercent" @bind:event="oninput" placeholder="Ex: 40" />
                                </label>
                                <label>
                                    Montant rembourse
                                    <input type="number" min="0" step="100" @bind="RefundAmount" @bind:event="oninput" placeholder="@RefundReferenceAmount.ToString()" />
                                </label>
                            </div>
                            <p class="mission-dispute-hint">Le montant est prioritaire. Sinon le pourcentage calcule le remboursement depuis la base affichee ci-dessus.</p>
                        }
                        <label>
                            Note de resolution
                            <textarea @bind="ResolutionNote" placeholder="Expliquez la decision prise avant de cloturer le litige."></textarea>
                        </label>
                        <button type="button" @onclick="ResolveDisputeAsync" disabled="@IsActionBusy">Cloturer le litige</button>
                    </div>
                }
                else
                {
                    <p class="muted-action">Aucune action sensible disponible pour ce statut.</p>
                }
            </article>
        </section>
        @if (Mission.Disputes.Count > 0)
        {
            <section class="operator-list dispute-history-panel">
                <header>
                    <div>
                        <h2>Historique litige</h2>
                        <p>Decisions prises et remboursements valides par l'administration.</p>
                    </div>
                </header>
                @foreach (var dispute in Mission.Disputes.OrderByDescending(dispute => dispute.OpenedAt))
                {
                    <article class="operator-row">
                        <div>
                            <strong>@TranslateDisputeResolution(dispute.Resolution)</strong>
                            <p>@dispute.Description</p>
                            <small>Ouvert le @FormatDate(dispute.OpenedAt)</small>
                        </div>
                        <div class="operator-meta">
                            <span class="@GetDisputeStatusClass(dispute.Status)">@TranslateDisputeStatus(dispute.Status)</span>
                            <small>@(dispute.ResolutionNote ?? "Pas encore de note de resolution")</small>
                        </div>
                        <div class="operator-kpis">
                            <span>@(dispute.RefundPercent.HasValue ? $"{dispute.RefundPercent}% rembourse" : "Pas de %")</span>
                            <span>@FormatMoney(dispute.RefundAmount, dispute.Currency)</span>
                            <span>@FormatDate(dispute.ResolvedAt)</span>
                        </div>
                    </article>
                }
            </section>
        }
    }
    else if (SelectedTab == "finances")
    {
        <section class="mission-finance-panel">
            <header>
                <div>
                    <h2>Lecture financiere</h2>
                    <p>Controle du prix client, de la commission wélé, du reversement entreprise et des remboursements.</p>
                </div>
                <strong>@TranslatePaymentStatus(Mission.PaymentStatus)</strong>
            </header>

            <div class="mission-finance-summary">
                <article>
                    <span>Prix client</span>
                    <strong>@FormatMoney(CustomerChargedAmount, Mission.Currency)</strong>
                </article>
                <article>
                    <span>Frais de mise en relation</span>
                    <strong>@FormatMoney(Mission.CustomerServiceFeeAmount, Mission.Currency)</strong>
                </article>
                <article>
                    <span>Commission wélé</span>
                    <strong>@FormatMoney(Mission.PlatformCommissionAmount, Mission.Currency)</strong>
                </article>
                <article>
                    <span>Reversement entreprise</span>
                    <strong>@FormatMoney(Mission.CompanyPayoutAmount, Mission.Currency)</strong>
                </article>
                <article>
                    <span>Remboursement</span>
                    <strong>@FormatMoney(Mission.RefundAmount, Mission.Currency)</strong>
                </article>
            </div>

            @if (Mission.FinancialLines.Count == 0)
            {
                <article class="mission-finance-empty">
                    <strong>Aucune ligne financiere</strong>
                    <p>La mission n'a pas encore de devis accepte, paiement, frais ou remboursement a afficher.</p>
                </article>
            }
            else
            {
                <div class="mission-finance-lines">
                    @foreach (var line in Mission.FinancialLines)
                    {
                        <article class="@GetFinancialLineClass(line.Amount)">
                            <div>
                                <span>@TranslateFinancialLineType(line.LineType)</span>
                                <strong>@line.Label</strong>
                            </div>
                            <strong>@FormatSignedMoney(line.Amount, line.Currency)</strong>
                        </article>
                    }
                </div>
            }
        </section>
    }
    else if (SelectedTab == "assignments")
    {
        <section class="operator-list">
            <header>
                <div>
                    <h2>Affectations prestataires</h2>
                    <p>@Mission.Assignments.Count tentative(s) ou affectation(s)</p>
                </div>
            </header>
            @foreach (var assignment in Mission.Assignments)
            {
                <article class="operator-row mission-assignment-row">
                    <div>
                        <strong>@assignment.ProviderName</strong>
                        <p>@assignment.CompanyName</p>
                        <small>Expire le @FormatDate(assignment.ExpiresAt)</small>
                    </div>
                    <div class="operator-meta">
                        <span class="@GetAssignmentStatusClass(assignment.Status)">@TranslateAssignmentStatus(assignment.Status)</span>
                        <small>@(assignment.RefusalReason ?? "Pas de refus")</small>
                    </div>
                    <div class="operator-kpis">
                        <span>Arrivee @TranslateLocationStatus(assignment.ArrivalVerificationStatus)</span>
                        <span>@FormatDistance(assignment.ArrivalDistanceMeters, assignment.ArrivalToleranceMeters)</span>
                        <span>@FormatDate(assignment.ArrivalVerifiedAt)</span>
                    </div>
                </article>
            }
        </section>
    }
    else if (SelectedTab == "messages")
    {
        <section class="timeline-panel">
            @if (Mission.Messages.Count == 0)
            {
                <article>
                    <strong>Aucun message</strong>
                    <p>Le chat mission n'a pas encore de message rattache.</p>
                </article>
            }
            @foreach (var message in Mission.Messages)
            {
                <article>
                    <strong>@TranslateSenderType(message.SenderType)</strong>
                    <p>@message.Body</p>
                    <small>@FormatDate(message.CreatedAt) - @(message.ReadAt is null ? "Non lu" : "Lu")</small>
                </article>
            }
        </section>
    }
    else if (SelectedTab == "logs")
    {
        <section class="mission-timeline-panel">
            <header>
                <div>
                    <span>Chronologie mission</span>
                    <h2>Evenements cles</h2>
                    <p>Lecture metier rapide pour retrouver ce qui s'est passe pendant un appel client ou un controle admin.</p>
                </div>
                <strong>@BuildMissionTimeline(Mission).Count evenement(s)</strong>
            </header>

            <div class="mission-timeline-list">
                @foreach (var item in BuildMissionTimeline(Mission))
                {
                    <article class="@GetTimelineItemClass(item.Tone)">
                        <span>@item.Step</span>
                        <div>
                            <strong>@item.Title</strong>
                            <p>@item.Description</p>
                            <small>@FormatDate(item.OccurredAt)</small>
                        </div>
                    </article>
                }
            </div>
        </section>

        <AdminAuditLogPanel
            ContextType="Mission"
            ContextId="Mission.Id"
            Eyebrow="Journal mission"
            Title="@Mission.ServiceName"
            Subtitle="Actions, affectations, paiements, position et evenements rattaches a cette mission." />
    }
}

@code {
    [Parameter] public Guid MissionId { get; set; }

    private AdminMissionDetailResponse? Mission { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsActionBusy { get; set; }
    private string? ErrorMessage { get; set; }
    private string? Message { get; set; }
    private string DisputeReason { get; set; } = "Other";
    private string CancellationReason { get; set; } = "Other";
    private string? DisputeNote { get; set; }
    private string? CancellationNote { get; set; }
    private int? CancellationFeeAmount { get; set; }
    private int? CancellationRefundPercent { get; set; } = 100;
    private bool IncludeCustomerServiceFeeInCancellationRefund { get; set; }
    private string? ResolutionNote { get; set; }
    private string ResolutionType { get; set; } = "PartialRefund";
    private int? RefundPercent { get; set; }
    private int? RefundAmount { get; set; }
    private bool IncludeCustomerServiceFeeInDisputeRefund { get; set; }
    private string SelectedTab { get; set; } = "summary";
    private bool DispatchAsUrgent { get; set; }
    private bool RequiresRefundInput => ResolutionType is "PartialRefund" or "RefundCustomer";
    private int MissionRefundBaseAmount => Mission?.FinalTotalAmount ?? Mission?.CompanyQuotedAmount ?? Mission?.EstimatedTotalAmount ?? 0;
    private int CustomerChargedAmount => Mission is null
        ? 0
        : Mission.CustomerTotalAmount > 0
            ? Mission.CustomerTotalAmount
            : MissionRefundBaseAmount + Mission.CustomerServiceFeeAmount;
    private int RefundReferenceAmount => MissionRefundBaseAmount
        + (IncludeCustomerServiceFeeInDisputeRefund ? Mission?.CustomerServiceFeeAmount ?? 0 : 0);
    private int PreviewRefundAmount => RefundAmount ?? (RefundPercent.HasValue
        ? (int)Math.Round(RefundReferenceAmount * RefundPercent.Value / 100m, MidpointRounding.AwayFromZero)
        : ResolutionType == "RefundCustomer" ? RefundReferenceAmount : 0);
    private int CancellationRefundReferenceAmount => MissionRefundBaseAmount
        + (IncludeCustomerServiceFeeInCancellationRefund ? Mission?.CustomerServiceFeeAmount ?? 0 : 0);
    private int CancellationRefundPreviewAmount => Math.Max(
        0,
        (int)Math.Round(
            CancellationRefundReferenceAmount * (CancellationRefundPercent ?? 100) / 100m,
            MidpointRounding.AwayFromZero)
        - (CancellationFeeAmount ?? 0));

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            Mission = await ApiClient.GetAdminMissionAsync(MissionId);
        }
        catch (Exception exception)
        {
            ErrorMessage = $"Impossible de charger la mission. Detail: {exception.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task MarkDisputedAsync()
    {
        if (Mission is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(DisputeNote))
        {
            ErrorMessage = "Ajoutez une note avant de signaler un litige. Elle servira au suivi admin.";
            return;
        }

        IsActionBusy = true;
        ErrorMessage = null;
        Message = null;

        try
        {
            await ApiClient.MarkAdminMissionDisputedAsync(Mission.Id, DisputeReason, DisputeNote);
            Message = "Mission marquee en litige.";
            DisputeNote = null;
            DisputeReason = "Other";
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = $"Action impossible. Detail: {exception.Message}";
        }
        finally
        {
            IsActionBusy = false;
        }
    }

    private async Task DispatchOffersAsync()
    {
        if (Mission is null)
        {
            return;
        }

        IsActionBusy = true;
        ErrorMessage = null;
        Message = null;

        try
        {
            var offers = await ApiClient.CreateAdminMissionDispatchOffersAsync(Mission.Id, DispatchAsUrgent);
            Message = offers.Count == 0
                ? "Aucune entreprise eligible pour le moment."
                : $"{offers.Count} offre(s) entreprise disponible(s) pour cette mission.";
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = $"Relance impossible. Detail: {exception.Message}";
        }
        finally
        {
            IsActionBusy = false;
        }
    }

    private async Task ResolveDisputeAsync()
    {
        if (Mission is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(ResolutionNote))
        {
            ErrorMessage = "Ajoutez une note de resolution avant de cloturer le litige.";
            return;
        }

        if (RequiresRefundInput && RefundPercent is null && RefundAmount is null)
        {
            ErrorMessage = "Indiquez un pourcentage ou un montant de remboursement avant de cloturer le litige.";
            return;
        }

        var refundValidationMessage = ValidateRefundDecision();
        if (refundValidationMessage is not null)
        {
            ErrorMessage = refundValidationMessage;
            return;
        }

        IsActionBusy = true;
        ErrorMessage = null;
        Message = null;

        try
        {
            Mission = await ApiClient.ResolveAdminMissionDisputeAsync(
                Mission.Id,
                ResolutionType,
                ResolutionNote ?? string.Empty,
                RefundPercent,
                RefundAmount,
                IncludeCustomerServiceFeeInDisputeRefund);
            Message = "Litige cloture.";
            ResolutionNote = null;
            RefundPercent = null;
            RefundAmount = null;
            IncludeCustomerServiceFeeInDisputeRefund = false;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = $"Action impossible. Detail: {exception.Message}";
        }
        finally
        {
            IsActionBusy = false;
        }
    }

    private async Task CancelMissionAsync()
    {
        if (Mission is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(CancellationNote))
        {
            ErrorMessage = "Ajoutez une note avant d'annuler la mission.";
            return;
        }

        if (CancellationRefundPercent is < 0 or > 100)
        {
            ErrorMessage = "Le pourcentage de remboursement doit etre compris entre 0 et 100.";
            return;
        }

        IsActionBusy = true;
        ErrorMessage = null;
        Message = null;

        try
        {
            Mission = await ApiClient.CancelAdminMissionAsync(
                Mission.Id,
                CancellationReason,
                CancellationNote,
                CancellationFeeAmount,
                CancellationRefundPercent,
                IncludeCustomerServiceFeeInCancellationRefund);
            Message = "Mission annulee par l'administration.";
            CancellationReason = "Other";
            CancellationNote = null;
            CancellationFeeAmount = null;
            CancellationRefundPercent = 100;
            IncludeCustomerServiceFeeInCancellationRefund = false;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = $"Annulation impossible. Detail: {exception.Message}";
        }
        finally
        {
            IsActionBusy = false;
        }
    }

    private void BackToList() => Navigation.NavigateTo("/missions");
    private void SelectTab(string tab) => SelectedTab = tab;
    private string GetTabClass(string tab) => SelectedTab == tab ? "active" : string.Empty;

    private void OnResolutionTypeChanged(ChangeEventArgs args)
    {
        ResolutionType = args.Value?.ToString() ?? "PartialRefund";
        if (ResolutionType == "RefundCustomer")
        {
            RefundPercent = 100;
            RefundAmount = null;
        }
        else if (!RequiresRefundInput)
        {
            ClearRefundDecision();
        }
    }

    private void PrepareFullRefund()
    {
        ResolutionType = "RefundCustomer";
        RefundPercent = 100;
        RefundAmount = null;
        ErrorMessage = null;
    }

    private void ClearRefundDecision()
    {
        RefundPercent = null;
        RefundAmount = null;
        IncludeCustomerServiceFeeInDisputeRefund = false;
        ErrorMessage = null;
    }

    private string GetRefundPreviewLabel()
    {
        if (!RequiresRefundInput)
        {
            return "Aucun remboursement pour cette decision.";
        }

        if (RefundAmount.HasValue)
        {
            return "Montant saisi par l'admin.";
        }

        if (RefundPercent.HasValue)
        {
            return $"{RefundPercent.Value}% de la base mission.";
        }

        if (ResolutionType == "RefundCustomer")
        {
            return "Remboursement total prepare.";
        }

        return "A renseigner avant validation.";
    }

    private string? ValidateRefundDecision()
    {
        if (!RequiresRefundInput)
        {
            return null;
        }

        if (RefundPercent is < 0 or > 100)
        {
            return "Le pourcentage de remboursement doit etre compris entre 0 et 100.";
        }

        if (RefundAmount is < 0)
        {
            return "Le montant de remboursement ne peut pas etre negatif.";
        }

        if (RefundReferenceAmount > 0 && PreviewRefundAmount > RefundReferenceAmount)
        {
            return "Le remboursement ne peut pas depasser le montant de reference de la mission.";
        }

        return null;
    }

    private static string FormatMoney(int? amount, string currency) => amount is null ? "Aucun prix" : $"{amount:N0} {currency}";
    private static string FormatMoney(int amount, string currency) => $"{amount:N0} {currency}";
    private static string FormatSignedMoney(int amount, string currency)
        => amount < 0 ? $"-{Math.Abs(amount):N0} {currency}" : $"+{amount:N0} {currency}";
    private static string FormatDate(DateTimeOffset? value) => value?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Non renseigne";
    private static string FormatDate(DateTimeOffset value) => value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    private static string FormatLocation(decimal? latitude, decimal? longitude) => latitude is null || longitude is null ? "Non renseignees" : $"{latitude}, {longitude}";
    private static string FormatDistance(int? distance, int tolerance) => distance is null ? $"Tolerance {tolerance} m" : $"{distance} m / tolerance {tolerance} m";
    private static string FormatMissionTitle(string serviceName, string? prestationName)
        => string.IsNullOrWhiteSpace(prestationName) ? serviceName : $"{serviceName} - {prestationName}";

