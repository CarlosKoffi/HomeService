@page "/mission-test"
@using HomeService.Admin.Services
@using HomeService.Contracts.Admin
@inject ProviderMissionTestApiClient ApiClient
@inject PlatformApiClient AdminApiClient
@inject NavigationManager Navigation

<PageTitle>Validation prestataire - Test</PageTitle>

<div class="admin-page-heading">
    <div>
        <p class="eyebrow">Outil de test</p>
        <h1>Validation prestataire</h1>
        <p class="lead">Préparez un prestataire, forcez sa disponibilité, puis déroulez le workflow de mission existant.</p>
    </div>
    <button type="button" class="secondary-action" @onclick="LoadAsync" disabled="@IsLoading">Actualiser</button>
</div>

<div class="test-notice">
    Cette page utilise le vrai workflow : delai, validation du prestataire, statut de mission et notification client.
</div>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <p class="admin-message">@Message</p>
}
@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p class="admin-message error-message">@ErrorMessage</p>
}

<section class="assignment-panel provider-control-panel">
    <header>
        <div>
            <h2>Tous les prestataires</h2>
            <p>
                @(ProvidersSnapshot?.Stats.TotalProviders ?? 0) profil(s),
                @(ProvidersSnapshot?.Stats.AvailableProviders ?? 0) disponible(s).
            </p>
        </div>
        <label class="provider-test-search">
            <span>Recherche</span>
            <input type="search" @bind="ProviderSearchTerm" @bind:event="oninput" placeholder="Nom, téléphone, entreprise ou service" />
        </label>
    </header>

    @if (IsLoading)
    {
        <p class="empty-state">Chargement des prestataires...</p>
    }
    else if (VisibleProviders.Count == 0)
    {
        <p class="empty-state">Aucun prestataire ne correspond à la recherche.</p>
    }
    else
    {
        <div class="provider-test-list">
            @foreach (var provider in VisibleProviders)
            {
                <article class="provider-test-row">
                    <div class="provider-test-identity">
                        <span class="provider-test-avatar">@GetInitials(provider.FullName)</span>
                        <div>
                            <strong>@provider.FullName</strong>
                            <small>@provider.PhoneNumber</small>
                            <small>@(provider.CompanyName ?? "Sans entreprise")</small>
                        </div>
                    </div>
                    <div>
                        <span class="field-label">Validation</span>
                        <strong>@TranslateProviderStatus(provider.Status)</strong>
                        <small>@TranslateEmploymentType(provider.EmploymentType)</small>
                    </div>
                    <div>
                        <span class="field-label">Compétences</span>
                        <strong>@GetServiceSummary(provider)</strong>
                        <small>@provider.YearsOfExperience an(s) d’expérience</small>
                    </div>
                    <div class="provider-test-availability">
                        <span class="status-pill @(provider.IsAvailable ? "ok" : provider.Status == "Approved" ? "danger" : "pending")">
                            @GetAvailabilityLabel(provider)
                        </span>
                        @if (provider.Status == "Approved")
                        {
                            <button
                                type="button"
                                class="@(provider.IsAvailable ? "secondary-action" : "primary-action")"
                                disabled="@(ChangingProviderId is not null || IsSubmitting)"
                                @onclick="() => ToggleProviderAvailabilityAsync(provider)">
                                @(ChangingProviderId == provider.Id
                                    ? "Mise à jour..."
                                    : provider.IsAvailable ? "Rendre indisponible" : "Forcer disponible")
                            </button>
                        }
                        else
                        {
                            <small>Validez d’abord le profil.</small>
                        }
                        <button type="button" class="secondary-action" @onclick="() => OpenProvider(provider.Id)">Voir la fiche</button>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="assignment-panel">
    <header>
        <div>
            <h2>Missions prestataire actives</h2>
            <p>@(Snapshot?.Assignments.Count ?? 0) mission(s) a accepter, demarrer ou terminer.</p>
        </div>
    </header>

    @if (IsLoading)
    {
        <p class="empty-state">Chargement des affectations...</p>
    }
    else if (Snapshot is null || Snapshot.Assignments.Count == 0)
    {
        <p class="empty-state">Aucune mission n'attend actuellement la reponse d'un prestataire.</p>
    }
    else
    {
        <div class="assignment-list">
            @foreach (var assignment in Snapshot.Assignments)
            {
                <article class="assignment-row">
                    <div class="mission-reference">
                        <strong>@assignment.ServiceLabel</strong>
                        <span>@assignment.MissionNumber</span>
                    </div>
                    <div>
                        <span class="field-label">Prestataire</span>
                        <strong>@assignment.ProviderName</strong>
                        <small>@assignment.CompanyName</small>
                    </div>
                    <div>
                        <span class="field-label">Intervention</span>
                        <strong>@assignment.Address</strong>
                        <small>@assignment.Status</small>
                    </div>
                    <div class="assignment-action">
                        @if (assignment.CanAccept || assignment.CanStart)
                        {
                            <label class="eta-field">
                                <span>Temps avant arrivee</span>
                                <select value="@GetEta(assignment.AssignmentId)" @onchange="eventArgs => SetEta(assignment.AssignmentId, eventArgs.Value?.ToString())">
                                    <option value="5">5 min</option>
                                    <option value="10">10 min</option>
                                    <option value="15">15 min</option>
                                    <option value="20">20 min</option>
                                    <option value="30">30 min</option>
                                </select>
                            </label>
                        }
                        @if (assignment.CanAccept)
                        {
                            <button type="button" class="primary-action" disabled="@IsSubmitting" @onclick="() => AcceptAsync(assignment)">
                                Accepter comme prestataire
                            </button>
                        }
                        @if (assignment.CanStart)
                        {
                            <button type="button" class="secondary-action" disabled="@IsSubmitting" @onclick="() => PositionAsync(assignment)">
                                Mettre a jour la position
                            </button>
                            <button type="button" class="primary-action" disabled="@IsSubmitting" @onclick="() => StartAsync(assignment)">
                                Demarrer
                            </button>
                        }
                        @if (assignment.CanComplete)
                        {
                            <button type="button" class="primary-action" disabled="@IsSubmitting" @onclick="() => CompleteAsync(assignment)">
                                Fin de mission
                            </button>
                        }
                        @if (!assignment.CanAccept && !assignment.CanStart && !assignment.CanComplete)
                        {
                            <span class="blocked-label">Indisponible</span>
                            <small>@assignment.UnavailableReason</small>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private AdminProviderMissionTestListResponse? Snapshot { get; set; }
    private AdminProviderListResponse? ProvidersSnapshot { get; set; }
    private bool IsLoading { get; set; }
    private bool IsSubmitting { get; set; }
    private Guid? ChangingProviderId { get; set; }
    private string? Message { get; set; }
    private string? ErrorMessage { get; set; }
    private string? ProviderSearchTerm { get; set; }
    private Dictionary<Guid, int> EtaMinutes { get; } = [];

    private IReadOnlyList<AdminProviderSummaryResponse> VisibleProviders =>
        (ProvidersSnapshot?.Items ?? [])
            .Where(provider => MatchesProviderSearch(provider, ProviderSearchTerm))
            .OrderByDescending(provider => provider.IsAvailable)
            .ThenBy(provider => provider.FullName)
            .ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var assignmentsTask = ApiClient.GetAssignmentsAsync();
            var providersTask = AdminApiClient.GetAdminProvidersAsync(null, null, null);
            await Task.WhenAll(assignmentsTask, providersTask);
            Snapshot = await assignmentsTask;
            ProvidersSnapshot = await providersTask;
            foreach (var assignment in Snapshot?.Assignments ?? [])
            {
                EtaMinutes.TryAdd(assignment.AssignmentId, 10);
            }
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ToggleProviderAvailabilityAsync(AdminProviderSummaryResponse provider)
    {
        ChangingProviderId = provider.Id;
        Message = null;
        ErrorMessage = null;
        var nextAvailability = !provider.IsAvailable;
        try
        {
            var result = await AdminApiClient.SetAdminProviderAvailabilityAsync(
                provider.Id,
                nextAvailability,
                "Disponibilité forcée depuis l’outil de test prestataire.");
            if (!result.IsSuccess)
            {
                ErrorMessage = result.ErrorMessage ?? "La disponibilité n’a pas pu être modifiée.";
                return;
            }

            Message = nextAvailability
                ? $"{provider.FullName} est disponible. Vous pouvez poursuivre le test de mission."
                : $"{provider.FullName} est maintenant indisponible.";
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            ChangingProviderId = null;
        }
    }

    private void OpenProvider(Guid providerId) => Navigation.NavigateTo($"/providers/{providerId}");

    private static bool MatchesProviderSearch(AdminProviderSummaryResponse provider, string? search)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return true;
        }

        var term = search.Trim();
        return provider.FullName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || provider.PhoneNumber.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (provider.CompanyName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || provider.Services.Any(service => service.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private static string GetInitials(string fullName) => string.Concat(fullName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    private static string GetServiceSummary(AdminProviderSummaryResponse provider) =>
        provider.Services.Count == 0
            ? "Aucun service actif"
            : string.Join(", ", provider.Services.Take(2));

    private static string GetAvailabilityLabel(AdminProviderSummaryResponse provider) => provider.Status != "Approved"
        ? "Validation requise"
        : provider.IsAvailable ? "Disponible" : "Indisponible";

    private static string TranslateEmploymentType(string value) => value switch
    {
        "TemporaryWorker" => "Intérimaire",
        "CompanyEmployee" => "Employé",
        _ => value
    };

    private static string TranslateProviderStatus(string value) => value switch
    {
        "Approved" => "Validé plateforme",
        "Invited" => "Invité",
        "ProfileIncomplete" => "Profil incomplet",
        "PendingPlatformReview" => "À valider",
        "InterimCandidate" => "Candidat intérimaire",
        "SuspendedByCompany" => "Suspendu entreprise",
        "SuspendedByPlatform" => "Suspendu plateforme",
        "Inactive" => "Inactif",
        _ => value
    };

    private async Task AcceptAsync(AdminProviderMissionTestAssignmentResponse assignment)
    {
        IsSubmitting = true;
        Message = null;
        ErrorMessage = null;
        try
        {
            var result = await ApiClient.AcceptAsync(assignment.AssignmentId, GetEta(assignment.AssignmentId));
            Message = result?.Message ?? "Mission acceptee.";
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task PositionAsync(AdminProviderMissionTestAssignmentResponse assignment) =>
        await RunActionAsync(
            () => ApiClient.PositionAsync(assignment.AssignmentId, GetEta(assignment.AssignmentId)),
            "Position de test mise a jour.");

    private int GetEta(Guid assignmentId) =>
        EtaMinutes.TryGetValue(assignmentId, out var minutes) ? minutes : 10;

    private void SetEta(Guid assignmentId, string? value)
    {
        EtaMinutes[assignmentId] = int.TryParse(value, out var minutes) ? minutes : 10;
    }

    private async Task StartAsync(AdminProviderMissionTestAssignmentResponse assignment) =>
        await RunActionAsync(() => ApiClient.StartAsync(assignment.AssignmentId), "Mission demarree.");

    private async Task CompleteAsync(AdminProviderMissionTestAssignmentResponse assignment) =>
        await RunActionAsync(() => ApiClient.CompleteAsync(assignment.AssignmentId), "Mission terminee.");

    private async Task RunActionAsync(
        Func<Task<AdminProviderMissionTestActionResponse?>> action,
        string fallbackMessage)
    {
        IsSubmitting = true;
        Message = null;
        ErrorMessage = null;
        try
        {
            var result = await action();
            Message = result?.Message ?? fallbackMessage;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
