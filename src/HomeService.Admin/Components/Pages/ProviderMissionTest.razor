@page "/mission-test"
@using HomeService.Admin.Services
@using HomeService.Contracts.Admin
@inject ProviderMissionTestApiClient ApiClient

<PageTitle>Validation prestataire - Test</PageTitle>

<div class="admin-page-heading">
    <div>
        <p class="eyebrow">Outil de test</p>
        <h1>Validation prestataire</h1>
        <p class="lead">Simulez ici les actions du prestataire, de l'acceptation jusqu'a la fin de mission.</p>
    </div>
    <button type="button" class="secondary-action" @onclick="LoadAsync" disabled="@IsLoading">Actualiser</button>
</div>

<div class="test-notice">
    Cette page utilise le vrai workflow : delai, validation du prestataire, statut de mission et notification client.
</div>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <p class="admin-message">@Message</p>
}
@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p class="admin-message error-message">@ErrorMessage</p>
}

<section class="assignment-panel">
    <header>
        <div>
            <h2>Missions prestataire actives</h2>
            <p>@(Snapshot?.Assignments.Count ?? 0) mission(s) a accepter, demarrer ou terminer.</p>
        </div>
    </header>

    @if (IsLoading)
    {
        <p class="empty-state">Chargement des affectations...</p>
    }
    else if (Snapshot is null || Snapshot.Assignments.Count == 0)
    {
        <p class="empty-state">Aucune mission n'attend actuellement la reponse d'un prestataire.</p>
    }
    else
    {
        <div class="assignment-list">
            @foreach (var assignment in Snapshot.Assignments)
            {
                <article class="assignment-row">
                    <div class="mission-reference">
                        <strong>@assignment.ServiceLabel</strong>
                        <span>@assignment.MissionNumber</span>
                    </div>
                    <div>
                        <span class="field-label">Prestataire</span>
                        <strong>@assignment.ProviderName</strong>
                        <small>@assignment.CompanyName</small>
                    </div>
                    <div>
                        <span class="field-label">Intervention</span>
                        <strong>@assignment.Address</strong>
                        <small>@assignment.Status</small>
                    </div>
                    <div class="assignment-action">
                        @if (assignment.CanAccept || assignment.CanStart)
                        {
                            <label class="eta-field">
                                <span>Temps avant arrivee</span>
                                <select value="@GetEta(assignment.AssignmentId)" @onchange="eventArgs => SetEta(assignment.AssignmentId, eventArgs.Value?.ToString())">
                                    <option value="5">5 min</option>
                                    <option value="10">10 min</option>
                                    <option value="15">15 min</option>
                                    <option value="20">20 min</option>
                                    <option value="30">30 min</option>
                                </select>
                            </label>
                        }
                        @if (assignment.CanAccept)
                        {
                            <button type="button" class="primary-action" disabled="@IsSubmitting" @onclick="() => AcceptAsync(assignment)">
                                Accepter comme prestataire
                            </button>
                        }
                        @if (assignment.CanStart)
                        {
                            <button type="button" class="secondary-action" disabled="@IsSubmitting" @onclick="() => PositionAsync(assignment)">
                                Mettre a jour la position
                            </button>
                            <button type="button" class="primary-action" disabled="@IsSubmitting" @onclick="() => StartAsync(assignment)">
                                Demarrer
                            </button>
                        }
                        @if (assignment.CanComplete)
                        {
                            <button type="button" class="primary-action" disabled="@IsSubmitting" @onclick="() => CompleteAsync(assignment)">
                                Fin de mission
                            </button>
                        }
                        @if (!assignment.CanAccept && !assignment.CanStart && !assignment.CanComplete)
                        {
                            <span class="blocked-label">Indisponible</span>
                            <small>@assignment.UnavailableReason</small>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private AdminProviderMissionTestListResponse? Snapshot { get; set; }
    private bool IsLoading { get; set; }
    private bool IsSubmitting { get; set; }
    private string? Message { get; set; }
    private string? ErrorMessage { get; set; }
    private Dictionary<Guid, int> EtaMinutes { get; } = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            Snapshot = await ApiClient.GetAssignmentsAsync();
            foreach (var assignment in Snapshot?.Assignments ?? [])
            {
                EtaMinutes.TryAdd(assignment.AssignmentId, 10);
            }
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task AcceptAsync(AdminProviderMissionTestAssignmentResponse assignment)
    {
        IsSubmitting = true;
        Message = null;
        ErrorMessage = null;
        try
        {
            var result = await ApiClient.AcceptAsync(assignment.AssignmentId, GetEta(assignment.AssignmentId));
            Message = result?.Message ?? "Mission acceptee.";
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task PositionAsync(AdminProviderMissionTestAssignmentResponse assignment) =>
        await RunActionAsync(
            () => ApiClient.PositionAsync(assignment.AssignmentId, GetEta(assignment.AssignmentId)),
            "Position de test mise a jour.");

    private int GetEta(Guid assignmentId) =>
        EtaMinutes.TryGetValue(assignmentId, out var minutes) ? minutes : 10;

    private void SetEta(Guid assignmentId, string? value)
    {
        EtaMinutes[assignmentId] = int.TryParse(value, out var minutes) ? minutes : 10;
    }

    private async Task StartAsync(AdminProviderMissionTestAssignmentResponse assignment) =>
        await RunActionAsync(() => ApiClient.StartAsync(assignment.AssignmentId), "Mission demarree.");

    private async Task CompleteAsync(AdminProviderMissionTestAssignmentResponse assignment) =>
        await RunActionAsync(() => ApiClient.CompleteAsync(assignment.AssignmentId), "Mission terminee.");

    private async Task RunActionAsync(
        Func<Task<AdminProviderMissionTestActionResponse?>> action,
        string fallbackMessage)
    {
        IsSubmitting = true;
        Message = null;
        ErrorMessage = null;
        try
        {
            var result = await action();
            Message = result?.Message ?? fallbackMessage;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
