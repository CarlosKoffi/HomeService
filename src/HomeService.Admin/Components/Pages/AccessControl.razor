@page "/access-control"
@using HomeService.Admin.Services
@using HomeService.Contracts.Admin
@inject PlatformApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Acces et roles</PageTitle>

<section class="admin-page-heading">
    <div>
        <p class="eyebrow">Securite admin</p>
        <h1>Acces & roles</h1>
        <p class="lead">
            Configurez qui peut voir, modifier, valider ou piloter chaque module admin.
        </p>
    </div>
</section>

<nav class="service-admin-tabs access-admin-tabs" aria-label="Navigation acces admin">
    <button type="button" class="@GetAccessTabClass(AccessAdminTab.Overview)" @onclick="() => ActiveTab = AccessAdminTab.Overview">
        Vue d'ensemble
    </button>
    <button type="button" class="@GetAccessTabClass(AccessAdminTab.Roles)" @onclick="() => ActiveTab = AccessAdminTab.Roles">
        Roles & modules <span>@Roles.Count</span>
    </button>
    <button type="button" class="@GetAccessTabClass(AccessAdminTab.Permissions)" @onclick="() => ActiveTab = AccessAdminTab.Permissions">
        Permissions <span>@Modules.Count</span>
    </button>
    <button type="button" class="@GetAccessTabClass(AccessAdminTab.Admins)" @onclick="() => ActiveTab = AccessAdminTab.Admins">
        Administrateurs <span>@Admins.Count</span>
    </button>
</nav>

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <p class="admin-message success-message">@SuccessMessage</p>
}

@if (!string.IsNullOrWhiteSpace(ActionErrorMessage))
{
    <p class="admin-message error-message">@ActionErrorMessage</p>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p class="admin-message error-message">@ErrorMessage</p>
}

@if (ActiveTab == AccessAdminTab.Overview)
{
    <section class="info-panel">
        <div>
            <h2>Principe de securite</h2>
            <p>
                Chaque administrateur doit avoir uniquement les modules utiles a son travail.
                Les actions sensibles comme valider, suspendre ou configurer restent separees.
            </p>
        </div>
        <div class="check-list">
            <span>Acces minimum necessaire</span>
            <span>Actions sensibles separees</span>
            <span>Super admins limites</span>
            <span>Journalisation des decisions</span>
        </div>
    </section>

    <section class="admin-metric-grid access-summary-grid">
        <article>
            <span>Roles actifs</span>
            <strong>@Roles.Count(role => role.IsActive)</strong>
        </article>
        <article>
            <span>Modules</span>
            <strong>@Modules.Count</strong>
        </article>
        <article>
            <span>Admins actifs</span>
            <strong>@Admins.Count(admin => admin.IsActive)</strong>
        </article>
        <article>
            <span>Super admins</span>
            <strong>@Admins.Count(admin => admin.IsSuperAdmin)</strong>
        </article>
    </section>

    <section class="dashboard-grid">
        <article>
            <h2>Super admin</h2>
            <p>Acces total. Peut creer les roles, configurer les modules et inviter les autres admins.</p>
            <p class="section-help">A reserver a tres peu de personnes. Toute action critique est journalisee.</p>
        </article>
        <article>
            <h2>Roles modulaires</h2>
            <p>Un role donne acces a des modules precis: missions, notifications, services, validations entreprises.</p>
            <p class="section-help">Un admin peut avoir plusieurs roles si ses responsabilites traversent plusieurs equipes.</p>
        </article>
        <article>
            <h2>Actions controlees</h2>
            <p>Voir une liste ne donne pas forcement le droit de valider, rejeter, relancer ou configurer.</p>
            <p class="section-help">L'objectif est de simplifier le quotidien sans ouvrir trop de droits.</p>
        </article>
    </section>
}

@if (ActiveTab == AccessAdminTab.Roles)
{
<section class="access-layout access-layout-single">
    <article>
        <div class="section-heading">
            <div>
                <h2>Roles</h2>
                <p class="section-help">Un role est un paquet de permissions metier, facile a attribuer a un admin.</p>
            </div>
        </div>

        <div class="access-form">
            <label>
                Nom du role
                <input type="text" @bind="NewRoleName" placeholder="Ex: Finance" />
            </label>
            <label>
                Description
                <input type="text" @bind="NewRoleDescription" placeholder="Ce que ce role peut faire" />
            </label>
            <button type="button" @onclick="CreateRoleAsync" disabled="@IsBusy">Creer ce role</button>
        </div>

        <div class="access-filter-strip">
            <label>
                Rechercher
                <input type="search" @bind="RoleSearchTerm" @bind:event="oninput" placeholder="Role, module ou permission" />
            </label>
        </div>

        <div class="role-list">
            @if (IsLoading)
            {
                <div>
                    <strong>Chargement...</strong>
                    <p>Lecture des roles depuis la base.</p>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div>
                    <strong>Erreur</strong>
                    <p>@ErrorMessage</p>
                </div>
            }
            else if (FilteredRoles.Count == 0)
            {
                <div>
                    <strong>Aucun role</strong>
                    <p>Aucun role ne correspond a la recherche actuelle.</p>
                </div>
            }
            else
            {
                @foreach (var role in FilteredRoles)
                {
                    <div class="@GetRoleCardClass(role)">
                        <strong>@role.Name</strong>
                        <p>@role.Description</p>
                        <span>@GetRolePermissionSummary(role)</span>
                    </div>
                }
            }
        </div>
    </article>
</section>
}

@if (ActiveTab == AccessAdminTab.Permissions)
{
<section class="access-permission-board">
    <article>
        <div class="section-heading">
            <div>
                <h2>Permissions par module</h2>
                <p class="section-help">Selectionnez un role, puis cochez uniquement les actions necessaires a l'equipe.</p>
            </div>
        </div>

        <div class="access-form compact">
            <label>
                Role a configurer
                <select value="@SelectedRoleId" @onchange="OnSelectedRoleChanged">
                    @foreach (var role in Roles)
                    {
                        <option value="@role.Id">@role.Name</option>
                    }
                </select>
            </label>
            <button type="button" @onclick="SaveSelectedRolePermissionsAsync" disabled="@IsBusy">Enregistrer les droits</button>
        </div>

        <div class="permission-matrix">
            <div class="matrix-head">Module admin</div>
            <div class="matrix-head">Consulter</div>
            <div class="matrix-head">Modifier</div>
            <div class="matrix-head">Decider</div>
            @foreach (var module in Modules)
            {
                <div class="module-cell">
                    <strong>@module.Name</strong>
                    <small>@GetModuleHint(module.Name)</small>
                </div>
                <label><input type="checkbox" checked="@HasViewPermission(module.Id)" @onchange="args => ToggleViewPermission(module.Id, args)" /> Lire</label>
                <label><input type="checkbox" checked="@HasEditPermission(module.Id)" @onchange="args => ToggleEditPermission(module.Id, args)" /> Agir</label>
                <label><input type="checkbox" checked="@HasApprovePermission(module.Id)" @onchange="args => ToggleApprovePermission(module.Id, args)" /> Valider</label>
            }
        </div>
    </article>
</section>
}

@if (ActiveTab == AccessAdminTab.Admins)
{
<section class="translation-list access-admin-list">
    <div class="section-heading">
        <div>
            <h2>Administrateurs</h2>
            <p class="section-help">Creez les comptes internes, attribuez leurs roles et suspendez rapidement un acces si besoin.</p>
        </div>
    </div>

    <div class="access-form admin-invite-form">
        <label>
            Nom et prenom
            <input type="text" @bind="NewAdminFullName" placeholder="Ex: Awa Kone" />
        </label>
        <label>
            Email de l'admin
            <input type="email" @bind="NewAdminEmail" placeholder="admin@wele.ci" />
        </label>
        <label>
            Role
            <select @bind="NewAdminRoleId">
                <option value="">Selectionner un role</option>
                @foreach (var role in Roles.Where(role => role.IsActive).OrderBy(role => role.Name))
                {
                    <option value="@role.Id">@role.Name</option>
                }
            </select>
        </label>
        <button type="button" @onclick="CreateAdminAsync" disabled="@IsBusy">Generer le lien d'invitation</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(LastInvitationLink) && !IsInvitationForSelectedAdmin)
    {
        <div class="admin-invite-result">
            <div class="admin-invite-summary-card">
                <span>Invitation creee</span>
                <strong>@LastInvitationEmail</strong>
                <p>Lien valable 6h. Envoyez ce message a l'administrateur pour finaliser son acces.</p>
            </div>
            <div class="admin-invite-link-card">
                <div>
                    <span>Lien d'activation</span>
                    <a href="@LastInvitationLink" target="_blank" rel="noreferrer">Ouvrir dans un nouvel onglet</a>
                </div>
                <input class="admin-invite-link-input" value="@LastInvitationLink" readonly />
            </div>
            <div class="admin-invite-message-card">
                <label for="adminInviteMessage">Message pret a envoyer</label>
                <textarea id="adminInviteMessage" readonly rows="6">@LastInvitationMessage

@LastInvitationLink</textarea>
            </div>
        </div>
    }
    <div class="admin-filters access-admin-filters">
        <label>
            Recherche
            <input type="search" @bind="AdminSearchTerm" @bind:event="oninput" placeholder="Nom, email ou role" />
        </label>
        <label>
            Statut
            <select @bind="AdminStatusFilter">
                <option value="all">Tous</option>
                <option value="active">Actifs</option>
                <option value="suspended">Suspendus</option>
                <option value="super-admin">Super admins</option>
            </select>
        </label>
        <button type="button" class="secondary-action" @onclick="ClearAdminFilters">Reinitialiser</button>
    </div>

    @if (FilteredAdmins.Count == 0)
    {
        <article class="admin-empty-row">
            <strong>Aucun administrateur</strong>
            <p>Aucun compte ne correspond aux filtres actuels.</p>
        </article>
    }

    @if (SelectedAdmin is not null)
    {
        <article class="admin-profile-editor admin-wide-panel">
            <div class="section-heading">
                <div>
                    <h2>Profil admin</h2>
                    <p class="section-help">Modifiez le nom affiche dans les logs, l'email de connexion et les roles.</p>
                </div>
                <button type="button" class="secondary-action" @onclick="CloseAdminProfile">Fermer</button>
            </div>

            <div class="admin-profile-grid">
                <label>
                    Nom et prenom
                    <input type="text" @bind="AdminProfileFullNameDraft" placeholder="Ex: Awa Kone" />
                </label>
                <label>
                    Email de connexion
                    <input type="email" @bind="AdminProfileEmailDraft" placeholder="admin@wele.ci" />
                </label>
                <label>
                    Etat du compte
                    <input value="@GetAdminActivationLabel(SelectedAdmin)" readonly />
                </label>
            </div>

            <div class="admin-profile-role-panel">
                <div>
                    <strong>Roles autorises</strong>
                    <p>Cochez les modules que cet admin peut utiliser, puis enregistrez les roles.</p>
                </div>
                <div class="role-checkboxes admin-profile-role-list" aria-label="Roles de @SelectedAdmin.FullName">
                    @foreach (var role in Roles)
                    {
                        <label>
                            <input type="checkbox"
                                   checked="@HasAdminRoleDraft(SelectedAdmin.Id, role.Id)"
                                   @onchange="args => ToggleAdminRoleDraft(SelectedAdmin.Id, role.Id, args)" />
                            @role.Name
                        </label>
                    }
                </div>
            </div>

            @if (IsInvitationForSelectedAdmin)
            {
                <div class="admin-invite-result admin-profile-invite-result">
                    <div class="admin-invite-summary-card">
                        <div>
                            <span>Nouveau lien genere</span>
                            <strong>@LastInvitationEmail</strong>
                        </div>
                        <p>Lien valable 6h. Envoyez ce message a l'administrateur pour finaliser son acces.</p>
                    </div>
                    <div class="admin-invite-link-card">
                        <div>
                            <span>Lien d'activation</span>
                            <a href="@LastInvitationLink" target="_blank" rel="noreferrer">Ouvrir dans un nouvel onglet</a>
                        </div>
                        <input class="admin-invite-link-input" value="@LastInvitationLink" readonly />
                    </div>
                    <div class="admin-invite-message-card">
                        <label for="adminProfileInviteMessage">Message pret a envoyer</label>
                        <textarea id="adminProfileInviteMessage" readonly rows="6">@LastInvitationMessage

@LastInvitationLink</textarea>
                    </div>
                </div>
            }

            <div class="admin-profile-actions">
                <button type="button" @onclick="SaveSelectedAdminProfileAsync" disabled="@IsBusy">Enregistrer le profil</button>
                <button type="button" @onclick="() => SaveAdminRoleAsync(SelectedAdmin)" disabled="@IsBusy">Enregistrer les roles</button>
                <button type="button"
                        class="secondary-action"
                        @onclick="() => RegenerateInvitationAsync(SelectedAdmin)"
                        disabled="@(IsBusy || SelectedAdmin.HasActivatedAccess)">
                    Regenerer le lien d'invitation
                </button>
            </div>
        </article>
    }

    @foreach (var admin in FilteredAdmins)
    {
        <article class="admin-access-row">
            <div>
                <strong>@admin.FullName</strong>
                <p>@admin.Email</p>
            </div>
            <span>@GetAdminRoleLabel(admin)</span>
            <span class="@GetAdminStatusClass(admin)">@GetAdminStatusLabel(admin)</span>
            <span class="status-pill @(admin.MfaEnabled ? "ok" : "danger")">
                @(admin.MfaEnabled ? "Authenticator actif" : "Authenticator requis")
            </span>
            <div class="role-checkboxes compact-role-editor" aria-label="Roles de @admin.FullName">
                @foreach (var role in Roles)
                {
                    <label>
                        <input type="checkbox"
                               checked="@HasAdminRoleDraft(admin.Id, role.Id)"
                               @onchange="args => ToggleAdminRoleDraft(admin.Id, role.Id, args)" />
                        @role.Name
                    </label>
                }
            </div>
            <button type="button" class="secondary-action" @onclick="() => OpenAdminProfile(admin)" disabled="@IsBusy">Voir / modifier</button>
            <button type="button" @onclick="() => SaveAdminRoleAsync(admin)" disabled="@IsBusy">Enregistrer</button>
            @if (admin.IsActive)
            {
                <button type="button" class="ghost-danger-button" @onclick="() => DeactivateAdminAsync(admin)" disabled="@IsBusy">Suspendre</button>
            }
            else
            {
                <button type="button" @onclick="() => ReactivateAdminAsync(admin)" disabled="@IsBusy">Reactiver</button>
            }
        </article>
    }
</section>
}

@code {
    private List<AdminRoleSummaryResponse> Roles { get; set; } = [];
    private List<AdminModuleSummaryResponse> Modules { get; set; } = [];
    private List<AdminUserSummaryResponse> Admins { get; set; } = [];
    private bool IsLoading { get; set; } = true;
    private bool IsBusy { get; set; }
    private string? ErrorMessage { get; set; }
    private string? ActionErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private string? NewRoleName { get; set; }
    private string? NewRoleDescription { get; set; }
    private Guid? SelectedRoleId { get; set; }
    private HashSet<string> PermissionDraft { get; set; } = [];
    private string? NewAdminEmail { get; set; }
    private string? NewAdminFullName { get; set; }
    private Guid? NewAdminRoleId { get; set; }
    private string? LastInvitationLink { get; set; }
    private string? LastInvitationMessage { get; set; }
    private string? LastInvitationEmail { get; set; }
    private string? RoleSearchTerm { get; set; }
    private string? AdminSearchTerm { get; set; }
    private string AdminStatusFilter { get; set; } = "all";
    private Dictionary<Guid, HashSet<Guid>> AdminRoleDrafts { get; set; } = [];
    private AccessAdminTab ActiveTab { get; set; } = AccessAdminTab.Overview;
    private Guid? SelectedAdminId { get; set; }
    private string? AdminProfileFullNameDraft { get; set; }
    private string? AdminProfileEmailDraft { get; set; }

    private IReadOnlyList<AdminRoleSummaryResponse> FilteredRoles
        => Roles
            .Where(MatchesRoleFilters)
            .OrderByDescending(role => role.IsActive)
            .ThenBy(role => role.Name)
            .ToList();

    private IReadOnlyList<AdminUserSummaryResponse> FilteredAdmins
        => Admins
            .Where(MatchesAdminFilters)
            .OrderByDescending(admin => admin.IsActive)
            .ThenByDescending(admin => admin.IsSuperAdmin)
            .ThenBy(admin => admin.FullName)
            .ToList();

    private AdminUserSummaryResponse? SelectedAdmin
        => SelectedAdminId is null ? null : Admins.FirstOrDefault(admin => admin.Id == SelectedAdminId.Value);

    private bool IsInvitationForSelectedAdmin
        => SelectedAdmin is not null
            && !string.IsNullOrWhiteSpace(LastInvitationLink)
            && !string.IsNullOrWhiteSpace(LastInvitationEmail)
            && string.Equals(SelectedAdmin.Email, LastInvitationEmail, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var snapshot = await ApiClient.GetAdminAccessSnapshotAsync();
            Roles = snapshot?.Roles.ToList() ?? [];
            Modules = snapshot?.Modules.ToList() ?? [];
            Admins = snapshot?.Admins.ToList() ?? [];
            HydrateDrafts();
        }
        catch (Exception exception)
        {
            ErrorMessage = $"Impossible de charger les acces admin. Detail: {exception.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task CreateRoleAsync()
    {
        await RunAccessActionAsync(
            async () => await ApiClient.CreateAdminRoleAsync(new CreateAdminRoleRequest(NewRoleName ?? string.Empty, NewRoleDescription ?? string.Empty)),
            "Role cree.");

        NewRoleName = null;
        NewRoleDescription = null;
    }

    private async Task SaveSelectedRolePermissionsAsync()
    {
        if (SelectedRoleId is null)
        {
            ActionErrorMessage = "Selectionnez un role a configurer.";
            return;
        }

        var permissions = PermissionDraft
            .Select(ParsePermissionKey)
            .Where(permission => permission is not null)
            .Select(permission => permission!)
            .ToList();

        await RunAccessActionAsync(
            async () => await ApiClient.UpdateAdminRolePermissionsAsync(
                SelectedRoleId.Value,
                new UpdateAdminRolePermissionsRequest(permissions)),
            "Permissions enregistrees.");
    }

    private async Task CreateAdminAsync()
    {
        if (string.IsNullOrWhiteSpace(NewAdminFullName))
        {
            ActionErrorMessage = "Saisissez le nom et prenom de l'admin.";
            return;
        }

        if (NewAdminRoleId is null)
        {
            ActionErrorMessage = "Selectionnez un role pour cet admin.";
            return;
        }

        IsBusy = true;
        ActionErrorMessage = null;
        SuccessMessage = null;
        LastInvitationLink = null;
        LastInvitationMessage = null;
        LastInvitationEmail = null;

        try
        {
            var invitation = await ApiClient.CreateAdminInvitationAsync(new CreateAdminUserRequest(
                NewAdminFullName,
                NewAdminEmail ?? string.Empty,
                false,
                [NewAdminRoleId.Value]));
            ApplySnapshot(invitation?.Snapshot);
            LastInvitationEmail = invitation?.Email;
            LastInvitationMessage = invitation?.Message;
            LastInvitationLink = BuildInvitationLink(invitation?.Token);
            SuccessMessage = "Lien d'invitation admin genere.";
        }
        catch (Exception exception)
        {
            ActionErrorMessage = $"Action impossible. Detail: {exception.Message}";
        }
        finally
        {
            IsBusy = false;
        }

        NewAdminEmail = null;
        NewAdminFullName = null;
        NewAdminRoleId = null;
    }

    private async Task SaveAdminRoleAsync(AdminUserSummaryResponse admin)
    {
        AdminRoleDrafts.TryGetValue(admin.Id, out var roleIds);

        await RunAccessActionAsync(
            async () => await ApiClient.UpdateAdminUserRolesAsync(admin.Id, new UpdateAdminUserRolesRequest(roleIds?.ToList() ?? [])),
            "Acces admin modifies.");
    }

    private async Task SaveSelectedAdminProfileAsync()
    {
        if (SelectedAdmin is null)
        {
            ActionErrorMessage = "Selectionnez un admin a modifier.";
            return;
        }

        await RunAccessActionAsync(
            async () => await ApiClient.UpdateAdminUserProfileAsync(
                SelectedAdmin.Id,
                new UpdateAdminUserProfileRequest(AdminProfileFullNameDraft ?? string.Empty, AdminProfileEmailDraft ?? string.Empty)),
            "Profil admin mis a jour.");

        var refreshedAdmin = Admins.FirstOrDefault(admin => admin.Id == SelectedAdmin.Id);
        if (refreshedAdmin is not null)
        {
            OpenAdminProfile(refreshedAdmin);
        }
    }

    private async Task RegenerateInvitationAsync(AdminUserSummaryResponse admin)
    {
        IsBusy = true;
        ActionErrorMessage = null;
        SuccessMessage = null;
        LastInvitationLink = null;
        LastInvitationMessage = null;
        LastInvitationEmail = null;

        try
        {
            var invitation = await ApiClient.RegenerateAdminInvitationAsync(admin.Id);
            ApplySnapshot(invitation?.Snapshot);
            LastInvitationEmail = invitation?.Email;
            LastInvitationMessage = invitation?.Message;
            LastInvitationLink = BuildInvitationLink(invitation?.Token);
            SuccessMessage = "Nouveau lien d'invitation genere.";
            var refreshedAdmin = Admins.FirstOrDefault(item => item.Id == admin.Id);
            if (refreshedAdmin is not null)
            {
                OpenAdminProfile(refreshedAdmin);
            }
        }
        catch (Exception exception)
        {
            ActionErrorMessage = $"Action impossible. Detail: {exception.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task DeactivateAdminAsync(AdminUserSummaryResponse admin)
    {
        await RunAccessActionAsync(
            async () => await ApiClient.DeactivateAdminUserAsync(admin.Id),
            "Admin suspendu.");
    }

    private async Task ReactivateAdminAsync(AdminUserSummaryResponse admin)
    {
        await RunAccessActionAsync(
            async () => await ApiClient.ReactivateAdminUserAsync(admin.Id),
            "Admin reactive.");
    }

    private async Task RunAccessActionAsync(Func<Task<AdminAccessSnapshotResponse?>> action, string successMessage)
    {
        IsBusy = true;
        ActionErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var snapshot = await action();
            ApplySnapshot(snapshot);
            SuccessMessage = successMessage;
        }
        catch (Exception exception)
        {
            ActionErrorMessage = $"Action impossible. Detail: {exception.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void ApplySnapshot(AdminAccessSnapshotResponse? snapshot)
    {
        Roles = snapshot?.Roles.ToList() ?? [];
        Modules = snapshot?.Modules.ToList() ?? [];
        Admins = snapshot?.Admins.ToList() ?? [];
        HydrateDrafts();
    }

    private void HydrateDrafts()
    {
        SelectedRoleId ??= Roles.FirstOrDefault()?.Id;
        HydratePermissionDraft();

        AdminRoleDrafts = Admins.ToDictionary(
            admin => admin.Id,
            admin => Roles
                .Where(role => admin.Roles.Contains(role.Name, StringComparer.OrdinalIgnoreCase))
                .Select(role => role.Id)
                .ToHashSet());
    }

    private void HydratePermissionDraft()
    {
        PermissionDraft.Clear();
        var selectedRole = Roles.FirstOrDefault(role => role.Id == SelectedRoleId);
        if (selectedRole is null)
        {
            return;
        }

        foreach (var permission in selectedRole.Permissions)
        {
            PermissionDraft.Add(BuildPermissionKey(permission.ModuleId, permission.Action));
        }
    }

    private void OnSelectedRoleChanged(ChangeEventArgs args)
    {
        SelectedRoleId = Guid.TryParse(args.Value?.ToString(), out var roleId) ? roleId : null;
        HydratePermissionDraft();
    }

    private void TogglePermission(Guid moduleId, string action, ChangeEventArgs args)
    {
        var key = BuildPermissionKey(moduleId, action);
        var isChecked = args.Value is bool value && value;
        if (isChecked)
        {
            PermissionDraft.Add(key);
            return;
        }

        PermissionDraft.Remove(key);
    }

    private void ToggleViewPermission(Guid moduleId, ChangeEventArgs args)
    {
        TogglePermission(moduleId, "View", args);
    }

    private void ToggleEditPermission(Guid moduleId, ChangeEventArgs args)
    {
        TogglePermission(moduleId, "Edit", args);
    }

    private void ToggleApprovePermission(Guid moduleId, ChangeEventArgs args)
    {
        TogglePermission(moduleId, "Approve", args);
    }

    private bool HasAdminRoleDraft(Guid adminId, Guid roleId)
    {
        return AdminRoleDrafts.TryGetValue(adminId, out var roleIds) && roleIds.Contains(roleId);
    }

    private void ToggleAdminRoleDraft(Guid adminId, Guid roleId, ChangeEventArgs args)
    {
        if (!AdminRoleDrafts.TryGetValue(adminId, out var roleIds))
        {
            roleIds = [];
            AdminRoleDrafts[adminId] = roleIds;
        }

        var isChecked = args.Value is bool value && value;
        if (isChecked)
        {
            roleIds.Add(roleId);
            return;
        }

        roleIds.Remove(roleId);
    }

    private bool HasDraftPermission(Guid moduleId, string action)
    {
        return PermissionDraft.Contains(BuildPermissionKey(moduleId, action));
    }

    private bool HasViewPermission(Guid moduleId)
    {
        return HasDraftPermission(moduleId, "View");
    }

    private bool HasEditPermission(Guid moduleId)
    {
        return HasDraftPermission(moduleId, "Edit");
    }

    private bool HasApprovePermission(Guid moduleId)
    {
        return HasDraftPermission(moduleId, "Approve");
    }

    private static string BuildPermissionKey(Guid moduleId, string action)
    {
        return $"{moduleId:N}:{action}";
    }

    private static AdminPermissionAssignmentRequest? ParsePermissionKey(string key)
    {
        var parts = key.Split(':', 2);
        if (parts.Length != 2 || !Guid.TryParse(parts[0], out var moduleId))
        {
            return null;
        }

        return new AdminPermissionAssignmentRequest(moduleId, parts[1]);
    }

    private bool MatchesRoleFilters(AdminRoleSummaryResponse role)
    {
        if (string.IsNullOrWhiteSpace(RoleSearchTerm))
        {
            return true;
        }

        var search = RoleSearchTerm.Trim();
        return role.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
            || role.Description.Contains(search, StringComparison.OrdinalIgnoreCase)
            || role.Permissions.Any(permission =>
                permission.ModuleName.Contains(search, StringComparison.OrdinalIgnoreCase)
                || permission.Action.Contains(search, StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesAdminFilters(AdminUserSummaryResponse admin)
    {
        var statusMatches = AdminStatusFilter switch
        {
            "active" => admin.IsActive,
            "suspended" => !admin.IsActive,
            "super-admin" => admin.IsSuperAdmin,
            _ => true
        };

        if (!statusMatches)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(AdminSearchTerm))
        {
            return true;
        }

        var search = AdminSearchTerm.Trim();
        return admin.FullName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || admin.Email.Contains(search, StringComparison.OrdinalIgnoreCase)
            || admin.Roles.Any(role => role.Contains(search, StringComparison.OrdinalIgnoreCase));
    }

    private void ClearAdminFilters()
    {
        AdminSearchTerm = null;
        AdminStatusFilter = "all";
        ActionErrorMessage = null;
        SuccessMessage = null;
    }

    private void OpenAdminProfile(AdminUserSummaryResponse admin)
    {
        SelectedAdminId = admin.Id;
        AdminProfileFullNameDraft = admin.FullName;
        AdminProfileEmailDraft = admin.Email;
        ActionErrorMessage = null;
        SuccessMessage = null;
    }

    private void CloseAdminProfile()
    {
        SelectedAdminId = null;
        AdminProfileFullNameDraft = null;
        AdminProfileEmailDraft = null;
    }

    private static string GetRolePermissionSummary(AdminRoleSummaryResponse role)
    {
        if (!role.IsActive)
        {
            return "Role inactif";
        }

        if (role.Permissions.Count == 0)
        {
            return "Aucune permission configuree";
        }

        var modules = role.Permissions
            .Select(permission => permission.ModuleName)
            .Distinct()
            .Take(4);

        return string.Join(", ", modules);
    }

    private static string GetRoleCardClass(AdminRoleSummaryResponse role)
    {
        return role.IsActive ? "role-card active" : "role-card inactive";
    }

    private static string GetModuleHint(string moduleName)
    {
        return moduleName switch
        {
            "Dashboard" => "Vue globale et indicateurs",
            "CompanyApplications" => "Dossiers entreprises a verifier",
            "Companies" => "Entreprises partenaires",
            "Providers" => "Prestataires et interimaires",
            "Missions" => "Demandes, devis, litiges et annulations",
            "Payments" => "Encaissements et commissions",
            "Services" => "Catalogue services et prestations",
            "Notifications" => "Modeles, regles et envois",
            "Localization" => "Textes et traductions",
            "Cms" => "Contenu editorial des sites",
            "AccessControl" => "Admins, roles et permissions",
            "AuditLogs" => "Journal des actions sensibles",
            _ => "Module operationnel"
        };
    }

    private static string GetAdminRoleLabel(AdminUserSummaryResponse admin)
    {
        if (admin.IsSuperAdmin)
        {
            return "Super admin";
        }

        return admin.Roles.Count == 0 ? "Aucun role" : string.Join(", ", admin.Roles);
    }

    private static string GetAdminStatusLabel(AdminUserSummaryResponse admin)
    {
        if (!admin.IsActive)
        {
            return "Suspendu";
        }

        return admin.HasActivatedAccess ? "Actif" : "Invitation en attente";
    }

    private static string GetAdminStatusClass(AdminUserSummaryResponse admin)
    {
        if (!admin.IsActive)
        {
            return "status-pill danger";
        }

        return admin.HasActivatedAccess ? "status-pill ok" : "status-pill pending";
    }

    private static string GetAdminActivationLabel(AdminUserSummaryResponse admin)
    {
        if (!admin.IsActive)
        {
            return "Compte suspendu";
        }

        if (admin.HasActivatedAccess)
        {
            return admin.LastLoginAt is null ? "Acces active, jamais connecte" : $"Acces active, derniere connexion {admin.LastLoginAt:dd/MM/yyyy HH:mm}";
        }

        if (admin.InvitationExpiresAt is null)
        {
            return "Invitation a generer";
        }

        return admin.InvitationExpiresAt <= DateTimeOffset.UtcNow
            ? "Invitation expiree"
            : $"Invitation valable jusqu'au {admin.InvitationExpiresAt:dd/MM/yyyy HH:mm}";
    }

    private string GetAccessTabClass(AccessAdminTab tab)
    {
        return ActiveTab == tab ? "active" : string.Empty;
    }

    private string? BuildInvitationLink(string? token)
    {
        return string.IsNullOrWhiteSpace(token)
            ? null
            : Navigation.ToAbsoluteUri($"/admin-invitation/{Uri.EscapeDataString(token)}").ToString();
    }

    private static string BuildDefaultFullName(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return "Nouvel admin";
        }

        var localPart = email.Split('@', 2)[0].Replace('.', ' ').Replace('_', ' ').Trim();
        return string.IsNullOrWhiteSpace(localPart) ? "Nouvel admin" : localPart;
    }

    private enum AccessAdminTab
    {
        Overview,
        Roles,
        Permissions,
        Admins
    }
}
