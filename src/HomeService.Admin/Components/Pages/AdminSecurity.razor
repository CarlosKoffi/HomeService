@page "/admin-security"
@using HomeService.Admin.Services
@using HomeService.Contracts.Admin
@using QRCoder
@inject PlatformApiClient ApiClient
@inject AdminSessionState SessionState
@inject NavigationManager Navigation

<PageTitle>Sécurité du compte</PageTitle>

<div class="admin-page-heading security-heading">
    <div>
        <p class="eyebrow">Sécurité</p>
        <h1>Authenticator</h1>
        <p class="lead">Une confirmation personnelle protège les reversements, remboursements et réglages financiers.</p>
    </div>
</div>

@if (IsRequiredOnboarding)
{
    <section class="onboarding-welcome">
        <span>Première connexion</span>
        <h2>Protégeons votre compte avant de commencer</h2>
        <p>Cette installation personnelle prend environ deux minutes. Vous aurez besoin de votre téléphone.</p>
        <ol>
            <li class="@(GetOnboardingStep() >= 1 ? "active" : null)"><b>1</b><span>Installer ou ouvrir<br /><strong>Authenticator</strong></span></li>
            <li class="@(GetOnboardingStep() >= 2 ? "active" : null)"><b>2</b><span>Scanner<br /><strong>le QR code</strong></span></li>
            <li class="@(GetOnboardingStep() >= 3 ? "active" : null)"><b>3</b><span>Saisir<br /><strong>les 6 chiffres</strong></span></li>
            <li class="@(GetOnboardingStep() >= 4 ? "active" : null)"><b>4</b><span>Sauvegarder<br /><strong>les codes de secours</strong></span></li>
        </ol>
    </section>
}

@if (!string.IsNullOrWhiteSpace(Message))
{
    <p class="admin-message @(IsError ? "error-message" : "success-message")">@Message</p>
}

@if (IsLoading)
{
    <section class="security-card"><p>Chargement de la sécurité du compte…</p></section>
}
else if (Activation is not null)
{
    <section class="security-card recovery-card">
        <span class="security-state enabled">Activation réussie</span>
        <h2>Conservez ces codes de secours</h2>
        <p>Chaque code ne fonctionne qu’une fois. Copiez-les dans un gestionnaire de mots de passe ou imprimez-les, puis quittez cet écran.</p>
        <div class="recovery-grid">
            @foreach (var recoveryCode in Activation.RecoveryCodes)
            {
                <code>@recoveryCode</code>
            }
        </div>
        <button type="button" class="primary-action" @onclick="FinishActivation">J’ai sauvegardé mes codes et j’accède à l’admin</button>
    </section>
}
else if (Enrollment is not null)
{
    <section class="security-card enrollment-card">
        <div class="security-instructions">
            <span class="security-step">1</span>
            <div>
                <h2>Scannez le QR code</h2>
                <p>Ouvrez Google Authenticator ou Microsoft Authenticator sur votre téléphone, touchez <strong>+</strong>, puis choisissez <strong>Scanner un QR code</strong>.</p>
            </div>
        </div>
        <div class="qr-panel">
            <img src="@QrCodeDataUrl" alt="QR code Authenticator Wélé" />
            <div>
                <small>Clé manuelle</small>
                <code>@FormatManualKey(Enrollment.ManualKey)</code>
                <p>Valable jusqu’à @Enrollment.ExpiresAt.ToLocalTime().ToString("HH:mm").</p>
            </div>
        </div>
        <div class="security-instructions">
            <span class="security-step">2</span>
            <div>
                <h2>Confirmez le premier code</h2>
                <p>Saisissez les 6 chiffres affichés dans Authenticator.</p>
            </div>
        </div>
        <div class="activation-form">
            <input inputmode="numeric" autocomplete="one-time-code" maxlength="6" @bind="ActivationCode" placeholder="000 000" />
            <button type="button" class="primary-action" @onclick="ActivateAsync" disabled="@IsSubmitting">Activer Authenticator</button>
            <button type="button" class="secondary-action" @onclick="CancelEnrollment" disabled="@IsSubmitting">Annuler</button>
        </div>
    </section>
}
else
{
    <section class="security-card security-summary">
        <div>
            <span class="security-state @(Status?.IsEnabled == true ? "enabled" : "required")">
                @(Status?.IsEnabled == true ? "Protection active" : "Activation requise")
            </span>
            <h2>@(Status?.IsEnabled == true ? "Votre compte est protégé" : "Protégez les actions sensibles")</h2>
            @if (Status?.IsEnabled == true)
            {
                <p>Les opérations financières exigent désormais un code personnel. Il reste <strong>@Status.RemainingRecoveryCodes code(s) de secours</strong>.</p>
            }
            else
            {
                <p>Installez si nécessaire <strong>Google Authenticator</strong> ou <strong>Microsoft Authenticator</strong> sur votre téléphone. Chaque administrateur doit utiliser son propre appareil.</p>
            }
        </div>
        @if (Status?.IsEnabled != true)
        {
            <button type="button" class="primary-action" @onclick="BeginEnrollmentAsync" disabled="@IsSubmitting">Commencer la configuration</button>
        }
    </section>
}

<style>
    .onboarding-welcome{max-width:900px;margin-bottom:20px;padding:24px 28px;border-radius:24px;background:linear-gradient(135deg,#0d2b5b,#1769ff);color:#fff;box-shadow:0 18px 50px rgba(23,105,255,.2)}.onboarding-welcome>span{display:inline-flex;padding:6px 10px;border-radius:999px;background:rgba(255,255,255,.16);font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.onboarding-welcome h2{margin:12px 0 6px;font-size:26px}.onboarding-welcome>p{margin:0;color:#dce9ff}.onboarding-welcome ol{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:24px 0 0;padding:0;list-style:none}.onboarding-welcome li{display:flex;align-items:center;gap:10px;padding:12px;border:1px solid rgba(255,255,255,.18);border-radius:14px;color:#c5d8fa}.onboarding-welcome li.active{border-color:rgba(255,255,255,.65);background:rgba(255,255,255,.13);color:#fff}.onboarding-welcome li b{display:grid;place-items:center;flex:0 0 28px;height:28px;border-radius:50%;background:#fff;color:#1769ff}.onboarding-welcome li span{font-size:12px;line-height:1.35}
    .security-heading{max-width:980px}.security-card{max-width:900px;padding:28px;border:1px solid #dbe5f4;border-radius:24px;background:#fff;box-shadow:0 18px 50px rgba(15,31,60,.08)}.security-card h2{margin:10px 0 8px;font-size:25px}.security-card p{color:#667085;line-height:1.65}.security-state{display:inline-flex;padding:7px 11px;border-radius:999px;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.05em}.security-state.enabled{background:#dcfae6;color:#067647}.security-state.required{background:#fff1e8;color:#c2410c}.security-summary{display:flex;align-items:center;justify-content:space-between;gap:30px}.security-instructions{display:flex;gap:14px;align-items:flex-start;margin:8px 0 18px}.security-step{display:grid;place-items:center;flex:0 0 34px;height:34px;border-radius:50%;background:#1769ff;color:#fff;font-weight:900}.security-instructions h2{margin:2px 0}.security-instructions p{margin:0}.qr-panel{display:flex;align-items:center;gap:28px;margin:18px 0 28px;padding:20px;border-radius:20px;background:#f7faff}.qr-panel img{width:220px;height:220px;padding:10px;border-radius:14px;background:#fff}.qr-panel code{display:block;margin:8px 0;font-size:16px;letter-spacing:.12em;word-break:break-all}.activation-form{display:flex;gap:10px;flex-wrap:wrap}.activation-form input{width:190px;min-height:48px;border:1px solid #cfd9e8;border-radius:12px;padding:0 16px;font-size:20px;letter-spacing:.2em}.recovery-grid{display:grid;grid-template-columns:repeat(2,minmax(150px,1fr));gap:10px;margin:20px 0}.recovery-grid code{padding:13px;border:1px dashed #9cb4d8;border-radius:10px;background:#f7faff;text-align:center;font-size:17px}.primary-action{min-height:44px;padding:0 20px;border:0;border-radius:12px;background:#1769ff;color:#fff;font-weight:900}.secondary-action{min-height:44px;padding:0 18px;border:1px solid #ccd8e8;border-radius:12px;background:#fff;font-weight:800}
    @@media(max-width:720px){.security-summary,.qr-panel{align-items:flex-start;flex-direction:column}.onboarding-welcome ol{grid-template-columns:1fr 1fr}.qr-panel img{width:min(220px,100%);height:auto}.recovery-grid{grid-template-columns:1fr}.security-card,.onboarding-welcome{padding:20px}}
</style>

@code {
    private AdminMfaStatusResponse? Status { get; set; }
    private AdminMfaEnrollmentResponse? Enrollment { get; set; }
    private AdminMfaActivationResponse? Activation { get; set; }
    private string? QrCodeDataUrl { get; set; }
    private string ActivationCode { get; set; } = string.Empty;
    private string? Message { get; set; }
    private bool IsError { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsSubmitting { get; set; }
    private bool IsRequiredOnboarding => SessionState.CurrentUser?.MfaEnrollmentRequired == true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Status = await ApiClient.GetAdminMfaStatusAsync();
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task BeginEnrollmentAsync()
    {
        IsSubmitting = true;
        try
        {
            Enrollment = await ApiClient.BeginAdminMfaEnrollmentAsync();
            if (Enrollment is not null)
            {
                using var generator = new QRCodeGenerator();
                using var data = generator.CreateQrCode(Enrollment.ProvisioningUri, QRCodeGenerator.ECCLevel.Q);
                var svg = new SvgQRCode(data).GetGraphic(7);
                QrCodeDataUrl = $"data:image/svg+xml;base64,{Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(svg))}";
            }
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task ActivateAsync()
    {
        if (ActivationCode.Trim().Length != 6)
        {
            SetMessage("Saisissez le code à 6 chiffres affiché dans Authenticator.", true);
            return;
        }

        IsSubmitting = true;
        try
        {
            Activation = await ApiClient.ActivateAdminMfaAsync(ActivationCode.Trim());
            Status = Activation?.Status;
            await SessionState.RefreshAsync();
            Enrollment = null;
            QrCodeDataUrl = null;
            SetMessage(Activation?.Message ?? "Authenticator activé.", false);
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void FinishActivation()
    {
        Activation = null;
        Navigation.NavigateTo("/", forceLoad: true);
    }
    private void CancelEnrollment() { Enrollment = null; QrCodeDataUrl = null; ActivationCode = string.Empty; }
    private void SetMessage(string message, bool error) { Message = message; IsError = error; }
    private int GetOnboardingStep() => Activation is not null ? 4 : Enrollment is not null ? 2 : Status?.IsEnabled == true ? 4 : 1;
    private static string FormatManualKey(string value) => string.Join(' ', Enumerable.Range(0, (value.Length + 3) / 4).Select(index => value.Substring(index * 4, Math.Min(4, value.Length - index * 4))));
}
